---
/**
 * 一键把站点用到的字体注入页面。
 *
 * 两条路，各有原因：
 *
 * 1) Google Sans Flex / Encode Sans SC / JetBrains Mono 走 Astro 的 Fonts API：
 *    构建时自托管、自动生成 @font-face + CSS 变量、顺带给出度量匹配的兜底字面。
 *    InterVariable 则由 scripts/build-inter-fonts.mjs 从 rsms.me 下载完整变量字体并自托管。
 *    ⚠️ Astro 给这些拉丁族名加内容哈希 ⇒ main.css 里用 var(--font-xxx) 引用；
 *       中文 Noto 字体不走 Astro API，保留 'Noto Sans SC' / 'Noto Serif SC' 字面名。
 *    ⚠️ 拉丁族的 `fallbacks` 配成 []：var() 展开是「族名, 系统兜底, generic」，
 *       自带 generic 的话它会排在后面那个中文字族**前面**，汉字就落到系统宋体/黑体了。
 *
 * 1b) GSF 的**斜体面**是单独一份烘焙产物（slnt 冻结 + ss01 并入 ccmp），见下面那段注释。
 *     它只在这条链路里出现，不进 Fonts API 的 fonts 配置。
 *
 * 2) 中文两族（Noto Sans SC / Noto Serif SC）直接用 Google Fonts CSS API；
 *    Google 根据 unicode-range 选择所需的字体分片，字 CSS 与字体文件均由 Google 提供。
 *
 * ⚠️ preload 预算：全站图片 preload ≤1（当前 0 条，见 Layout 的说明）+ 字体 preload 3 条：
 *    Google Sans Flex（站名/大标题）、Encode Sans SC（导航/分类）、
 *    CatNotoSC（分类 chip 的中文子集，只有 7.9 KB）。
 *    InterVariable 正体通过样式表正常加载，不额外 preload；中文字体按 unicode-range 分片，
 *    preload 任何一片都是瞎猜，所以不 preload。
 * ⚠️ 关于「Google Sans Flex 闪一下」：它 368 KB，冷缓存下晚于首帧到达，
 *    以前是 swap ⇒ 先画 Inter 再跳到 GSF。现在这一族单独用 font-display: block
 *    （见 astro.config.mjs），字形没到就先不画，绝不出现「错误字形 → 正确字形」的跳变。
 *    所以它虽然大，仍然值得 preload：pre 的是「让它尽量早到、缩短空白期」，不是「靠缩体积免闪」。
 * ⚠️ preload 链接自带 crossorigin（同源也要写）：凭据模式不一致会重复下载一次。
 */
import { Font } from 'astro:assets';
import { componentDataByCssVariable } from 'virtual:astro:assets/fonts/internal';
import interFonts from '../generated/inter-fonts.json';
import gsfItalic from '../generated/gsf-italic.json';

interface Props {
  /** 只在需要最快出字的页面（正文布局）打开 */
  preload?: boolean;
}

const { preload = false } = Astro.props;
const cjkGoogleFontsUrl =
  'https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@100..900&family=Noto+Serif+SC:wght@200..900&display=swap';

// ⚡️ Google Sans Flex 的斜体面。
// GSF 没有 italic，只有 slnt 轴（-10..0）；只声明正体的话，`font-style: italic` 没有可选的
// @font-face，浏览器就自己把正体倾斜（假斜体）。
// 这里指向 scripts/rebuild-gsf-italic.mjs 烘焙好的那份：**slnt 已冻结进字体文件**，
// 单层 a（ss01）已并入 ccmp（字体默认生效）。所以 CSS 只需要 font-style: italic：
//   ⚠️ 不要在这里加 font-variation-settings:"slnt" -10 —— 它是作者级轴锁定，
//      会把 wdth/opsz/wght 的 CSS 表现一起压住（实测斜体 + font-stretch 会失效）。
//   ⚠️ 也不要加 font-feature-settings:"ss01" —— 已在字体里，加了反而让 canvas 与 CSS 不一致。
// ⚠️ font-display: swap（不是 block）：这一面**不 preload**，block 会让斜体文字在最坏情况下
//    3 秒不可见；swap 至少立刻有兜底斜体可读。block 只用在被 preload 的标题族上。
// 族名必须和 Astro 生成的正体**完全一致**（它带内容哈希），所以从 Fonts API 的虚拟模块里读出来。
// ⚠️ 正则要容忍冒号后的空白：build 的 CSS 是压缩过的（`font-family:"X"`），
//    dev 下没压缩（`font-family: "X"`），写死不带空格会让 dev 里静默拿不到族名。
const gsfFamily = /font-family:\s*"([^"]+)"/.exec(
  componentDataByCssVariable.get('--font-google-sans-flex')?.css ?? ''
)?.[1];
const gsfItalicCss =
  gsfFamily &&
  `@font-face{` +
    `font-family:"${gsfFamily}";` +
    `src:url("${gsfItalic.url}") format("woff2");` +
    `font-display:swap;` +
    `unicode-range:${gsfItalic.unicodeRange};` +
    `font-weight:1 1000;` +
    `font-style:italic;` +
    `}`;
---

 <link rel="preconnect" href="https://fonts.googleapis.com" />
 <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
 <link rel="stylesheet" href={cjkGoogleFontsUrl} />

 {/* GSF 只有一个 face（按轴请求的整份字体），用 true（= 该族全部 face）比 subset 过滤稳；
      其余族按 subset 过滤，避免把 latin-ext / italic 也一起 preload 掉 */}
 <Font cssVariable="--font-google-sans-flex" preload={preload ? true : false} />
 <Font cssVariable="--font-encode-sans-sc" preload={preload ? [{ subset: 'latin' }] : false} />
 <Font cssVariable="--font-jetbrains-mono" />

{preload && (
  <link rel="preload" href="/fonts/CatNotoSC-VF.woff2" as="font" type="font/woff2" crossorigin />
)}

{gsfItalicCss && <style set:html={gsfItalicCss}></style>}

<link rel="stylesheet" href={interFonts.href} />
