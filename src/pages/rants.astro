---
import Layout from '../layouts/Layout.astro';
import LikeButton from '../components/LikeButton.astro';
import { formatDate, formatTime, getPostUrl, type Lang } from '../lib/posts';

const LANG: Lang = 'zh';
const markdownFiles = import.meta.glob('./blog/rants/*.md', { eager: true });
// ⚠️ 不能用 post.Content：md 的 frontmatter 里写了 layout ⇒ Content 会把整个文章页（含页头、标签）也套进来。
//    compiledContent() 只给编译后的正文 HTML，正好是卡片里要的。
const cards = await Promise.all(
    Object.values(markdownFiles)
        .filter((p: any) => !p.frontmatter?.draft)
        .sort((a: any, b: any) => new Date(b.frontmatter?.date || 0).getTime() - new Date(a.frontmatter?.date || 0).getTime())
        .map(async (post: any) => {
            const url = getPostUrl(post, LANG);
            return {
                url,
                // slug 就是 URL 最后一段：跟单篇页传给点赞组件的那个一致，两边共用一个计数
                slug: url.split('/').pop() || '',
                date: formatDate(post.frontmatter?.date, LANG),
                time: formatTime(post.frontmatter?.date, LANG),
                ai: post.frontmatter?.ai === true,
                html: typeof post.compiledContent === 'function' ? await post.compiledContent() : '',
            };
        })
);
---

<Layout
    title="一些碎碎念"
    description="随手记下的吐槽，不成篇的都在这儿。"
    brandUrl="https://www.ethan929.com/"
    brandText='<img src="/images/avatar.webp" alt="Avatar" class="nav-avatar"><span>Ethan</span>'
>
    <div class="rants-wrapper" data-pagefind-ignore>
        <div class="rants-grid">
            {cards.map((card: any) => (
                <article class="rant-card">
                    <div class="date rant-card-meta">
                        <span class="date-group">
                            <svg class="date-icon" viewBox="0 0 48 48" aria-hidden="true">
                                <path d="M5 19H43V40C43 41.1046 42.1046 42 41 42H7C5.89543 42 5 41.1046 5 40V19Z"/>
                                <path d="M5 9C5 7.89543 5.89543 7 7 7H41C42.1046 7 43 7.89543 43 9V19H5V9Z"/>
                                <path d="M16 4V12"/>
                                <path d="M32 4V12"/>
                                <path d="M28 34H34"/>
                                <path d="M14 34H20"/>
                                <path d="M28 26H34"/>
                                <path d="M14 26H20"/>
                            </svg> {card.date}
                        </span>
                        {card.time && (
                            <span class="date-group">
                                <svg class="date-icon time-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                                    <path d="M24 44C35.0457 44 44 35.0457 44 24C44 12.9543 35.0457 4 24 4C12.9543 4 4 12.9543 4 24C4 35.0457 12.9543 44 24 44Z" fill="none" stroke-linejoin="round"/>
                                    <path d="M24.0084 12.0001L24.0072 24.0089L32.4866 32.4883" stroke-linecap="round" stroke-linejoin="round"/>
                                </svg> <Fragment set:html={card.time} />
                            </span>
                        )}
                        {card.ai && (
                            <span class="tag cat-tag ai-badge">
                                <span class="ai-badge-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.49,2.91l1.22,3.15"/><path d="M1.68,6.05h12.8"/><path d="M4,7.91s1.27,3.69,3.87,5.43c2.6,1.74,7.16,2.81,7.16,2.81"/><path d="M12.19,6.05l-.05.35s-.99,3.89-3.59,6.17c-2.6,2.28-6.88,3.33-6.88,3.33"/><polyline points="22.06 21.1 17.31 10.28 12.56 21.1"/><line x1="14.46" y1="17.21" x2="20.17" y2="17.21"/></svg></span><span class="ai-badge-text">AI</span>
                            </span>
                        )}
                    </div>
                    <div class="rant-card-source">
                        <a class="rant-card-source-btn" href={card.url} aria-label="查看原文">
                            <svg viewBox="0 0 48 48"><path d="M39 4H11C9.89543 4 9 4.89543 9 6V42C9 43.1046 9.89543 44 11 44H39C40.1046 44 41 43.1046 41 42V6C41 4.89543 40.1046 4 39 4Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 30L31 30" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M17 36H24" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><rect x="17" y="12" width="14" height="10" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </a>
                    </div>
                    <div class="rant-card-body" set:html={card.html} />
                    <LikeButton slug={card.slug} lang={LANG} />
                </article>
            ))}
        </div>
        {cards.length === 0 && <p class="rants-empty">还没写。</p>}
    </div>

    <script src="/js/rants-feed.js" is:inline></script>
</Layout>
