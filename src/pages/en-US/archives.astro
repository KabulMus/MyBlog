---
import Layout from '../../layouts/Layout.astro';
import '../../styles/archives.css';
import { categoryNamesEn, toCatArray } from '../../config/categories';
import { formatDate, getPostUrl, renderTitleHtml, type Lang } from '../../lib/posts';

const LANG: Lang = 'en';
// Full posts only: rants live in blog/en-US/rants/ and have their own /ramblings page
const markdownFiles = import.meta.glob('../blog/en-US/**/index.md', { eager: true });

const posts = Object.values(markdownFiles)
    .filter((p: any) => p.url.startsWith('/blog/en-US/') && !p.url.includes('/rants/') && !p.url.includes('/drafts/') && !p.frontmatter?.draft)
    .sort((a: any, b: any) => new Date(b.frontmatter?.date || 0).getTime() - new Date(a.frontmatter?.date || 0).getTime());

// Group by year (years descending, then posts descending inside a year). Read the year off the raw
// date string so time-zone conversion can't push a New Year's Eve post into the neighbouring year.
const years: { year: string; posts: any[] }[] = [];
for (const post of posts) {
    const year = String(post.frontmatter?.date || '').slice(0, 4) || '——';
    if (years.length === 0 || years[years.length - 1].year !== year) {
        years.push({ year, posts: [] });
    }
    years[years.length - 1].posts.push(post);
}

// The year is already in the group heading, so the row keeps only month + day
function monthDay(dateStr: string) {
    const full = formatDate(dateStr, LANG);
    const stripped = full.replace(/,\s*\d{4}$/, '');
    return stripped === full ? full : stripped;
}

let articleIndex = posts.length;
const rows = years.map((group) => ({
    year: group.year,
    posts: group.posts.map((post: any) => ({
        index: articleIndex--,
        url: getPostUrl(post, LANG),
        iso: String(post.frontmatter?.date || ''),
        date: monthDay(post.frontmatter?.date || ''),
        cats: toCatArray(post.frontmatter?.category),
        title: renderTitleHtml(post.frontmatter?.title || 'Untitled'),
    })),
}));
---

<Layout
    title="Archives"
    description="Every post, arranged by year."
    brandUrl="https://www.ethan929.com/en-US/"
    brandText='<img src="/images/avatar-64.webp" alt="Avatar" class="nav-avatar" width="32" height="32"><span>Ethan</span>'
>
    <div class="posts-index" data-pagefind-ignore>
        {rows.map((group) => (
            <section class="posts-year">
                <h2 class="posts-year-title" id={String(group.year)}>
                    <span class="posts-year-label">{group.year}</span>
                    <sup class="posts-year-count" aria-label={`${group.posts.length} posts`}>{group.posts.length}</sup>
                </h2>
                <ul class="posts-rows">
                    {group.posts.map((post: any) => (
                        <li>
                            <a class="posts-row" href={post.url}>
                                <span class="posts-row-cats">
                                    {post.cats.map((cat: string) => (
                                        <span
                                            class={`tag cat-tag cat-${cat}`}
                                            title={categoryNamesEn[cat] || cat}
                                            aria-label={categoryNamesEn[cat] || cat}
                                        >
                                            {cat === 'achievements' ? 'Achieve.' : categoryNamesEn[cat] || cat}
                                        </span>
                                    ))}
                                </span>
                                <time class="posts-row-date" datetime={post.iso}>{post.date}</time>
                                <span class="posts-row-title" set:html={post.title}></span>
                                <span class="posts-row-index" aria-label={`Post ${post.index}`}>#{post.index}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </section>
        ))}
        {rows.length === 0 && <p class="posts-empty">No posts yet.</p>}
    </div>
</Layout>
