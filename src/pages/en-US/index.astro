---
import Layout from '../../layouts/Layout.astro';

const markdownFiles = import.meta.glob('../blog/en-US/*.md', { eager: true });
const allPosts: any[] = Object.values(markdownFiles);

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    return dateStr.replace(/-/g, '.');
}

const sortedPosts = allPosts.sort((a, b) => {
    const dateA = new Date(a.frontmatter?.date || 0).getTime();
    const dateB = new Date(b.frontmatter?.date || 0).getTime();
    return dateB - dateA;
});
---

<Layout
    title="Ethan’s Blog"
    brandUrl="https://www.ethan929.com/en-US/"
    brandText='<img src="https://i2.hdslb.com/bfs/face/fc65f0eb630fe0b35f46062548b7184f40eefeb9.jpg" alt="Avatar" class="nav-avatar"><span>Ethan</span>'
>
    <div class="blog-list-wrapper" data-pagefind-ignore>
        <div class="search-container">
            <div id="search"></div>
        </div>

        <ul class="post-list">
            {sortedPosts.map((post) => {
                const postUrl = post.url || `/blog/en-US/${post.file?.split('/').pop()?.replace('.md', '')}`;
                return (
                    <li class="post-item">
                        <a href={postUrl} class="post-title-link">
                            <h3>{post.frontmatter?.title || 'Untitled post'}</h3>
                        </a>
                        {post.frontmatter?.date && (
                            <span class="post-date">
                                <icons>date</icons> {formatDate(post.frontmatter.date)}
                            </span>
                        )}
                    </li>
                );
            })}
        </ul>

        {sortedPosts.length === 0 && (
            <p style="color: var(--text-sub); text-align: center; margin-top: 4rem;">No posts yet</p>
        )}
    </div>
</Layout>

<link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
<script src="/pagefind/pagefind-ui.js" is:inline></script>

<script is:inline>
    window.addEventListener('DOMContentLoaded', () => {
        if (typeof PagefindUI !== 'undefined') {
            new PagefindUI({
                element: '#search',
                showImages: false,
                translations: { placeholder: 'Search posts…' }
            });

            const searchEl = document.querySelector('#search');
            if (searchEl) {
                searchEl.removeAttribute('title');
                searchEl.querySelectorAll('[title]').forEach(el => el.removeAttribute('title'));
            }
        }
    });
</script>
