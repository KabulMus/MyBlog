---
import Layout from '../../layouts/Layout.astro';
import { tagNamesEn, tagCats, groupTagsByCat, tagOrder } from '../../config/tags';
import { categories, categoryNamesEn as categoryNames, catOrder, toCatArray } from '../../config/categories';
import { formatDate, formatTime, smartQuotes, getPostUrl, type Lang } from '../../lib/posts';

const LANG: Lang = 'en';
const postsPerPage = 8;
const markdownFiles = import.meta.glob('../blog/en-US/*.md', { eager: true });
const rantFiles = import.meta.glob('../blog/en-US/rants/*.md', { eager: true });
const rantModules = new Set<any>(Object.values(rantFiles));
// Numbering and date sorting include rants (the article header lines up), the homepage cards do not
const allPosts: any[] = [...Object.values(markdownFiles), ...Object.values(rantFiles)].filter((p: any) => !p.frontmatter?.draft);

function buildPageHref(page: number, basePath = '/en-US') {
    const path = basePath === '/' ? '/' : basePath;
    return `${path}?page=${page}`;
}

const tagNames = tagNamesEn;

function warningLabel(w: string, lang: 'zh' | 'en'): string {
    const map: Record<string, { zh: string; en: string }> = {
        opinion: { zh: '主观', en: 'Opinion' },
        spoilers: { zh: '剧透', en: 'Spoilers' },
        politics: { zh: '政治', en: 'Politics' },
        adult: { zh: '成人', en: 'Adult' },
    };
    return map[w]?.[lang] || w;
}

const sortedPosts = allPosts.sort((a, b) => {
    const dateA = new Date(a.frontmatter?.date || 0).getTime();
    const dateB = new Date(b.frontmatter?.date || 0).getTime();
    return dateB - dateA;
});

// The folder is the genre: blog/en-US/*.md are full posts, blog/en-US/rants/*.md are rants
const homePosts = sortedPosts.filter((p: any) => !rantModules.has(p));
const rantPosts = sortedPosts.filter((p: any) => rantModules.has(p));
// #N on a card is the ordinal within the full posts (rants carry no number, matching the article header)
const rankByUrl: Record<string, number> = {};
homePosts.forEach((p: any, i: number) => { rankByUrl[getPostUrl(p, LANG)] = homePosts.length - i; });

// tag → 归属分类：优先用词典显式配置的 cats；未配置的 tag 再从文章动态提取
//（文章可属于多个分类，动态提取时其 tag 归属到文章的所有分类）
const tagToCats: Record<string, string[]> = {};
Object.entries(tagCats).forEach(([tag, cats]) => { tagToCats[tag] = [...cats]; });
homePosts.forEach((post: any) => {
    const cats = toCatArray(post.frontmatter?.category);
    if (cats.length === 0) return;
    (post.frontmatter?.tags || []).forEach((tag: string) => {
        if (tagToCats[tag]) return; // 已由词典配置，跳过动态提取
        if (!tagToCats[tag]) tagToCats[tag] = [];
        cats.forEach((cat: string) => {
            if (tagToCats[tag].indexOf(cat) === -1) tagToCats[tag].push(cat);
        });
    });
});
// 按 tagOrder 显式排序（分类分组，组内按配置顺序；未收录的排末尾）
const orderIndex: Record<string, number> = {};
tagOrder.forEach((t: string, i: number) => { orderIndex[t] = i; });
const allTags: string[] = Object.keys(tagToCats).sort((a: string, b: string) => {
    const ia = orderIndex[a] ?? 9999;
    const ib = orderIndex[b] ?? 9999;
    if (ia !== ib) return ia - ib;
    return String(tagNames[a] || a).localeCompare(String(tagNames[b] || b));
});

const totalPages = Math.max(1, Math.ceil(homePosts.length / postsPerPage));
const pageNumbers = Array.from({ length: totalPages }, (_, i) => i + 1);
const requestedPage = Number(Astro.url.searchParams.get('page') || '1');
const currentPage = Math.min(Math.max(requestedPage, 1), totalPages);
const prevPage = Math.max(1, currentPage - 1);
const nextPage = Math.min(totalPages, currentPage + 1);
---

<Layout
    title="Ethan's Blog"
    brandUrl="https://www.ethan929.com/en-US/"
    brandText='<img src="/images/avatar.webp" alt="Avatar" class="nav-avatar"><span>Ethan</span>'
>
    <Fragment slot="head">
        {/* ⚠️ These two used to sit at the very end of the page (after `</Layout>`): the stylesheet
            held up first paint and the script blocked parsing, so the search box always took a beat to show up. */}
        <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
        <script src="/pagefind/pagefind-ui.js" defer is:inline></script>
    </Fragment>

    <div class="blog-list-wrapper" data-pagefind-ignore>
        {rantPosts.length > 0 && (
            <div class="rant-preview" data-pagefind-ignore>
                <span class="rant-preview-title">Some Ramblings</span>
                <a class="rant-preview-more" href="/en-US/rants">Enter<svg viewBox="0 0 48 48" aria-hidden="true"><path d="M19 12L31 24L19 36"/></svg></a>
                {/* One click layer over the whole block: any mouse click goes to the masonry */}
                <a class="rant-preview-enter" href="/en-US/rants" aria-hidden="true" tabindex="-1"></a>
            </div>
        )}

        <div class="search-container">
            {/* Placeholder shell: draws the very same box before PagefindUI mounts (see .search-skeleton) */}
            <div class="search-skeleton" aria-hidden="true">
                <svg class="search-skeleton-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M21 38C30.3888 38 38 30.3888 38 21C38 11.6112 30.3888 4 21 4C11.6112 4 4 11.6112 4 21C4 30.3888 11.6112 38 21 38Z" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/><path d="M26.657 14.3431C25.2093 12.8954 23.2093 12 21.0001 12C18.791 12 16.791 12.8954 15.3433 14.3431" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M33.2216 33.2217L41.7069 41.707" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/></svg>
                <span>Search posts…</span>
            </div>
            <div id="search"></div>
        </div>

        <div class="cat-filter-bar" data-pagefind-ignore>
            {categories.map((cat: any) => (
                <button class={`cat-filter-btn cat-filter-btn--${cat.id}`} data-cat={cat.id}>{cat.en}</button>
            ))}
        </div>

        <div class="tag-filter-bar" data-pagefind-ignore id="tag-filter-bar">
            <div class="tag-filter-bar-inner">
            {allTags.map(tag => (
                <button
                    class={`tag-filter-btn tag-filter-btn--${tag}`}
                    data-tag={tag}
                    data-cats={(tagToCats[tag] || []).join(',')}
                >{tagNames[tag] || tag}</button>
            ))}
            </div>
        </div>

        <div class="post-list-wrap">
        <ul class="post-list">
            {homePosts.map((post, index) => {
                const postPage = Math.floor(index / postsPerPage) + 1;
                const postUrl = getPostUrl(post, LANG);
                const postCats = toCatArray(post.frontmatter?.category);
                const postWarnings = Array.isArray(post.frontmatter?.warning)
                    ? post.frontmatter.warning
                    : (post.frontmatter?.warning ? [post.frontmatter.warning] : []);
                return (
                    <li class="post-item" data-page={postPage} data-tags={(post.frontmatter?.tags || []).join(',')} data-categories={postCats.join(',')}>
                        {post.frontmatter?.image && (
                            <div class="post-card-image">
                                <img src={post.frontmatter.image} alt="" loading="lazy" decoding="async" />
                            </div>
                        )}
                        <span class="post-index">{rankByUrl[postUrl]}</span>
                        {(() => {
                            const grouped = postCats.length > 0
                                ? groupTagsByCat(postCats, post.frontmatter?.tags || [], tagCats)
                                : [];
                            if (grouped.length === 0) return null;
                            return (
                                <div class="post-tags" data-pagefind-ignore>
                                    {grouped.map((group, gi: number) => (
                                        <Fragment key={'cat-' + group.cat}>
                                            {gi > 0 && <span class="tag-group-sep" aria-hidden="true"><svg viewBox="0 0 12 24"><rect x="5.25" y="2" width="1.5" height="20" rx=".75" ry=".75"/></svg></span>}
                                            <span class={`tag cat-tag cat-${group.cat}`}>{categoryNames[group.cat] || group.cat}</span>
                                            {group.tags.map((tag: string, ti: number) => (
                                                <Fragment key={tag}>
                                                    {ti > 0 && <span class="tag-sep" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="6"/></svg></span>}
                                                    <span class={`tag tag-${tag}`}>{tagNames[tag] || tag}</span>
                                                </Fragment>
                                            ))}
                                        </Fragment>
                                    ))}
                                    {/* 内容提示（个人观点/剧透）：frontmatter warning 时显示，与 AI 徽标同区靠右 */}
                                    {postWarnings.length > 0 && (
                                        <span class="cw-pills" data-pagefind-ignore>
                                            {postWarnings.map((w: string) => (
                                                <span class={`tag cat-tag cw-pill cw-${w}`}>{warningLabel(w, 'en')}</span>
                                            ))}
                                        </span>
                                    )}
                                </div>
                            );
                        })()}
                        <a href={postUrl} class="post-title-link">
                            <h3>{smartQuotes(post.frontmatter?.title || 'Untitled post')}</h3>
                        </a>
                        {post.frontmatter?.date && (
                            <div class="post-meta" data-pagefind-ignore>
                                <span class="post-meta-item">
                                    <svg class="date-icon" viewBox="0 0 48 48" aria-hidden="true">
                                        <path d="M5 19H43V40C43 41.1046 42.1046 42 41 42H7C5.89543 42 5 41.1046 5 40V19Z"/>
                                        <path d="M5 9C5 7.89543 5.89543 7 7 7H41C42.1046 7 43 7.89543 43 9V19H5V9Z"/>
                                        <path d="M16 4V12"/>
                                        <path d="M32 4V12"/>
                                        <path d="M28 34H34"/>
                                        <path d="M14 34H20"/>
                                        <path d="M28 26H34"/>
                                        <path d="M14 26H20"/>
                                    </svg> <Fragment set:html={formatDate(post.frontmatter.date, LANG)} />
                                </span>
                                {formatTime(post.frontmatter.date, LANG) && (
                                    <span class="post-meta-item">
                                        <svg class="date-icon time-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                                            <path d="M24 44C35.0457 44 44 35.0457 44 24C44 12.9543 35.0457 4 24 4C12.9543 4 4 12.9543 4 24C4 35.0457 12.9543 44 24 44Z" fill="none" stroke-linejoin="round"/>
                                            <path d="M24.0084 12.0001L24.0072 24.0089L32.4866 32.4883" stroke-linecap="round" stroke-linejoin="round"/>
                                        </svg> <Fragment set:html={formatTime(post.frontmatter.date, LANG)} />
                                    </span>
                                )}
                                <span class="post-meta-item post-like-meta" data-like-meta={postUrl.split('/').pop()}>
                                    <svg class="like-heart" viewBox="0 0 48 48" aria-hidden="true">
                                        <path d="M15 8C8.92487 8 4 12.9249 4 19C4 30 17 40 24 42.3262C31 40 44 30 44 19C44 12.9249 39.0751 8 33 8C29.2797 8 25.9907 9.8469 24 12.6738C22.0093 9.8469 18.7203 8 15 8Z"/>
                                    </svg>
                                    <span class="like-count">–</span>
                                </span>
                            </div>
                        )}
                        {/* AI 翻译徽标：卡片右下角锁死（absolute 定位，不参与底部信息流式布局） */}
                        {post.frontmatter?.ai && (
                            <span class="tag cat-tag ai-badge">
                                <span class="ai-badge-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.49,2.91l1.22,3.15"/><path d="M1.68,6.05h12.8"/><path d="M4,7.91s1.27,3.69,3.87,5.43c2.6,1.74,7.16,2.81,7.16,2.81"/><path d="M12.19,6.05l-.05.35s-.99,3.89-3.59,6.17c-2.6,2.28-6.88,3.33-6.88,3.33"/><polyline points="22.06 21.1 17.31 10.28 12.56 21.1"/><line x1="14.46" y1="17.21" x2="20.17" y2="17.21"/></svg></span><span class="ai-badge-text">AI</span>
                            </span>
                        )}
                    </li>
                );
            })}
        </ul>

        <div id="post-list-empty" data-pagefind-ignore><p>No matching posts</p></div>
        </div>

        {homePosts.length === 0 && (
            <p style="color: var(--text-sub); text-align: center; margin-top: 4rem;">No posts yet</p>
        )}

        {totalPages > 1 && (
            <nav class="pagination" aria-label="Pagination" data-total-pages={totalPages}>
                <div class="pagination-side">
                    <span class="pagination-start">1</span>
                    <a
                        href={buildPageHref(prevPage)}
                        class={`pagination-nav-button ${currentPage === 1 ? 'is-disabled' : ''}`}
                        data-page={prevPage}
                        aria-label="Previous page"
                        aria-disabled={currentPage === 1 ? 'true' : 'false'}
                    >
                        <svg viewBox="0 0 48 48" aria-hidden="true">
                            <path d="M31 36L19 24L31 12"/>
                        </svg>
                    </a>
                </div>

                <input
                    class="pagination-input"
                    type="number"
                    inputmode="numeric"
                    min="1"
                    max={totalPages}
                    value={currentPage}
                    aria-label="Jump to page"
                />

                <div class="pagination-side">
                    <a
                        href={buildPageHref(nextPage)}
                        class={`pagination-nav-button ${currentPage === totalPages ? 'is-disabled' : ''}`}
                        data-page={nextPage}
                        aria-label="Next page"
                        aria-disabled={currentPage === totalPages ? 'true' : 'false'}
                    >
                        <svg viewBox="0 0 48 48" aria-hidden="true">
                            <path d="M19 12L31 24L19 36"/>
                        </svg>
                    </a>
                    <span class="pagination-end">{totalPages}</span>
                </div>
            </nav>
        )}
    </div>
</Layout>

<script is:inline>
    var activeCategory = '';
    var activeTags = [];

    var POSTS_PER_PAGE = 8; // 与顶部 postsPerPage 保持一致

    function snapshotOrigPages() {
        document.querySelectorAll('.post-list .post-item').forEach(function (item) {
            if (!item.getAttribute('data-orig-page')) {
                item.setAttribute('data-orig-page', item.getAttribute('data-page') || '1');
            }
        });
    }

    function updateEmptyState(isEmpty) {
        var empty = document.getElementById('post-list-empty');
        if (empty) empty.classList.toggle('is-visible', isEmpty);
    }

    // 筛选时重新组页：匹配卡片按「匹配结果顺序」重新分配页码，并同步分页 UI；卡片上的 #N 编号不动
    function repaginate() {
        snapshotOrigPages();
        var items = Array.prototype.slice.call(document.querySelectorAll('.post-list .post-item'));
        var matchIndex = 0;
        var matchCount = 0;
        items.forEach(function (item) {
            var cats = (item.getAttribute('data-categories') || '').split(',').filter(Boolean);
            var tags = (item.getAttribute('data-tags') || '').split(',').filter(Boolean);
            var ok = (!activeCategory || cats.indexOf(activeCategory) !== -1) &&
                     (activeTags.length === 0 || activeTags.some(function (t) { return tags.indexOf(t) !== -1; }));
            if (ok) {
                item.setAttribute('data-page', String(Math.floor(matchIndex / POSTS_PER_PAGE) + 1));
                matchIndex++;
                matchCount++;
            } else {
                item.setAttribute('data-page', item.getAttribute('data-orig-page') || '1');
            }
        });
        var total = Math.max(1, Math.ceil(matchCount / POSTS_PER_PAGE));
        var pagination = document.querySelector('.pagination');
        if (pagination) {
            pagination.classList.toggle('is-collapsed', total <= 1);
            pagination.setAttribute('data-total-pages', String(total));
            var input = pagination.querySelector('.pagination-input');
            if (input) input.max = String(total);
            var end = pagination.querySelector('.pagination-end');
            if (end) end.textContent = String(total);
        }
        // 仅当「有文章但筛选 0 命中」时显示空态（避免和无文章时的提示重复）
        updateEmptyState(items.length > 0 && matchCount === 0);
    }

    // tag 筛选栏展开/收起：只切换 CSS class，动画全部由 @keyframes 驱动
    // （grid-template-rows 0fr↔1fr 平滑展开，并自然推挤下方卡片滑动）
    function setTagBar(tagBar, open) {
        if (!tagBar) return;
        if (open && tagBar.classList.contains('is-open')) return; // 已展开，无需重播
        tagBar.classList.remove('is-open', 'is-closing');
        void tagBar.offsetWidth; // 强制 reflow，确保动画每次都能重新触发
        tagBar.classList.add(open ? 'is-open' : 'is-closing');
    }

    function getPageFromUrl() {
        const params = new URLSearchParams(window.location.search);
        const page = Number(params.get('page') || '1');
        return Number.isFinite(page) && page > 0 ? page : 1;
    }

    function showPage(page) {
        const list = document.querySelector('.post-list');
        if (!list) return;

        list.classList.add('is-transitioning');

        window.setTimeout(() => {
            document.querySelectorAll('.post-list .post-item').forEach((item) => {
                const itemPage = Number(item.getAttribute('data-page') || '1');
                const itemCats = (item.getAttribute('data-categories') || '').split(',').filter(Boolean);
                const itemTags = (item.getAttribute('data-tags') || '').split(',').filter(Boolean);
                const matchesCat = !activeCategory || itemCats.indexOf(activeCategory) !== -1;
                const matchesTag = activeTags.length === 0 || activeTags.some(function(t) { return itemTags.includes(t); });
                const matchesPage = itemPage === page;
                item.classList.toggle('is-hidden', !matchesCat || !matchesTag || !matchesPage);
            });

            document.querySelectorAll('.pagination-link').forEach((link) => {
                const linkPage = Number(link.getAttribute('data-page') || '1');
                const isCurrent = linkPage === page;
                link.classList.toggle('active', isCurrent);
                if (isCurrent) {
                    link.setAttribute('aria-current', 'page');
                } else {
                    link.removeAttribute('aria-current');
                }
            });

            const pagination = document.querySelector('.pagination');
            const totalPages = Number(pagination?.getAttribute('data-total-pages') || '1');
            const prevPage = Math.max(1, page - 1);
            const nextPage = Math.min(totalPages, page + 1);

            document.querySelectorAll('.pagination-nav-button').forEach((button) => {
                const isPrev = button.getAttribute('aria-label') === 'Previous page';
                const targetPage = isPrev ? prevPage : nextPage;
                const href = `/en-US?page=${targetPage}`;
                button.setAttribute('data-page', String(targetPage));
                button.setAttribute('href', href);

                const isDisabled = targetPage < 1 || targetPage > totalPages || targetPage === page;
                button.classList.toggle('is-disabled', isDisabled);
                button.setAttribute('aria-disabled', isDisabled ? 'true' : 'false');
            });

            document.querySelectorAll('.pagination-input').forEach((input) => {
                input.value = page;
            });

            list.classList.remove('is-transitioning');
        }, 160);
    }

    function smoothScrollToTop() {
        const startY = window.pageYOffset || document.documentElement.scrollTop || 0;
        if (startY <= 2) return;

        const duration = 280;
        const startTime = performance.now();

        const step = (now) => {
            const elapsed = now - startTime;
            const progress = Math.min(elapsed / duration, 1);
            const eased = 1 - Math.pow(1 - progress, 3);
            window.scrollTo(0, startY * (1 - eased));

            if (progress < 1) {
                requestAnimationFrame(step);
            }
        };

        requestAnimationFrame(step);
    }

    window.addEventListener('DOMContentLoaded', () => {
        if (typeof PagefindUI !== 'undefined') {
            new PagefindUI({
                element: '#search',
                showImages: false,
                translations: { placeholder: 'Search posts…' },
                processTerm: (term) => {
                    // 中文片段按精确短语匹配（配合 unigram 索引）：
                    // 索引用零宽空格 U+200B 分隔，查询用普通空格分隔再包引号；
                    // 英文查询不含 CJK，不受影响
                    return term.replace(/[\u4e00-\u9fff\u3400-\u4dbf]+/g, function(m) { return '"' + m.split('').join(' ') + '"'; });
                }
            });

            const searchEl = document.querySelector('#search');
            if (searchEl) {
                searchEl.removeAttribute('title');
                searchEl.querySelectorAll('[title]').forEach(el => el.removeAttribute('title'));
            }
        }

    var initialPage = getPageFromUrl();
        sessionStorage.setItem('blogHomePage', String(initialPage));
        repaginate();
        showPage(initialPage);

        document.querySelectorAll('.cat-filter-btn').forEach((btn) => {
            btn.addEventListener('click', function() {
                var cat = this.getAttribute('data-cat') || '';
                // 再次点击已选中的分类则取消选择（回到全部）；点其他分类则切换
                activeCategory = activeCategory === cat ? '' : cat;
                activeTags = [];
                // 清空逻辑状态时同步移除 tag 按钮的 active 高亮（避免切回分类时残留视觉）
                document.querySelectorAll('.tag-filter-btn').forEach(function(b) {
                    b.classList.remove('active');
                });
                document.querySelectorAll('.cat-filter-btn').forEach(function(b) {
                    b.classList.toggle('is-active', b.getAttribute('data-cat') === activeCategory);
                });
                var tagBar = document.getElementById('tag-filter-bar');
                var wasOpen = tagBar.classList.contains('is-open');
                if (activeCategory) {
                    // 显示分类：只显示该分类下的 tag（一个 tag 可属多分类）
                    document.querySelectorAll('.tag-filter-btn').forEach(function(b) {
                        var cats = (b.getAttribute('data-cats') || '').split(',').filter(Boolean);
                        b.style.display = cats.indexOf(activeCategory) !== -1 ? '' : 'none';
                    });
                    if (wasOpen) {
                        // 已展开（分类间切换）：保持展开，仅 tag 组淡入过渡，不重播栏动画
                        var inner = tagBar.querySelector('.tag-filter-bar-inner');
                        inner.classList.remove('switch-in');
                        void inner.offsetWidth;
                        inner.classList.add('switch-in');
                    } else {
                        setTagBar(tagBar, true);
                    }
                } else {
                    // 取消分类：保持当前 tag 显示，随整个栏一起收起（渐隐，无闪现也不瞬间消失）
                    setTagBar(tagBar, false);
                }
                var nextUrl = new URL(window.location.href);
                nextUrl.searchParams.set('page', '1');
                history.pushState({}, '', nextUrl);
                sessionStorage.setItem('blogHomePage', '1');
                repaginate();
                showPage(1);
                smoothScrollToTop();
            });
        });

        document.querySelectorAll('.tag-filter-btn').forEach((btn) => {
            btn.addEventListener('click', function() {
                var tag = this.getAttribute('data-tag') || '';
                var idx = activeTags.indexOf(tag);
                if (idx === -1) {
                    activeTags.push(tag);
                } else {
                    activeTags.splice(idx, 1);
                }
                var nextUrl = new URL(window.location.href);
                nextUrl.searchParams.set('page', '1');
                history.pushState({}, '', nextUrl);
                sessionStorage.setItem('blogHomePage', '1');
                document.querySelectorAll('.tag-filter-btn').forEach(function(b) {
                    b.classList.toggle('active', activeTags.indexOf(b.getAttribute('data-tag') || '') !== -1);
                });
                repaginate();
                showPage(1);
                smoothScrollToTop();
            });
        });

        document.querySelectorAll('.pagination-link, .pagination-nav-button').forEach((link) => {
            link.addEventListener('click', (event) => {
                if (link.classList.contains('is-disabled')) {
                    event.preventDefault();
                    return;
                }

                event.preventDefault();
                const nextPage = Number(link.getAttribute('data-page') || '1');
                const nextUrl = new URL(window.location.href);
                nextUrl.searchParams.set('page', String(nextPage));
                history.pushState({}, '', nextUrl);
                sessionStorage.setItem('blogHomePage', String(nextPage));
                showPage(nextPage);
                smoothScrollToTop();
            });
        });

        document.querySelectorAll('.pagination-input').forEach((input) => {
            input.addEventListener('keydown', (event) => {
                if (event.key !== 'Enter') return;

                event.preventDefault();
                const targetPage = Number(input.value);
                if (!Number.isFinite(targetPage) || targetPage < 1) return;

                const pageNum = Math.min(targetPage, Number(input.max || '1'));
                const nextUrl = new URL(window.location.href);
                nextUrl.searchParams.set('page', String(pageNum));
                history.pushState({}, '', nextUrl);
                sessionStorage.setItem('blogHomePage', String(pageNum));
                showPage(pageNum);
                smoothScrollToTop();
                input.blur();
            });
        });
    });

    window.addEventListener('popstate', () => {
        showPage(getPageFromUrl());
    });
</script>
