		<script is:inline>
			// 全局 Toast 通知函数（供全站复用）
			function showToast(message, isError) {
				var toast = document.getElementById('global-toast');
				if (!toast) return;
				var icon = toast.querySelector('svg');
				var text = toast.querySelector('span');
				text.innerText = message;
				if (isError) {
					toast.style.borderColor = '#ef4444';
					icon.innerHTML = '<path d="M18 6L6 18M6 6l12 12" style="stroke: #ef4444"/>';
				} else {
					toast.style.borderColor = 'var(--primary-blue)';
					icon.innerHTML = '<path d="M20 6L9 17l-5-5" style="stroke: var(--primary-blue)"/>';
				}
				toast.classList.add('show');
				setTimeout(function() { toast.classList.remove('show'); }, 3000);
			}

			// 点击 RSS 订阅：复制链接到剪贴板，弹出 Toast 提示（不跳转 XML 页面）
			(function() {
				function fallbackCopy(text, done) {
					var ta = document.createElement('textarea');
					ta.value = text;
					ta.style.position = 'fixed';
					ta.style.opacity = '0';
					document.body.appendChild(ta);
					ta.focus();
					ta.select();
					try { document.execCommand('copy'); done(); } catch (e) {}
					document.body.removeChild(ta);
				}
				function copyToClipboard(text, done) {
					if (navigator.clipboard && navigator.clipboard.writeText) {
						navigator.clipboard.writeText(text).then(done).catch(function() { fallbackCopy(text, done); });
					} else {
						fallbackCopy(text, done);
					}
				}
				var links = document.querySelectorAll('.rss-link');
				for (var i = 0; i < links.length; i++) {
					(function(link) {
						link.addEventListener('click', function(e) {
							e.preventDefault();
							var url = link.getAttribute('data-copy') || link.href;
							copyToClipboard(url, function() {
								showToast(document.documentElement.lang === 'en-US' ? 'RSS link copied' : 'RSS 地址已复制');
							});
						});
					})(links[i]);
				}
			})();

			// 有题头图时：若标题/日期在图片区域内放不下（会顶出导航栏被遮挡），
			// 自动增高图片区域（保持宽度、中间裁剪），让标题在导航栏下方完整显示。
			(function() {
				function fitHeroImage() {
					var hero = document.querySelector('.page-hero.has-hero-image');
					if (!hero) return;
					var wrap = hero.querySelector('.hero-image-wrap');
					var content = hero.querySelector('.hero-content');
					var img = wrap ? wrap.querySelector('img') : null;
					if (!wrap || !content || !img) return;
					// 基准 = 图片「自然比例」高度（CSS aspect-ratio 的结果），随当前宽度实时算。
					// ⚠️ 不能拿 wrap 当前高度当基准：那可能已被本函数加高，字体到位后测量略小
					// 会走 else 清空内联高 → 图“刚对一会儿又弹回原比例”。
					var base = wrap.offsetHeight;
					var ar = getComputedStyle(img).aspectRatio || '';
					var m = /([\d.]+)\s*\/\s*([\d.]+)/.exec(ar);
					if (m && img.clientWidth > 0) base = img.clientWidth * (parseFloat(m[2]) / parseFloat(m[1]));
					// 标题栏高度 + 底部偏移(24) + 标题顶部与返回按钮的间距(64)
					var need = content.offsetHeight + 24 + 64;
					if (need > base) {
						img.style.height = need + 'px';
					} else {
						img.style.height = '';
					}
					placeCredit(hero);
				}

				// 题图来源标注：它就是「序号/日期/时间」那一行里的一个 group（同一个 .date-group 排版），
				// 默认靠 margin-left:auto 推到该行右端。行放不下、它被挤到下一行时，把 auto 撤掉，
				// 跟其它组一样从行首左对齐。
				// ⚠️ 只改 class、不动 DOM：两种形态共用同一个元素。
				function placeCredit(hero) {
					var credit = hero.querySelector('.article-credit');
					if (!credit || !credit.parentElement) return;
					// 基准 = 那一行自己的首行顶端（不能拿兄弟节点比：「序号」组可能已经换到别的行）
					var rowTop = credit.parentElement.getBoundingClientRect().top;
					var wrapped = credit.getBoundingClientRect().top - rowTop > 4;
					credit.classList.toggle('is-wrapped', wrapped);
				}
				var fitHeroTimer = null;
				function scheduleFitHero() {
					clearTimeout(fitHeroTimer);
					fitHeroTimer = setTimeout(fitHeroImage, 150);
				}
				// 定稿后淡入：配合 html.hero-lock 的隐藏态，高度算好后才显示 → 无「跳动」
				function unlockHeroImage() {
					var hero = document.querySelector('.page-hero.has-hero-image');
					if (hero && !hero.classList.contains('is-hero-ready')) {
						hero.classList.add('is-hero-ready');
					}
				}
				if (document.readyState === 'loading') {
					document.addEventListener('DOMContentLoaded', fitHeroImage);
				} else {
					fitHeroImage();
				}
				window.addEventListener('load', fitHeroImage);
				window.addEventListener('resize', scheduleFitHero);
				document.addEventListener('pageshow', fitHeroImage);
				// 网页字体就绪后再测一次：首访时常因字体未加载完、标题用回退字体被测矮，
				// 导致误判「不需要增高」（移动端表现为先进来不对、刷新才对）。
				// 字体就绪 = 高度可定稿 → 先算好高度再淡入，杜绝「图突然长高」的跳动。
				if (document.fonts && document.fonts.ready) {
					document.fonts.ready.then(function () { fitHeroImage(); unlockHeroImage(); });
				}
				// 兜底：万一 fonts.ready 异常卡住，题图不能永远隐藏
				setTimeout(unlockHeroImage, 1500);
				// 标题区尺寸一变（字体换入、日期换行、页面转场动画结束后）就自动重算：
				// 用 ResizeObserver 监听 .hero-content，绕开各类「只在刷新后正确」的时序问题。
				if (typeof ResizeObserver !== 'undefined') {
					var heroContentToWatch = document.querySelector('.page-hero.has-hero-image .hero-content');
					if (heroContentToWatch) {
						var heroResizeObserver = new ResizeObserver(function () { scheduleFitHero(); });
						heroResizeObserver.observe(heroContentToWatch);
					}
				}
			})();
		</script>

