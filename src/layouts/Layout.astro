---
import '../styles/main.css'
import LikeButton from '../components/LikeButton.astro';
import { tagNamesZh, tagNamesEn, tagCats, groupTagsByCat } from '../config/tags';
import { getCategoryName, toCatArray } from '../config/categories';

interface Props {
	title?: string;
	description?: string;
	frontmatter?: any; 
	brandUrl?: string;
	brandText?: string;
}

const { frontmatter, title, description, brandUrl, brandText } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isEnglishRoute = currentPath.includes('/en-US');
// 首页（中/英）不进 pagefind 索引：搜索只命中具体文章页
const isHome = currentPath === '/' || currentPath === '/en-US';
const htmlLang = isEnglishRoute ? 'en-US' : 'zh-CN';
const resolvedBrandUrl = brandUrl || (isEnglishRoute ? '/en-US' : '/');
const langSwitchHref = getLangSwitchHref(currentPath);
const langSwitchLabel = isEnglishRoute ? '切换到中文' : 'Switch to English';
const navLabels = isEnglishRoute
    ? { blog: 'Blog', channels: 'Channels', toolkit: 'Toolkit', support: 'Support', charlie: 'About Charlie' }
    : { blog: '博客', channels: '频道列表', toolkit: '工具箱', support: '联系支持', charlie: '关于周深' };
// 吐槽那条线（/rants、/en-US/rants）：正文页的返回按钮要用
const rantsHref = isEnglishRoute ? '/en-US/rants' : '/rants';
const isRantsRoute = currentPath === rantsHref;
const menuAriaLabel = isEnglishRoute ? 'Menu' : '菜单';
const themeAriaLabel = isEnglishRoute ? 'Toggle theme' : '切换亮暗模式';

// 内容提示（Content Warning）：frontmatter warning 字段（可字符串或数组），如 ['opinion'] / ['spoilers']
const postWarnings: string[] = Array.isArray(frontmatter?.warning)
    ? frontmatter.warning
    : (frontmatter?.warning ? [frontmatter.warning] : []);
function warningLabel(w: string, lang: 'zh' | 'en'): string {
    const map: Record<string, { zh: string; en: string }> = {
        opinion: { zh: '主观', en: 'Opinion' },
        spoilers: { zh: '剧透', en: 'Spoilers' },
        politics: { zh: '政治', en: 'Politics' },
        adult: { zh: '成人', en: 'Adult' },
    };
    return map[w]?.[lang] || w;
}
function smartQuotes(text: string): string {
    // 双引号对：标准处理
    text = text.replace(/"([^"\n]*)"/g, '\u201C$1\u201D');
    const chars = text.split('');
    const positions: number[] = [];
    for (let i = 0; i < chars.length; i++) {
        if (chars[i] === "'") positions.push(i);
    }
    if (positions.length === 0) return text;
    const isAlnum = (ch: string) => /[A-Za-z0-9]/.test(ch);
    // 状态机：inQuote 表示当前是否处于开引号内部。
    // 规则：
    //   不在引号内：前是字母 → 撇号（it's）；否则 → 开引号 ‘
    //   在引号内：后是字母 → 撇号；后是空白/结尾 → 闭引号 ’
    //   在引号内后跟标点：若后面还有 ' → 是撇号（如 somethin'.' 中间那个），否则是闭引号
    let inQuote = false;
    for (let i = 0; i < chars.length; i++) {
        if (chars[i] !== "'") continue;
        const prev = i > 0 ? chars[i - 1] : '';
        const next = i < chars.length - 1 ? chars[i + 1] : '';
        if (inQuote) {
            if (isAlnum(next)) {
                chars[i] = '\u2019'; // 后是字母 → 撇号（it's）
            } else if (next === '' || /\s/.test(next)) {
                chars[i] = '\u2019'; // 后是空白/结尾 → 闭引号
                inQuote = false;
            } else {
                // 后是标点：若后面还有 ' → 当前是撇号（最后那个才是闭引号）
                if (positions.some((p) => p > i)) {
                    chars[i] = '\u2019';
                } else {
                    chars[i] = '\u2019'; // 闭引号
                    inQuote = false;
                }
            }
        } else {
            if (isAlnum(prev)) {
                chars[i] = '\u2019'; // 前是字母 → 撇号（it's）
            } else {
                // 候选开引号：只有后面存在“闭引号候选”（某个 ' 后是非字母/结尾）才当开引号，
                // 否则是开头撇号缩写（'cause / 'Twas / 'em / 'til）
                const hasClosing = positions.some(
                    (j) => j > i && (j === chars.length - 1 || !isAlnum(chars[j + 1]))
                );
                if (hasClosing) {
                    chars[i] = '\u2018'; // 开引号
                    inQuote = true;
                } else {
                    chars[i] = '\u2019'; // 开头撇号（'cause 等）
                }
            }
        }
    }
    return chars.join('');
}

function renderTitle(text: string): string {
    const quoted = smartQuotes(text);
    // 仅将 emoji 单独包 span 以重置颜色，不分割渐变
    const emojiRanges = /[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}\u{FE00}-\u{FE0F}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{1F900}-\u{1F9FF}]/gu;
    return quoted.replace(emojiRanges, '<span class="emoji">$&</span>');
}
const pageTitle = frontmatter?.title || (frontmatter?.date ? formatDate(frontmatter.date) : '') || title || (isEnglishRoute ? 'My Blog' : '我的博客');
const renderedTitle = renderTitle(pageTitle);
const ogDescription = description || (isEnglishRoute
    ? "Ethan's blog—music, creation, essays & achievements."
    : 'Ethan 的博客—音乐、创作、随笔与成就。');
const ogImage = 'https://blog.ethan929.com/favicon.webp';
const pageDate = formatDateHtml(frontmatter?.date || "");
const pageTime = formatTime(frontmatter?.date || "");

// 计算文章序号（时间正序）
let postIndex = 0;
let idx = -1;
let sorted: any[] = [];
if (frontmatter?.date && currentPath.startsWith('/blog')) {
    // ⚠️ 只算成篇的（blog/ 平铺目录）：吐槽不参与序号编排，也不进上一篇/下一篇序列
    const cnPosts = Object.values(import.meta.glob('../pages/blog/*.md', { eager: true })) as any[];
    const enPosts = Object.values(import.meta.glob('../pages/blog/en-US/*.md', { eager: true })) as any[];
    const allMd = isEnglishRoute ? enPosts : cnPosts;
    sorted = allMd
        .filter((p: any) => !p.frontmatter?.draft)
        .sort((a: any, b: any) => new Date(a.frontmatter?.date || 0).getTime() - new Date(b.frontmatter?.date || 0).getTime());
    // ⚠️ 按 URL 找自己，别按标题：吐槽已经没有 title，undefined === undefined 会匹到第一篇
    idx = sorted.findIndex((p: any) => p.url === currentPath);
    if (idx !== -1) postIndex = idx + 1;
}

let prevPost: { title: string; url: string } | null = null;
let nextPost: { title: string; url: string } | null = null;
if (idx !== -1) {
    const base = isEnglishRoute ? '/blog/en-US' : '/blog';
    if (idx > 0) {
        const p = sorted[idx - 1];
        prevPost = { title: p.frontmatter?.title || '', url: p.url || '' };
    }
    if (idx < sorted.length - 1) {
        const p = sorted[idx + 1];
        nextPost = { title: p.frontmatter?.title || '', url: p.url || '' };
    }
}

const prevIndex = prevPost ? postIndex - 1 : 0;
const nextIndex = nextPost ? postIndex + 1 : 0;

// 返回主页对应页码：主页按时间倒序分页（postsPerPage=8，与 index.astro 一致）
// sorted 是正序、postIndex 是正序序号；倒序索引 = sorted.length - postIndex
const backPostsPerPage = 8;
const articlePage = (frontmatter?.date && currentPath.startsWith('/blog') && sorted.length > 0 && postIndex > 0)
    ? Math.floor((sorted.length - postIndex) / backPostsPerPage) + 1
    : 1;
const baseHome = isEnglishRoute ? '/en-US' : '/';
// 吐槽（住在 blog/rants/ 下）：正文页不放分类标签和内容警告，返回按钮也指到 /rants
const isRantArticle = currentPath.includes('/rants/');
const backHref = isRantArticle
    ? rantsHref
    : (articlePage > 1 ? `${baseHome}?page=${articlePage}` : baseHome);

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    // 日期部分：英文 Aug 2, 2020；中文 2020年8月2日（月日不补零）
    // 英文月份按规范：May/June/July 不缩写，其余缩写
    const m = dateStr.match(/^(\d{4})-(\d{2})-(\d{2})/);
    if (!m) return dateStr.replace(/-/g, '.');
    const [, y, mo, d] = m;
    if (isEnglishRoute) {
        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'June', 'July', 'Aug', 'Sept', 'Oct', 'Nov', 'Dec'];
        return `${months[+mo - 1]} ${+d}, ${+y}`;
    }
    return `${+y}年${+mo}月${+d}日`;
}

// 跟上面同格式，但把「年月日」包进 .date-cjk（那个类单独压一档字重，见 main.css）——
// hero 上显示的日期用这份；pageTitle（<title> / og:title）必须用纯文本那份。
function formatDateHtml(dateStr: string) {
    const html = formatDate(dateStr).replace(/([年月日])/g, '<span class="date-cjk">$1</span>');
    return html.includes('date-cjk') ? `<span class="date-text">${html}</span>` : html;
}

function formatTime(dateStr: string) {
    if (!dateStr) return '';
    // 时间部分：中文 24 小时制 14:32；英文 12 小时制 2:32 PM
    const m = dateStr.match(/[T ](\d{1,2}):(\d{2})/);
    if (!m) return '';
    const h = +m[1];
    const mm = m[2];
    if (isEnglishRoute) {
        const ampm = h >= 12 ? 'PM' : 'AM';
        const h12 = h % 12 === 0 ? 12 : h % 12;
        return `<span class="time-value">${h12}<span class="time-colon">:</span>${mm} ${ampm}</span>`;
    }
    return `<span class="time-value">${h}<span class="time-colon">:</span>${mm}</span>`;
}

// 文章点赞：从路径取 slug（如 /blog/2026-07-01-hi → 2026-07-01-hi）
const articleSlug = currentPath.startsWith('/blog') ? (currentPath.split('/').pop() || '') : '';

const tagNames: Record<string, string> = isEnglishRoute ? tagNamesEn : tagNamesZh;

function getLangSwitchHref(pathname: string) {
    const normalized = pathname.replace(/\/+$/, "") || "/";

    if (normalized === "/") return "/en-US";
    if (normalized === "/en-US") return "/";
    if (normalized === "/blog") return "/blog/en-US";
    if (normalized === "/blog/en-US") return "/blog";
    if (normalized === "/rants") return "/en-US/rants";
    if (normalized === "/en-US/rants") return "/rants";

    if (normalized.includes('/en-US')) {
        return normalized.replace('/en-US', '');
    }

    if (normalized.startsWith('/blog/')) {
        const [, , ...rest] = normalized.split('/');
        return `/blog/en-US/${rest.join('/')}`;
    }

    return normalized;
}

---
<!doctype html>
<html lang={htmlLang} data-pagefind-ignore={frontmatter?.draft || isHome || isRantArticle || isRantsRoute ? '' : undefined}> 
	<head>
		<script is:inline>
		(function () {
		    var t;
		    try { t = sessionStorage.getItem('user-theme'); } catch (e) {}
		    if (t !== 'dark' && t !== 'light') {
		        t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
		    }
		    document.documentElement.setAttribute('data-theme', t);
		    // 题图防跳动：JS 存在时标记 hero-lock（题图先隐藏，字体就绪+定稿后才淡入，见 fitHero 脚本）
		    document.documentElement.classList.add('hero-lock');
		})();
		</script>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.webp" type="image/webp"/>
		<link 
			rel="stylesheet" 
			href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" 
			crossorigin="anonymous"
		/>
		<!-- Google Fonts（替代原 CSS @import：link 并行加载 + preconnect 提前握手）
		     ⚠️ media="print" + onload 是非阻塞加载：这 60+ KB 的目录 CSS 不再卡首屏，字体没到就先用后备字体
		     （display=swap 本来就是这个行为）；关了 JS 由 <noscript> 里那份兜底。 -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Encode+Sans+SC:wght@100..900&family=Encode+Sans:wght@100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Noto+Sans+SC:wght@100..900&family=Noto+Serif+SC:wght@200..900&display=swap" media="print" onload="this.media='all'" />
		<noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Encode+Sans+SC:wght@100..900&family=Encode+Sans:wght@100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Noto+Sans+SC:wght@100..900&family=Noto+Serif+SC:wght@200..900&display=swap" /></noscript>
		<!-- Inter 官方可变字体（全字形 + optical size，替代 gfonts 的 Inter） -->
		<link rel="preconnect" href="https://rsms.me/" />
		<link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>

		<!-- Open Graph / 社交分享卡片 -->
		<meta property="og:site_name" content={isEnglishRoute ? "Ethan's Blog" : 'Ethan 的博客'} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:type" content={frontmatter?.date ? 'article' : 'website'} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:locale" content={isEnglishRoute ? 'en_US' : 'zh_CN'} />
		<meta property="og:locale:alternate" content={isEnglishRoute ? 'zh_CN' : 'en_US'} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImage} />

		<script src="/js/core.js" is:inline></script>
		<!-- 页面往 <head> 里塞东西的入口（首页用它把 pagefind 的 CSS/JS 提前引进来） -->
		<slot name="head" />
	</head>
	<body class={[
		currentPath.startsWith('/blog') || isRantsRoute ? 'is-article-page' : '',
		isRantsRoute ? 'is-rants-index' : '',
		isHome ? 'is-home' : '',
	].filter(Boolean).join(' ')}>
		{(currentPath.startsWith('/blog') || isRantsRoute) && (
			<a class="article-back-btn" id="article-back-btn" href={backHref} aria-label={isEnglishRoute ? 'Back' : '返回'}>
				<svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M31 36L19 24L31 12"/></svg>
			</a>
		)}
		<nav class="navbar" id="top-nav">
			<div class="nav-container">
				<a href={resolvedBrandUrl} class="nav-brand">
                    {
                        /* ⚡️ 如果传了 brandText，就用 Fragment 渲染传进来的复杂 HTML，
                           否则显示其他 markdown 文章页默认的返回箭头 */
                        brandText ? (
                            <Fragment set:html={brandText} />
                        ) : (
                            <svg width="24" height="24" viewBox="0 0 48 48" fill="none"><path d="M31 36L19 24L31 12"/></svg>

                        )
                    }
                </a>
				
				<div class="nav-links desktop-only">
					<a href={isEnglishRoute ? '/en-US/rss.xml' : '/rss.xml'} class="rss-nav-link rss-link" data-copy={isEnglishRoute ? 'https://blog.ethan929.com/en-US/rss.xml' : 'https://blog.ethan929.com/rss.xml'} data-text="RSS">RSS</a>
					<span class="nav-divider" aria-hidden="true"></span>
					<a href={isEnglishRoute ? '/en-US' : '/'} data-text={navLabels.blog} class="active">{navLabels.blog}</a>
					<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/channels/' : 'https://www.ethan929.com/channels/'} data-text={navLabels.channels}>{navLabels.channels}</a>
					<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/toolkit/' : 'https://www.ethan929.com/toolkit/'} data-text={navLabels.toolkit}>{navLabels.toolkit}</a>
					<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/support/' : 'https://www.ethan929.com/support/'} data-text={navLabels.support}>{navLabels.support}</a>
					<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/charlie/' : 'https://www.ethan929.com/charlie/'} data-text={navLabels.charlie}>{navLabels.charlie}</a>
				</div>

				<a href={isEnglishRoute ? '/en-US/rss.xml' : '/rss.xml'} class="rss-link mobile-rss mobile-only" data-copy={isEnglishRoute ? 'https://blog.ethan929.com/en-US/rss.xml' : 'https://blog.ethan929.com/rss.xml'} data-text="RSS">RSS</a>
				<span class="mobile-rss-divider mobile-only" aria-hidden="true"></span>
				<button class="menu-toggle mobile-only" onclick="toggleMenu()" aria-label={menuAriaLabel}>
					<svg width="24" height="24" viewBox="0 0 48 48" fill="none"><path d="M7.94971 11.9497H39.9497"/><path d="M7.94971 23.9497H39.9497"/><path d="M7.94971 35.9497H39.9497"/></svg>
				</button>
			</div>

			<div class="nav-dropdown" id="nav-dropdown">
				<a href={isEnglishRoute ? '/en-US' : '/'} onclick="toggleMenu(false)" data-text={navLabels.blog} class="active">{navLabels.blog}</a>
				<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/channels/' : 'https://www.ethan929.com/channels/'} onclick="toggleMenu(false)" data-text={navLabels.channels}>{navLabels.channels}</a>
				<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/toolkit/' : 'https://www.ethan929.com/toolkit/'} onclick="toggleMenu(false)" data-text={navLabels.toolkit}>{navLabels.toolkit}</a>
				<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/support/' : 'https://www.ethan929.com/support/'} onclick="toggleMenu(false)" data-text={navLabels.support}>{navLabels.support}</a>
				<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/charlie/' : 'https://www.ethan929.com/charlie/'} onclick="toggleMenu(false)" data-text={navLabels.charlie}>{navLabels.charlie}</a>
			</div>
		</nav>

		<header class={`page-hero${frontmatter?.image ? ' has-hero-image' : ''}`}>
			{frontmatter?.image ? (
				<>
					<div class="hero-image-wrap">
						<img src={frontmatter.image} alt="" />
						<div class="hero-image-fade" aria-hidden="true"></div>
						<section class="hero-content">
							<div>
								<h1 set:html={renderedTitle}></h1> 
								{pageDate && (
									<span class="date">
										<span class="date-group">
											{frontmatter?.draft ? (
												<span class="page-index is-draft">{isEnglishRoute ? 'Draft' : '草稿'}</span>
											) : isRantArticle ? (
												<span class="page-index is-rant">{isEnglishRoute ? 'Rant' : '吐槽'}</span>
											) : (
												postIndex > 0 && <span class="page-index">#{postIndex}</span>
											)}
										</span>
										<span class="date-group">
											<svg class="date-icon" viewBox="0 0 48 48" aria-hidden="true">
												<path d="M5 19H43V40C43 41.1046 42.1046 42 41 42H7C5.89543 42 5 41.1046 5 40V19Z"/>
												<path d="M5 9C5 7.89543 5.89543 7 7 7H41C42.1046 7 43 7.89543 43 9V19H5V9Z"/>
												<path d="M16 4V12"/>
												<path d="M32 4V12"/>
												<path d="M28 34H34"/>
												<path d="M14 34H20"/>
												<path d="M28 26H34"/>
												<path d="M14 26H20"/>
												</svg> <Fragment set:html={pageDate} />
										</span>
										{pageTime && (
											<span class="date-group">
												<svg class="date-icon time-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
													<path d="M24 44C35.0457 44 44 35.0457 44 24C44 12.9543 35.0457 4 24 4C12.9543 4 4 12.9543 4 24C4 35.0457 12.9543 44 24 44Z" fill="none" stroke-linejoin="round"/>
													<path d="M24.0084 12.0001L24.0072 24.0089L32.4866 32.4883" stroke-linecap="round" stroke-linejoin="round"/>
												</svg> <Fragment set:html={pageTime} />
											</span>
										)}
										{/* AI 翻译徽标：放在「序号、日期、时间」之后，保持 date 组间距 */}
										{frontmatter?.ai && (
											<span class="tag cat-tag ai-badge">
												<span class="ai-badge-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7.49,2.91l1.22,3.15"/><path d="M1.68,6.05h12.8"/><path d="M4,7.91s1.27,3.69,3.87,5.43c2.6,1.74,7.16,2.81,7.16,2.81"/><path d="M12.19,6.05l-.05.35s-.99,3.89-3.59,6.17c-2.6,2.28-6.88,3.33-6.88,3.33"/><polyline points="22.06 21.1 17.31 10.28 12.56 21.1"/><line x1="14.46" y1="17.21" x2="20.17" y2="17.21"/></svg></span><span class="ai-badge-text">AI</span>
											</span>
										)}
										{/* 题图来源（frontmatter.imageCredit，不填就不渲染）：和序号/日期/时间同款 group，
