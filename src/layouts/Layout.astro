	<script is:inline>
		(function() {
			var savedPage = sessionStorage.getItem('blogHomePage');
			if (savedPage && savedPage !== '1') {
				var brandLink = document.querySelector('.nav-brand');
				if (brandLink) {
					var href = brandLink.getAttribute('href') || '';
					if (href === '/' || href === '/en-US') {
						brandLink.setAttribute('href', href + '?page=' + savedPage);
					}
				}
			}

			// 可靠的 JS 两行省略号（post nav 卡片 + 目录条目共用：按词截断，加 …）
			function clampNavTitles() {
				document.querySelectorAll('.post-nav-title, .toc-text').forEach(function(el) {
					var lineHeight = parseFloat(window.getComputedStyle(el).lineHeight) || 22;
					var maxHeight = lineHeight * 2;
					var fullText = el.getAttribute('data-full-text');
					if (fullText === null) {
						fullText = el.textContent;
						el.setAttribute('data-full-text', fullText);
					}
					el.style.maxHeight = maxHeight + 'px';
					el.textContent = fullText;
					// 加 1px 容差，避免刚好两行时被误判为溢出
					if (el.scrollHeight <= el.clientHeight + 1) return;
					// 二分截断直到不超过两行
					var low = 0, high = fullText.length;
					while (low < high) {
						var mid = Math.ceil((low + high) / 2);
						el.textContent = fullText.slice(0, mid) + '…';
						if (el.scrollHeight <= el.clientHeight + 1) {
							low = mid;
						} else {
							high = mid - 1;
						}
					}
					// 词边界处理：只有当截断点正好落在英文单词内部（下一个字符是字母/数字）时，
					// 才回退到最近空格（单词边界），避免切断英文单词；
					// CJK 字符可逐字断行，无需回退（否则会因一个空格丢掉后面本可放下的中文字）
					var cut = low;
					var nextCh = fullText[low] || '';
					if (/[A-Za-z0-9]/.test(nextCh)) {
						var lastSpace = fullText.lastIndexOf(' ', cut);
						if (lastSpace > cut * 0.5) {
							cut = lastSpace;
						}
					}
					el.textContent = fullText.slice(0, cut).replace(/\s+$/, '') + '…';
				});
			}

			document.addEventListener('DOMContentLoaded', clampNavTitles);
			window.addEventListener('load', clampNavTitles);
			window.addEventListener('resize', clampNavTitles);
			// 字体加载完成后重算：避免首次测量因 CJK/西文字体未就绪而误判“未超两行”
			if (document.fonts && document.fonts.ready) {
				document.fonts.ready.then(clampNavTitles);
			}

			// 代码块复制按钮（与语言标签合成统一工具栏）
			function addCopyButtons() {
				document.querySelectorAll('.typography-body pre').forEach(function(pre) {
					if (pre.querySelector('.code-toolbar')) return;
					var lang = pre.getAttribute('data-language') || 'code';

					var toolbar = document.createElement('div');
					toolbar.className = 'code-toolbar';

					var langEl = document.createElement('span');
					langEl.className = 'code-lang';
					langEl.textContent = lang;

					var btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'code-copy-btn';
					btn.setAttribute('aria-label', '复制代码');
					var copyIcon = '<svg viewBox="0 0 24 24"><rect x="8.15" y="8.15" width="12.26" height="12.26" rx="3" ry="3"/><path d="M3.59,14.7V5.89c0-1.27,1.03-2.3,2.3-2.3h8.81"/></svg>';
					var checkIcon = '<svg viewBox="0 0 24 24"><polyline points="4.42 12.36 10.11 19.33 19.58 4.67" stroke="#58cc02"/></svg>';
					btn.innerHTML = copyIcon;
					btn.addEventListener('click', function() {
						var code = pre.querySelector('code');
						var text = code ? code.innerText : pre.innerText;
						function done() {
							btn.classList.add('copied');
							btn.innerHTML = checkIcon;
							setTimeout(function() {
								btn.classList.remove('copied');
								btn.innerHTML = copyIcon;
							}, 1500);
						}
						if (navigator.clipboard && navigator.clipboard.writeText) {
							navigator.clipboard.writeText(text).then(done, function() { fallbackCopy(text, done); });
						} else {
							fallbackCopy(text, done);
						}
					});

					toolbar.appendChild(langEl);
					toolbar.appendChild(btn);
					pre.classList.add('has-code-toolbar');
					pre.appendChild(toolbar);
				});
			}
			function fallbackCopy(text, done) {
				var ta = document.createElement('textarea');
				ta.value = text;
				ta.style.position = 'fixed';
				ta.style.opacity = '0';
				document.body.appendChild(ta);
				ta.select();
				try { document.execCommand('copy'); } catch (e) {}
				document.body.removeChild(ta);
				done();
			}
			document.addEventListener('DOMContentLoaded', addCopyButtons);

			// 文章目录（TOC）
			function buildToc() {
				var containers = [];
				var tocMain = document.getElementById('toc');
				var tocPopup = document.getElementById('toc-popup');
				if (tocMain) containers.push(tocMain);
				if (tocPopup) containers.push(tocPopup);
				if (!containers.length) return;

				var isEn = (document.documentElement.lang || '').toLowerCase().indexOf('en') === 0;
				var body = document.querySelector('.typography-body');
				if (!body) return;
				var headings = body.querySelectorAll('h2, h3, h4');
				var items = [];
				headings.forEach(function(h) {
					if (h.closest('.post-title-link') || h.closest('.toc') || h.closest('.toc-popup')) return;
					// 跳过不可见标题（如被 CSS 隐藏的自动注脚标题 #footnote-label）
					if (h.offsetParent === null) return;
					var text = h.textContent.replace(/\s+/g, ' ').trim();
					if (!text) return;
					var id = h.id || (text.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fff]+/g, '-').replace(/^-+|-+$/g, '') || ('toc-' + items.length));
					h.id = id;
					items.push({ level: parseInt(h.tagName.charAt(1), 10), id: id, text: text });
				});
				// 即使没有标题（items 为空），也继续渲染，保证始终有「top / bottom」导航项

				// 页面级导航：篇首 / 篇末（点击平滑滚动，实时计算目标位置）
				function makeNavItem(label, getTop) {
					var li = document.createElement('li');
					li.className = 'toc-item toc-item--nav';
					var a = document.createElement('a');
					a.href = '#';
					a.setAttribute('data-text', label); /* 供弹层条目 ::before 占位防字重位移 */
					var span = document.createElement('span');
					span.className = 'toc-text';
					span.textContent = label;
					a.appendChild(span);
					a.addEventListener('click', function(e) {
						e.preventDefault();
						window.scrollTo({ top: getTop(), behavior: 'smooth' });
					});
					li.appendChild(a);
					return li;
				}

				var allLinks = [];
				containers.forEach(function(container) {
					var title = document.createElement('div');
					title.className = 'toc-title';
					title.textContent = isEn ? 'Contents' : '目录';
					container.appendChild(title);

					var list = document.createElement('ul');
					list.className = 'toc-list';
					list.appendChild(makeNavItem('Top', function() { return 0; }));

					items.forEach(function(it) {
						var li = document.createElement('li');
						li.className = 'toc-item toc-item--h' + it.level;
						var a = document.createElement('a');
						a.href = '#' + encodeURIComponent(it.id);
						a.setAttribute('data-target', it.id);
						a.setAttribute('data-text', it.text); /* 供弹层条目 ::before 占位防字重位移 */
						var span = document.createElement('span');
						span.className = 'toc-text';
						span.textContent = it.text;
						a.appendChild(span);
						li.appendChild(a);
						list.appendChild(li);
					});

					list.appendChild(makeNavItem('Bottom', function() {
						return document.documentElement.scrollHeight;
					}));
					container.appendChild(list);
					allLinks = allLinks.concat(Array.prototype.slice.call(list.querySelectorAll('a')));
				});

				// 滚动时高亮当前章节（scroll 监听 + rAF 节流）
				function updateActive() {
					var currentId = null;
					var nearBottom = (window.innerHeight + (window.scrollY || 0)) >= document.documentElement.scrollHeight - 20;
					if (nearBottom) {
						var lastItem = items[items.length - 1];
						if (lastItem) currentId = lastItem.id;
					} else {
						for (var i = 0; i < items.length; i++) {
							var el = document.getElementById(items[i].id);
							if (el && el.getBoundingClientRect().top <= 120) {
								currentId = items[i].id;
							}
						}
					}
					allLinks.forEach(function(a) {
						var target = a.getAttribute('data-target');
						// 跳过「篇首/篇末」等无章节目标的导航项，避免 null===null 误高亮
						if (target === null) return;
						a.classList.toggle('is-active', target === currentId);
					});
				}
				updateActive();
				window.addEventListener('scroll', function() { window.requestAnimationFrame(updateActive); });
				window.addEventListener('resize', updateActive);
				// 目录条目生成后，应用 post nav 同款两行按词省略号
				clampNavTitles();
				// 移动端：右上角按钮切换目录弹层
				var toggleBtn = document.getElementById('toc-toggle');
				if (toggleBtn && tocPopup) {
					toggleBtn.addEventListener('click', function(e) {
						e.stopPropagation();
						toggleBtn.classList.toggle('active');
						tocPopup.classList.toggle('active');
					});
					// 点击弹层内任一目录项后收起弹层
					tocPopup.addEventListener('click', function(e) {
						if (e.target.closest && e.target.closest('a')) {
							toggleBtn.classList.remove('active');
							tocPopup.classList.remove('active');
						}
					});
					document.addEventListener('click', function(e) {
						if (tocPopup.classList.contains('active') &&
							!tocPopup.contains(e.target) &&
							!toggleBtn.contains(e.target)) {
							toggleBtn.classList.remove('active');
							tocPopup.classList.remove('active');
						}
					});
				}
			}
			document.addEventListener('DOMContentLoaded', buildToc);

			// 视频嵌入点击加载：.video-embed 占位 → 点击注入真实 iframe（YT/B 站通用）
			function initVideoEmbeds() {
				document.querySelectorAll('.video-embed').forEach(function(wrap) {
					var btn = wrap.querySelector('.video-embed-btn');
					if (!btn) return;
					btn.addEventListener('click', function() {
						var src = wrap.getAttribute('data-embed-src');
						if (!src || wrap.querySelector('iframe')) return;
						var iframe = document.createElement('iframe');
						iframe.src = src;
						iframe.setAttribute('allowfullscreen', '');
						iframe.setAttribute('loading', 'lazy');
						iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
						iframe.setAttribute('title', 'Embedded video');
						// 立即替换；iframe 自身 background 与占位同色，加载期间不闪页面背景
						wrap.replaceChildren(iframe);
					});
				});
			}
			document.addEventListener('DOMContentLoaded', initVideoEmbeds);

			// 标签行窄屏重排：
			//  1) cat 不在行首时，不得把「cat + 首个 tag」拆到两行 → 隐藏前一个 | 并在 cat 前插断行整组换行；
			//     cat 在行首则允许 tag 自行换行。
			//  2) 同一 cat 内 tag 换行时去掉分隔符 ·（行尾/行首的 · 与跨组 | 都隐藏）。
			function relayoutTagRows() {
				document.querySelectorAll('.article-tags, .post-tags').forEach(function(row) {
					var cy = function(el) { var r = el.getBoundingClientRect(); return r.top + r.height / 2; };
					var sameRow = function(a, b) { return Math.abs(a - b) < 6; };
					var isCat = function(el) {
						return el.classList.contains('cat-tag') && !el.classList.contains('cw-pill') && !el.classList.contains('ai-badge');
					};
					// 清理
					row.querySelectorAll('.tag-row-break').forEach(function(el) { el.remove(); });
					row.querySelectorAll('.is-hidden').forEach(function(el) { el.classList.remove('is-hidden'); });
					// 迭代至稳定：display:none 隐藏分隔符会回流改变布局，需按最终布局重判（最多 3 轮）
					for (var iter = 0; iter < 5; iter++) {
						var changed = false;
						// pass 1：违规 cat（不在行首且首个 tag 被拆到下一行）→ 隐藏前 | 并插断行
						var kids = Array.prototype.slice.call(row.children);
						var needBreak = [];
						var prevVis = null;
						for (var i = 0; i < kids.length; i++) {
							var el = kids[i];
							if (el.classList.contains('tag-row-break') || el.classList.contains('is-hidden')) continue;
							if (isCat(el)) {
								if (!prevVis || !sameRow(cy(el), cy(prevVis))) { prevVis = el; continue; } // cat 行首 → 允许
								var firstTag = null;
								for (var j = i + 1; j < kids.length; j++) {
									var c = kids[j];
									if (c.classList.contains('tag-row-break') || c.classList.contains('is-hidden')) continue;
									if (isCat(c)) break;
									if (c.classList.contains('tag') && !c.classList.contains('cw-pill')) { firstTag = c; break; }
									if (c.classList.contains('cw-pills') || c.classList.contains('ai-badge')) break;
								}
								if (firstTag && !sameRow(cy(el), cy(firstTag))) needBreak.push({ el: el, prev: prevVis });
							}
							prevVis = el;
						}
						needBreak.forEach(function(o) {
							if (o.prev && o.prev.classList.contains('tag-group-sep')) o.prev.classList.add('is-hidden');
							var br = document.createElement('span');
							br.className = 'tag-row-break';
							row.insertBefore(br, o.el);
							changed = true;
						});
						// pass 2：分隔符显示当且仅当其前后可见元素同行（换行处隐藏，回流后同行则恢复）
						kids = Array.prototype.slice.call(row.children);
						for (var k = 0; k < kids.length; k++) {
							var s = kids[k];
							if (!s.classList.contains('tag-sep') && !s.classList.contains('tag-group-sep')) continue;
							var p = null;
							for (var a = k - 1; a >= 0; a--) {
								var ca = kids[a];
								if (ca.classList.contains('tag-row-break') || ca.classList.contains('is-hidden')) continue;
								p = ca; break;
							}
							var n = null;
							for (var b = k + 1; b < kids.length; b++) {
								var cb = kids[b];
								if (cb.classList.contains('tag-row-break') || cb.classList.contains('is-hidden')) continue;
								n = cb; break;
							}
							var shouldShow = !!(p && n && sameRow(cy(p), cy(n)));
							if (shouldShow && s.classList.contains('is-hidden')) { s.classList.remove('is-hidden'); changed = true; }
							else if (!shouldShow && !s.classList.contains('is-hidden')) { s.classList.add('is-hidden'); changed = true; }
						}
						if (!changed) break;
					}
					// 行距：给每个换行处（非首行的第一个可见元素前）确保有 .tag-row-break，
					// break 的高度即行距（cat 违规处 pass1 已插；普通 tag 换行处在此补插）。
					// 这样行内结构不变、分隔符 align-self:center 不受影响，且所有换行处行距一致
					// （不能用 row-gap：零高 break 会让 cat 换行处变成双倍间距；
					//   也不能用行首元素 margin-top：center 分隔符只随行框中心移动一半会错位）。
					var groups2 = [], curG = [], curCyG = null;
					Array.prototype.slice.call(row.children).forEach(function(el) {
						if (el.classList.contains('tag-row-break') || el.classList.contains('is-hidden')) return;
						var c = cy(el);
						if (curCyG === null || !sameRow(c, curCyG)) { if (curG.length) groups2.push(curG); curG = []; curCyG = c; }
						curG.push(el);
					});
					if (curG.length) groups2.push(curG);
					for (var gi = 1; gi < groups2.length; gi++) {
						var firstEl = groups2[gi][0];
						var prevSib = firstEl.previousElementSibling;
						if (prevSib && prevSib.classList.contains('tag-row-break')) continue;
						var br2 = document.createElement('span');
						br2.className = 'tag-row-break';
						row.insertBefore(br2, firstEl);
					}
				});
			}
			window.addEventListener('resize', relayoutTagRows);
			document.addEventListener('DOMContentLoaded', relayoutTagRows);
			window.addEventListener('load', relayoutTagRows);
		})();
	</script>

	<script>
		// 🎼 五线谱 / 简谱切换（配合 astro.config.mjs 里的 remarkScoreSwitch）
		//
		// 一个 .score-switch 里有两块乐谱（作者手写的两种记谱法）→ 按**全局偏好**只显示其中一块。
		// 偏好优先级：`?notation=abc|jianpu`（临时看另一种，方便分享/排查）> localStorage（记住上次选择）> HTML 里先写的那块（作者定的默认）。
		// ⚠️ 隐藏的那块**不预先渲染**：display:none 的容器 clientWidth = 0，abcjs 与 simple-notation 都会量错宽度
		//    （简谱会退到 736 的兜底）→ 只在它被显示时才渲染（渲染器懒加载好之后会挂到 window.__scoreRender 上）。
		// ⚠️ 本脚本排在两个渲染脚本**之前**（模块脚本按文档顺序执行）→ 隐藏动作一定先于它们的首轮渲染。
		// ⚠️ 两块乐谱自己的 CSS 带 display:flex，会盖掉 `hidden` 属性 → 隐藏靠 main.css 的 `.score-switch [hidden]`。
		(function initScoreSwitches() {
			const switches = Array.from(document.querySelectorAll<HTMLElement>('.score-switch'));
			if (!switches.length) return;
			const KEY = 'score-notation';
			// 切换时的淡出（旧谱）/ 淡入（新谱）时长（ms）。CSS 里 .score-switch > …-score 的 transition 用同一个数。
			// 关了系统动画（prefers-reduced-motion）就置 0 → 直接换块，不做过渡。
			const FADE_MS = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 0 : 160;
			const isKind = (v: unknown): v is 'abc' | 'jianpu' => v === 'abc' || v === 'jianpu';
			/** 两块 = 带 .abc-score / .jianpu-score 的那个元素（按钮也有 data-notation，所以按类名认） */
			const paneOf = (wrap: HTMLElement, kind: 'abc' | 'jianpu') =>
				wrap.querySelector<HTMLElement>('.' + kind + '-score[data-notation="' + kind + '"]');
			// 全局偏好：URL 参数 > localStorage > 源文件里先写的（DOM 顺序）
			let pref = '';
			try {
				const q = new URLSearchParams(location.search).get('notation');
				if (isKind(q)) pref = q;
			} catch {
				/* 忽略 */
			}
			if (!pref) {
				try {
					const v = localStorage.getItem(KEY);
					if (isKind(v)) pref = v;
				} catch {
					/* 隐私模式等：用默认 */
				}
			}
			switches.forEach((wrap) => {
				const panes = Array.from(wrap.querySelectorAll<HTMLElement>('[data-notation]')).filter(
					(el) => el.classList.contains('abc-score') || el.classList.contains('jianpu-score')
				);
				if (!panes.length) return;
				const kindOf = (el: HTMLElement) => (el.getAttribute('data-notation') === 'abc' ? 'abc' : 'jianpu');
				const active = panes.some((p) => kindOf(p) === pref) ? pref : kindOf(panes[0]); // 先写的 = 默认
				const convertBtn = wrap.querySelector<HTMLElement>('[data-score-convert]');
				// 标签是「两种名字叠在同一格」的两个 span（见 remarkScoreSwitch / .score-lang）→
				// 切换时只改谁亮谁暗，由 CSS 的 opacity 过渡交叉淡化。
				const langItems = Array.from(wrap.querySelectorAll<HTMLElement>('.score-lang [data-lang-for]'));
				// 工具栏 = [当前记谱法] + [转换按钮]（对应代码块的「语言标签 + 复制按钮」）。
				// 按钮的 aria-label 写的是**动作**（“转换为简谱”）→ 跟着当前显示的那种变。
				// ⚠️ 不写 title：作者要求不要悬浮提示。
				const setToolbar = (kind: string) => {
					const to = kind === 'abc' ? 'labelJianpu' : 'labelAbc';
					langItems.forEach((el) => {
						const on = el.dataset.langFor === kind;
						el.dataset.active = on ? 'true' : 'false';
						if (on) el.removeAttribute('aria-hidden');
						else el.setAttribute('aria-hidden', 'true');
					});
					if (convertBtn) convertBtn.setAttribute('aria-label', (convertBtn as HTMLElement).dataset[to] || '');
				};
				const setPanes = (kind: string) => {
					wrap.dataset.active = kind;
					panes.forEach((p) => {
						p.hidden = kindOf(p) !== kind;
					});
				};
				const apply = (kind: string) => {
					setToolbar(kind);
					setPanes(kind);
				};
				apply(active);
				if (convertBtn) {
					convertBtn.addEventListener('click', () => {
						// 单按钮语义：永远换到「另一种」记谱法
						const kind: 'abc' | 'jianpu' = wrap.dataset.active === 'abc' ? 'jianpu' : 'abc';
						const next = paneOf(wrap, kind);
						if (!next) return;
						if (wrap.dataset.switching === '1') return; // 上一次动画还没结束：忽略这次点击（不改工具栏也不改状态）
						// 还没渲染过就现在渲染（两个渲染器会在加载完后把自己挂到 window.__scoreRender）
						const ensureRendered = () => {
							if (next.classList.contains('is-rendered')) return;
							const fn = (window as any).__scoreRender?.[kind];
							if (typeof fn === 'function') fn(next);
						};
						// 清掉上一轮可能残留的动画类（幂等，两条路径都调）
						const clearAnim = () => {
							panes.forEach((p) => p.classList.remove('is-enter', 'is-exit', 'is-layered'));
							wrap.classList.remove('is-crossfading');
							wrap.style.height = ''; // 交回 auto（收尾时高度已等于最终高度，不会跳）
							if (lang) lang.style.width = ''; // 同上，标签宽度也交回 auto
						};
						const current = wrap.dataset.active;
						const prev = isKind(current) ? paneOf(wrap, current) : null;
						// 工具栏标签的宽度也要一起动：先量旧宽，等 setToolbar 换了名字再量新宽，
						// 钉住旧宽 → 强制重排 → 设新宽（配合 .score-switch.is-crossfading .score-lang 的 width 过渡）
						const lang = wrap.querySelector<HTMLElement>('.score-lang');
						const langW = lang ? lang.getBoundingClientRect().width : 0;
						setToolbar(kind); // 工具栏（当前记谱法 + 转换按钮文案）立即响应
						wrap.dataset.active = kind;
						// 偏好存下来：全局生效，其它文章的乐谱也跟着走
						try {
							localStorage.setItem(KEY, kind);
						} catch {
							/* 忽略 */
						}
						// 不做动画（prefers-reduced-motion / 找不到旧块）：直接换
						if (!FADE_MS || !prev) {
							clearAnim();
							next.hidden = false;
							panes.forEach((p) => {
								if (p !== next) p.hidden = true;
							});
							ensureRendered();
							return;
						}
						// 叠加交叉淡化：两块**同时可见、完全重合**，旧块绝对定位叠在上面淡出、新块原位淡入
						// （不是「先淡出到空白再淡入」）。新块是在完全透明时完成懒渲染的 → 不会闪出源码兜底。
						wrap.dataset.switching = '1';
						// ⚠️ 先加 is-crossfading：标签的 width 过渡挂在 .score-switch.is-crossfading .score-lang 上，
						//    晚加的话改宽度时还没有 transition，宽度会瞬间跳一下
						wrap.classList.add('is-crossfading'); // overflow:hidden + height/width 过渡
						if (lang && langW) {
							const langW1 = lang.getBoundingClientRect().width;
							lang.style.width = langW + 'px';
							void lang.offsetWidth;
							lang.style.width = langW1 + 'px';
						}
						const heightFrom = wrap.getBoundingClientRect().height; // 旧块撑开的外框高
						prev.classList.add('is-layered'); // 先脱离文档流（位置不变，仍在最上层）
						next.hidden = false;
						next.classList.add('is-enter'); // 起始值 opacity: 0（此时还没开始过渡）
						ensureRendered();
						void next.offsetWidth; // 强制算一次样式：把 next = 0、prev 绝对定位定成「起始值」
						const heightTo = wrap.getBoundingClientRect().height; // 新块撑开的外框高
						wrap.style.height = heightFrom + 'px';
						void wrap.offsetWidth;
						wrap.style.height = heightTo + 'px'; // 外框高度跟着平滑变
						next.classList.remove('is-enter'); // 新块淡入 0 → 1
						prev.classList.add('is-exit'); // 旧块淡出 1 → 0
						window.setTimeout(() => {
							prev.hidden = true; // 旧块已全透明，收起
							clearAnim();
							wrap.removeAttribute('data-switching');
						}, FADE_MS + 30); // +30：等 CSS 那侧确实过渡完，避免收尾时跳一下
					});
				}
			});
		})();
	</script>

	<script>
		import { bravuraDigitMetrics, bravuraDigitSize, drawBravuraDigits, whenBravuraReady } from '../lib/bravura-digits';

		// 🎼 ABC 乐谱渲染（abcjs）：仅当本页存在 .abc-score 时才动态加载 abcjs（代码分割，不污染其他页）。
		// 绘制颜色取自当前主题的 --text-main；主题切换（手动切换 / 跟随系统）会改 html[data-theme]，
		// 这里用 MutationObserver 监听并在变化时用新主题色重绘。
		async function initAbcScores() {
			const hosts = Array.from(document.querySelectorAll<HTMLElement>('.abc-score'));
			if (!hosts.length) return;
			// 先把源码读进 dataset（首次渲染后 <pre class="abc-source"> 会被 renderAbc 替换掉，重绘时改从 dataset 取）
			hosts.forEach((host) => {
				const codeEl = host.querySelector('.abc-source code');
				if (codeEl && !host.dataset.abc) {
					host.dataset.abc = (codeEl.textContent || '').replace(/\n$/, '');
				}
			});
			if (!hosts.some((h) => h.dataset.abc)) return;
			const abcjs = await import('abcjs');

			/**
			 * 速度记号里的数字（`♩ = 88` 的 88）换成 **Bravura 雕刻数字**（与简谱同一套，用户要求）。
			 * abcjs 把它画成一个普通 `<text>`（Times New Roman，内容形如 `= 88`；音符符号是路径）：
			 *   `<text x y font-size="20"><tspan x> = 88</tspan></text>`
			 * 做法：把那一段拆成「前缀（`= `）+ 逐字字形」，**不写 x**（顺着前缀排）、用**相对 dy** 上提
			 * `字号 × 0.35`（字形骑在基线上、正文数字坐在基线上 → 抬 0.35em 后「字形墨迹中心」才对齐「文字墨迹中心」）。
			 * ⚠️ 量不到 Bravura（字体没就绪）就原样留着，字体就绪后再补一遍；
			 *   已经换过的不会被重复处理（`= ` 后面跟着私用区码位，过不了 `\d` 这条正则）→ 幂等。
			 * ⚠️ `responsive: 'resize'` 时 abcjs 会**自己重画**（不经过 renderOne）→ resize 后要再补一遍。
			 */
			const engraveTempoDigits = (host: HTMLElement) => {
				const LIFT = 0.35; // em：字形墨迹中心相对文字墨迹中心要高出的量
				host.querySelectorAll('svg text').forEach((textEl) => {
					// 数字可能直接就是 text 的内容，也可能在它唯一的 tspan 里（实测 abcjs 是后者）
					const span = Array.from(textEl.children).find((c) => c.tagName === 'tspan' && /^\s*=\s*\d/.test(c.textContent || ''));
					const target: Element | null = span || (/^\s*=\s*\d/.test(textEl.textContent || '') ? textEl : null);
					if (!target) return;
					const m = /^(\s*=\s*)(\d+)([\s\S]*)$/.exec(target.textContent || '');
					if (!m) return;
					const fs = parseFloat(textEl.getAttribute('font-size') || '') || 20; // abcjs 速度行字号（实测 20）
					const size = bravuraDigitSize(fs);
					const keepX = target.getAttribute('x') || textEl.getAttribute('x');
					const NS = 'http://www.w3.org/2000/svg';
					target.textContent = '';
					const prefix = document.createElementNS(NS, 'tspan');
					if (keepX) prefix.setAttribute('x', keepX);
					prefix.textContent = m[1];
					target.appendChild(prefix);
					drawBravuraDigits(target, m[2], size, null, false, -fs * LIFT, true);
					if (m[3]) {
						const tail = document.createElementNS(NS, 'tspan');
						tail.setAttribute('dy', String(fs * LIFT)); // 尾巴（若有）挪回正常基线
						tail.textContent = m[3];
						target.appendChild(tail);
					}
				});
			};

			/** abcjs 给连音组数字的字号（实测 15）及其墨迹下缘高度（Times 的 `3`：上缘 0.733em、下缘 0.067em，实测） */
			const ABC_TRIPLET_FONT_SIZE = 15;
			const ABC_TRIPLET_INK_DESC = 0.067;

			/**
			 * 连音组上的数字（`(2`–`(9`；abcjs 一律画成单个 Times 斜体数字，CSS 已把斜体掰直）：
			 * 换成跟简谱 / 拍号**同一套 Bravura 雕刻数字**（`timeSig0`–`timeSig9` 全在子集里 ⇒ 2…9 都行），
			 * 并把横向位置改到**梁的墨迹中点** ——
			 * abcjs 是按「中间那个音的**音符头**中心」摆的，而梁是从第一个音杆到最后一个音杆，
			 * 中点比它靠右半个杆宽（实测 4.3px），看着就是「有点偏左」（用户实测否掉）。
			 * 纵向：让 Bravura 的墨迹**下缘**落在原来那个字形墨迹的下缘上（= 它的基线 + 0.067em）→
			 *      换字体后离梁的净空不变。
			 * ⚠️ 幂等：换过之后 text 里是个 tspan（打 `data-abc-triplet` 标记），重跑直接跳过。
			 * ⚠️ `responsive: 'resize'` 时 abcjs 会自己重画（我们的替换被冲掉）→ 重画后要再补一遍。
			 */
			const engraveTripletDigits = (host: HTMLElement) => {
				const svg = host.querySelector('svg');
				if (!svg) return;
				const ctm = svg.getScreenCTM();
				const scale = ctm && ctm.a ? ctm.a : 1; // 一个用户单位占几个 CSS px
				const beams = Array.from(svg.querySelectorAll('.abcjs-beam-elem')).map((b) => b.getBoundingClientRect());
				svg.querySelectorAll('.abcjs-triplet text').forEach((textEl) => {
					if (textEl.hasAttribute('data-abc-triplet')) return;
					// abcjs 把连音组的数字画成一个 <text>：`(2`–`(9` 都是**单个数字**（`(3:2` 这种只写分子）
					const n = (textEl.textContent || '').trim();
					if (!/^[2-9]$/.test(n)) return;
					const r = textEl.getBoundingClientRect();
					if (!r.width || !r.height) return; // 容器不可见时量不到任何东西：留给下次
					const cx = (r.left + r.right) / 2;
					const fs = parseFloat(textEl.getAttribute('font-size') || '') || ABC_TRIPLET_FONT_SIZE;
					// 梁 = 横跨这个数字、又在它下头、离得最近的那根（没有就不动 abcjs 给的 x）
					const beam = beams
						.filter((b) => b.left <= cx && b.right >= cx && b.top >= r.top && b.top - r.bottom <= fs * 4 * scale)
						.sort((a, b) => a.top - b.top)[0];
					if (beam) {
						const x = parseFloat(textEl.getAttribute('x') || '0') + ((beam.left + beam.right) / 2 - cx) / scale;
						textEl.setAttribute('x', String(x));
					}
					const size = bravuraDigitSize(fs);
					const ink = bravuraDigitMetrics(n, size);
					const inkBottom = parseFloat(textEl.getAttribute('y') || '0') + fs * ABC_TRIPLET_INK_DESC;
					textEl.setAttribute('text-anchor', 'middle');
					textEl.setAttribute('data-abc-triplet', '1');
					textEl.textContent = '';
					drawBravuraDigits(textEl, n, size, null, false, inkBottom - ink.desc);
				});
			};

			/** 刻字：速度行数字 + 连音组数字（abcjs 每次重画都会冲掉它们，凡重画后都得补） */
			const engraveDigits = (host: HTMLElement) => {
				engraveTempoDigits(host);
				engraveTripletDigits(host);
			};

			// ⚠️ abcjs 的分句有个隐形门槛（见 abcjs 源码 abc_tunebook_svg.js）：
			//    `if (params.wrap && params.staffwidth)` —— **不传 staffwidth 就整个不换行**，
			//    wrap 参数被静默忽略（所以以前手写换行是什么样、它就是什么样，窄屏只会整体缩小）。
			/** ABC 每行小节数：与简谱同一套档位（谱宽 ≥680 → 4；480–680 → 3；<480 → 2） */
			const ABC_PER_LINE_WIDE = 680; // ⚠️ 与 JIANPU_PER_LINE_WIDE / _MID 保持一致
			const ABC_PER_LINE_MID = 480;
			const ABC_MIN_SPACING = 1.8; // abcjs 官方示例里用的值：行宽放不下「首选节数」时它会自己退回按宽度分句
			const ABC_MAX_SPACING = 2.7; // 同上（限制一行被拉得多松，也是 abcjs 官方示例的取值）。
			// ⚠️ 2026-10-02 试过调到 4，想让它把「行末空白」拉掉：**完全没有变化**（gap 一模一样），别白试。
			const abcTierFor = (w: number) => (w >= ABC_PER_LINE_WIDE ? 4 : w >= ABC_PER_LINE_MID ? 3 : 2);
			/**
			 * 布局宽度下限：**≥ 它就跟容器走，< 它就固定按它排**（用户 2026-10-02 定为 **500**，
			 * 简谱那边是 550）—— 两个值都是他自己调出来的，别擅自改。
			 */
			const ABC_MIN_STAFF_WIDTH = 500;
			/** 布局宽度：**≥ 600 跟容器走**（实时重排）；**< 600 恒为 600**（用户 2026-10-02：「屏幕宽度大于等于 600 时原样按照宽度排，小于 600 了立刻冻结到 600px 的样式不动了」）*/
			const abcStaffWidth = (host: HTMLElement) => Math.max(Math.round(host.clientWidth) || 736, ABC_MIN_STAFF_WIDTH);
			const abcTier = (host: HTMLElement) => abcTierFor(abcStaffWidth(host));
			/** 每行的小节数（按 y 分行统计小节线） */
			const abcLineCounts = (host: HTMLElement) => {
				const svg = Array.from(host.querySelectorAll('svg')).find((s) => (s.getAttribute('viewBox') || '') !== '0 0 24 24');
				if (!svg) return [] as number[];
				const sr = svg.getBoundingClientRect();
				const rows = new Map<number, number>();
				svg.querySelectorAll('.abcjs-bar').forEach((b) => {
					const r = b.getBoundingClientRect();
					const k = Math.round((r.top - sr.top) / 20) * 20;
					rows.set(k, (rows.get(k) || 0) + 1);
				});
				return Array.from(rows.entries()).sort((a, b) => a[0] - b[0]).map((e) => e[1]);
			};
			/** 「一行只剩 1 小节」的行数 —— 这是排版是否合格的唯一判据（用户钦定，别自创 fill 之类的花样） */
			const abcLonelyLines = (counts: number[]) => counts.filter((c) => c <= 1).length;
			/** 缩放档位（用户钦定粒度）：出现「一行一小节」就逐档往下缩，不许再换 n（不换行）。
			 *  ⚠️ 最低档停在 **0.6**（2026-10-02 用户选 B）：0.5 会让密谱的字号比 `scale = 1` 小掉四分之一，
			 *  放一起看明显偏小（《月亮桥》）。再往下缩的收益不如多几行。 */
			const ABC_SCALES = [1, 0.85, 0.72, 0.6];
			/**
			 * 反复「小房子」**末尾那间**的横线宽度（abcjs 内部单位，跟它房子高度 20 同一套）。
			 * 用户要「定宽、不封口」：不要按小节宽算（有时太长有时太短），取个稍小一点的定值 ——
			 * 82 ≈ 简谱那边库给的 ≈81px（实测同一页一小节 ≈189 单位，两边比例相近，切换记谱法时观感一致）。
			 */
			const ABC_VOLTA_WIDTH = 82;

			/**
			 * 把一段 abcjs 文本的**水平锚点**挪到 `target`。
			 * ⚠️ abcjs 给标题/作曲写的 `x` 在子 `<tspan>` 上也各有一份，而 **tspan 的 `x` 会覆盖父级** ⇒
			 *    只改父级没用（实测 `scale = 0.5` 的《月亮桥》：标题 `text` 的 x 改成 467.77 了，它那个
			 *    `<tspan x="406">` 仍把字画在原处）。所以按**差值**把每个带 `x` 的 tspan 一起平移。
			 */
			const alignAbcTextX = (el: Element, target: number) => {
				const cur = parseFloat(el.getAttribute('x') || 'NaN');
				if (!Number.isFinite(cur) || cur === target) return;
				const dx = target - cur;
				el.setAttribute('x', target.toFixed(2));
				el.querySelectorAll('tspan[x]').forEach((sp) => {
					const v = parseFloat(sp.getAttribute('x') || 'NaN');
					if (Number.isFinite(v)) sp.setAttribute('x', (v + dx).toFixed(2));
				});
			};

			/**
			 * 渲染一段 ABC，不合格就修 —— 顺序固定，`n`（每行小节数）**先定好，之后整个缩放过程不再变**：
			 *  ① 原样渲染 `(档位, scale 1)`；
			 *  ② 末行只剩 1 小节 → 换一次 n（`n+1` 挤进上一行优先，其次 `n−1`），换完就锁定；
			 *  ③ 还有「一行一小节」→ 用 `ABC_SCALES` 逐档往下缩，缩到不出现为止，
			 *     **然后再多缩一档** —— 第一个「刚够放下两小节」的档位看着很挤，
			 *     用户原话：「在两个小节被缩到最窄之前就开始缩放」（= 别停在那个卡死的档位上）。
			 * @param perLine 每行小节数（不传 = 按档位）
			 */
			const renderOne = (host: HTMLElement, perLine?: number) => {
				const src = host.dataset.abc;
				if (!src) return;
				// 默认时值（`L:`）：**abcjs 自己的默认跟着拍号乱跳** —— 实测 `M: 2/4` 与 `3/8` 是 1/16、
				// `4/4` 与 `6/8` 是 1/8（ABC 标准的表就是这么定的）。站点统一成「留空 = 拍号的分母」，
				// 与简谱那边的 `len:` 同一口径（用户 2026-10-01：`M: 2/4` 的曲子拿 1/16 算，一小节才 1/4 拍）。
				// ⚠️ 只补**省缺的** `L:`；作者写了的（含 `[L:` 行内写法）一律不动。
				const srcUnit = (() => {
					if (/^\s*(\[[^\]\n]*\])?\s*L\s*[:：]/m.test(src)) return src;
					const m = /^\s*M\s*[:：]\s*(\d+)\s*\/\s*(\d+)\s*$/m.exec(src);
					const line = `L: 1/${m ? m[2] : '4'}`;
					const lines = src.split('\n');
					// 头部到 `K:` 为止 ⇒ 插在 K: 之前；没 K: 就接在 M: 后面；都没有就放最前
					const at = lines.findIndex((l) => /^\s*K\s*[:：]/.test(l));
					if (at >= 0) lines.splice(at, 0, line);
					else {
						const mi = lines.findIndex((l) => /^\s*M\s*[:：]/.test(l));
						if (mi >= 0) lines.splice(mi + 1, 0, line);
						else lines.unshift(line);
					}
					return lines.join('\n');
				})();
				const fg = (getComputedStyle(document.documentElement).getPropertyValue('--text-main') || '#1D1D1F').trim();
				const width = abcStaffWidth(host); // ⚠️ 窄于阈值就冻结排版宽度，靠等比缩放顶上
				// 每行小节数 = 档位（谱宽 ≥680 → 4；480–680 → 3；<480 → 2）。
				// ⚠️ 别改成 0（= 不传 preferredMeasuresPerLine ⇒ abcjs 自己按宽度折行）：实测每行小节数
				//    会变成 2/2/3/2/1/2/3/2 这种参差，行与行的谱线宽度也不一样（527 vs 599），
				//    看着就像「某行溢出」+「一堆单小节成行」（用户 2026-10-02 报的就是这个）。
				const tier = perLine || abcTierFor(width);
				let n = tier;
				const draw = (usePerLine: number, scale: number) => {
					// ⚠️ `n = 0` ⇒ **不传** preferredMeasuresPerLine（abcjs 自己按宽度折行）
					const wrapOpts: any = {
						minSpacing: ABC_MIN_SPACING,
						maxSpacing: ABC_MAX_SPACING,
					};
					if (usePerLine > 0) wrapOpts.preferredMeasuresPerLine = usePerLine;
					abcjs.renderAbc(host, srcUnit, {
						responsive: 'resize',
						add_classes: true,
						foregroundColor: fg,
						staffwidth: width, // ← 必须：不给它 abcjs 就不分句
						scale,
						// ⚠️ 试验中：不传 `wrap` —— 传了它会改用「按宽度自适应」折行：
						//    每行小节数会变成 2/2/3/2/1/2/3/2 这种参差，行与行的谱线宽度也不一样（527 / 599）；
						//    `preferredMeasuresPerLine`、`$` 强制换行都左右不了它（都实测过，行宽一模一样）。
						//    不传时它按**源码换行**折行并把每行拉齐（行宽 595~596 全统一，泪海还回到 scale 1）。
						// wrap: wrapOpts,
					});
					host.classList.add('is-rendered');
					// 调号：abcjs 会给**每个 staff 行**画一次调号（五线谱的排版惯例，用户要保留），但它还会在
					// **源码换行**处再画一次 —— 那些行如果没触发视觉折行，同一个视觉行里就会连着冒出好几个调号
					// （用户：「我每在源代码换一次行，对应音符前都出现了一次调号」）。
					// 做法：**只在同一个视觉行内部去重** —— 字形序列与这一行里上一个调号相同的删掉，跨行的重复一律保留
					// （每行行首重申调号本来就是对的：「人家谱号在每行行首本来就要有的」）。
					// ⚠️ 删掉后原位留白，但**不做位移补偿**：一旦把右侧内容左移，行末竖线会跟着走而**谱表线不动**
					//    ⇒ 每行末尾多出一截空表线（用户：「abc 现在五线谱总会凸出去一点」）。
					const ksigs = Array.from(host.querySelectorAll('svg g.abcjs-key-signature'));
					/** 调号的「字形序列」——⚠️ 不能拿 innerHTML 比：abcjs 把路径的**绝对坐标**写在 `d` 里，
					 *  同一调号在不同位置的字形串都不一样（实测四处 G 调号互不相等 ⇒ 一个都删不掉）。 */
					const sigOf = (el: Element) =>
						Array.from(el.children)
							.map((c) => c.getAttribute('data-name') || c.tagName)
							.join(',');
					const sigSeenInRow = new Map<Element, string>();
					ksigs.forEach((el) => {
						const row = el.parentElement;
						if (!row) return;
						const sig = sigOf(el);
						const prev = sigSeenInRow.get(row);
						sigSeenInRow.set(row, sig);
						if (prev === sig) el.remove();
					});
					// 反复「小房子」：**末尾那间**（最后一组 ending、且编号不是 1）改成定宽 + 不封口，续行那几段去掉。
					// ⚠️ 数字只画在有 anchor1 的那一段 ⇒ 没 text 的就是续行段；按「有数字」切成一间一间的。
					// ⚠️ 只动最后一间（= 2 房子；只有 `[1. … :|` 没有 2 房子时它的编号就是 1，不动）。
					const voltas: Element[][] = [];
					host.querySelectorAll('svg g.abcjs-ending').forEach((g) => {
						if (g.querySelector('text')) voltas.push([g]);
						else if (voltas.length) voltas[voltas.length - 1].push(g);
					});
					const lastVolta = voltas[voltas.length - 1];
					const lastText = lastVolta ? (lastVolta[0].querySelector('text') as SVGTextElement | null) : null;
					const lastNo = lastText && (lastText.textContent || '').trim();
					// 房子序号统一成「1.」这种带点的写法（abcjs 原样输出 `[1` 就是「1」；简谱那边本来就是「1.」）
					host.querySelectorAll('svg g.abcjs-ending > text').forEach((t) => {
						const span = t.querySelector('tspan') || t;
						const s = span.textContent || '';
						if (s && !/\.$/.test(s)) span.textContent = s + '.';
					});
					if (lastVolta && lastNo && !/^1\.?$/.test(lastNo)) {
						const firstPath = lastVolta[0].querySelector('path');
						const m = firstPath && (firstPath.getAttribute('d') || '').match(/-?\d*\.?\d+/g);
						const rest = lastVolta.slice(1);
						if (firstPath && m && m.length >= 8) {
							const x = +m[0];
							const y = +m[1];
							const h = +m[3] - y; // 竖线高度（abcjs 写死 20）
							const avail = +m[m.length - 2] - x; // 首页那一段原本的横线长度
							/** 重画成「左竖线 + 定宽横线」，不画右竖线（＝不封口） */
							const paint = (p: Element, x0: number, y0: number, w: number) =>
								p.setAttribute('d', `M ${x0} ${y0} L ${x0} ${y0 + h} M ${x0} ${y0} L ${x0 + w} ${y0}`);
							if (avail >= ABC_VOLTA_WIDTH || !rest.length) {
								// 首页那一段本身就够长（或压根没续行）⇒ 就地截短成定宽、去掉封口，续行那几段丢掉
								rest.forEach((el) => el.remove());
								paint(firstPath, x, y, Math.min(ABC_VOLTA_WIDTH, Math.max(0, avail)));
							} else {
								// `[2` 正好卡在换行处（首页只剩一丁点）⇒ 整间挪到下一行的行首去画（谱面上常见的写法）
								const p2 = rest[0].querySelector('path');
								const m2 = p2 && (p2.getAttribute('d') || '').match(/-?\d*\.?\d+/g);
								if (p2 && m2 && m2.length >= 4) {
									const x2 = +m2[0];
									const y2 = +m2[1];
									paint(p2, x2, y2, Math.min(ABC_VOLTA_WIDTH, Math.max(0, +m2[m2.length - 2] - x2)));
									// 序号跟着搬（保持它相对房子顶线的偏移）
									lastText.setAttribute('x', String(x2 + 5));
									lastText.setAttribute('y', String(y2 + (parseFloat(lastText.getAttribute('y') || '0') - y)));
									rest[0].appendChild(lastText);
									rest.slice(1).forEach((el) => el.remove());
									lastVolta[0].remove();
								} else rest.forEach((el) => el.remove());
							}
						}
					}
					host.dataset.abcTier = String(tier); // ⚠️ 拿档位比较，别拿 abcPerLine（可能 = 档位±1）
					host.dataset.abcPerLine = String(usePerLine);
					host.dataset.abcStaffWidth = String(width);
					host.dataset.abcScale = String(scale);
					// ⚠️ `scale ≠ 1` 时 abcjs 把**标题**按 `staffwidth / 2` 摆，而谱面内容的实际范围比那个宽度更宽
					//    ⇒ 标题偏左（实测《月亮桥》scale 0.5 时标题中心 406、谱面中心 467.5，偏了 61），作曲行同理。
					//    居中基准改成谱面内容的实际范围，作曲行贴到内容右端。
					if (scale !== 1) {
						try {
							let inkL = Infinity;
							let inkR = -Infinity;
							host.querySelectorAll('svg g.abcjs-staff-wrapper').forEach((w) => {
								const bx = (w as SVGGraphicsElement).getBBox();
								inkL = Math.min(inkL, bx.x);
								inkR = Math.max(inkR, bx.x + bx.width);
							});
							if (Number.isFinite(inkL) && Number.isFinite(inkR)) {
								const titleEl = host.querySelector('svg .abcjs-title');
								const compEl = host.querySelector('svg .abcjs-composer');
								if (titleEl) alignAbcTextX(titleEl, (inkL + inkR) / 2);
								if (compEl) alignAbcTextX(compEl, inkR);
							}
						} catch {
							// 量不到（不可见等）就保持 abcjs 原样
						}
					}
					// 作曲行与速度记号**并排**：abcjs 把速度记号单独摆在最上面一行 ⇒ 标题 / 作曲 / 速度三行叠着，
					// 作曲与谱面之间空一大块（用户：「作曲那一行和速度是分开的，这导致出现了很多空白」）。
					// 做法：把所有谱行整体上移 Δ = 速度行基线 − 作曲行基线，速度记号跟着落回作曲那一行；
					// viewBox 高度同时减 Δ（少掉的那条空带子要还回去）。
					// ⚠️ 谱行必须**一起**移（多行谱只移第一行会把行距搞乱）；
					// ⚠️ 没写作曲（`C:`）就没有可并的那一行 ⇒ 保持 abcjs 原样。
					const composerEl = host.querySelector('svg .abcjs-composer');
					const tempoText = host.querySelector('svg g[data-name="tempo"] text');
					const staffWraps = Array.from(host.querySelectorAll('svg g.abcjs-staff-wrapper'));
					if (composerEl && tempoText && staffWraps.length) {
						const dy = parseFloat(tempoText.getAttribute('y') || '0') - parseFloat(composerEl.getAttribute('y') || '0');
						if (dy > 1) {
							staffWraps.forEach((w) => {
								const prev = w.getAttribute('transform');
								w.setAttribute('transform', `translate(0 ${-dy.toFixed(2)})` + (prev ? ' ' + prev : ''));
							});
							const svgEl = host.querySelector('svg');
							const vb = ((svgEl && svgEl.getAttribute('viewBox')) || '').split(/\s+/).map(Number);
							if (svgEl && vb.length === 4) {
								svgEl.setAttribute('viewBox', `${vb[0]} ${vb[1]} ${vb[2]} ${+(vb[3] - dy).toFixed(2)}`);
								// ⚠️⚠️ 容器的高是 abcjs 用 `padding-bottom: 旧高/宽*100%`（inline style）撑的 ⇒
								//    只缩 viewBox 会在**底下留一条空白**（用户：「这样下边就有空白出现了诶」）——
								//    必须把占位比例一起改成新高/宽。
								host.style.paddingBottom = `${(((vb[3] - dy) / vb[2]) * 100).toFixed(4)}%`;
							}
						}
					}
					// ⚠️ viewBox 宽度**贴合实际内容**：abcjs 在 `scale ≠ 1` 时算出来的框可能比内容宽得多
					//    （作曲行等元素按未缩放的宽度定位）⇒ 谱面缩在左边、右边一大块空白，而且整体还显得比
					//    `scale = 1` 的谱小一圈。宽度按「谱行 + 标题/作曲」的左右墨迹重算（左右边距对称），
					//    高度不动，`padding-bottom` 跟着改（容器高度是它撑的）。
					{
						const svgEl = host.querySelector('svg');
						const wraps = Array.from(host.querySelectorAll('svg g.abcjs-staff-wrapper'));
						if (svgEl && wraps.length) {
							let inkL = Infinity;
							let inkR = -Infinity;
							const acc = (el: Element) => {
								const b = (el as SVGGraphicsElement).getBBox();
								inkL = Math.min(inkL, b.x);
								inkR = Math.max(inkR, b.x + b.width);
							};
							wraps.forEach(acc);
							host.querySelectorAll('svg g.abcjs-meta-top').forEach(acc);
							const vb = (svgEl.getAttribute('viewBox') || '').split(/\s+/).map(Number);
							const want = inkR + inkL; // 左边距 = inkL ⇒ 右边也留同样多
							if (vb.length === 4 && Number.isFinite(want) && want > 10 && Math.abs(want - vb[2]) > 2) {
								svgEl.setAttribute('viewBox', `${vb[0]} ${vb[1]} ${want.toFixed(2)} ${vb[3]}`);
								host.style.paddingBottom = `${((vb[3] / want) * 100).toFixed(4)}%`;
							}
						}
					}
					engraveDigits(host);
					// Bravura 是异步加载的：第一次可能量不到（已退回正文数字）→ 字体**真正可用**后补一次
					if (!host.dataset.abcTempoFontReady) {
						host.dataset.abcTempoFontReady = '1';
						whenBravuraReady(() => engraveDigits(host));
					}
					// 布局宽度由 `abcStaffWidth` 决定：≥600 跟容器走，<600 恒为 600（窄屏只缩放、不改形状）
					return abcLineCounts(host);
				};
				try {
					let rows = draw(n, 1);
					// ② 出现「一行一小节」→ 允许**换一次** n（挤进上一行 n+1 优先，其次放一节下来 n−1），
					//    换完锁定 —— 之后整个缩放过程都不再换行（用户：「开始缩放之后就不要再继续换行了」）。
					// 折行完全交给**源码换行**（2026-10-02 用户：「abc 和 jianpu 都改成按原码行换行吧」）：
					// 不传 `wrap` 时 abcjs 就按源码行排，而且会把每行拉齐（行宽统一）；
					// 传了它会改用「按宽度自适应」折行 —— 每行小节数会变成 2/2/3/2/1/2/3/2 这种参差、行宽也不齐，
					// 而且 `preferredMeasuresPerLine` 与 `$` 强制换行都左右不了它（都实测过）。
					draw(n, 1);
				} catch (err) {
					console.error('abcjs render failed:', err);
				}
			};
			// ⚠️ 切换组件里被隐藏的那块不渲染：display:none 的容器量不到宽度（abcjs 会按错宽度排版）
			//    它由切换器在「被显示」时通过 window.__scoreRender.abc 调起渲染
			const isVisible = (h: HTMLElement) => !!h.offsetParent;
			const renderAll = () => hosts.forEach((h) => {
				if (isVisible(h)) renderOne(h);
			});
			renderAll();
			(window as any).__scoreRender = Object.assign((window as any).__scoreRender || {}, { abc: renderOne });
			// `responsive: 'resize'` 时 abcjs 会自己重画（不经过 renderOne）→ 补一遍拍号数字；
			// 但它重画时用的还是**旧的 staffwidth**（只是把 SVG 缩放）→ 宽度变了要自己按新宽度重新分句。
			// ⚠️ **同步执行，不用定时器**（和简谱的 syncJianpuLayout 一个道理）：后台标签页会把定时器/RO 回调
			//    节流到几分钟后，用 debounce 的话窄屏下永远等不到重排。
			// 触发条件：档位变了，或排版宽度比上次宽/窄了 24px 以上（免得每像素都重画）。
			// ⚠️ 谱面窄于 ABC_MIN_STAFF_WIDTH 时排版宽度被冻结成常数 → 这里自然就不会重排，
			//    只剩下 abcjs 的等比缩放（正是「不再动图案，只缩放」）。
			const syncAbcLayout = () => hosts.forEach((h) => {
				if (!h.dataset.abc || !isVisible(h)) return;
				const width = abcStaffWidth(h);
				const prevWidth = Number(h.dataset.abcStaffWidth) || 0;
				if (String(abcTierFor(width)) !== h.dataset.abcTier || Math.abs(prevWidth - width) >= 24) renderOne(h);
				else engraveDigits(h); // abcjs 自己重画会把刻字冲掉，补回来
			});
			window.addEventListener('resize', syncAbcLayout);
			if ('ResizeObserver' in window) {
				const ro = new ResizeObserver(() => syncAbcLayout());
				hosts.forEach((h) => ro.observe(h));
			}
			// 从后台切回前台时立刻校一次（RO / resize 在后台可能被节流，补一刀）
			document.addEventListener('visibilitychange', () => {
				if (!document.hidden) syncAbcLayout();
			});
			// 主题变化 → 用新主题色重绘（renderAbc 会清空容器重画，无残留）
			// ⚠️ 隐藏那块（切换组件里没显示的那个）**不能就地重绘**（量不到宽度，会按错宽度排版），
			//    但也不能不理它：它的颜色是 abcjs 在渲染时**烧进 SVG** 的（foregroundColor），
			//    改成暗色后它仍是旧的黑色，等切换器把它显示出来时因为已经 is-rendered 就不会再画了。
			//    → 这里把它的 is-rendered 摘掉当作「作废」，切换器显示它时会按当前主题重绘。
			let lastTheme = document.documentElement.getAttribute('data-theme');
			new MutationObserver(() => {
				const theme = document.documentElement.getAttribute('data-theme');
				if (theme && theme !== lastTheme) {
					lastTheme = theme;
					hosts.forEach((h) => {
						if (isVisible(h)) renderOne(h);
						else if (h.classList.contains('is-rendered')) h.classList.remove('is-rendered');
					});
				}
			}).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
		}
		initAbcScores();
	</script>

	<script>
		import { bravuraDigitMetrics, bravuraDigitSize, drawBravuraDigits, whenBravuraReady } from '../lib/bravura-digits';

		// 🎼 简谱渲染（simple-notation）：仅当本页存在 .jianpu-score 时才动态加载（代码分割，不污染其他页）。
		// 围栏内容：可选头部行 title/composer/key/beat/time/tempo/lyric/wrap:…（另认已废的 `lyricist`，只消费不画），其余行为谱面文本。
		// wrap: 每行小节数（默认按容器宽度自动分句；写 off 表示完全按手写换行）
		const JIANPU_PER_LINE_WIDE = 680; // 谱宽 ≥ 它 → 每行 4 小节
		const JIANPU_PER_LINE_MID = 480; // 谱宽 ≥ 它（且 < WIDE）→ 每行 3 小节；再窄 → 2 小节
		const JIANPU_BAR_SHRINK = 16; // 小节线/终止线**总共**收窄多少像素（库默认 40px 高 → 40−16 = 24px；上下各收 8）
		const JIANPU_BAR_RAISE = 2; // 小节线（含反复记号/终止线）整体再上移的像素（用户：「所有小节线都向上移一点点」）
		const JIANPU_DOT_SPAN = 10; // 反复记号两个点之间的距离（库默认 20px，太散）
		const JIANPU_TIE_DROP = 7.5; // 连音线整体下移的像素（弧顶由此贴近音符；实测留 ~4px 净空，再大就会碰到数字顶）
		const JIANPU_TIE_DOT_GAP = 3; // 下方音符有高音点（八度点）时，连音线抬到「点顶上方」留的净空
		const JIANPU_ACC_CENTER_DROP = 0; // 变音记号**墨迹中心**落在「数字墨迹顶部往下、数字墨迹高度的 40%」处
		//                                   （＝数字左上角；0 = 与数字顶齐，0.5 = 与数字中心齐）
		const JIANPU_REPEAT_DOT_GAP = 2; // 反复记号圆点近侧边缘距竖线的净空（库给 `:|` 的是 ~10px，太开）
		const JIANPU_VOLTA_DX = 0; // 小房子左端对齐到「该小节第一个音符的墨迹左端」后，再额外右移的量（微调用）
		const JIANPU_VOLTA_LABEL_DX = -4; // 房子里的序号（1./2.）再往里挪的像素（库画得贴左竖线：实测墨迹左端距竖线 10.1px）
		const JIANPU_VOLTA_DY = 8; // 反复「小房子」下移的像素
		const JIANPU_LINE_MARGIN = 24; // 每行首末墨迹距谱面左右边缘的留白（左右对称）
		const JIANPU_MIN_NOTE_GAP = 14; // ⚠️ 已不用（那是旧的「密度降档」判据，`perLine` 恒为 0 后入口就不成立了）；现在用下面两个常量
		/** 音符间的**平均**间距低于它就**冻结排版宽度**（2026-10-02 用户：「到了那个阈值之后谱子形状就不变了，
		 *  转而只进行整体适配宽度的显示」）—— 谱面就按当时那个宽度定死，之后容器再宽再窄都只做整体等比缩放。 */
		/** 布局宽度下限：**≥600 跟容器走；<600 恒按 600 排**（用户 2026-10-02：「屏幕宽度大于等于 600 时原样按照宽度排，小于 600 了立刻冻结到 600px 的样式不动了」）*/
		const JIANPU_MIN_LAYOUT_WIDTH = 550;
