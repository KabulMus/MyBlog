		//                               收窄 26px = 信息行以下整块上提 26px（谱面跟着上提，viewBox 自动变矮）。
		const JIANPU_INFO_H_DEF = 120; // 库默认的信息带高度（仅作参考：库就是按这个高度把标题摆在带子正中的）
		const JIANPU_INFO_TOP_RATIO = 0.5; // 信息块上方留白占「可用空白」的比例（0.5 = 居中；越小越往上靠）
		const JIANPU_CONTENT_PAD_TOP = 20; // 库的 `content.padding` 纵向值（谱首上边留白）；下面「收空白」时拿它当基准
		const JIANPU_HEAD_GAP = 5; // 谱首最后一行墨迹 → 谱面第一行墨迹的净空（有标题没信息时，谱面就贴到标题下头）
		const JIANPU_BEAT_SPLIT = 9; // 拍号退路（正文数字）时，两根本线各偏离基线多少
		//                             （数字墨迹高 ≈0.7em，两根差 2×9=18 → 中间 6.8px 净空、分数线居中各留 3.4px）
		const JIANPU_BEAT_BAR_ASC = 0.35; // 分数线在基线上方多少 em（= 数字墨迹高 0.7em 的一半 → 正好落在两数字正中）
		const JIANPU_BEAT_BAR_GAP = 2.5; // Bravura 数字墨迹与分数线之间的净空（用字形墨迹量出来的精确值）
		const JIANPU_KEY_ACC_DX = 1.6; // 调号里升降号 Bravura 字形与其后字母之间再拉开的间距
		const JIANPU_KEY_ACC_DY = -1.6; // 调号里升降号抬高多少（负 = 上抬）
		const JIANPU_MOD_LIFT = 24; // 谱内转调标记抬到音符基线上方多少（画在行间，不占行内空间）
		const JIANPU_MOD_SIZE = 16; // 谱内转调标记（`1 = X`）的字号：比信息区那行（JIANPU_INFO_SIZE）小一点（用户要求）
		const JIANPU_MOD_GAP = 2; // 谱内转调标记与周围墨迹之间要留的净空（横向相交的元素才算障碍）
		const JIANPU_MOD_DX = 0; // 谱内转调标记的**左右位置**：换调点那个音符的**墨迹左端** + 本值（负 = 往左）
		const JIANPU_MOD_SHIFT = 10; // 上面那个位置**放不下**时最多再横着挪多少像素（改成 0 = 绝不横移，永远按 JIANPU_MOD_DX 摆）
		//                              ⚠️ 谱宽 = SVG viewBox 宽，**随容器变**（436/636/696/736/800…）→ 不能写死绝对 x
		const JIANPU_GRACE_GAP = 0; // 倚音墨迹右端距主数字墨迹左端的净空
		const JIANPU_GRACE_ABOVE = 2; // 倚音墨迹底部距主数字墨迹顶部的净空
		const JIANPU_GRACE_STEP = 2.5; // 一组多个倚音时，相邻倚音**墨迹**之间的净空（库的 8px 锚点间距会挤在一起）
		const JIANPU_GRACE_ARC_RATIO = 0.15; // 倚音引导线中部最大厚度 = **弦长 × 该比例**（线短就细：这条弦长 7.09 → 约 1.06px；
		//                                      连音线是固定 2.4px 但弦长 23px（比例 ≈ 0.1），不能拿绝对值硬套小弧）
		const JIANPU_ACC_SIZE = 12; // 变音记号的字号（库用 12，偏小）
		const JIANPU_ACC_GAP = -1; // 变音记号**墨迹**右端与数字**墨迹**左端之间要留的净空（按 canvas 量的真实墨迹）
		const JIANPU_TIE_NEST_GAP = 3.5; // 连音线套连音线时，外层弧下缘与内层弧上缘之间的净空（2026-09-12 定的是 7，
		//                                  2026-10-02 收到 3.5：嵌套改成「可以共享端点」后，内层顶点落在外层 86.6% 高度处，
		//                                  这个净空会被 e 除法放大 ⇒ 7 时外层鼓得很高（用户：「外层太高了」）
		const JIANPU_TIE_THICK = 2.4; // 连音线中间最大厚度（两端收成尖，纺锤形填充）
		const JIANPU_TRIPLET_LABEL_GAP = 2; // 嵌在弧缺口里的数字：墨迹底端距弦线的净空（2026-10-01 由 4 下移到 2，用户：「数字稍微往下一点」）
		const JIANPU_TRIPLET_LABEL_SIZE = 14; // `3` 的目标字号（对照衬线数字的墨迹高；Bravura 数字要 ×1.4 才有同样墨迹）
		const JIANPU_TRIPLET_SPLIT_GAP = 2.5; // 圆滑线在中间为数字让出的缺口：数字墨迹两侧各再留这么多
		const JIANPU_DOT_GAP = -0.7; // 附点的**墨迹左端**距数字**墨迹右端**的净空（负 = 轻微压进数字边界；用户认可的视觉）
		const JIANPU_UNDERLINE_RIM = 1.5; // 减时线两端超出音符墨迹的长度（固定，不再被 justify 的拉伸系数乘大）
		const JIANPU_UNDERLINE_JOIN = 2; // 同层两条减时线首尾相差这么多以内就并成一条（库在拍之间会留 ~6px 缝）
		const JIANPU_GRACE_BEAM_JOIN = 4; // 倚音减时线：倚音之间本来就只留 ~2.5px 墨迹净空，缝 ≤ 这个值就算相接
		const JIANPU_GRACE_DOT_DROP = 7.5; // 倚音八度点**中心**距倚音基线（跟主音符那套一致：库给主音符的点就是「基线 + 7.5」= 减时线下方 4.5px）
		const JIANPU_GRACE_ARC_DOT_GAP = 1; // 倚音引导弧要为低音点让出的净空（弧的整体下移基准取「减时线」与「点底」里更靠下的那个）
		const JIANPU_BAR_PAIR_GAP = 8; // 离反复/终止线的粗线这么近的细线跟它同组，不单独挪
		const JIANPU_REPEAT_DOT_NEAR = 12; // 反复号的圆点离竖线这么近就算它那一组的（一起挪）

		/**
		 * 解析围栏源码 → { info, lyric, score }
		 *
		 * 头部字段：站点全称（`title / composer / key / beat / time / len / tempo / lyric / wrap`，
		 * 另认已经废掉的 `lyricist`——只消费不画）
		 * ＋**与 abc 对齐的单字母别名**：`T:` `C:` `K:` `M:` `L:` `Q:` `W:`（`M: 2/4` / `beat: 2/4` / `time: 2/4`
		 * 都是「分数式拍号」，一行顶过去 `beat:` + `time:` 两行；
		 * `L: 1/8` = `len: 8`，`Q: 90` / `Q: 1/4=90` = `tempo: 90`，`W:` = `lyric:`）。后写的覆盖先写的。
		 */
		function parseJianpuSource(raw: string) {
			const info: Record<string, string> = {};
			const lyricLines: string[] = [];
			// 正文行（每行带上「这一行的换调」：`K: X` 单独一行时挂到它后面第一个正文行上）
			// `inlAt` = 行内那个换调记号落在这一行的第几个小节（−1 = 这一行没有行内换调）
			const bodyRows: { text: string; mod: string | null; inl: string | null; inlAt: number }[] = [];
			let pendingMod: string | null = null;
			let bodyStarted = false;
			/**
			 * 正文行 → 把行内的换调记号摘出来（方括号 `[K: G]` 与裸写的 `K: G` 都认）：这一行从中途起换调。
			 * ⚠️ 还要记下它前面有几条小节线（= 它在第几个小节）—— 标记要画在**换调点那个小节**上方，
			 *    光知道「这一行要换调」不够（否则永远画在行首，用户实测报过「1 = F 怎么在行首了」）。
			 */
			const takeInlineMod = (line: string) => {
				let key: string | null = null;
				let at = -1;
				const text = line.replace(/\[\s*[Kk]:\s*([A-Ga-g](?:#|b|min)?)\s*\]|(^|[\s|])[Kk]:\s*([A-Ga-g](?:#|b|min)?)(?=\s|\||$)/g, (_all: string, k1: string, pre: string, k2: string, offset: number, src: string) => {
					if (!key) {
						key = k1 || k2;
						at = (src.slice(0, offset).match(/\|\]|\|\||\|/g) || []).length;
					}
					return pre || '';
				});
				return { text, key, at };
			};
			/** 单字母别名 → 全称（对齐 abc：T 标题 / C 作曲 / K 调号 / M 拍号 / L 默认时值 / Q 速度 / W 歌词） */
			const ALIAS: Record<string, string> = { t: 'title', c: 'composer', k: 'key', m: 'beat', l: 'len', q: 'tempo', w: 'lyric' };
			const KNOWN = ['title', 'composer', 'lyricist', 'key', 'beat', 'time', 'len', 'tempo', 'lyric', 'wrap']; // `lyricist` 已废：只认不画
			raw.split('\n').forEach((line) => {
				const m = /^([A-Za-z]+)\s*[:：]\s*(.*)$/.exec(line.trim());
				if (!m) {
					const { text, key: inlineKey, at: inlineAt } = takeInlineMod(line);
					if (text.trim()) {
						bodyStarted = true;
						bodyRows.push({ text, mod: pendingMod, inl: inlineKey, inlAt: inlineAt });
						pendingMod = null;
					}
					return;
				}
				const rawKey = m[1];
				const key = rawKey.length === 1 ? ALIAS[rawKey.toLowerCase()] ?? rawKey.toLowerCase() : rawKey.toLowerCase();
				if (!KNOWN.includes(key)) {
					bodyStarted = true;
					const { text, key: inlineKey, at: inlineAt } = takeInlineMod(line);
					bodyRows.push({ text, mod: pendingMod, inl: inlineKey, inlAt: inlineAt }); // 认不出的键（`X:` / `R:` 之类）当正文，交给归一丢字符
					pendingMod = null;
					return;
				}
				const value = m[2].trim();
				// ⚠️ **正文开始之后**写的 `K:` / `key:` = **谱内转调**（2026-10-02 用户要求），不再是头部字段：
				//    记在「下一个正文行」上，由 `planJianpuBars` 在那一行前强制断行、渲染时在行首画「1 = X」。
				//    ⚠️ 只认**纯调名**（`G` / `Bb` / `C#` / `Emin`）：别的东西（`K: 转G调`）当正文行，
				//       免得把一行谱子整行吃掉。
				if (bodyStarted && key === 'key' && /^[A-Ga-g](#|b|min)?$/.test(value)) {
					pendingMod = value;
					return;
				}
				if (bodyStarted && key === 'key') {
					const { text, key: inlineKey, at: inlineAt } = takeInlineMod(line);
					bodyRows.push({ text, mod: pendingMod, inl: inlineKey, inlAt: inlineAt });
					pendingMod = null;
					return;
				}
				if (key === 'lyric') {
					lyricLines.push(m[2]);
					return;
				}
				// 拍号写成**分数**：`M: 2/4`（也认 `beat: 2/4` / `time: 2/4`）—— 分子 = 每小节几拍、分母 = 以几分音符为一拍
				if ((key === 'beat' || key === 'time') && /^\d+\s*\/\s*\d+$/.test(value)) {
					const [b, t] = value.split('/').map((v) => v.trim());
					info.beat = b;
					info.time = t;
					return;
				}
				// 默认时值：`L: 1/8` 与 `L: 8` / `len: 8` 等价
				if (key === 'len') {
					const n = /(\d+)\s*$/.exec(value);
					if (n) info.len = n[1];
					return;
				}
				// 速度：`Q: 90` 或 `Q: 1/4=90`（后者顺带告诉库「一拍 = 四分音符」，没写 time 时才采用）
				if (key === 'tempo') {
					const q = /^(?:(\d+)\s*\/\s*(\d+)\s*=\s*)?(\d+)\s*$/.exec(value);
					if (!q) return;
					if (q[2] && !info.time) info.time = q[2];
					info.tempo = q[3];
					return;
				}
				info[key] = value;
			});
			return { info, lyric: lyricLines.join('\n'), score: bodyRows.map((r) => r.text).join('\n').trim(), bodyRows };
		}

		/**
		 * 每行放几小节 —— **默认 0 = 按原码行换行**（2026-10-02 用户：「abc 和 jianpu 都改成按原码行换行吧」）。
		 * `wrap: N` 仍可手动指定每行几小节；`wrap: off` 与默认等价（都是 0）。
		 */
		function measuresPerLine(host: HTMLElement) {
			const override = (host.dataset.jianpuWrap || '').trim().toLowerCase();
			if (override === 'off' || override === '0') return 0;
			if (/^\d+$/.test(override) && +override > 0) return +override;
			return 0;
		}

		/**
		 * 各行「**平均**音符间距」里最小的那个（判「挤不挤」用）。
		 * ⚠️ 用**平均**而不是最小：小节里的十六分对间距天生就小（实测 8.7px），拿最小值当判据的话
		 *    再怎么降档都过不了（一个 4/4 小节里 16 个音符，行宽全给它也还是 8.7）—— 那量的是「谱子本身多密」，
		 *    不是「这行排得松不松」。平均间距 = 行宽 / 音符数，讲的才是「每个音符分到多宽」。
		 * ⚠️ 量的是音符数字的 `x`（= 数字中心），必须在 ⑪ justify 之后量（那才是最终位置）。
		 */
		function jianpuNoteGap(host: HTMLElement): number {
			const svg = host.querySelector('svg');
			if (!svg) return Infinity;
			let min = Infinity;
			svg.querySelectorAll('g[sn-tag^="stave-"]').forEach((st) => {
				const xs = Array.from(st.querySelectorAll('g[sn-tag^="note-"] text[font-size="18"]'))
					.map((t) => parseFloat(t.getAttribute('x') || 'NaN'))
					.filter(Number.isFinite)
					.sort((a, b) => a - b);
				if (xs.length < 2) return;
				min = Math.min(min, (xs[xs.length - 1] - xs[0]) / (xs.length - 1));
			});
			return min;
		}

		// （原来那个 `applyJianpuScale` 已删：缩字号/缩 viewBox 都不是用户要的，他要的是「冻结排版宽度 + 整体缩放」）

		/**
		 * 谱面结构：**每行的小节 + 每条小节线后面的记号**（记号 = 原文里的 `|` / `||` / `|]`；null = 没写）。
		 *
		 * 一份结构两处用：① 拼给库的谱面（小节间单竖线、换行 = 乐句）；② `shapeJianpuBarlines`
		 * 照它把库画出来的线一条条对上记号（库给每行末尾都补一根粗线，那根不属于任何小节）。
		 *
		 * 分句：按**固定小节数**切行，手写换行不再当硬边界（想保留就用 `wrap: off`）。
		 * ⚠️ 库不会自动折行：完全不换行的话整首歌会被塞进一行，音符间距会被压到几个像素。
		 * ⚠️ **最后一行不能只剩 1 小节**（用户要求：要么没有剩余，要么至少剩 2 个）⇒ 余 1 节时
		 *    并进**当前这一行**（那行变 perLine+1 小节，音符排紧一点）。只有总数就 1 节时才真的只剩 1 节。
		 * ⚠️ **换调点不参与断行**（2026-10-02 用户要求删掉原先那条「带换调标记的小节强制开新行」）：带 `mod` / `inl`
		 *    的小节照常按 `perLine` 折行，换调标记跟着那个小节走，位置由 `modAt`（该行里第几个小节）记下来。
		 */
		function planJianpuBars(rowsIn: { text: string; mod: string | null; inl: string | null; inlAt: number }[], perLine: number) {
			const parsed = rowsIn
				.map((r) => {
					const measures: string[] = [];
					const tokens: (string | null)[] = [];
					const parts = (r.text || '').trim().split(/(\|\]|\|\||\|)/);
					for (let i = 0; i < parts.length; i += 2) {
						const body = (parts[i] || '').trim();
						if (!body) continue;
						measures.push(body);
						tokens.push(i + 1 < parts.length ? parts[i + 1] : null);
					}
					// 换调落在该行的第几个小节：`K: X` 单独一行的从行首起算（0），写在行内的用它记下的位置
					return { measures, tokens, mod: r.mod, inl: r.inl, inlAt: r.inlAt, modAt: r.mod ? 0 : r.inlAt };
				})
				.filter((r) => r.measures.length);
			// 手写换行处（= 乐句边界）没写记号的话补 `|`：换行本来就意味着有条线；最后一个不补
			parsed.forEach((row, ri) => {
				const lastIdx = row.tokens.length - 1;
				if (ri < parsed.length - 1 && row.tokens[lastIdx] === null) row.tokens[lastIdx] = '|';
			});
			if (!perLine || perLine < 1) return parsed; // wrap: off → 手写换行就是行
			// 把所有行拉平成一串（小节 + 记号 + 换调），再按 perLine 切行；换调只挂在它那一行的第一个小节上
			const flat: { m: string; t: string | null; mod: string | null; inl: string | null }[] = [];
			parsed.forEach((row) => {
				row.measures.forEach((m, i) => flat.push({ m, t: row.tokens[i], mod: i === 0 ? row.mod : null, inl: i === row.inlAt ? row.inl : null }));
			});
			const rows: { measures: string[]; tokens: (string | null)[]; mod: string | null; inl: string | null; modAt: number }[] = [];
			let at = 0;
			while (at < flat.length) {
				const left = flat.length - at;
				let take = Math.min(perLine, left);
				if (left - take === 1) take = Math.min(perLine + 1, left); // 余 1 节⇒并进这一行（「挤进去」）
				const seg = flat.slice(at, at + take);
				// 换调点落在这一行的第几个小节（没有就是 −1）；标记就画在那个小节上方
				const modAt = seg.findIndex((f) => f.mod || f.inl);
				rows.push({
					measures: seg.map((f) => f.m),
					tokens: seg.map((f) => f.t),
					mod: modAt >= 0 ? seg[modAt].mod : null,
					inl: modAt >= 0 ? seg[modAt].inl : null,
					modAt,
				});
				at += take;
			}
			return rows;
		}

		/** `len:` 允许的默认时值（分母：4 = 四分音符，8 = 八分音符…） */
		const JIANPU_LEN_DENS = [1, 2, 4, 8, 16, 32];
		/** 库能**单独画出来**的短时值（单位 = 四分音符）→ 音级后面的后缀。凑不出精确值时取最近的一档 */
		const JIANPU_SHORT_DURS: [number, string][] = [
			[0.125, '/32'],
			[0.1875, '/32.'],
			[0.25, '/16'],
			[0.375, '/16.'],
			[0.5, '/8'],
			[0.75, '/8.'],
			[1, ''],
			[1.5, '.'],
		];

		/**
		 * 音符写法归一：作者写的写法 → 库认的写法（**原文不动**，磁盘/编辑器里还是你敲的）。
		 *
		 * 音高：音级 `1`-`7`、休止 `0` 或 `z`、延长 `-`
		 * 顺序：**变音记号 → 音级 → 八度 → 时值 → 附点**，例 `#6,/8.`
		 *   · 变音记号 `#`（升）/ `b`（降）/ `=`（**还原号**，可叠）；八度 `,` 低 / `'` 高（abc 的写法），`_`/`^` 是库自己的写法、也认
		 *   · 时值都相对**默认时值 L**（围栏 `len:`，不写 = 四分音符）：`/`（可叠）减半、`*N`（N 可省 = 2）倍长、
		 *     `.` 附点、`>` / `<` 附点节奏对（同 abc）、`-` = **一拍**（绝对量、加法）
		 * 分隔符 = **空白**（逗号不当分隔符）
		 * 记号（都跟 abc 对齐）：
		 *   · `(1 2 3)` = **圆滑线 / 连音线**（库的连音线写法，弧线不管音高、能跨小节）
		 *   · `[1.]` `[2.]` = **小房子**（也认 `[1` / `[1]`；库老写法的 `{1.}` 已不接受，花括号只当倚音 / 换气符）
		 *   · `{5 6}` = **倚音**；`{v}` / `!breath!` = 换气符；其它 `{Dm7}` 这类和弦名整段丢掉
		 *   · `t3[1 2 3]` = **连音组**（`t` + 个数 2…9，如 `t3[1 2 3]` 三连音、`t5[...]` 五连音；组的边界是方括号，
		 *     圆括号留给圆滑线 ⇒ `t3[21(1] 1)` 能让组末音与后面的音连起来）
		 * ⚠️ 交给库的只有两种时值写法：**整拍及以上 = 裸音级 + `-`**（一拍一个破折号，简谱惯例）；
		 *    **不足一拍 = `/N`**（附点值 `/N.`）。凑不出精确时值（如 L=8 时 `*5/`）就近取整。
		 * ⚠️ 库只认 `#`/`b`（`parseNote` 里按个数相加）⇒ `=` 先按 `#` 发给库（保证有字形、时值权重也与升号一致），
		 *    画出来再按「记号出现顺序」把字形换成还原号（见 `applyJianpuNaturals`）。这里把下标记进 `naturals`。
		 * ⚠️ 换行不能碰（那是乐句边界）、`|` 系列小节线也不能碰 ⇒ 按行处理。
		 * ⚠️ 认不出的字符直接丢掉 —— 以前会原样透传给库，变成垃圾音/报错音。
		 */
		function normalizeJianpuNotes(score: string, lenDen: number, tuplets: string[] = [], naturals: number[] = [], graceAccs: string[] = [], glueLines?: (boolean[] | null)[], slurPairs?: [number, number][]) {
			const base = 4 / (JIANPU_LEN_DENS.includes(lenDen) ? lenDen : 4); // 默认时值（单位 = 四分音符）
			/** 已发出去的音符里，带变音记号的那个的序号（0 起）—— `naturals` 记的是它的下标 */
			let accIndex = 0;
			/**
			 * 从 `i` 处读一个音：`[#b]*` + 音级（或 `-`/`z`）+ 八度（`,`/`'`/`^`/`_`）+ 时值（`*N` / `/`·叠）+ 附点。
			 * 读不出音就返回 null（调用方接着看别的记号）。
			 */
			const readNote = (s: string, i: number) => {
				const start = i;
				let accidental = '';
				while (i < s.length && (s[i] === '#' || s[i] === 'b' || s[i] === '=')) accidental += s[i++];
				const ch = s[i];
				if (ch === undefined || (!/\d/.test(ch) && ch !== '-' && ch !== 'z' && ch !== 'Z')) return null;
				const head = ch === 'z' || ch === 'Z' ? '0' : ch; // `z` = 休止符（跟 abc 一样），库写 `0`
				i++;
				let oct = '';
				let mult = 1;
				let halves = 0;
				let dot = false;
				for (;;) {
					const c = s[i];
					if (c === ',' || c === '^' || c === '_' || c === "'" || c === '\u2019') {
						// `,` = 低八度（跟 abc 一样）、`'` = 高八度（abc 的写法）、`_`/`^` = 库自己的写法
						oct += c === '_' || c === ',' ? '_' : '^';
						i++;
						continue;
					}
					if (c === '*') {
						i++;
						let digits = '';
						while (i < s.length && /\d/.test(s[i])) digits += s[i++];
						mult *= digits ? parseInt(digits, 10) : 2;
						continue;
					}
					if (c === '/') {
						halves++;
						i++;
						continue;
					}
					if (c === '.' && !dot) {
						dot = true;
						i++;
						continue;
					}
					break;
				}
				if (i === start) return null;
				return { accidental, head, oct, mult: mult || 1, halves, dot, end: i };
			};
			/** 一段文本 → 音符 token 数组（调用方用 `,` 连起来就是库的写法） */
			/** ⚠️ `grace` = 这段是倚音：库**不画**倚音上的变音记号（实测 `{#5 6}` 只出两个裸数字）⇒ 下标不能算它，
			 *  否则后面所有记号都会错位一位；连音组在倚音里时照样继承这个标记。 */
			/** 全局音符序号（跨行累加）、等着配对的圆滑线起点（FIFO：第 k 个 `(` 配第 k 个 `)`） */
			let noteSeq = 0;
			const slurOpen: number[] = [];
			const scan = (text: string, grace = false, glueOut?: boolean[], count = true): string[] => {
				const tokens: string[] = [];
				/** 正在等的那个音跟**前一个音**之间是不是隔着空白 —— 减时线要不要跟前一条连起来就看它 */
				let pendingGap = true;
				/** 已解析、还没吐出的音（等 `>` / `<` 定倍率；`gap` = 它与前一个音之间的空白快照） */
				let pending: { text: string; oct: string; q: number; suffix: string; isDash: boolean; gap: boolean } | null = null;
				let prefix = ''; // 下一个音符的前缀（`[` / `(` / `<5 6>` / `{v}`）
				let ratio = 1; // `>` / `<` 给**下一个**音的倍率
				/** 吐一个 token；`joined` = 它跟**前一个 token** 紧挨着（`|` / `:` 不算音，不进 glue） */
				const push = (tok: string, joined: boolean) => {
					tokens.push(tok);
					glueOut?.push(joined);
					if (count) noteSeq++;
				};
				/** 按最终时值 q 把音吐出来（`-` 展开出来的那几根跟前一个音算紧挨着） */
				const emit = (rec: { text: string; oct: string; suffix: string; isDash: boolean; gap: boolean }, q: number) => {
					if (rec.isDash) {
						// 延长线：一拍一根（`-` 是一拍，不是一份 L）
						const n = Math.max(1, Math.round(q));
						push(prefix + rec.text + rec.suffix, !rec.gap);
						for (let k = 1; k < n; k++) push('-', true);
						prefix = '';
						return;
					}
					if (q > 1.5) {
						// 一拍半以上（且不是附点值）⇒ 就近取整拍，用 `-` 铺
						const n = Math.max(1, Math.round(q));
						push(prefix + rec.text + rec.oct + rec.suffix, !rec.gap);
						for (let k = 1; k < n; k++) push('-', true);
						prefix = '';
						return;
					}
					let best = JIANPU_SHORT_DURS[0];
					let dist = Infinity;
					JIANPU_SHORT_DURS.forEach(([v, suffix]) => {
						const d = Math.abs(v - q);
						if (d < dist) {
							dist = d;
							best = [v, suffix];
						}
					});
					push(prefix + rec.text + best[1] + rec.oct + rec.suffix, !rec.gap);
					prefix = '';
				};
				const flush = () => {
					if (!pending) return;
					const rec = pending;
					pending = null;
					emit(rec, rec.q);
				};
				let i = 0;
				while (i < text.length) {
					const c = text[i];
					if (/\s/.test(c)) {
						pendingGap = true;
						i++; // 空白只是分隔，**先不 flush** —— `>` / `<` 后面还要改前一个音
						continue;
					}
					if (c === '|' || c === ':') {
						flush();
						tokens.push(c);
						pendingGap = true; // 小节线两边天然断开
						i++;
						continue;
					}
					// 花括号 = 倚音 `{5 6}`；`{v}` / `{V}` = 换气符；
					// 其余（`{Dm7}` 这种和弦名）整段丢掉 —— 用户已明确不要和弦功能。
					// ⚠️ 小房子**只认方括号** `[1.]`：库老写法的 `{1.}` 不再接受 —— 原来「纯数字花括号」会被当成小房子，
					//    写 `{5}` 想要倚音却画出个房子（用户实测踩到）。
					// ⚠️ 一律当**后面那个音的前缀**（库就是这么认的：逗号不能插在中间）。
					if (c === '{') {
						const j = text.indexOf('}', i);
						const inner = (j < 0 ? text.slice(i + 1) : text.slice(i + 1, j)).trim();
						i = j < 0 ? text.length : j + 1;
						flush();
						if (/^[vV]$/.test(inner)) prefix += '{v}'; // 换气符
						else if (/\d/.test(inner) && /^[-#b=\d\s,\^_./*()z']*$/.test(inner)) prefix += '<' + scan(inner, true, undefined, false).join(',') + '>'; // 倚音
						continue;
					}
					// 方括号 = 小房子（abc 的写法）：`[1.]` / `[1.` / `[1]`；其余方括号（以前是连音线）丢掉
					if (c === '[') {
						const m = /^\[(\d+)\s*\.?\s*\]?/.exec(text.slice(i));
						flush();
						if (m) {
							prefix += '{' + m[1] + '.}';
							i += m[0].length;
						} else i++;
						continue;
					}
					if (c === ']') {
						i++; // 光杆方括号没有含义了
						continue;
					}
					// 圆括号 = 圆滑线 / 连音线 ⇒ 用库的连音线写法（`(1 2 3)` → `[1,2,3]`，那条弧线不管音高、能跨小节）
					if (c === '(') {
						flush();
						prefix += '[';
						if (count) slurOpen.push(noteSeq); // 起点 = 下一个音符
						i++;
						continue;
					}
					if (c === ')') {
						if (pending) pending.suffix += ']';
						else if (tokens.length) tokens[tokens.length - 1] += ']';
						if (count) {
							// ⚠️ 有新解析出来但还没吐出的音（pending）时，它就是本条圆滑线的终点
							const s = slurOpen.shift();
							const last = pending ? noteSeq : noteSeq - 1;
							if (s !== undefined && last > s) slurPairs?.push([s, last]);
						}
						i++;
						continue;
					}
					// 附点节奏：前一个 ×1.5（`>`）/ ×0.5（`<`），后一个反过来（同 abc 的 `>` `<`）
					if (c === '>' || c === '<') {
						if (pending) pending.q *= c === '>' ? 1.5 : 0.5;
						ratio = c === '>' ? 0.5 : 1.5;
						i++;
						continue;
					}
					// 装饰记号：`!breath!` = 换气符（同 abc），其余（`!trill!` 之类）库不支持 ⇒ 丢掉
					if (c === '!') {
						const j = text.indexOf('!', i + 1);
						const name = (j < 0 ? text.slice(i + 1) : text.slice(i + 1, j)).trim().toLowerCase();
						i = j < 0 ? text.length : j + 1;
						flush();
						if (name === 'breath') prefix += '{v}';
						continue;
					}
					// 连音组 `t3[1 2 3]`（`t` + 个数 2…9：`t3[` 三连音、`t5[` 五连音…）—— 整组当一个 token（库的写法）。
					// ⚠️ **个数前面必须有 `t`**（2026-10-02 用户拍板）：简谱音级本来就是数字，`5(2/3/)` 这种
					//    「音符 + 圆滑线」跟老写法 `5(...)`（五连音）**完全同形**，不加字母根本区分不了。
					// ⚠️ **组的边界用方括号**（同天又改了一版）：圆括号归**圆滑线专用** —— 圆滑线可以写在组内、
					//    甚至跨出组外（`t3[21(1] 1)` = 三连音的末音与后面那个 1 连起来）。用圆括号的话这写法
					//    根本表达不了（组内的 `(` 会跟组的 `)` 配错，要么组提前结束、要么组跑出行外）。
					// ⚠️ 库只认 `3(`（正则写死的）⇒ 交给库时**一律写成 `3(`**，真实数字按出现顺序记进 `tuplets`，
					//    由 `styleJianpuTriplets` 取回来当标签（组内音符不受影响，库本来也不换算连音时值）。
					const tm = /^[tT]([2-9])\[/.exec(text.slice(i, i + 3));
					if (tm) {
						const j = text.indexOf(']', i + 3);
						const inner = text.slice(i + 3, j < 0 ? text.length : j);
						const innerGlue: boolean[] = [];
						// ⚠️⚠️ **必须先 flush**：`scan` 是延迟吐 token 的（`>` / `<` 还能改前一个音），
						//   而组内音符是**立刻**计数的 ⇒ 先扫组内的话，前面那个还没吐出的音（`5 t3[...]`）
						//   就没算进 `noteSeq`，组内音符的全局序号整体少 1（圆滑线端点因此指到前一个音上，
						//   用户：「我连的是三连音最后的 1，显示出来怎么是第二个 1」）。
						flush();
						const members = scan(inner, grace, innerGlue, true);
						// 空组（`5()`）不发 —— 库碰上空组也不会画括号，发了只会让两边的顺序错位
						if (members.length) {
							tuplets.push(tm[1]);
							// ⚠️ 组内的圆滑线标记（`[` / `]`）**不给库**：库那套「一个音最多一个起点/终点」表达不了
							//    （跨出组外的那种更是写都写不进去）⇒ 一律由 `fixJianpuSlurs` 按 `slurPairs` 补画。
							tokens.push('3(' + members.map((mm) => mm.replace(/[[\]]/g, '')).join(',') + ')');
							// 库里这一组会展开成 members.length 个音符 ⇒ glue 按同样的个数摊开（组内成员之间也照原文空格算）
							if (glueOut) members.forEach((_, k) => glueOut.push(k === 0 ? !pendingGap : innerGlue[k]));
							pendingGap = false;
						}
						i = j < 0 ? text.length : j + 1;
						continue;
					}
					const rec = readNote(text, i);
					if (rec) {
						flush();
						const gap = pendingGap; // 这个音跟上一个音之间有没有空白，在此刻定下来
						pendingGap = false;
						// 变音记号：库只认 `#`/`b`（`=` 它会当不存在直接忽略）⇒ `=` 先按 `#` 发过去，
						// 画出来再按「记号出现顺序」换字形（下标记进 `naturals`，见 applyJianpuNaturals）
						if (rec.accidental) {
							// 库只会在「音级（不是休止/延长）且升降个数不相互抵消」时画记号，下标得跟它一致
							const libAcc = rec.accidental.replace(/=/g, '#');
							const net = (libAcc.match(/#/g) || []).length - (libAcc.match(/b/g) || []).length;
							if (!grace && net !== 0 && rec.head !== '0' && rec.head !== '-') {
								if (rec.accidental.includes('=')) naturals.push(accIndex);
								accIndex++;
							}
						}
						// 倚音的记号库**根本不画**（`drawGraceNote` 里不调 `drawUpDownCount`）⇒ 按倚音顺序逐个记下来，
						// 渲染后由 `drawJianpuGraceAccidentals` 照库的比例自己补字形（空串 = 这个倚音没记号）
						if (grace) graceAccs.push(rec.accidental);
						pending = {
							text: rec.accidental.replace(/=/g, '#') + rec.head,
							oct: rec.head === '-' ? '' : rec.oct,
							q: (rec.mult / 2 ** rec.halves) * (rec.dot ? 1.5 : 1) * (rec.head === '-' ? 1 : base) * ratio,
							suffix: '',
							isDash: rec.head === '-',
							gap,
						};
						ratio = 1; // `>` / `<` 给的倍率只作用在它后面那一个音上
						i = rec.end;
						continue;
					}
					flush();
					i++; // 认不出的字符直接丢掉（以前会当一个音符 token 发给库 ⇒ 变成垃圾音）
				}
				flush();
				return tokens;
			};
			return score
				.split('\n')
				.map((line) => {
					const glue: boolean[] = [];
					let out = scan(line, false, glue).join(',');
					out = out.replace(/,+/g, ','); // 多个逗号并一个
					out = out.replace(/,(?=\||\])/g, '').replace(/([|\[]),/g, '$1'); // 紧贴小节线的逗号收掉
					glueLines?.push(glue);
					return out.replace(/^,+|,+$/g, '');
				})
				.join('\n');
		}

		/**
		 * 去掉库默认绘制、但我们不需要的两处元素：
		 *  ① 小节号：小节线正上方的小号数字（库把每个小节包在 g[sn-tag="measure-N"] 里，其中直接子 text 就是序号）
		 *  ② 谱首小节线：每个乐句最左边那条起始小节线（乐句以小节线起头属于多余）
		 */
		function cleanJianpuSvg(host: HTMLElement) {
			const svg = host.querySelector('svg');
			if (!svg) return;
			// ① 小节号
			svg.querySelectorAll('g[sn-tag^="measure-"] > text').forEach((t) => t.remove());
			// ② 谱首小节线：乐句 = 同时含「小节线」和「小节分组」的 <g>；删除其中最左那条 line
			// ⚠️ 反复记号（|: / :|）本身就是「两条挨很近的竖线 + 两个点」画在乐句最左边，
			//    且那条粗线（stroke-width=3）会是最左的一条——直接删最左会把反复号削掉一半
			//    （实测：反复号只剩细线 + 两个点，看着就是个残缺的记号）。
			//    判定：只有「最左线是细线（sw≤1）」且「10px 内没有第二条竖线」（排除成对竖线）时才删。
			const x1 = (l: Element) => parseFloat(l.getAttribute('x1') || 'Infinity');
			Array.from(svg.querySelectorAll('g')).forEach((g) => {
				const kids = Array.from(g.children);
				const lines = kids.filter((c) => c.tagName.toLowerCase() === 'line');
				// 只处理乐句容器（同时有小节线和小节分组），避开外层 score / info 分组
				if (!lines.length || !kids.some((c) => (c.getAttribute('sn-tag') || '').startsWith('measure-'))) return;
				const leftmost = lines.reduce((a, b) => (x1(b) < x1(a) ? b : a));
				const sw = parseFloat(leftmost.getAttribute('stroke-width') || '1');
				const paired = lines.some((l) => l !== leftmost && Math.abs(x1(l) - x1(leftmost)) < 10);
				if (sw <= 1 && !paired) leftmost.remove();
			});
		}

		/**
		 * 调号里的升降号改用 **Bravura** 字形（用户要求，跟音符上的变音记号同一套），并抬高一点、
		 * 与后面的字母拉开间距。
		 *
		 * 库 `drawMusicInfo` 是直接 append 普通文本节点的：`♯`(U+266F) / `♭`(U+266D)，
		 * 跟着谱面正文的衬线栈（Source Serif 4 / Noto Serif SC）走 —— 与音符上那批用的是
		 * Bravura 私用区（ED60～ED64）不是同一套字形。
		 * ⚠️ 必须**换码位**：Bravura 子集是从库引用到的 17 个码位里裁出来的，**不含 U+266D/266F**
		 *   → 换成 `ED60`(♭) / `ED62`(♯)，再包一个 `font-family="Bravura"` 的 tspan。
		 * ⚠️ `dy` 在 SVG 文本里是**累加**的：记号抬高后，后面那个兄弟节点会跟着上移 →
		 *   必须给它补一个相反的 `dy`（同时用 `dx` 拉开间距）。实测在记号后紧跟的是字母，
		 *   而同一行更后面的速度行在**另一个 tspan** 里（自身带 dy="-10"）→ 补完字母还要把
		 *   这个偏移一并回正，否则整条速度行会跟着抬。
		 */
		function useBravuraKeySignature(host: HTMLElement) {
			const NS = 'http://www.w3.org/2000/svg';
			/** 给「记号之后的那个节点」补上反向 dy（+ 拉开间距的 dx） */
			const fixAfter = (el: Element) => {
				if (JIANPU_KEY_ACC_DY) el.setAttribute('dy', String(-JIANPU_KEY_ACC_DY));
				if (JIANPU_KEY_ACC_DX) el.setAttribute('dx', String(JIANPU_KEY_ACC_DX));
			};
			host.querySelectorAll('svg g[sn-tag="info"] text, svg g[sn-tag="info"] tspan').forEach((el) => {
				Array.from(el.childNodes).forEach((node) => {
					if (node.nodeType !== 3) return;
					const v = node.nodeValue || '';
					if (!/[♯♭]/.test(v)) return;
					const span = document.createElementNS(NS, 'tspan');
					span.setAttribute('font-family', 'Bravura');
					if (JIANPU_KEY_ACC_DY) span.setAttribute('dy', String(JIANPU_KEY_ACC_DY));
					span.textContent = v.replace(/♯/g, '\uED62').replace(/♭/g, '\uED60');
					el.replaceChild(span, node);
					// ① 记号后面紧跟的兄弟（正常情况下就是调号字母）
					const next = span.nextSibling;
					if (next && next.nodeType === 3) {
						const t = document.createElementNS(NS, 'tspan');
						fixAfter(t);
						t.textContent = next.nodeValue || '';
						el.replaceChild(t, next);
					} else if (next && next.nodeType === 1) {
						fixAfter(next as Element);
					}
					// ② 若记号后面在本元素内已无内容，偏移会溢出到**父元素的下一个兄弟**（速度行就在那里）
					if (!span.nextSibling && el.nextElementSibling && JIANPU_KEY_ACC_DY) {
						const sib = el.nextElementSibling;
						const own = parseFloat(sib.getAttribute('dy') || '0') || 0;
						sib.setAttribute('dy', String(own - JIANPU_KEY_ACC_DY));
					}
				});
			});
		}

		/**
		 * 把信息区里两个「库写死的值」改掉，否则后面调位置会带不动它们：
		 *   ① 字号：调号 / 速度 / 作曲 / 拍号都是 14px、速度符号 𝅘𝅥 是 18px，都比谱面偏小 → 提到 16px
		 *      （𝅘𝅥 按同比例 18 × 16/14 = 20.5 跟着长）。
		 *   ② ⚠️ 速度行的 𝅘𝅥 那个 tspan 上还有个库写死的 `y`（= 信息块的基线）。tspan 一旦带 y 就**不再
		 *      跟父级 text 的 y 走** → 整个信息块挪位置时，𝅘𝅥 和它后面的 "= 88" 会被留在原地。
		 *      所以不能删它（试过：删了它就开始跟前面的调号行累加 dy，速度行反而跑到调号上方 30px），
		 *      而是整块挪 y 的时候把它一起挪（见 centerJianpuInfoVertically 里的 `tspan[y]`）。
		 *
		 * ⚠️ 为什么用 JS 改字号而不是写在 CSS 里：渲染是在**离屏 scratch 容器**（没有 .jianpu-score 类，
		 *    拿不到 main.css）里完成的，CSS 在那儿不生效 → 量出来的行盒不是最终值，后面按它做的垂直居中
		 *    会差几个像素。改成直接覆写属性，量到啥就是最终渲染值。
		 * ⚠️ 库的字号单位混用：外层 text / 作曲 tspan 是 "14"，调号、速度那两个 tspan 是 "14px"。
		 */
		function normalizeJianpuInfo(host: HTMLElement) {
			host.querySelectorAll('svg g[sn-tag="info"] text, svg g[sn-tag="info"] tspan').forEach((el) => {
				const fs = el.getAttribute('font-size');
				if (fs === '14' || fs === '14px') el.setAttribute('font-size', String(JIANPU_INFO_SIZE));
				else if (fs === '18') el.setAttribute('font-size', String(JIANPU_INFO_GLYPH_SIZE));
			});
			// 标题：库给 30，而 abcjs 的谱面标题是 27 → 统一成 27（两种记谱法切换时标题一样大）。
			// ⚠️ 标题的 y **不做补偿**：信息带改矮（120 → JIANPU_INFO_HEIGHT）后，库自己就把标题往上摆了，
			//    那个位置正好让标题上沿和五线谱标题对齐（实测基线 52 → 标题盒顶 22.5px，五线谱是 20.8px）。
			//    以前补回 (120−94)/2 = 13px → 标题盒顶跑到 32.2px，上面空一大块（用户反馈「标题上边的间距有点大」）。
			// ⚠️ 标题的 y 同时是 centerJianpuInfoVertically 计算信息块位置时的「带子上界」，改它会连带挪信息行。
			const title = host.querySelector('svg g[sn-tag="info"] > text');
			if (title) title.setAttribute('font-size', String(JIANPU_TITLE_SIZE));
			// 调号里的「1」单独加粗成 700（与谱内音符数字同字重）；等号保持常规。
			// ⚠️ 只包「1」这一个字符 → 包出一个 font-weight=700 的 tspan；再跑一次时文本已不以 1 开头，自然幂等。
			const keyLeaf = Array.from(host.querySelectorAll('svg g[sn-tag="info"] tspan'))
				.find((el) => !el.querySelector('tspan') && /^\s*1\s*=/.test(el.textContent || ''));
			const keyText = keyLeaf && Array.from(keyLeaf.childNodes).find((n) => n.nodeType === 3 && (n.nodeValue || '').indexOf('1') >= 0);
			if (keyLeaf && keyText) {
				const v = keyText.nodeValue || '';
				const at = v.indexOf('1');
				const bold = document.createElementNS('http://www.w3.org/2000/svg', 'tspan');
				bold.setAttribute('font-weight', '700');
				bold.textContent = v.slice(0, at + 1);
				keyText.nodeValue = v.slice(at + 1);
				keyLeaf.insertBefore(bold, keyText);
			}
		}

		/** 速度记号里的音符符号（𝄝 全音符、𝅗𝅥 二分、𝅘𝅥 四分、𝅘𝅥𝅮 八分…）：U+1D15D–U+1D164 */
		const TEMPO_NOTE_RE = /[\u{1D15D}-\u{1D164}]/u;

		/**
		 * 速度记号前那个音符符号：库写死画四分音符（U+1D15F），按「每拍时值」（围栏里的 `time:`）换成对应的那个：
		 * `time: 1` 全音符 / `2` 二分 / `4` 四分（库默认）/ `8` 八分 / `16` 十六分 / …
		 * ⚠️ 那个符号单独在一个 `font-family=serif` 的 tspan 里（CSS 给它保留了 Bravura 字体栈），
		 *    所以只改**字符**，字体/字号/基线都不动。
		 * ⚠️ 非 2 的幂（乱填的值）就保持库的四分音符；幂次超过 128 也不换。
		 */
		function useTempoBeatSymbol(host: HTMLElement) {
			const time = Number(host.dataset.jianpuTime || '');
			if (!(time > 0) || (time & (time - 1)) !== 0) return;
			const cp = 0x1d15d + Math.log2(time);
			if (cp < 0x1d15d || cp > 0x1d164 || cp === 0x1d15f) return; // 四分音符就是库的默认值，不用改
			const info = host.querySelector('svg g[sn-tag="info"]');
			if (!info) return;
			info.querySelectorAll('tspan').forEach((t) => {
				Array.from(t.childNodes).forEach((n) => {
					if (n.nodeType === 3 && TEMPO_NOTE_RE.test(n.nodeValue || '')) {
						n.nodeValue = (n.nodeValue || '').replace(TEMPO_NOTE_RE, String.fromCodePoint(cp));
					}
				});
			});
		}

		/**
		 * 速度里的数字（`𝅘𝅥 = 88` 的 88）也换成 **Bravura 雕刻数字**（用户要求，与拍号同一套字形）。
		 *
		 * 结构：速度行 = 含 𝅘𝅥 的那个 tspan，里面依次是「𝅘𝅥 的 tspan（库写死了 y）」+「` = 88` 的 tspan」。
		 * 做法：把后者的文字拆成「前缀（` = `）+ 逐字字形 + 尾巴」，**不写 x**（顺着 𝅘𝅥 自然往下排，父级 anchor=start）。
		 * 字形骑在基线上（asc≈desc）而正文数字坐在基线上 → 字号按墨迹等高反推（见 bravuraDigitSize），
		 * 基线再上提 JIANPU_BEAT_BAR_ASC em，让「字形墨迹中心」对齐「文字墨迹中心」，跟旁边的 ` = ` 看着是一条线。
		 * ⚠️ 字形 tspan 自带 `y` → `centerJianpuInfoVertically` 会把它一起挪（它认 `tspan[y]`）。
		 * ⚠️ 量不到 Bravura（字体没就绪）就保持库的正文数字，并打 `data-jianpu-digits` 标记触发字体就绪后的重排。
		 */
		function useBravuraTempoDigits(host: HTMLElement) {
			const info = host.querySelector('svg g[sn-tag="info"]');
			if (!info) return;
			const tempoText = Array.from(info.querySelectorAll('text')).find((t) => TEMPO_NOTE_RE.test(t.textContent || ''));
			const tempoLine = tempoText && Array.from(tempoText.children).find((c) => TEMPO_NOTE_RE.test(c.textContent || ''));
			if (!tempoText || !tempoLine) return;
			// 装数字的那一段：速度行里第一个含「= 数字」的子 tspan（𝅘𝅥 那个不含等号）
			const digitsSpan = Array.from(tempoLine.children).find((c) => /=\s*\d/.test(c.textContent || ''));
			if (!digitsSpan) return;
			const m = /^(\s*=\s*)(\d+)([\s\S]*)$/.exec(digitsSpan.textContent || '');
			if (!m) return;
			// 字号统一按常量反推（信息区 16 → 22.4）；字形骑在基线上 → 抬 JIANPU_BEAT_BAR_ASC 对齐文字墨迹中心
			const size = bravuraDigitSize(JIANPU_INFO_SIZE);
			// 数字字形不依赖字体是否就绪（码位+位置固定，字形等到字体加载完自动显）→ 直接排
			const lift = -JIANPU_INFO_SIZE * JIANPU_BEAT_BAR_ASC;
			const NS = 'http://www.w3.org/2000/svg';
			digitsSpan.textContent = '';
			digitsSpan.setAttribute('data-jianpu-digits', '1');
			const prefix = document.createElementNS(NS, 'tspan');
			prefix.textContent = m[1];
			digitsSpan.appendChild(prefix);
			drawBravuraDigits(digitsSpan, m[2], size, null, false, lift, true);
			if (m[3]) {
				const tail = document.createElementNS(NS, 'tspan');
				tail.setAttribute('dy', String(-lift)); // 尾巴（如「-92」）挪回正常基线（相对值，跟着行一起走）
				tail.textContent = m[3];
				digitsSpan.appendChild(tail);
			}
		}

		/**
		 * 去掉信息行里的「作曲: 」前缀（用户要求只留名字）。
		 * 库把信息行放在 `g[sn-tag="info"]`，作曲/作词是 `<text>…<tspan>作曲: X</tspan></text>`。
		 * ⚠️ 只改**直接文本节点**（不重建子节点），tspan 的 x / dy / text-anchor 全保留。
		 */
		function stripJianpuInfoLabels(host: HTMLElement) {
			host.querySelectorAll('svg g[sn-tag="info"] text, svg g[sn-tag="info"] tspan').forEach((el) => {
				Array.from(el.childNodes).forEach((node) => {
					if (node.nodeType !== 3) return;
					const v = node.nodeValue || '';
					const t = v.replace(/^\s*作曲\s*[:：]\s*/, '');
					if (t !== v) node.nodeValue = t;
				});
			});
		}

		/**
		 * 把调号（1 = C）和速度（𝅘𝅥 = 88）排到**同一行**（用户要求），中间留 JIANPU_INFO_GAP 的空隙。
		 *
		 * 库 `drawMusicInfo` 是把它们上下叠着放的（调号 dy=-30、速度 dy=-10，各占一行）。做法：
		 * 把速度那一组整体挪到调号右侧，并把它的基线抬到调号那条基线上。
		 * ⚠️ 速度组里**外层 tspan 和 𝅘𝅥 的 tspan 都写死了 x = innerX**（库的左边界）→ 两个都得改 x，
		 *    否则速度会跑回谱面最左边。
		 * ⚠️ `dy` 在 SVG 文本里是累加量、且库嵌套了两层 tspan，算出来的理论值未必落地 → 先按算出来的
		 *    改一遍，再量一次两边行盒的残差补掉（幂等，重排时重复调用也不会跑偏）。
		 * 放不下（调号 + 空隙 + 速度会压到作曲行）就不合并、保持两行。
		 */
		function inlineJianpuKeyTempo(host: HTMLElement) {
			const NS = 'http://www.w3.org/2000/svg';
			const box = (el: Element) => (el as SVGGraphicsElement).getBBox();
			const num = (v: string | null) => (v === null ? 0 : parseFloat(v) || 0);
			const bottom = (el: Element) => { const b = box(el); return b.y + b.height; };
			const info = host.querySelector('svg g[sn-tag="info"]');
			if (!info) return;
			const texts = Array.from(info.querySelectorAll('text'));
			// ⚠️ 围栏头里的 key / beat+time / tempo 是**各自独立可选**的（作者完全可以只写其中一两行）→
			//    任何一项缺席都不能让整段排版早退：拍号照样要画成分数、剩下的项照样要按间隙排好。
			//    （以前这里是 `if (!keyLine || !tempoLine) return;` —— 删掉 key 或 tempo 就整个失效。）
			// 调号/速度在同一个 text 里（musicText，textContent 含音符符号）；拍号是另一个独立 text。
			const musicText = texts.find((t) => TEMPO_NOTE_RE.test(t.textContent || '')) || null;
			const lines = musicText ? Array.from(musicText.children).filter((c) => c.tagName === 'tspan') : [];
			const tempoLine = lines.find((c) => TEMPO_NOTE_RE.test(c.textContent || '')) || null;
			// ⚠️ 调号**不能**靠 musicText 找：没写 `tempo:` 就没有那个音符符号，musicText = null ⇒ 认不出调号、
			//    拍号会被当成首项贴到左缘、直接压在调号上（用户实测：「有调号的时候拍号也不给调号留地方」）。
			const keyText = texts.find((t) => t.getAttribute('text-anchor') !== 'middle' && /1\s*=/.test(t.textContent || '')) || null;
			const keyLines = keyText ? Array.from(keyText.children).filter((c) => c.tagName === 'tspan') : [];
			// 取没混进速度符号的那一层 tspan（= 整行 `1 = C`，含字母、也带 dy）
			const keyLine = keyLines.find((c) => /1\s*=/.test(c.textContent || '') && !TEMPO_NOTE_RE.test(c.textContent || '')) || keyLines[0] || keyText;
			const beatText = texts.find((t) => /^\s*\d+\s*\/\s*\d+\s*$/.test(t.textContent || '')) || null;
			if (!keyLine && !tempoLine && !beatText) return;
			// 右边界：有作曲就用作曲的墨迹左缘（不能压到它），没有就用谱面宽 − 10（库自己的内边距）
			const creator = texts.find((t) => ['end', 'right'].includes(t.getAttribute('text-anchor') || ''));
			const vb = ((info as SVGElement).ownerSVGElement?.getAttribute('viewBox') || '').trim().split(/[\s,]+/).map(Number);
			const scoreW = vb.length === 4 && vb[2] > 0 ? vb[2] : 736;
			const limit = creator ? box(creator).x : scoreW - 10;
			// ⚠️ 横向用**整行调号**（含升降号 + 字母）的盒子；纵向必须用 keyLeaf（避开升降号 tspan 的超高行盒）
			const keyBox = keyLine ? box(keyLine) : null;
			// 拍号的 y 恰好就是调号行的基线（innerY + innerHeight − 50）→ 纵向不用管，只要横着排进去。
			// 拍号改画成**分数形式**（用户要求：上下两个数字 + 中间一条分数线），数字用 **Bravura 的拍号字形**
			// `timeSig0`–`timeSig9`（U+E080–E089，SMuFL 专为拍号画的一整套：上下两个数字天生同一套、且**骑在基线上**
			// （asc≈desc），叠起来就是真雕刻拍号的样子）。
			// ⚠️ 字号不能照抄正文：这些字形是按乐谱行高画的（20px 时墨迹才 ~10px）→ 用 canvas 量真实墨迹，
			//    反推「与信息行数字墨迹等高」所需的字号；量不出来（Bravura 还没加载好）就退回正文数字（700 字重），
			//    字体就绪后的那次重排会再走一遍（和变音记号同一套机制）。
			// ⚠️ 用**绝对 y**、不用 dy：这里的 tspan 都带自己的 `x`，实测（Chromium）带 x 的 tspan **不**承接
			//    前一个 tspan 的 dy，`dy=-7` 后 `dy=+14` 会得到「上 −7 / 下 +14」（数字间距 21px、分母垂在行外）✗。
			// ⚠️ 必须在「量宽度排位置」**之前**拆：拆完整行宽度从 "4/4" 的 ~23px 变成单个数字的 ~8px，
			//    横排位置要按新宽度算，否则会和速度之间多出一大段空隙。
			// ⚠️ 分数线是 `beatText` 的**兄弟节点**（SVG 的 <text> 里放不了 <line>）→ 横移/纵移都得单独带上它。
			let beatBar: SVGLineElement | null = null;
			if (beatText) {
				const m = /^\s*(\d+)\s*\/\s*(\d+)\s*$/.exec(beatText.textContent || '');
				if (m) {
					const b0 = box(beatText);
					const cx = b0.x + b0.width / 2; // 两个数字共用的中心线（分数记号本来就按中心对齐）
					const baseY = num(beatText.getAttribute('y')); // 该行基线（= 调号行基线）
					// 分数整体墨迹中心：与旁边调号/速度行的墨迹中心齐平（= 基线上方 0.35em，见常量注释）
					const mid = baseY - JIANPU_INFO_SIZE * JIANPU_BEAT_BAR_ASC;
					beatText.setAttribute('text-anchor', 'middle'); // 退路（正文数字整串一个 tspan）用；字形走下面的逐字绝对 x
					beatText.textContent = '';
					// 标记「这串数字想用 Bravura 字形」：字体没就绪时会退回正文数字，靠这个标记触发字体就绪后的重排
					beatText.setAttribute('data-jianpu-digits', '1');
					// 分子 / 分母共用一个字号（常量反推，不随数字串变）
					const glyphSize = bravuraDigitSize(JIANPU_INFO_SIZE);
					/**
					 * 画一组数字（分子 / 分母）：SMuFL 的拍号数字一次一个字形，`12/8` = timeSig1 + timeSig2 + 分数线 + timeSig8。
					 * 墨迹高度/字宽都用常量（见 bravura-digits.ts 文件头），所以**不存在「量不到 → 退回正文数字」这种分支**。
					 */
					const placeDigits = (digits: string, i: number) => {
						const ink = bravuraDigitMetrics(digits, glyphSize);
						// 分子：墨迹底距分数线 JIANPU_BEAT_BAR_GAP；分母：墨迹顶距分数线同样多
						const y = i === 0 ? mid - JIANPU_BEAT_BAR_GAP - ink.desc : mid + JIANPU_BEAT_BAR_GAP + ink.asc;
						drawBravuraDigits(beatText, digits, glyphSize, cx, true, y);
					};
					placeDigits(m[1], 0);
					placeDigits(m[2], 1);
					// 分数线：宽度取上下两组里较宽的那个（box 是所有 tspan 的并集）；高度落在墨迹带正中 = mid
					const half = box(beatText).width / 2;
					beatBar = document.createElementNS(NS, 'line') as SVGLineElement;
					beatBar.setAttribute('x1', String(cx - half));
					beatBar.setAttribute('x2', String(cx + half));
					beatBar.setAttribute('y1', String(mid));
					beatBar.setAttribute('y2', String(mid));
					beatBar.setAttribute('stroke', 'black');
					beatBar.setAttribute('stroke-width', '1');
					beatBar.setAttribute('data-jianpu-beatbar', '1'); // 标记：后续垂直居中步骤要认领它
					beatText.parentNode?.appendChild(beatBar);
				}
			}
			// 依次横排：调号 → 拍号（若有）→ 速度（若有），中间各留 JIANPU_INFO_GAP。
			// ⚠️ 没写调号时拍号就是首项 → 贴到信息行左缘。库把拍号摆在「调号槽」里，不挪它左边缘
			//    会空出一整块（用户实测：「没写调号 拍号会给留出来空」）。
			const moveX = (el: Element | null, dx: number) => {
				if (!el || !dx) return;
				[el, ...Array.from(el.querySelectorAll('[x]'))].forEach((node) => {
					node.setAttribute('x', String(num(node.getAttribute('x')) + dx));
				});
			};
			const moveBeatBar = (dx: number) => {
				if (!beatBar || !dx) return;
				beatBar.setAttribute('x1', String(num(beatBar.getAttribute('x1')) + dx));
				beatBar.setAttribute('x2', String(num(beatBar.getAttribute('x2')) + dx));
			};
			const leftEdge = keyText ? num(keyText.getAttribute('x')) : JIANPU_INFO_PAD_LEFT;
			let cursor: number | null = keyBox ? keyBox.x + keyBox.width : null;
			if (beatText) {
				const bb = box(beatText);
				if (cursor === null) {
					moveX(beatText, leftEdge - bb.x); // 拍号当首项：贴左缘
					moveBeatBar(leftEdge - bb.x);
					cursor = leftEdge + bb.width;
				} else {
					const dx = cursor + JIANPU_INFO_GAP - bb.x;
					// ⚠️ 拆分后 x 落在两根 tspan 上（text 自己的 x 已被子 tspan 覆盖）→ 两边一起挪
					moveX(beatText, dx);
					moveBeatBar(dx);
					cursor += JIANPU_INFO_GAP + bb.width;
				}
			}
			// 速度行：存在、且前面至少有一项（调号或拍号）就能并到同一行；放不下就保持库原本所在的另一行。
			// ⚠️ 以前这里还要求 beatText 存在 ⇒ 「只写调号和速度」时永远不合并、白白占两行（用户实测）。
			if (!tempoLine || !musicText || cursor === null) return;
			const tempoBox = box(tempoLine);
			// 放不下就不合并（保持库原本的两行）
			if (cursor + JIANPU_INFO_GAP + tempoBox.width > limit - JIANPU_INFO_GAP) return;
			// ① 横向：速度组整体右移（外层 tspan 和 𝅘𝅥 上的 x 都要改）
			moveX(tempoLine, cursor + JIANPU_INFO_GAP - tempoBox.x);
			// ② 纵向：抬到「首项所在的那条基线」。有调号就抄调号的 dy；只有拍号时按拍号基线反算
			//    （拍号那个 <text> 的 y 就是调号行的基线，见上面注释）
			const anchorDy = keyLine
				? keyLine.getAttribute('dy') || '0'
				: String(num(beatText ? beatText.getAttribute('y') : null) - num(musicText.getAttribute('y')));
			tempoLine.setAttribute('dy', anchorDy);
		}

		/**
		 * 让「作曲」行与调号/速度行**同高**（用户要求：作曲不该另占一个高度）。
		 *
		 * 库 `drawCreatorInfo` 把作词/作曲画在信息区右下（右对齐，逐行往下排）：
		 *   有作词 → 作词 dy=-30（正好与调号行同高）、作曲 dy=+20（正好落到速度行上 ✓）；
		 *   只有作曲 → 作曲 dy=0，落在信息块的**基线行**上 —— 比速度行还低 10，看着像多出来的第三行 ✗。
		 * 这里只修「只有一行」的情况（作曲单独出现、或只有作者）：把它抬到速度行那条基线上；
		 * 有作词/作谱时库自己的排法已经对齐了，不动。
		 */
		function alignJianpuComposerLine(host: HTMLElement) {
			const num = (v: string | null) => (v === null ? 0 : parseFloat(v) || 0);
			const info = host.querySelector('svg g[sn-tag="info"]');
			if (!info) return;
			const texts = Array.from(info.querySelectorAll('text'));
			// 速度行 = 含音符符号的那个 tspan
			const tempoText = texts.find((t) => TEMPO_NOTE_RE.test(t.textContent || ''));
			const tempoLine = tempoText && Array.from(tempoText.children).find((c) => TEMPO_NOTE_RE.test(c.textContent || ''));
			if (!tempoText || !tempoLine) return;
			// 作曲行 = 右对齐的那个 text（标题是 middle、调号/速度是 start）
			const creator = texts.find((t) => ['end', 'right'].includes(t.getAttribute('text-anchor') || ''));
			if (!creator) return;
			const lines = Array.from(creator.children).filter((c) => c.tagName === 'tspan');
			if (lines.length !== 1 || !(lines[0].textContent || '').trim()) return;
			// 同行放不下就不抬（宁可让作曲留在库原始的下一行，也不要重叠）
			const right = Math.max(...Array.from(tempoText.children)
				.filter((c) => c.tagName === 'tspan')
				.map((c) => { const b = (c as SVGGraphicsElement).getBBox(); return b.x + b.width; }));
			if (right + JIANPU_INFO_GAP > (creator as SVGGraphicsElement).getBBox().x) return;
			// 目标 dy = 速度行的 dy +（两个 text 的 y 差）
			const target = num(tempoLine.getAttribute('dy')) + num(tempoText.getAttribute('y')) - num(creator.getAttribute('y'));
			if (Math.abs(target - num(lines[0].getAttribute('dy'))) < 0.01) return;
			lines[0].setAttribute('dy', String(target));
		}

		/**
		 * 信息块（调号+速度+作曲那一行）在标题与谱面之间**垂直居中**（用户要求：上下留白要匀）。
		 *
		 * 库是按「三行」给标题下方留的整块空间（调号 dy=-30 / 速度 dy=-10 / 作曲 dy=0），我们把三行
		 * 并成一行后，下面就空出一大块、而紧贴着标题——看着就是「上头空这么小、下头空这么大」。
		 * 这里量出上界（标题基线）与下界（谱面第一行最顶上那条墨迹）之间的空白，把信息块摆到
		 * 「上 JIANPU_INFO_TOP_RATIO / 下 1−JIANPU_INFO_TOP_RATIO」的位置（不平均分：上边太大会显得
		 * 标题和信息行分了家，正居中又觉得上头空太多 —— 0.4 是用户两轮调出来的）。
		 * ⚠️ 墨迹位置没法直接量（SVG `getBBox()` 给的是**字体行盒**，比可见墨迹高一截）→ 用经验比例换算
		 *    （基线上方 JIANPU_INFO_INK_ASC em、下方 JIANPU_INFO_INK_DESC em）。
		 * 幂等：位移是按「当前几何」算的，摆正后再跑一次算出来就是 0。
		 */
		function centerJianpuInfoVertically(host: HTMLElement) {
			const num = (v: string | null) => (v === null ? 0 : parseFloat(v) || 0);
			const svg = host.querySelector('svg');
			const info = svg && svg.querySelector('g[sn-tag="info"]');
			const score = svg && svg.querySelector('g[sn-tag="score"]');
			if (!svg || !info || !score) return;
			const texts = Array.from(info.querySelectorAll('text'));
			// 标题 = 居中的那个 text；剩下的（调号/速度/作曲）就是信息块
			const title = texts.find((t) => ['middle', 'center'].includes(t.getAttribute('text-anchor') || '')) || texts[0];
			if (!title) return;
			const blockTexts = texts.filter((t) => t !== title);
			if (!blockTexts.length) return;
			// 每一行的基线 = text 的 y + 它直接子 tspan 的 dy（实测单层 tspan 就是叠加在 text 的 y 上）
			const base = (t: Element) => Array.from(t.children)
				.filter((c) => c.tagName === 'tspan')
				.map((c) => num(t.getAttribute('y')) + num(c.getAttribute('dy')));
			const lines: number[] = [];
			blockTexts.forEach((t) => lines.push(...base(t)));
			if (!lines.length) return;
			// 下界：谱面第一行里最高的那条墨迹
			// ⚠️ 只能用**与字体无关的精确几何**：小节线的 y1、八度点的圆（cy − r）。
			//    音符/倚音数字的墨迹位置得从字体行盒推，而渲染是在离屏容器（没有 .jianpu-score，
			//    字体栈还是库写的宋体，不是最终的 Source Serif 4）里做的 → 量出来的行盒不对，
			//    会差好几像素（实测少算 6px，导致居中偏上 3px）。
			//    代价：第一行若有倚音（画在数字上方）会高出小节线顶 ~9px → 信息块最多低 ~4px，可接受。
			const stave = score.querySelector('g[sn-tag^="stave-"]');
			const tops: number[] = [];
			if (stave) {
				stave.querySelectorAll(':scope > line').forEach((l) => tops.push(parseFloat(l.getAttribute('y1') || '')));
				stave.querySelectorAll('g[sn-tag^="note-"] > circle').forEach((c) => {
					tops.push(num(c.getAttribute('cy')) - num(c.getAttribute('r')));
				});
			}
			const ink = tops.filter((v) => isFinite(v));
			const bandBottom = ink.length ? Math.min(...ink) : (score as SVGGraphicsElement).getBBox().y;
			const bandTop = num(title.getAttribute('y'));
			if (!(bandBottom > bandTop)) return;
			const fsInfo = JIANPU_INFO_SIZE;
			const top = Math.min(...lines) - fsInfo * JIANPU_INFO_INK_ASC;
			const bottom = Math.max(...lines) + fsInfo * JIANPU_INFO_INK_DESC;
			// 上下留白不平均分：上 40% / 下 60%（上边太大会显得标题和信息行分家；0.5 就是正居中）
			const shift = (bandTop + (bandBottom - bandTop - (bottom - top)) * JIANPU_INFO_TOP_RATIO) - top;
			if (!shift) return;
			blockTexts.forEach((t) => {
				t.setAttribute('y', String(num(t.getAttribute('y')) + shift));
				// ⚠️ 库里写死了 y 的 tspan（速度行的 𝅘𝅥）不会跟父级走，必须一起挪
				t.querySelectorAll('tspan[y]').forEach((c) => c.setAttribute('y', String(num(c.getAttribute('y')) + shift)));
			});
			// 拍号的**分数线**是 `text` 的兄弟节点（SVG 的 <text> 里放不了 <line>）→ 单独跟着挪
			info.querySelectorAll('[data-jianpu-beatbar]').forEach((l) => {
				l.setAttribute('y1', String(num(l.getAttribute('y1')) + shift));
				l.setAttribute('y2', String(num(l.getAttribute('y2')) + shift));
			});
		}

		/**
		 * 谱首留白：标题没写就不给它留位置（后头的信息跟上来），信息也没有就直接跟谱。
		 *
		 * 背景：库里信息区是按「标题 + 三行信息」固定高度的（info.height），标题空着那块照样留着；
		 * 而且没标题时它会把第一行信息摆到标题的位置上、其余留在原处 ⇒ 信息行之间空一大块。
		 * 做法：**总是**给库一个标题占位（见 renderJianpuScore 里那个 \u00a0），几何就跟
		 * 「标题 + 信息」完全一致（前面几步微调也都是按这个基准调的），最后在这里把多出来的
		 * 那截整体上移、并把 viewBox 高度减掉（谱面高度是 viewBox 撑的，不减就成了底部留白）。
		 * 幂等：位移按「当前几何」算，摆正之后再跑一次是 0。
		 */
		function compactJianpuHead(host: HTMLElement) {
			const svg = host.querySelector('svg') as SVGSVGElement | null;
			const info = svg && (svg.querySelector('g[sn-tag="info"]') as SVGGElement | null);
			const scoreG = svg && (svg.querySelector('g[sn-tag="score"]') as SVGGElement | null);
			if (!svg || !info || !scoreG) return;
			const hasTitle = host.dataset.jianpuHasTitle === '1';
			const hasInfo = host.dataset.jianpuHasInfo === '1';
			if (hasTitle && hasInfo) return; // 都有：维持库 + 各步微调后的样子
			const num = (v: string | null) => (v === null ? 0 : parseFloat(v) || 0);
			// 谱面第一行最上面那条墨迹：跟 centerJianpuInfoVertically 用同一套（只认与字体无关的精确几何）
			const stave = scoreG.querySelector('g[sn-tag^="stave-"]');
			const tops: number[] = [];
			if (stave) {
				stave.querySelectorAll(':scope > line').forEach((l) => tops.push(num(l.getAttribute('y1'))));
				stave.querySelectorAll('g[sn-tag^="note-"] > circle').forEach((c) => tops.push(num(c.getAttribute('cy')) - num(c.getAttribute('r'))));
			}
			const scoreTop = tops.length ? Math.min(...tops) : scoreG.getBBox().y;
			if (!isFinite(scoreTop)) return;
			// 信息行的基线（⚠️ 占位标题不能算进来，否则信息块的「顶」就被它拉到标题那条线上）
			const texts = Array.from(info.querySelectorAll('text'));
			const stripped = host.dataset.jianpuTitleStripped === '1'; // 占位标题已经收掉（重排时会被重建，所以记在 dataset 上）
			const placeholder = !hasTitle && !stripped;
			const titleEl = hasTitle || placeholder ? texts.find((t) => ['middle', 'center'].includes(t.getAttribute('text-anchor') || '')) || texts[0] : null;
			const lines: number[] = [];
			texts.forEach((t) => {
				if (t === titleEl) return;
				const ys = Array.from(t.children)
					.filter((c) => c.tagName === 'tspan')
					.map((c) => num(t.getAttribute('y')) + num(c.getAttribute('dy')));
				lines.push(...(ys.length ? ys : [num(t.getAttribute('y'))]));
			});
			let dy: number;
			if (!hasTitle) {
				dy = lines.length
					? JIANPU_CONTENT_PAD_TOP - (Math.min(...lines) - JIANPU_INFO_SIZE * JIANPU_INFO_INK_ASC) // 信息贴到顶部留白
					: JIANPU_CONTENT_PAD_TOP - scoreTop; // 连信息都没有：谱面直接跟上来
			} else {
				dy = num(titleEl!.getAttribute('y')) + JIANPU_TITLE_SIZE * 0.2 + JIANPU_HEAD_GAP - scoreTop; // 谱面贴到标题下头
			}
			if (!(dy < 0)) return; // 只负责上移
			if (!hasTitle) {
				// 信息块整体上移（含 tspan 上写死的 y、以及拍号那条分数线 —— 跟 centerJianpuInfoVertically 同一套改法）
				info.querySelectorAll('text').forEach((t) => {
					t.setAttribute('y', String(num(t.getAttribute('y')) + dy));
					t.querySelectorAll('tspan[y]').forEach((c) => c.setAttribute('y', String(num(c.getAttribute('y')) + dy)));
				});
				info.querySelectorAll('[data-jianpu-beatbar]').forEach((l) => {
					l.setAttribute('y1', String(num(l.getAttribute('y1')) + dy));
					l.setAttribute('y2', String(num(l.getAttribute('y2')) + dy));
				});
				if (placeholder && titleEl) {
					titleEl.remove(); // 占位标题（那行空白）收掉
					host.dataset.jianpuTitleStripped = '1';
				}
			}
			// 谱面：同一个位移（「信息 ↔ 谱面」那段净空保持不变）。
			// ⚠️ score 组上还有 centerJianpuScore 加的水平 transform，得读出来再拼，别覆盖掉。
			const m = /translate\(\s*([-\d.]+)[\s,]+([-\d.]+)\s*\)/.exec(scoreG.getAttribute('transform') || '');
			scoreG.setAttribute('transform', 'translate(' + (m ? m[1] : '0') + ' ' + ((m ? num(m[2]) : 0) + dy) + ')');
			// viewBox 跟着变矮（dy 是负数）；谱面高度就是靠 viewBox 撑的
			const vb = (svg.getAttribute('viewBox') || '').split(/\s+/).map(Number);
			if (vb.length === 4 && vb[3] > 0) svg.setAttribute('viewBox', vb[0] + ' ' + vb[1] + ' ' + vb[2] + ' ' + (vb[3] + dy));
		}

		/**
		 * 库把「时值延长」渲染成半角连字符 "-"（墨迹仅 6.45px，而音符宽 10.35px），看着像断点。
		 * 换成 en dash "–"（约 8.5px）与音符等宽，延音线更连贯。
		 * 只改 SVG 文本，不动库写的数据属性（note-data 等），不影响后续播放/光标对齐。
		 */
		function widenJianpuDashes(host: HTMLElement) {
			host.querySelectorAll('svg g[sn-tag^="note-"] > text').forEach((t) => {
				if ((t.textContent || '').trim() === '-') t.textContent = '\u2013';
			});
		}

		/**
		 * 库把小节线/终止线画成固定 40px 高（约音符墨迹 25.6px 的 1.56 倍），全中音区、无时值线的曲子里显得偏长。
		 * 上下各收 JIANPU_BAR_SHRINK/2 像素（只改 y1/y2，不动 stroke-width，所以线不会变细），再整体上移 JIANPU_BAR_RAISE。
		 * ⚠️ 只处理乐句 <g> 的直接子 line（= 小节线/终止线/反复记号的竖线）；时值线在 g[sn-tag="beam"] 里，不在其列。
		 * ⚠️ 反复记号的两个圆点由 `tightenJianpuRepeatDots` 重新对到「竖线中点」上，所以它必须排在本步之后（会跟着上移）。
		 */
		function shortenJianpuBarlines(host: HTMLElement) {
			const d = JIANPU_BAR_SHRINK / 2;
			host.querySelectorAll('svg g[sn-tag^="stave-"] > line').forEach((l) => {
				const y1 = parseFloat(l.getAttribute('y1') || '');
				const y2 = parseFloat(l.getAttribute('y2') || '');
				if (!isFinite(y1) || !isFinite(y2) || y2 <= y1) return;
				l.setAttribute('y1', String(y1 + d - JIANPU_BAR_RAISE));
				l.setAttribute('y2', String(y2 - d - JIANPU_BAR_RAISE));
			});
		}

		/**
		 * 谱首小节线删掉后，乐句左侧留白会比右侧多（库原本靠那条线占位），整行看着偏右。
		 * 这里按乐句的实际墨迹范围把整个谱面组水平平移，让左右留白相等。
		 * ⚠️ 不能改 viewBox：那会把上面的「标题 / 调号 / 作曲」行一起带偏。
		 */
		function centerJianpuScore(host: HTMLElement) {
			const svg = host.querySelector('svg') as SVGSVGElement | null;
			const scoreG = svg ? (svg.querySelector('g[sn-tag="score"]') as SVGGraphicsElement | null) : null;
			if (!svg || !scoreG) return;
			const vb = (svg.getAttribute('viewBox') || '').split(/\s+/).map(Number);
			if (vb.length !== 4 || !(vb[2] > 0)) return;
			// getBBox 不受该元素自身 transform 影响，所以这里每次都算出同一个 dx（幂等）
			// ⚠️ 库在 score 组里还塞了一个整宽的隐形分隔符（`[sn-tag="break-line"]`，stroke=transparent、
			//    x 从 0 开始）→ 它会把 bbox 左界拉到 0，居中就偏了（实测偏 ~12px）。量的时候先把它藏起来。
			const breakLines = Array.from(host.querySelectorAll('svg [sn-tag="break-line"]')) as SVGElement[];
			const prevDisplay = breakLines.map((el) => el.style.display);
			breakLines.forEach((el) => (el.style.display = 'none'));
			let box: DOMRect;
			try {
				box = scoreG.getBBox();
			} catch (e) {
				return; // 容器不可见时 getBBox 会抛错：跳过，下次重排再算
			} finally {
				breakLines.forEach((el, i) => (el.style.display = prevDisplay[i]));
			}
			if (!(box.width > 0)) return;
			// 令 左留白 == 右留白：dx = (2*viewBox左 + viewBox宽 - 内容左 - 内容右) / 2
			const dx = Math.round(((2 * vb[0] + vb[2] - box.x - (box.x + box.width)) / 2) * 100) / 100;
			if (!dx) return;
			scoreG.setAttribute('transform', 'translate(' + dx + ' 0)');
		}

		/**
		 * 连音组：库画成「顶上一根横线（sw=2）+ 两个圆角 + 一个 sans-serif 的 `3`」= 方括号，
		 * 用户要的是「**一条圆滑线 + 上面一个小数字**」。做法：
		 *   · 摘掉那两根圆角 path 和横线，**保留**库那个 `3`（x 居中，纵向交给 `placeJianpuTripletLabels`；
		 *     字体由 CSS 换成谱面的衬线栈）；
		 *   · 原来横线的位置补一条**库风格的单弧**（`M x y A rx ry 0 0 1 x2 y`），交给紧接着的
		 *     `curveJianpuTieLines` 按连音线同一套算法重画成纺锤形 —— 弧高、厚度、**避让高音点**、套弧
		 *     全都跟圆滑线一模一样，这里不重复造形。
		 * ⚠️ 跨度按**所盖音符的中心**取（库那根横线是内缩的、而且内缩量是**库单位**会被 justify 缩放
		 *    ⇒ 不能拿它 ± 常量）：弧从第一个音中心连到最后一个音中心，不含别的音。
		 *    ⚠️ 也别再往外扩（曾各外扩半个音距 ⇒ 用户：「这一改又偏宽了」）。
		 * ⚠️ y **直接用库那根横线的 y**，不要自己加减：库给连音线和三连音括号的是**同一个基准**（实测都是
		 *    音符基线 − 24），连音线后续会被 `curveJianpuTieLines` 统一 +`JIANPU_TIE_DROP` 下移贴近音符。
		 *    我一开始在这里先减掉了 drop ⇒ 三连音比圆滑线高 7.5px（用户：「弧离音符太远」）。
		 * ⚠️ 必须排在 `curveJianpuTieLines` **之前**：库那两个圆角 path 的 `d` 也是「单弧」形状，
		 *    会被改弧那步当成连音线（跨度才 8px ⇒ k<1 ⇒ ry 被除成 28 的胖疙瘩，实测就是这么画坏的）。
		 * ⚠️ 必须排在 ⑪ justify **之后**（见管线里的注释：rx 不跟着缩放，渲染器会把椭圆等比放大）。
		 * @param tuplets `normalizeJianpuNotes` 按出现顺序记下来的连音组数字（库只会画 `3`）
		 */
		function styleJianpuTriplets(host: HTMLElement, tuplets: string[] = []) {
			const svg = host.querySelector('svg');
			const tieline = svg && svg.querySelector('g[sn-tag="tieline"]');
			if (!svg || !tieline) return;
			const NS = 'http://www.w3.org/2000/svg';
			const num = (el: Element | null, a: string) => (el ? parseFloat(el.getAttribute(a) || 'NaN') : NaN);
			let nth = 0;
			Array.from(tieline.children).forEach((label) => {
				if (label.tagName !== 'text' || (label.textContent || '').trim() !== '3') return;
				// 库的绘制顺序：圆角 path → 圆角 path → 横线 → `3`，所以 label 的前一个兄弟就是那根横线
				const line = label.previousElementSibling;
				if (!line || line.tagName !== 'line') return;
				const lx1 = parseFloat(line.getAttribute('x1') || 'NaN');
				const lx2 = parseFloat(line.getAttribute('x2') || 'NaN');
				const y = parseFloat(line.getAttribute('y1') || '0');
				if (!Number.isFinite(lx1) || !Number.isFinite(lx2)) return;
				// 这根横线盖住的音符：库的横线是**内缩**的（首/末音中心各往里一点，且内缩量是库单位、
				// 会被 justify 缩放），所以按「**相邻音中心的中间**」当边界 —— 天然的、随音距自适应的容差：
				// 取横线左侧最近的两个音心，它们的**中点**就是左边界（右同理），落在中间的音就是这一组。
				const stave = Array.from(svg.querySelectorAll('g[sn-tag^="stave-"]'))
					.map((st) => ({ st, base: num(st.querySelector('text[font-size="18"]') || st, 'y') }))
					.filter((s) => Number.isFinite(s.base) && s.base >= y)
					.sort((a, b) => a.base - b.base)[0];
				if (!stave) return;
				const centersAll = Array.from(stave.st.querySelectorAll('text[font-size="18"]'))
					.filter((t) => /^[0-9]/.test(t.textContent || '')) // 只认音符数字（`.` 附点、`–` 延音不算）
					.map((t) => num(t, 'x'))
					.filter(Number.isFinite)
					.sort((a, b) => a - b);
				const below = centersAll.filter((x) => x <= lx1);
				const above = centersAll.filter((x) => x >= lx2);
				const cutL = below.length >= 2 ? (below[below.length - 1] + below[below.length - 2]) / 2 : -Infinity;
				const cutR = above.length >= 2 ? (above[0] + above[1]) / 2 : Infinity;
				const centers = centersAll.filter((x) => x > cutL && x < cutR);
				if (!centers.length) return;
				const nx1 = Math.min(...centers);
				const nx2 = Math.max(...centers);
				const span = nx2 - nx1;
				// 把库那三个元素（横线 + 两根圆角）摘掉（圆角就是横线前面那俩 path）
				const corners: Element[] = [];
				for (let prev = line.previousElementSibling; prev && prev.tagName === 'path' && corners.length < 2; prev = prev.previousElementSibling) corners.push(prev);
				[line, ...corners].forEach((el) => el.remove());
				const arc = document.createElementNS(NS, 'path');
				// rx 取跨度的一半 ⇒ 改弧那步算出的 k = 1（不用缩放补偿），画出来就是标准弧高
				arc.setAttribute('d', 'M ' + nx1.toFixed(2) + ' ' + y + ' A ' + (span / 2).toFixed(2) + ' 8 0 0 1 ' + nx2.toFixed(2) + ' ' + y);
				arc.setAttribute('stroke', 'black');
				arc.setAttribute('data-jianpu-triplet', String(nth));
				tieline.appendChild(arc);
				label.setAttribute('data-jianpu-triplet-label', String(nth));
				label.setAttribute('data-jianpu-tuplet-n', tuplets[nth] || '3'); // 库画的是 `3`，真实数字按顺序取回（没了就退回 3）
				label.setAttribute('x', String(((nx1 + nx2) / 2).toFixed(2)));
				nth++;
			});
		}

		/**
		 * 把连音组的数字贴到它那条弧的上方（弧顶 = 弦线 − 外弧 ry），字形用 **Bravura 雕刻数字**
		 * （`timeSig2`–`timeSig9`，跟拍号/速度数字同一套、同一个子集字体）—— 用户要求跟速度数字统一；
		 * 度量全走 `bravuraDigitMetrics` 的常量（不依赖字体是否就绪）。
		 * ⚠️ 这套字形**骑在基线上**（asc ≈ desc ≈ 0.25em）⇒ 基线得算成「弧顶 − 净空 − asc」，
		 *    否则墨迹一半沉到基线下面、顶到弧上。
		 * ⚠️ **不给 tspan 写绝对 x**：横向靠「父级 x + 锚点 middle」——库那个 `3` 的 x 就是弧心，
		 *    而 ⑪ justify 是逐元素重写 x（只认 text 自己的 x，看不清 tspan 上的绝对 x），
		 *    写死绝对 x 的话弧被移走、字却留在原地（实测偏左 15px，用户：「怎么还有点偏移」）。
		 * ⚠️ 必须排在 `curveJianpuTieLines` **之后**：弧可能被「避让高音点」抬过，位置得按最终几何读。
		 * ⚠️ 也必须排在 `evenJianpuBarGaps` **之后**：那一步会把 tieline 层按「块内平移、块间线性插值」映射一遍，
		 *    标签的 x 常落在两块之间的留白里 ⇒ 被插值挪走，而弧的两个端点都在块内 ⇒ 原地不动，
		 *    数字就相对自己的弧偏掉（实测偏 1.2px）。放在最后就按**最终几何**把缺口劈开、把数字摆正。
		 */
		function placeJianpuTripletLabels(host: HTMLElement) {
			const tieline = host.querySelector('svg g[sn-tag="tieline"]');
			if (!tieline) return;
			Array.from(tieline.querySelectorAll('text[data-jianpu-triplet-label]')).forEach((label) => {
				const nth = label.getAttribute('data-jianpu-triplet-label');
				const arc = tieline.querySelector('path[data-jianpu-triplet="' + nth + '"]');
				if (!arc) return;
				const n = label.getAttribute('data-jianpu-tuplet-n') || '3';
				const size = bravuraDigitSize(JIANPU_TRIPLET_LABEL_SIZE);
				const ink = bravuraDigitMetrics(n, size);
				const put = (x: number, baseline: number) => {
					label.textContent = '';
					label.setAttribute('text-anchor', 'middle');
					label.setAttribute('x', x.toFixed(2));
					drawBravuraDigits(label, n, size, null, false, baseline);
				};
				// 到这一步弧已经过 `curveJianpuTieLines` = 纺锤形：上缘 ryOut、下缘 ryIn 两条共享端点的弧
				const SP = /^M\s*([\d.eE+-]+)\s+([\d.eE+-]+)\s*A\s*([\d.eE+-]+)\s+([\d.eE+-]+)\s+([\d.eE+-]+)\s+([01])\s+([01])\s+([\d.eE+-]+)\s+([\d.eE+-]+)\s*A\s+[\d.eE+-]+\s+([\d.eE+-]+)/.exec((arc.getAttribute('d') || '').trim());
				if (!SP) {
					// 认不出来（还没改成纺锤形）→ 退回旧行为：贴到弧顶上方
					const m0 = /^M\s*([\d.eE+-]+)\s+([\d.eE+-]+)\s*A\s+[\d.eE+-]+\s+([\d.eE+-]+)/.exec((arc.getAttribute('d') || '').trim());
					if (!m0) return;
					put(parseFloat(m0[1]), parseFloat(m0[2]) - parseFloat(m0[3]) - JIANPU_TRIPLET_LABEL_GAP - ink.asc);
					return;
				}
				const x1 = parseFloat(SP[1]);
				const y = parseFloat(SP[2]);
				const rx = parseFloat(SP[3]);
				const ryOut = parseFloat(SP[4]);
				const rot = SP[5];
				const laf = SP[6];
				const sw = SP[7];
				const x2 = parseFloat(SP[8]);
				const ryIn = parseFloat(SP[10]);
				const swBack = sw === '1' ? '0' : '1'; // 回程弧用相反 sweep，才能与上缘合成纺锤形
				const xm = (x1 + x2) / 2;
				// 中间为数字劈开：左右各半个纺锤，**共用同一个 rx / ry** ⇒ 两半拼起来仍是原来那条弧的上下缘，
				// 切口处厚度自然归零（用户：「圆滑线中间劈开放个 3，同时保持圆滑线的美观性」）
				const half = ink.total / 2 + JIANPU_TRIPLET_SPLIT_GAP;
				const cutL = xm - half;
				const cutR = xm + half;
				// ⚠️ 切口必须**落在弧上**（垂直切线），不能连到弦线：`M x1 y A rx ryOut … cutL y` 的两个端点
				//    要同时落在原椭圆上，否则浏览器只能换一条椭圆 ⇒ 画出来几乎是直线（实测弧高 0.4px）。
				const s = Math.sqrt(Math.max(0.02, 1 - Math.pow(half / rx, 2)));
				const oL = y - ryOut * s;
				const iL = y - ryIn * s;
				arc.setAttribute(
					'd',
					'M ' + x1 + ' ' + y + ' A ' + rx + ' ' + ryOut + ' ' + rot + ' ' + laf + ' ' + sw + ' ' + cutL + ' ' + oL.toFixed(2) + ' L ' + cutL + ' ' + iL.toFixed(2) + ' A ' + rx + ' ' + ryIn + ' ' + rot + ' ' + laf + ' ' + swBack + ' ' + x1 + ' ' + y + ' Z ' +
						'M ' + cutR + ' ' + iL.toFixed(2) + ' L ' + cutR + ' ' + oL.toFixed(2) + ' A ' + rx + ' ' + ryOut + ' ' + rot + ' ' + laf + ' ' + sw + ' ' + x2 + ' ' + y + ' A ' + rx + ' ' + ryIn + ' ' + rot + ' ' + laf + ' ' + swBack + ' ' + cutR + ' ' + iL.toFixed(2) + ' Z'
				);
				// 数字嵌进缺口：横向居中到劈口，纵向墨迹底端距弦线 JIANPU_TRIPLET_LABEL_GAP
				put(xm, y - JIANPU_TRIPLET_LABEL_GAP - ink.desc);
			});
		}

		/**
		 * 库的连音线（tieline 层）画得太平：`drawSingleTieLine` 用 radiusY = 跨度 × 0.08，
		 * 相邻两音（跨度 23～26px）只隆起 1.7～1.9px，读不出是「弧」，看着就是一条横线。
		 * 这里按真排版的做法重画成**两端细、中间粗的纺锤形**（填充轮廓，不是描边）：
		 * 上缘/下缘 = 两条共享端点的椭圆弧（rx 相同、ry 相差 JIANPU_TIE_THICK），闭合后 fill。
		 * 再整体下移 JIANPU_TIE_DROP，让弧贴近音符；ry 仍按跨度×0.18 并夹在 2.6～6px。
		 * ⚠️ 只改 g[sn-tag="tieline"] 里的 path；跨行连音线的跨度可能几百 px，所以必须夹上限。
		 */
		function curveJianpuTieLines(host: HTMLElement) {
			const RE = /^M\s*([\d.eE+-]+)\s+([\d.eE+-]+)\s*A\s*([\d.eE+-]+)\s+([\d.eE+-]+)\s+([\d.eE+-]+)\s+([01])\s+([01])\s+([\d.eE+-]+)\s+([\d.eE+-]+)$/;
			// 连音线要按「音符实际高度」定位：高音点（八度点）会把音符顶得更高，
			// 而库的连音线 y 是按固定的 `音符 y + 偏移` 算的 → 有高音点时弧会压在点上
			// （实测重叠 3px）。先把每个音符组基线上方的八度点顶边收集起来。
			// ⚠️ 只能用「局部坐标」（属性 / getBBox）：这一步跑在离屏容器里，
			//    此时 getBoundingClientRect() 全是 0（stave / 音符组 / score 都没有 transform，
			//    所以 tieline 层的坐标与音符属性坐标是同一套）。
			const noteDots: { cx: number; base: number; dotTop: number }[] = [];
			host.querySelectorAll('svg g[sn-tag^="note-"]').forEach((g) => {
				const digit = Array.from(g.querySelectorAll(':scope > text')).find((t) => t.getAttribute('font-size') === '18');
				if (!digit) return;
				const base = parseFloat(digit.getAttribute('y') || '0');
				let dotTop = Infinity;
				g.querySelectorAll('circle').forEach((c) => {
					const top = parseFloat(c.getAttribute('cy') || '0') - parseFloat(c.getAttribute('r') || '0');
					if (top < base) dotTop = Math.min(dotTop, top); // 只认基线上方的；低八度点在下方，不参与
				});
				noteDots.push({ cx: parseFloat(digit.getAttribute('x') || '0'), base, dotTop });
			});
			// 连音线可能套连音线：内层（跨度小）先定位，外层再抬到它上面 → 先按跨度升序排好
			const placedTies: { x1: number; x2: number; baseY: number; top: number }[] = [];
			const tieItems: { p: Element; m: RegExpExecArray; x1: number; x2: number; span: number }[] = [];
			host.querySelectorAll('svg g[sn-tag="tieline"] path').forEach((p) => {
				const m = RE.exec((p.getAttribute('d') || '').trim());
				if (!m) return;
				const x1 = parseFloat(m[1]);
				const x2 = parseFloat(m[8]);
				tieItems.push({ p, m, x1, x2, span: Math.abs(x2 - x1) });
			});
			tieItems.sort((a, b) => a.span - b.span);
			tieItems.forEach(({ p, m, x1: x1t, x2: x2t, span }) => {
				const rxt = span / 2;
				// ⚠️ **rx 直接用「最终跨度的一半」**（2026-10-02）：库给的 `rx` 是按**它渲染那一刻**的跨度算的，
				//    而 ⑪ justify 会把整行按墨迹重新拉伸（只改端点坐标、**不动 rx**）⇒ 到这一步 rx 与真实跨度已经对不上：
				//    浏览器要么按规范把椭圆等比放大、要么把它压扁，弧高就失控（实测跨行那条 ry 被算成 48，
				//    画成一个巨大的拱——用户：「0928 那个文章显示的不对」）。半径取 span/2 后浏览器不再做任何补齐，
				//    弧高就是 riseEff，稳。（原来那套「算 k 再除回去」的补偿就是为这个错位打的补丁，现在不需要了。）
				const baseY = parseFloat(m[2]) + JIANPU_TIE_DROP; // 未抬升的 y（同一行所有弧都相同，用来判同行）
				let yt = baseY;
				// ⚠️ 库给的 rx 常常小于弦长的一半（跨不过两个端点），此时浏览器会按 SVG 规范
				// 把 rx / ry **等比放大 k 倍**——弧高和厚度都跟着被缩放，而 k 逐条不同
				// （实测 k = 1.124 / 1.0 / 0.85 → 厚度 2.7 / 2.4 / 2.04，粗细不一致）。
				// 所以这里先把目标值除以 k，画出来才是统一的粗细与弧高。
				const halfRatio = span / 2 / rxt; // = √Λ
				const k = halfRatio >= 1 ? halfRatio : 1 - Math.sqrt(1 - halfRatio * halfRatio);
				let riseEff = Math.min(6, Math.max(2.6, span * 0.18)); // 目标「有效」弧高（套连音线时会加大）
				const thickEff = JIANPU_TIE_THICK; // 目标「有效」厚度（= JIANPU_TIE_THICK）
				// 这条连音线所辖的音符：x 落在两端之间、纵向同属一行（数字基线总在弧下方 ~9～17px）
				const tied = noteDots.filter(
					(n) => Math.abs(n.base - yt) < 25 && n.cx > x1t - 4 && n.cx < x2t + 4
				);
				const dotTop = Math.min(...tied.map((n) => n.dotTop));
				// 抬到「最高那个高音点上方 JIANPU_TIE_DOT_GAP」；没高音点、或本来就够高就不动（只会抬不会降）
				if (Number.isFinite(dotTop) && dotTop - JIANPU_TIE_DOT_GAP < yt) yt = dotTop - JIANPU_TIE_DOT_GAP;
				// 套连音线：**两端仍留在音符上**（yt 不动），只把中间那道弧加大到能从内层弧上方越过
				// —— 像真排版那样「外层更高、两端齐平」，而不是整根抬上去（两端会离音符很远）。
				// 内层判定：两端 x 被本条包住、且同一行（不判同行会误伤别行跨 x 重叠的弧）。
				//
				// ⚠️ 净空要按「**外层下缘** to **内层上缘**」算，不能只比两个弧顶：两条弧都有厚度
				//    （JIANPU_TIE_THICK），只比顶边会漏掉外层自己那 2.4px → 实测贴在一起（0.08px）。
				//    两条弧共用同一条弦线（端点同高），最紧的地方是**内层的峰值处**：
				//    需要 riseOut × e ≥ riseIn + thick + gap，e = 外层弧在该 x 处的归一化高度。
				// ⚠️ 嵌套/连续（2026-10-02）起，内层与外层**可以共享端点**（`(1(23))` 的两条都收在音 3 上）
				//    ⇒ 判定放宽成「含相等」，否则外层会从内层身上穿过去。
				//    相邻但不嵌套的两条（`(3(5)6)` 的 3→5 与 5→6）跨度互不包含 ⇒ 仍不会被误判。
				placedTies.forEach((inner) => {
					if (!(Math.abs(inner.baseY - baseY) < 1 && inner.x1 >= x1t - 1 && inner.x2 <= x2t + 1 && inner.x2 - inner.x1 < x2t - x1t)) return;
					const riseIn = yt - thickEff / 2 - inner.top; // 内层弧顶相对本条弦线的高度
					const dxN = (inner.x1 + inner.x2) / 2 - (x1t + x2t) / 2;
					const e = Math.sqrt(Math.max(0.05, 1 - Math.pow(dxN / (span / 2), 2)));
					const need = (riseIn + thickEff + JIANPU_TIE_NEST_GAP) / e;
					if (need > riseEff) riseEff = need; // 只加大，不缩小
				});
				placedTies.push({ x1: x1t, x2: x2t, baseY, top: yt - (riseEff + thickEff / 2) });
				const rise = riseEff;
				const thick = thickEff;
				// 纺锤形填充：上缘 / 下缘两条共享端点的椭圆弧（rx 相同、ry 相差 thick），
				// 共用端点 → 厚度按 sin 从两端 0 平滑过渡到中间 thick，无台阶。
				const ryOut = rise + thick / 2;
				const ryIn = Math.max(0.4, rise - thick / 2); // 夹正数：否则下缘会翻到上缘外面
				const rot = m[5];
				const laf = m[6];
				const swBack = m[7] === '1' ? '0' : '1'; // 回程弧用相反 sweep，才能与上缘合成纺锤形
				p.setAttribute(
					'd',
					'M ' + x1t + ' ' + yt +
						' A ' + rxt + ' ' + ryOut.toFixed(2) + ' ' + rot + ' ' + laf + ' ' + m[7] + ' ' + x2t + ' ' + yt +
						' A ' + rxt + ' ' + ryIn.toFixed(2) + ' ' + rot + ' ' + laf + ' ' + swBack + ' ' + x1t + ' ' + yt + ' Z'
				);
				// 改成填充：fill=black 会被 CSS 的 [fill='black'] 接管（跟随主题色）；
				// 描边必须去掉，否则「细描边 + 填充」会重新变成等宽粗线。
				p.setAttribute('fill', 'black');
				p.setAttribute('stroke', 'none');
				p.removeAttribute('stroke-width');
			});
		}

		/**
		 * 倚音（`<5/16>` 这种）按**真实墨迹**重新定位。
		 *
		 * 库按主数字 18px 定了写死的偏移（比主数字左 ~20px、上 ~16.5px）和 12px 字号，
		 * 但我们把主数字放大到 20px、字体也换成衬线（字形比宋体宽）→ 实测倚音横向间隙 6.5～6.8px（偏散）、
		 * 纵向只有 1.5～2.5px（太贴），一松一紧。
		 * 这里跟变音记号同一套：横向 = 倚音墨迹右端距主数字墨迹左端 `JIANPU_GRACE_GAP`；
		 * 纵向 = 倚音墨迹底部距主数字墨迹顶部 `JIANPU_GRACE_ABOVE`（字号靠 CSS 改成 13.3px = 12 × 20/18）。
		 *
		 * ⚠️ **一个音符组里可能有好几个倚音**（`{5 6}`）：库按 8px 间距摆（12px 字号下挤在一起、还串行），
		 *    所以这里从右往左逐个摆 —— 最右那个贴住主数字，往左每个留 `JIANPU_GRACE_STEP` 的**墨迹净空**，
		 *    整组共用同一个基线（组内最低的墨迹底端 = 目标底端）。
		 * ⚠️ 倚音在音符组里**不是独立分组**：它自己 + 它的下划线（组内 `line[stroke-width="0.5"]`，画时值）
		 *    都是兄弟节点 ⇒ 必须一起平移（下划线与倚音按**原 x 对齐**配对），否则会和下划线错开。
		 * ⚠️ 引导弧跟着**最右**那个倚音走（弧本来就起在最后一个倚音的右下）。
		 * ⚠️ 要排在 `fixJianpuGraceNotes` 之前（那一步会把标记弧对齐到下划线下方，弧的纵向不用这里管）。
		 * ⚠️ 依赖字体度量 → 字体未就绪时量到的是兜底字形，故渲染完会等字体就绪再重排一次（见 renderJianpuScore 尾部）。
		 */
		function placeJianpuGraceNotes(host: HTMLElement) {
			const cv = document.createElement('canvas').getContext('2d');
			const ink = (el: Element, ch: string) => {
				const cs = getComputedStyle(el);
				if (!cv) return { left: 0, right: 0, adv: 0, asc: 0, desc: 0 };
				cv.font = cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
				const m = cv.measureText(ch);
				return { left: m.actualBoundingBoxLeft, right: m.actualBoundingBoxRight, adv: m.width, asc: m.actualBoundingBoxAscent, desc: m.actualBoundingBoxDescent };
			};
			const num = (el: Element, a: string) => parseFloat(el.getAttribute(a) || '0');
			try {
				host.querySelectorAll('svg g[sn-tag^="note-"]').forEach((g) => {
					// 倚音数字 = 组内 12px 的 text，但**排除**变音记号（那些是 Bravura 字形）
					const graces = Array.from(g.querySelectorAll(':scope > text[font-size="12"]')).filter((t) => !/Bravura/.test(t.getAttribute('font-family') || ''));
					if (!graces.length) return;
					const digit = Array.from(g.querySelectorAll(':scope > text')).find((d) => d.getAttribute('font-size') === '18');
					if (!digit) return;
					const di = ink(digit, digit.textContent || '');
					const digitInkLeft = inkLR(digit, digit.textContent || '')?.[0] ?? num(digit, 'x') - di.adv / 2 + di.left; // 数字是 text-anchor=middle
					const targetRight = digitInkLeft - JIANPU_GRACE_GAP;
					const targetBottom = num(digit, 'y') - di.asc - JIANPU_GRACE_ABOVE;
					// 逐个量墨迹：**横向用渲染出来的盒子**（倚音锚点是 start ⇒ 宽度就是真实墨迹宽），
					// 拿不到就退回 canvas（见 inkLR）；纵向仍用 canvas 的墨迹高/低
					const items = graces
						.map((el) => {
							const i = ink(el, el.textContent || '');
							const b = inkLR(el, el.textContent || '');
							const x0 = num(el, 'x');
							return { el, i, x0, y0: num(el, 'y'), inkLeft: b ? b[0] : x0 + i.left, inkRight: b ? b[1] : x0 + i.right };
						})
						.sort((a, b) => a.x0 - b.x0);
					const baseline = targetBottom - Math.max(...items.map((it) => it.i.desc));
					// 从右往左摆：最右那个的墨迹右端贴 targetRight，往左每个再留 JIANPU_GRACE_STEP 净空
					const moves = new Map<Element, { dx: number; dy: number }>();
					let cursor = targetRight;
					items
						.slice()
						.reverse()
						.forEach((it) => {
							const inkLeftWanted = cursor - (it.inkRight - it.inkLeft);
							moves.set(it.el, { dx: inkLeftWanted - it.inkLeft, dy: baseline - it.y0 });
							cursor = inkLeftWanted - JIANPU_GRACE_STEP;
						});
					// 减时线（下划线）：库写死画成「倚音锚点 → +6px」（13.3px 下盖不满墨迹），而且**同一拍里相邻
					// 倚音同层的线要接起来**（标准记谱：两个十六分倚音共用一条下划线），范围按所盖倚音的墨迹取。
					// ⚠️⚠️ 归属**只看 DOM 顺序**、不看 x：库是「画完这个倚音的数字，紧接着画它的下划线」，
					//    按 x 猜在窄屏/字体没就绪时会整片错位（实测四条下划线全被判给第二个倚音 ⇒ 第一个的线消失，
					//    用户：「刷新加载瞬间两个都有，加载好之后就成一个了」）。
					const accs = Array.from(g.querySelectorAll(':scope > circle')).filter((c) => parseFloat(c.getAttribute('r') || '0') === 1); // 倚音自己的八度点
					const kids = Array.from(g.children);
					const at = items.map((it) => kids.indexOf(it.el));
					const linesOf: Element[][][] = items.map(() => []); // [第几个倚音][第几层]
					kids.forEach((el, k) => {
						if (el.tagName.toLowerCase() !== 'line' || el.getAttribute('stroke-width') !== '0.5') return;
						let gi = -1;
						at.forEach((idx, j) => {
							if (idx >= 0 && idx < k) gi = j; // 它前面最近的那个倚音
						});
						if (gi < 0) return;
						const byLv = linesOf[gi];
						(byLv[byLv.length] ||= []).push(el); // 层序 = DOM 序（库按 u 升序画）
					});
					// 倚音的数字 / 八度点先跟着自己走
					items.forEach((it) => {
						const mv = moves.get(it.el);
						if (!mv) return;
						it.el.setAttribute('x', String(it.x0 + mv.dx));
						it.el.setAttribute('y', String(it.y0 + mv.dy));
						// 倚音自己的低音点：横向居中到倚音墨迹中心，纵向摆到「它那条减时线**下方**」——库原来把它画得
						// 和线同高，线从点中间穿过去（用户：「倚音的低音点显示不正确」）。间距照主音符那套（基线 + 7.5）。
						const dotCx = (it.inkLeft + it.inkRight) / 2 + mv.dx;
						accs
							.filter((c) => Math.abs(num(c, 'cx') - it.x0) < 12)
							.forEach((c) => {
								c.setAttribute('cx', String(dotCx));
								c.setAttribute('cy', String(baseline + JIANPU_GRACE_DOT_DROP));
							});
					});
					const lvCount = Math.max(0, ...linesOf.map((a) => a.length));
					for (let lv = 0; lv < lvCount; lv++) {
						let run: number[] = [];
						const flush = () => {
							const pair = run.map((gi) => ({ gi, el: linesOf[gi][lv][0] }));
							pair.forEach(({ gi, el }) => {
								const dy = moves.get(items[gi].el)?.dy || 0;
								['y1', 'y2'].forEach((a) => el.setAttribute(a, String(num(el, a) + dy)));
							});
							const l = Math.min(...pair.map(({ gi }) => items[gi].inkLeft + (moves.get(items[gi].el)?.dx || 0)));
							const r = Math.max(...pair.map(({ gi }) => items[gi].inkRight + (moves.get(items[gi].el)?.dx || 0)));
							pair[0].el.setAttribute('x1', String(l));
							pair[0].el.setAttribute('x2', String(r));
							pair.slice(1).forEach(({ el }) => el.remove());
							run = [];
						};
						linesOf.forEach((a, gi) => {
							if (a[lv] && a[lv].length) run.push(gi);
							else if (run.length) flush();
						});
						if (run.length) flush();
					}
					// 引导弧：库画的是**主数字左边那个 5×5 的小四分之一弧**，横向基准是 `innerX`（= 音符**时值槽的左缘**，
					// 不是数字中心！`drawOctaveCount`/时值线都用 innerX..innerX+innerWidth 这套）⇒ 弧落在槽左缘外侧、
					// 倚音正右方。⚠️ 两个都错过一次：整条平移 / 只挪一端 → 端点压到别的音；拿**数字中心**当基准
					//   → 整条弧右移半个数字（≈5.7px）压到数字身上（用户：「倚音的线这不是又跑到里头去了」）。
					// 也不能跟着 justify 缩放：那个 5px 弦会被乘上整行拉伸系数（实测 s≈5.7 ⇒ 28.6px），
					// 再经 ⑦c 的叶片形就成了一条长圆滑线。⇒ 按**数字墨迹左端**（≈ innerX）照库的公式重画，纵向原样。
					const arc = Array.from(g.querySelectorAll(':scope > path')).find((p) => /^M\s*[-\d.eE+]+\s+[-\d.eE+]+\s*A\s*5\s+5\s/.test((p.getAttribute('d') || '').trim()));
					if (arc) {
						const AM = /^M\s*([-\d.eE+]+)\s+([-\d.eE+]+)\s+A\s*([-\d.eE+]+)\s+([-\d.eE+]+)\s+([-\d.eE+]+)\s+([01])\s+([01])\s+([-\d.eE+]+)\s+([-\d.eE+]+)$/.exec((arc.getAttribute('d') || '').trim());
						if (AM) {
							// 弧**头**（上端）对准**倚音组墨迹的中央**：一个音就是那个音的中心，两个音就是两者之间；
							// 尾（下端）落在组的右缘（= 数字墨迹左端 − `JIANPU_GRACE_GAP`，贴着主数字）。
							// 半径取弦长 ⇒ 仍是库那种 90° 四分之一弧（库：弦 5√2、半径 5）。
							// ⚠️ 别改成「横跨最后一个音」那种（用户 2026-10-01 明确否掉）。
							const first = items[0];
							const lastIt = items[items.length - 1];
							const gL = first.inkLeft + (moves.get(first.el)?.dx || 0);
							const gR = lastIt.inkRight + (moves.get(lastIt.el)?.dx || 0);
							const cx = (gL + gR) / 2;
							const side = Math.max(2.5, gR - cx);
							const y1 = +AM[2];
							arc.setAttribute('d', `M ${cx.toFixed(2)} ${AM[2]} A ${side.toFixed(2)} ${side.toFixed(2)} ${AM[5]} ${AM[6]} ${AM[7]} ${gR.toFixed(2)} ${(y1 + side).toFixed(2)}`);
						}
					}
				});
			} catch {
				/* 容器不可见时 getBBox 会抛错：保持库原样 */
			}
		}

		/**
		 * 倚音标记弧「跟着下划线走」。库 `drawGraceNote` 把弧的 y 写死为 `innerY + 20`，
		 * 而倚音自己的下划线（8/16/32 分音符）画在同一高度上 →
		 * 实测：弧起点 y=621、下划线 y=621.5 / 623.5，x 也重叠，两笔撞在一起。
		 * 这里把弧整体下移到「最后一条下划线下方 1px」；没有下划线时 dy=0，位置完全不变。
		 * ⚠️ 倚音下划线的标记：库给它写的是 stroke-width="0.5"（音符组内独有的细线）。
		 */
		function fixJianpuGraceNotes(host: HTMLElement) {
			// ⚠️ 半径不能用固定值：`placeJianpuGraceNotes` 会按倚音墨迹重算弦长（半径 = 弦长）⇒ 这里只要求
			//    「一个 90° 弧（rot/laf/sweep = 0 0 0）」
			const ARC_RE = /^M\s*([\d.eE+-]+)\s+([\d.eE+-]+)\s*A\s*([\d.eE+-]+)\s+([\d.eE+-]+)\s+0\s+0\s+0\s+([\d.eE+-]+)\s+([\d.eE+-]+)$/;
			host.querySelectorAll('svg g[sn-tag^="note-"]').forEach((g) => {
				const arc = Array.from(g.querySelectorAll('path')).find((p) => ARC_RE.test((p.getAttribute('d') || '').trim()));
				if (!arc) return;
				const under = Array.from(g.querySelectorAll('line')).filter((l) => l.getAttribute('stroke-width') === '0.5');
				if (!under.length) return;
				const m = ARC_RE.exec((arc.getAttribute('d') || '').trim());
				if (!m) return;
				// 下移基准 = 「最后一条减时线」与「倚音低音点的下沿 + 净空」里更靠下的那个：
				// 点在线下方（见 `placeJianpuGraceNotes`）⇒ 弧不能让线给它的位置，得再让开那个点。
				const lineBase = Math.max(...under.map((l) => parseFloat(l.getAttribute('y1') || '-Infinity')));
				const dots = Array.from(g.querySelectorAll(':scope > circle')).filter((c) => parseFloat(c.getAttribute('r') || '0') === 1);
				const dotBase = dots.length
					? Math.max(...dots.map((c) => parseFloat(c.getAttribute('cy') || '-Infinity') + parseFloat(c.getAttribute('r') || '0'))) + JIANPU_GRACE_ARC_DOT_GAP
					: -Infinity;
				const dy = Math.max(lineBase, dotBase) + 1 - parseFloat(m[2]);
				if (!(dy > 0)) return;
				arc.setAttribute(
					'd',
					'M ' + m[1] + ' ' + (parseFloat(m[2]) + dy) + ' A ' + m[3] + ' ' + m[4] + ' 0 0 0 ' + m[5] + ' ' + (parseFloat(m[6]) + dy)
				);
			});
		}

		/**
		 * 倚音的**引导线**（库画成一条 1px 描边的圆弧 `M x y A 5 5 0 0 0 …`，从倚音右下指向主数字）。
		 * 改成和连音线同一套「两端细、中间粗」的叶片形（填充轮廓，不是描边）——形状与连音线不同：
		 * 连音线两端几乎同高、弧很扁；这条是斜着的 90° 小圆弧。
		 * ⚠️ 这里**不能用连音线那套「rx 不变、ry 加/减 T/2」**——那条弧的弓高只有 1.48px，
		 *    ry 加减 1.2 实测只能做出 **0.75px** 的厚度（比原来的 1px 描边还细），而且
		 *    ry 与弓高的关系是**非单调**的（最小在 ry≈8，往两边都变大）→ 不能按 T/2 算。
		 * 改用**同心圆族**：把库的弧看成半径 rx 的圆（库写死 5×5），原弓高 s0 = rx − √(rx²−h²)
		 * （h = 半弦长）；上缘 / 下缘取弓高为 s0 ± T/2 的**两个圆**，由弓高反推半径
		 * r = (h² + s²)/(2s) → 两圆都过同样两个端点（厚度在两端归零）、厚度单调过渡、弧形状不变。
		 * ⚠️ 必须排在 `fixJianpuGraceNotes`（⑦b）**之后**：那一步是拿 `M x y A 5 5 …` 的原样正则改 y 的，
		 *    先转换就匹配不上了，弧会重新压到下划线上。
		 */
		function taperJianpuGraceArcs(host: HTMLElement) {
			const RE = /^M\s*([\d.eE+-]+)\s+([\d.eE+-]+)\s*A\s*([\d.eE+-]+)\s+([\d.eE+-]+)\s+([\d.eE+-]+)\s+([01])\s+([01])\s+([\d.eE+-]+)\s+([\d.eE+-]+)$/;
			host.querySelectorAll('svg g[sn-tag^="note-"]').forEach((g) => {
				// 只认倚音所在的音符组（组内有 fs=12 的倚音数字），组内的那条 path 就是引导线
				if (!g.querySelector(':scope > text[font-size="12"]')) return;
				const arc = Array.from(g.querySelectorAll(':scope > path')).find((p) => RE.test((p.getAttribute('d') || '').trim()));
				if (!arc) return;
				const m = RE.exec((arc.getAttribute('d') || '').trim());
				if (!m) return;
				const x1 = parseFloat(m[1]);
				const y1 = parseFloat(m[2]);
				const rx = parseFloat(m[3]);
				const x2 = parseFloat(m[8]);
				const y2 = parseFloat(m[9]);
				const half = Math.hypot(x2 - x1, y2 - y1) / 2; // 半弦长
				const thick = half * 2 * JIANPU_GRACE_ARC_RATIO; // 最大厚度：按弦长缩放（见常量注释）
				const s0 = Math.max(0.05, rx - Math.sqrt(Math.max(0, rx * rx - half * half))); // 原弧弓高
				// 目标弓高（夹住：弓高不能超过半弦长，否则反推不出半径）
				const sOut = Math.min(s0 + thick / 2, half * 0.999);
				const sIn = Math.max(0.05, s0 - thick / 2);
				const rOut = (half * half + sOut * sOut) / (2 * sOut);
				const rIn = (half * half + sIn * sIn) / (2 * sIn);
				const swBack = m[7] === '1' ? '0' : '1'; // 回程弧用相反 sweep，才能与上缘合成叶片形
				arc.setAttribute(
					'd',
					'M ' + x1 + ' ' + y1 +
						' A ' + rOut.toFixed(2) + ' ' + rOut.toFixed(2) + ' ' + m[5] + ' ' + m[6] + ' ' + m[7] + ' ' + x2 + ' ' + y2 +
						' A ' + rIn.toFixed(2) + ' ' + rIn.toFixed(2) + ' ' + m[5] + ' ' + m[6] + ' ' + swBack + ' ' + x1 + ' ' + y1 + ' Z'
				);
				// 改成填充：fill=black 交给 CSS 的 [fill='black']（跟随主题色）；描边必须去掉，
				// 否则「细描边 + 填充」会重新变成等宽线条。
				arc.setAttribute('fill', 'black');
				arc.setAttribute('stroke', 'none');
				arc.removeAttribute('stroke-width');
			});
		}

		/**
		 * 反复记号的两个点：（a）库默认间距 20px（r=1.8 的圆点，中心在线的中点上下各 10px），
		 * 收拢到 JIANPU_DOT_SPAN（10px，上下各 5px）；（b）**横向也要贴住竖线** —— 库给 `:|` 的圆点
		 * 离竖线 ~10px（而 `|:` 只有 ~3px，左右不对称，用户：「右反复记号的点和线分隔太大了吧」）
		 * → 近侧边缘统一留 JIANPU_REPEAT_DOT_GAP。只认 r>1.7 的圆点——
		 * 八度点/顿音点都是 r=1.5、倚音八度点 r=1，不会误伤。按同 cx 成对处理。
		 *
		 * ⚠️ 纵向中心取**那根竖线的中点**，不是圆点自己的均值：小节线在 ④ 里被整体上移过 JIANPU_BAR_RAISE，
		 *    圆点跟着线才居中（拿自己的均值算会在下方浮 2px —— 用户：「俩点没和那俩线居中」）。
		 *    所以本步必须排在 ④ 之后。
		 */
		function tightenJianpuRepeatDots(host: HTMLElement) {
			const byX = new Map<string, Element[]>();
			host.querySelectorAll('svg circle').forEach((c) => {
				if (parseFloat(c.getAttribute('r') || '0') < 1.7) return;
				const cx = c.getAttribute('cx') || '';
				const arr = byX.get(cx);
				if (arr) arr.push(c);
				else byX.set(cx, [c]);
			});
			byX.forEach((dots) => {
				if (dots.length < 2) return;
				const count = dots.length;
				const cy = (c: Element) => parseFloat(c.getAttribute('cy') || '0');
				const cx0 = parseFloat(dots[0].getAttribute('cx') || '0');
				const r = parseFloat(dots[0].getAttribute('r') || '1.8');
				const anchor = dots.reduce((s, c) => s + cy(c), 0) / count; // 只用来找线，不当中心
				const bars = Array.from(host.querySelectorAll('svg g[sn-tag^="stave-"] > line'))
					.map((l) => ({ x: parseFloat(l.getAttribute('x1') || '0'), mid: (parseFloat(l.getAttribute('y1') || '0') + parseFloat(l.getAttribute('y2') || '0')) / 2 }))
					.filter((b) => Math.abs(b.mid - anchor) < 20 && Math.abs(b.x - cx0) < 26)
					.sort((a, b) => Math.abs(a.x - cx0) - Math.abs(b.x - cx0));
				if (!bars.length) return;
				const bar = bars[0];
				// 纵向：围绕竖线中点摊成 JIANPU_DOT_SPAN（上下各 5px）
				const step = JIANPU_DOT_SPAN / 2;
				dots.slice().sort((a, b) => cy(a) - cy(b)).forEach((c, i) => {
					c.setAttribute('cy', String(bar.mid - step + (i * JIANPU_DOT_SPAN) / (count - 1)));
				});
				// 横向：把圆点挪到「近侧边缘距该线 JIANPU_REPEAT_DOT_GAP」。点在哪侧由原来的 cx 决定，左右反复号都能用。
				const nc = cx0 > bar.x ? bar.x + JIANPU_REPEAT_DOT_GAP + r : bar.x - JIANPU_REPEAT_DOT_GAP - r;
				dots.forEach((c) => c.setAttribute('cx', String(nc)));
			});
		}

		/**
		 * 变音记号字形的**墨迹常量**（em，× 字号）—— 为什么不用 canvas 量：
		 * 库那份 `Bravura` 是**每次渲染都重新注入 @font-face** 的，注入的那一帧里 canvas 只会量到
		 * 兜底字形的 .notdef 方块（宽度 = 字号）⇒ 算出来的位置整体偏 ~8px（实测 ♯ 量出 13px、实际 5px）。
		 * 跟 `src/lib/bravura-digits.ts` 是同一个教训：**字体给不了确定度量，就用常量**。
		 * 实测自库的 Bravura（13.3px 与 26.6px 两档一致；adv 线性，墨迹左右受 canvas 像素取整影响，误差 ≤0.5px）。
		 */
		const JIANPU_ACC_INK: Record<string, { l: number; r: number; asc: number; desc: number }> = {
			'\uED60': { l: 0.075, r: 0.376, asc: 0.752, desc: 0 }, // ♭
			'\uED61': { l: 0.075, r: 0.301, asc: 0.752, desc: 0 }, // ♮（还原号）
			'\uED62': { l: 0.075, r: 0.376, asc: 0.827, desc: 0.075 }, // ♯
			'\uED63': { l: 0.075, r: 0.526, asc: 0.451, desc: 0 }, // 𝄪
			'\uED64': { l: 0.075, r: 0.677, asc: 0.752, desc: 0 }, // 𝄫
		};
		/** 原文里的变音记号 → 上图用的字形（`=` = 还原号） */
		const JIANPU_ACC_GLYPH: Record<string, string> = {
			'#': '\uED62',
			'##': '\uED63',
			b: '\uED60',
			bb: '\uED64',
			'=': '\uED61',
		};

		/**
		 * 变音记号（升号 ♯ / 降号 ♭）：库用 Bravura 字体的 **12px** `<text>` 画在音符左上角
		 * （`text-anchor="start"`）。库给的字号偏小 → 放大到 JIANPU_ACC_SIZE。
		 *
		 * ⚠️ 横向**不能写死左移多少**：库给的位置只按数字宽度算，放大后会压住数字，而且
		 * **双升/双降（`##`/`bb`）的字形比单记号宽约 3px**（实测 U+ED63 宽 8.8px、U+ED62 宽 6.4px），
		 * 写死一个偏移量必然有一边出错（实测：双记号与自己的数字重叠 0.7～1.5px）。
		 * 所以这里按**实际墨迹**定位：让「记号墨迹右端」距离「数字墨迹左端」正好 JIANPU_ACC_GAP；
		 * 同时不许越过左侧已有墨迹（行首那种情况：反复号的圆点）——至少留 JIANPU_ACC_MIN_GAP。
		 *
		 * ⚠️ 纵向同样按**真实墨迹**算：各字形的墨迹高度/位置差很多（实测 15px 下：♯ 高 13、𝄪 只有 7、
		 *    ♭ 12，且 Bravura 的降号在 advance 框内偏左偏下）→ 固定 y 偏移会把记号整体浮在数字上方。
		 *    现在把「记号墨迹中心」对到「数字墨迹顶 + 数字高度的 JIANPU_ACC_CENTER_DROP」＝数字左上角。
		 * ⚠️ 识别方式：`font-family` 里带 Bravura（音符组内唯一的这类 text；元素另有同值的内联 style）。
		 * ⚠️ 要排在 centerJianpuScore 之前：移动会改变谱面最左墨迹，居中得用挪完的位置算。
		 */
		function adjustJianpuAccidentals(host: HTMLElement) {
			const bb = (el: Element) => (el as SVGGraphicsElement).getBBox();
			// ⚠️ 定位必须用**真实墨迹**：`getBBox()` 给的是 advance 框，Bravura 的降号字形在框内偏左，
			// 按框定位会让实际间隙忽大忽小（实测 1.4 / 2.9 / 6.0 / 10.0px）。
			const cv = document.createElement('canvas').getContext('2d');
			const ink = (el: Element, ch: string) => {
				const cs = getComputedStyle(el);
				if (!cv) return { left: 0, right: 0, adv: 0, asc: 0, desc: 0 };
				cv.font = cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
				const m = cv.measureText(ch);
				return { left: m.actualBoundingBoxLeft, right: m.actualBoundingBoxRight, adv: m.width, asc: m.actualBoundingBoxAscent, desc: m.actualBoundingBoxDescent };
			};
			/**
			 * 变音记号字形的**墨迹常量**（em，× 字号）—— 为什么不用 canvas 量：
			 * 库那份 `Bravura` 是**每次渲染都重新注入 @font-face** 的，注入的那一帧里 canvas 只会量到
			 * 兜底字形的 .notdef 方块（宽度 = 字号）⇒ 算出来的位置整体偏 ~8px（实测 ♯ 量出 13px、实际 5px）。
			 * 跟 `src/lib/bravura-digits.ts` 是同一个教训：**字体给不了确定度量，就用常量**。
			 */
			const inkConst = (el: Element, ch: string) => {
				const g = JIANPU_ACC_INK[(ch || '').trim()] ?? JIANPU_ACC_INK['\uED62'];
				// ⚠️ 用**实际渲染字号**（CSS 把 12 放大成 13.3），不是 JIANPU_ACC_SIZE
				const size = parseFloat(getComputedStyle(el).fontSize) || JIANPU_ACC_SIZE;
				return { left: size * g.l, right: size * g.r, adv: size * g.r, asc: size * g.asc, desc: size * g.desc };
			};
			try {
				host.querySelectorAll('svg g[sn-tag^="stave-"]').forEach((stave) => {
					const accs = Array.from(stave.querySelectorAll('g[sn-tag^="note-"] > text[font-family*="Bravura"]'));
					if (!accs.length) return;
					accs.forEach((t) => {
						t.setAttribute('font-size', String(JIANPU_ACC_SIZE));
						const digit = Array.from(t.parentElement!.querySelectorAll(':scope > text')).find((d) => d.getAttribute('font-size') === '18');
						if (!digit) return;
						const ai = inkConst(t, t.textContent || '');
						const di = ink(digit, digit.textContent || '');
						const digitInkLeft = parseFloat(digit.getAttribute('x') || '0') - di.adv / 2 + di.left; // 数字是 text-anchor=middle
						// ① 横向：让「记号墨迹右端」距「数字墨迹左端」正好 JIANPU_ACC_GAP。
						// ⚠️ **不**再拿左侧元素的 `getBBox()` 去「避让」：那是 advance 框（比墨迹宽），
						//    八分音符那种窄间距下会把记号一路推到**自己的数字上**（实测窄屏 3/4 个记号
						//    与数字墨迹重叠 5～8px —— 用户：「宽度较小时会和音符、圆滑线糊在一起」）。
						//    挤不下时宁可轻微压到左边那个（advance 框差 ~1px，实际墨迹几乎不碰），
						//    也绝不能让记号压住自己的数字。
						t.setAttribute('x', String(digitInkLeft - JIANPU_ACC_GAP - ai.right));
						// ② 纵向：两者**真实墨迹**对齐 —— 记号墨迹中心对到「数字墨迹顶 + 数字高度的 JIANPU_ACC_CENTER_DROP」
						//    （＝数字左上角，略微高出数字中心）。用**中心**而不是底/顶对齐：各字形的墨迹高度不同
						//    （♯ 13 / 𝄪 7 / ♭ 12），底对齐会让高矮不齐、顶对齐会让小字形显得飘。
						const digitY = parseFloat(digit.getAttribute('y') || '0');
						const digitH = di.asc + di.desc;
						const accMidFromBaseline = (ai.desc - ai.asc) / 2; // 记号墨迹中心相对其基线的偏移
						const y = digitY - di.asc + digitH * JIANPU_ACC_CENTER_DROP - accMidFromBaseline;
						t.setAttribute('y', String(y));
					});
				});
			} catch {
				// 容器不可见时 getBBox 会抛错：跳过，保持库的原始位置（下次重排再算）
			}
		}

		/**
		 * 还原号（♮，原文写 `=`）：库的 `drawUpDownCount` 只会按 `upDownCount` 画升/降号
		 * （正数升、负数降、**0 直接 return**）⇒ 它虽然符号表里有 `NaTURAL`（U+ED61），解析器却永远用不上。
		 * 变通：`=` 交给库时按 `#` 发（保证有字形、时值权重也跟升号一致），画出来再按**记号出现顺序**
		 * 把字形换成还原号 —— 两边顺序都是谱面顺序（库把记号 append 进所在音符组），所以按下标一一对应。
		 */
		function applyJianpuNaturals(host: HTMLElement, naturals: number[] = []) {
			if (!naturals.length) return;
			const texts = Array.from(host.querySelectorAll('svg g[sn-tag^="stave-"] g[sn-tag^="note-"] > text[font-family*="Bravura"]'));
			naturals.forEach((n) => {
				if (texts[n]) texts[n].textContent = '\uED61';
			});
		}

		/**
		 * **倚音上的**变音记号：库 `drawGraceNote` 里压根不调 `drawUpDownCount`（实测 `{#5 6}` 只出两个裸数字）
		 * ⇒ 记号得我们自己补一个 Bravura `<text>`。摆法与 `adjustJianpuAccidentals` 同一套（按墨迹常量，
		 * 不用 canvas —— 理由见 `JIANPU_ACC_INK`），只是基准换成**那个倚音**的墨迹，字号按库的比例 ×0.75
		 * （库给 12px 倚音配 9px 记号）。
		 * ⚠️ 必须排在 `adjustJianpuAccidentals` **之后**：那一步会把音符组里所有 Bravura text 当成「主数字的记号」
		 *    去重摆（我们补的这些会被拖到主数字旁边）；排在它后面就不会被它看到。
		 */
		function drawJianpuGraceAccidentals(host: HTMLElement, graceAccs: string[] = []) {
			if (!graceAccs.some(Boolean)) return;
			const cv = document.createElement('canvas').getContext('2d');
			const graces = Array.from(host.querySelectorAll('svg g[sn-tag^="note-"] > text[font-size="12"]')).filter((t) => !/Bravura/.test(t.getAttribute('font-family') || ''));
			if (graces.length !== graceAccs.length) return; // 对不上就整体跳过，保持原样
			graces.forEach((g, i) => {
				const glyph = JIANPU_ACC_GLYPH[graceAccs[i]];
				if (!glyph) return;
				const cs = getComputedStyle(g);
				const size = (parseFloat(cs.fontSize) || 12) * 0.75;
				const gi = JIANPU_ACC_INK[glyph];
				// 倚音数字 anchor=start ⇒ 墨迹左端 = x + aBBLeft（用渲染出来的盒子量，字体没就绪时宽度为 0，不会错）
				const box = inkLR(g, g.textContent || '');
				const inkLeft = box ? box[0] : parseFloat(g.getAttribute('x') || '0');
				let asc = 0;
				let desc = 0;
				if (cv) {
					cv.font = cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
					const m = cv.measureText(g.textContent || '');
					asc = m.actualBoundingBoxAscent;
					desc = m.actualBoundingBoxDescent;
				}
				const el = document.createElementNS('http://www.w3.org/2000/svg', 'text');
				el.setAttribute('data-jianpu-grace-acc', '1');
				el.setAttribute('font-family', 'Bravura, sans-serif');
				el.setAttribute('font-size', size.toFixed(2));
				el.setAttribute('text-anchor', 'start');
				el.setAttribute('x', String(inkLeft - JIANPU_ACC_GAP - size * gi.r));
				el.setAttribute('y', String(parseFloat(g.getAttribute('y') || '0') - asc + (asc + desc) * JIANPU_ACC_CENTER_DROP - ((size * gi.desc - size * gi.asc) / 2)));
				el.textContent = glyph;
				// 加进倚音所在的那个音符组（x/y 都是绝对坐标，挂在组里哪个位置都一样）
				const acc = el as SVGTextElement;
				g.parentElement?.appendChild(acc);
			});
		}

		/**
		 * 反复「小房子」（围栏里的 `[1.]` / `[2.]`，库画成 `g[sn-tag^="section-repeat-"]`）：
		 * 「一条 path 外框（左竖线 + 顶横线）+ 一个 1./2. 标签」；跨度与封口由后面的 `fitJianpuVoltas` 按 abc 的口径重写。
		 *
		 * ⚠️ 库把房子的左竖线画在**小节槽的左边界**上（实测 x=24 = 该行最左），而库又把每小节内容
		 *    **居中在槽里** → 该小节第一个音的墨迹要到 x≈29.7 才开始 → 房子左端**伸出音符左侧 11.8px**
		 *    （用户：「小房子往右移到音符正上，也就是别溢出来」）。
		 * 所以这里不写死右移量，而是按**该小节第一个音符的真实墨迹左端**算（数字 anchor=middle，
		 * 墨迹左端 = x − adv/2 + aBBLeft）：dx = 音符墨迹左端 − 房子左端 + JIANPU_VOLTA_DX。
		 * 认行：「数字基线 y > 房子底部」里最小的 y（房子在该行音符上方）；再取该行 x ≥ 房子左端
		 * 的最小音符 = 这个房子所覆盖小节的第一个音。整个分组一起平移 → 标签/横线相对位置不变。
		 * ⚠️ 排在 justifyJianpuLines 之前：房子与音符同属一行、被同一个线性映射等比挪动，相对关系不变。
		 * ⚠️ 幂等：dx 始终按**属性坐标**算（不受自身 transform 影响），重复跑不会累加。
		 */
		function shiftJianpuVolta(host: HTMLElement) {
			const cv = document.createElement('canvas').getContext('2d');
			const notes: { x: number; y: number; el: Element }[] = [];
			host.querySelectorAll('svg g[sn-tag^="note-"]').forEach((g) => {
				const d = Array.from(g.querySelectorAll(':scope > text')).find((t) => t.getAttribute('font-size') === '18');
				if (d) notes.push({ x: parseFloat(d.getAttribute('x') || '0'), y: parseFloat(d.getAttribute('y') || '0'), el: d });
			});
			/** 数字（text-anchor=middle）的墨迹左端相对其 x 的偏移 */
			const inkLeftOffset = (el: Element) => {
				if (!cv) return 0;
				const cs = getComputedStyle(el);
				cv.font = cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
				const m = cv.measureText(el.textContent || '');
				return -m.width / 2 + m.actualBoundingBoxLeft;
			};
			host.querySelectorAll('svg g[sn-tag^="section-repeat-"]').forEach((g) => {
				const path = g.querySelector('path');
				const nums = path && (path.getAttribute('d') || '').match(/-?\d*\.?\d+/g);
				if (!nums || nums.length < 4) return; // 认不出库的画法就别动（优雅降级）
				const xs: number[] = [];
				const ys: number[] = [];
				for (let i = 0; i + 1 < nums.length; i += 2) {
					xs.push(parseFloat(nums[i]));
					ys.push(parseFloat(nums[i + 1]));
				}
				const left = Math.min(...xs);
				const bottom = Math.max(...ys);
				const below = notes.filter((n) => n.y > bottom).map((n) => n.y);
				const rowY = below.length ? Math.min(...below) : NaN;
				if (!Number.isFinite(rowY)) return;
				const first = notes.filter((n) => n.y === rowY && n.x >= left).sort((a, b) => a.x - b.x)[0];
				if (!first) return;
				const dx = first.x + inkLeftOffset(first.el) - left + JIANPU_VOLTA_DX;
				g.setAttribute('transform', 'translate(' + dx.toFixed(2) + ' ' + JIANPU_VOLTA_DY + ')');
				// 序号标签（1./2.）再往里挪一点：库把它画得贴左竖线（实测墨迹左端距竖线 10.1px）。
				// 按**属性坐标**加，所以不影响上面的幂等性；后面的 justify 会把它跟整行一起等比例挪动。
				const label = g.querySelector('text');
				if (label && label.getAttribute('x') !== null) {
					label.setAttribute('x', String(parseFloat(label.getAttribute('x') || '0') + JIANPU_VOLTA_LABEL_DX));
				}
			});
		}

		/**
		 * 反复「小房子」的**跨度**（只动**有收尾 `:|`** 的那间，如 `[1.]`）：
		 *   · `:|` 在同一行 → 画到那里并**封口**（补一段右竖线）；
		 *   · `:|` 在后一行（这首谱里手写换行不算行边界，会被重排拆开）→ 本行画到行尾、**不封口**，
		 *     再在后一行补一段：从行首（`JIANPU_LINE_MARGIN`）画到 `:|`，在那里封口。
		 *   · 后面**没有** `:|` 的房子（末尾那间，后面还要接着唱）→ 什么都不动，保持库的原样：**定宽 + 不封口**。
		 *
		 * ⚠️ 库自己那个房子是**定宽**的（实测 ≈81px ≈ 一个小节），跟 `:|` 和行尾都没关系 ⇒ 有收尾的那间得我们自己重写。
		 * ⚠️ 必须排在 justify（⑪）+ evenJianpuBarGaps（⑪f）+ centerJianpuBarlines（⑪g）**之后**：
		 *    右端要对到小节线的**最终** x 上（这三步里小节线都还会动）。
		 * ⚠️⚠️ 写进 path 的是**组内局部坐标**：组上挂着 `translate(dx dy)`（⑩ 对齐左端时加的），而小节线/音符是谱面坐标
		 *    ⇒ 目标 x 一律要减 `dx`（实测 dx≈20.9，不减的话房子右端会冲到谱宽外面）。
		 */
		function fitJianpuVoltas(host: HTMLElement) {
			const svg = host.querySelector('svg');
			if (!svg) return;
			const px = (v: string | null) => parseFloat(v || '0');
			const staves = Array.from(svg.querySelectorAll('g[sn-tag^="stave-"]'));
			/** 某一行的第一个音符数字的基线 y */
			const rowNoteY = (stave: Element) => {
				const t = stave.querySelector('g[sn-tag^="note-"] > text[font-size="18"]');
				return t ? px(t.getAttribute('y')) : NaN;
			};
			/** 这一行里 `after` 右侧 `:|` 那组的粗线 x（＝视觉右缘；多个取最靠左）；圆点在组**右侧**的 `|:` 不算 */
			const endRepeatX = (stave: Element, after: number) => {
				const dots = Array.from(stave.querySelectorAll('circle'))
					.filter((c) => px(c.getAttribute('r')) > 1.7)
					.map((c) => px(c.getAttribute('cx')));
				const hits = Array.from(stave.querySelectorAll(':scope > line'))
					.filter((l) => px(l.getAttribute('stroke-width')) >= 3)
					.map((l) => px(l.getAttribute('x1')))
					.filter((tx) => tx > after && dots.some((d) => d < tx - 1 && Math.abs(d - tx) < 20));
				return hits.length ? Math.min(...hits) : null;
			};
			/** 这一行最右那根小节线的 x（＝行尾） */
			const rowEndX = (stave: Element) => Math.max(...Array.from(stave.querySelectorAll(':scope > line')).map((l) => px(l.getAttribute('x1'))));
			svg.querySelectorAll('g[sn-tag^="section-repeat-"]').forEach((g) => {
				g.querySelectorAll('[data-jianpu-volta="tail"]').forEach((el) => el.remove());
				const path = g.querySelector('path');
				const nums = path && (path.getAttribute('d') || '').match(/-?\d*\.?\d+/g);
				if (!path || !nums || nums.length !== 6) return; // 只认库那「3 点」画法，认不出就别动
				const left = Math.min(parseFloat(nums[0]), parseFloat(nums[2]), parseFloat(nums[4]));
				const ys = [1, 3, 5].map((i) => parseFloat(nums[i]));
				const top = Math.min(...ys);
				const bottom = Math.max(...ys);
				// 组上的 translate(dx dy)：属性坐标 = 谱面坐标 − (dx dy)
				const m = /translate\(\s*(-?[\d.]+)[\s,]+(-?[\d.]+)/.exec(g.getAttribute('transform') || '');
				const dx = m ? parseFloat(m[1]) : 0;
				// 房子在哪一行：数字基线 y > 房子底部里最小的那个；再从那个音找到它所属的 stave
				const notes = Array.from(svg.querySelectorAll('g[sn-tag^="note-"] > text[font-size="18"]'));
				const below = notes.map((t) => px(t.getAttribute('y'))).filter((y) => y > bottom);
				if (!below.length) return;
				const rowY = Math.min(...below);
				const note = notes.find((t) => px(t.getAttribute('y')) === rowY);
				const stave = note && note.closest('g[sn-tag^="stave-"]');
				if (!stave) return;
				// 本行（房子右侧）优先；本行没有就往后找**最近**一行里的 `:|`（跨行那一间）
				let term = endRepeatX(stave, left + dx + 8);
				let tailStave: Element | null = null;
				if (term === null) {
					for (let k = staves.indexOf(stave) + 1; k < staves.length && k > 0; k++) {
						const t = endRepeatX(staves[k], -Infinity);
						if (t !== null) {
							term = t;
							tailStave = staves[k];
							break;
						}
					}
				}
				if (term === null) return; // 末尾那间：库里那套定宽 + 不封口，不动
				const fmt = (v: number) => String(+v.toFixed(2));
				const rx = term - dx;
				if (!tailStave) {
					// 同一行：画到 `:|` 并封口
					if (rx > left + 8) path.setAttribute('d', `M ${fmt(left)} ${fmt(bottom)} L ${fmt(left)} ${fmt(top)} L ${fmt(rx)} ${fmt(top)} L ${fmt(rx)} ${fmt(bottom)}`);
					return;
				}
				// 跨行：本行画到行尾（不封口）；中间每一行都补满一条直线；收尾那一行从行首接到 `:|` 并封口
				const end = rowEndX(stave) - dx;
				if (end > left + 8) path.setAttribute('d', `M ${fmt(left)} ${fmt(bottom)} L ${fmt(left)} ${fmt(top)} L ${fmt(end)} ${fmt(top)}`);
				const from = JIANPU_LINE_MARGIN - dx;
				const y0 = rowNoteY(stave);
				const lastRow = staves.indexOf(tailStave);
				for (let k = staves.indexOf(stave) + 1; k <= lastRow; k++) {
					const dy = rowNoteY(staves[k]) - y0;
					if (!Number.isFinite(dy)) continue;
					const isLast = k === lastRow;
					const to = isLast ? rx : rowEndX(staves[k]) - dx;
					if (!(to > from)) continue;
					const tail = path.cloneNode(false) as SVGPathElement;
					tail.setAttribute('data-jianpu-volta', 'tail');
					let dTail = `M ${fmt(from)} ${fmt(top + dy)} L ${fmt(to)} ${fmt(top + dy)}`;
					if (isLast) dTail += ` L ${fmt(to)} ${fmt(bottom + dy)}`;
					tail.setAttribute('d', dTail);
					g.appendChild(tail);
				}
			});
		}

		/**
		 * canvas 量一段文字的**真实墨迹**左右端（不是 `getBBox` —— 那是 advance 框）。
		 * ⚠️ 简谱的音符数字都是 `text-anchor: middle` ⇒ 以属性 `x` 为**中心**反推墨迹左右端。
		 * ⚠️ 字体/字号取**计算样式**（库写在属性上的 SimSun 栈会被 CSS 换成站点衬线栈）。
		 */
		let jianpuInkCtx: CanvasRenderingContext2D | null | undefined;
		function jianpuTextInkLR(el: Element): { l: number; r: number } | null {
			if (jianpuInkCtx === undefined) jianpuInkCtx = document.createElement('canvas').getContext('2d');
			if (!jianpuInkCtx) return null;
			const x = parseFloat(el.getAttribute('x') || 'NaN');
			if (!Number.isFinite(x)) return null;
			const cs = getComputedStyle(el);
			jianpuInkCtx.font = cs.fontWeight + ' ' + cs.fontSize + ' ' + cs.fontFamily;
			const m = jianpuInkCtx.measureText(el.textContent || '');
			return { l: x - m.width / 2 + m.actualBoundingBoxLeft, r: x - m.width / 2 + m.actualBoundingBoxRight };
		}

		/** 元素所属行：`text@y` / `circle@cy` / `line@y1` / `path@d` 的第二个数（与 justify 同一套） */
		function jianpuLayerY(el: Element): number {
			const num = (a: string) => parseFloat(el.getAttribute(a) || 'NaN');
			const tag = el.tagName.toLowerCase();
			if (tag === 'text') return num('y');
			if (tag === 'circle') return num('cy');
			if (tag === 'line') return num('y1');
			if (tag === 'path') {
				const n = (el.getAttribute('d') || '').match(/-?\d*\.?\d+/g);
				return n && n.length > 1 ? parseFloat(n[1]) : NaN;
			}
			return NaN;
		}

		/** 元素在行内的代表 x：`circle@cx` / `line@x1` / `path@d` 的第一个数 / `text@x` */
		function jianpuRepX(el: Element): number {
			const num = (a: string) => parseFloat(el.getAttribute(a) || 'NaN');
			const tag = el.tagName.toLowerCase();
			if (tag === 'circle') return num('cx');
			if (tag === 'line') return num('x1');
			if (tag === 'path') {
				const n = (el.getAttribute('d') || '').match(/-?\d*\.?\d+/g);
				return n && n.length ? parseFloat(n[0]) : NaN;
			}
			return num('x');
		}

		/**
		 * 造一个谱内转调标记「1 = X」（跟信息区那份**一模一样**：同字号、同字体栈、`1` 同样加粗、
		 * 升降号同样换 Bravura 字形）。属性从信息区那个 `text` 上抄，信息区什么都没有时退回谱面音符的 text。
		 * @returns 还没定坐标的 `<text>`（x / y 由调用方设）
		 */
		function makeJianpuModLabel(host: HTMLElement, keyName: string): SVGTextElement | null {
			const svg = host.querySelector('svg');
			if (!svg) return null;
			// 属性模板：信息区那行（调号 + 速度就画在那儿）
			const infoTexts = svg.querySelectorAll('g[sn-tag="info"] text');
			const tpl: Element | null = infoTexts[infoTexts.length - 1] || svg.querySelector('text[font-size="18"]');
			if (!tpl) return null;
			const NS = 'http://www.w3.org/2000/svg';
			// 调名的解析与库 `parseKeySignature` 完全一致（`C#` / `Db` / `Emin` / `C`）
			const acc = /^[A-G]#$/i.test(keyName) ? '#' : /^[A-G]b$/i.test(keyName) ? 'b' : '';
			const letter = /^[A-G]min$/i.test(keyName)
				? keyName[0].toLowerCase()
				: /^[A-G]$/i.test(keyName) || acc
					? keyName[0].toUpperCase()
					: keyName;
			const text = document.createElementNS(NS, 'text') as SVGTextElement;
			['font-family', 'font-weight', 'fill', 'stroke', 'stroke-width'].forEach((a) => {
				const v = tpl.getAttribute(a);
				if (v !== null) text.setAttribute(a, v);
			});
			text.style.fontSize = JIANPU_MOD_SIZE + 'px'; // ⚠️ 不能写 font-size 属性（见 addJianpuModulations 的说明）
			text.setAttribute('text-anchor', 'start');
			text.setAttribute('data-jianpu-mod', '1');
			const outer = document.createElementNS(NS, 'tspan');
			const inner = document.createElementNS(NS, 'tspan');
			outer.appendChild(inner);
			text.appendChild(outer);
			const bold = document.createElementNS(NS, 'tspan');
			bold.setAttribute('font-weight', '700'); // 「1」跟谱内音符数字一样加粗（信息区那份也是这么包的）
			bold.textContent = '1';
			inner.appendChild(bold);
			inner.appendChild(document.createTextNode(' = '));
			if (acc) {
				const glyph = document.createElementNS(NS, 'tspan');
				glyph.setAttribute('font-family', 'Bravura');
				if (JIANPU_KEY_ACC_DY) glyph.setAttribute('dy', String(JIANPU_KEY_ACC_DY));
				glyph.textContent = acc === '#' ? '\uED62' : '\uED60';
				inner.appendChild(glyph);
				const alpha = document.createElementNS(NS, 'tspan');
				if (JIANPU_KEY_ACC_DY) alpha.setAttribute('dy', String(-JIANPU_KEY_ACC_DY));
				if (JIANPU_KEY_ACC_DX) alpha.setAttribute('dx', String(JIANPU_KEY_ACC_DX));
				alpha.textContent = letter;
				inner.appendChild(alpha);
			} else {
				inner.appendChild(document.createTextNode(letter));
			}
			return text;
		}

		/**
		 * 谱内转调的标记（`K: X`，2026-10-02 用户要求）：画在**换调点的上方**（行间的空白里），横向对着那个音符。
		 *
		 * 换调点 = 该行里带 `mod` / `inl` 的那个小节（`at` 给出它是第几个小节）：标记画在那一小节**第一个音符**
		 * 的上方 —— 折行不再为换调让路（2026-10-02 用户要求删掉那条规则），所以换调点可能落在一行的中间。
		 *
		 * 画在行间 = **不占行内空间**、也不动任何音符，位置正好就是换调点。
		 * ⚠️ 必须排在**所有会改横向几何的步骤之后**（⑪ justify、⑪f evenJianpuBarGaps、⑪g …）：
		 *    它是按音符的**最终**位置摆的，提前摆会被后面的映射带走。
		 * ⚠️ 字号走 `style` 而**不是 `font-size` 属性**：全站有一批 `text[font-size="18"]` 的选择器在认音符
		 *    （三连音组边界、小节线居中…），而标记的文案以 `1` 开头，带了这个属性就会被当成音符。
		 * ⚠️ 坐标只写在最外层 `text` 上（两级 tspan 都不写 x/y）：后面的步骤只认 `text` 自己的 x。
		 */
		function addJianpuModulations(host: HTMLElement, mods: { at: number; key: string }[]) {
			if (!mods.some((m) => m.key)) return;
			const svg = host.querySelector('svg');
			if (!svg) return;
			const staves = Array.from(svg.querySelectorAll('g[sn-tag^="stave-"]'));
			mods.forEach((entry, i) => {
				const stave = staves[i];
				if (!entry.key || !stave) return;
				// 换调点 = 该行第 `at` 个小节的第一个音符（`at` 越界就退回行首）
				const groups = Array.from(stave.children).filter((c) => /^measure-/.test(c.getAttribute('sn-tag') || ''));
				const group = groups[entry.at] || groups[0];
				const anchor = group && group.querySelector('g[sn-tag^="note-"] > text[font-size="18"]');
				if (!anchor) return;
				const base = parseFloat(anchor.getAttribute('y') || 'NaN');
				if (!Number.isFinite(base)) return;
				const label = makeJianpuModLabel(host, entry.key);
				if (!label) return;
				// 横向对着那个音符的墨迹左端（拿不到就退回它的 x；左右位置看 JIANPU_MOD_DX）
				const ink = jianpuTextInkLR(anchor);
				const x = (ink && Number.isFinite(ink.l) ? ink.l : parseFloat(anchor.getAttribute('x') || '0')) + JIANPU_MOD_DX;
				label.setAttribute('x', String(x));
				const y0 = base - JIANPU_MOD_LIFT;
				label.setAttribute('y', String(y0));
				stave.appendChild(label);
				// 行间这条缝未必放得下：上一行可能带歌词 / 低八度点探下来，本行音符上方又可能正好压着
				// 圆滑线 / 三连音弧 / 小房子 —— 所以摆完先量自己的**真实**墨迹（ascent 估不准：中文衬线栈
				// 实测 ≈1.09em），再在基线上方这段区间里逐 0.5px 扫一个「跟谁都挨不上」的位置：
				// 优先离默认位置最近的那个（没有完全不撞的，就退而求其次取重叠量最小的）。
				// ⚠️ 障碍只认**横向与自己相交**的元素（一行里别处探下来的东西挨不到标记）；
				//    先用属性坐标粗筛行距、再量盒子，免得给全谱几百个元素都调 getBBox。
				// ⚠️ `getBBox()` 不含自身 transform，而 stave / tieline 都没有 transform ⇒ 同一套坐标。
				try {
					// ⚠️ 量墨迹一律走「屏幕矩形 + CTM 逆变换」，**不用 `getBBox()`**：SVG 文本的 getBBox 是
					//    字体行盒（比可见墨迹高一大截），而**空 tspan**（三连音标签那类）在 Chromium 里还会
					//    返回一个荒唐的大框（实测 9.6×78.4）—— 拿它当障碍会把整条缝封死，标记无处可放。
					const ctm = svg.getScreenCTM();
					const inv = ctm && ctm.inverse();
					if (!inv) return;
					const local = (el: SVGElement, estimateText = false) => {
						const r = el.getBoundingClientRect();
						if (!r.width && !r.height) return null;
						const a = new DOMPoint(r.left, r.top).matrixTransform(inv);
						const b = new DOMPoint(r.right, r.bottom).matrixTransform(inv);
						let y0 = Math.min(a.y, b.y);
						let y1 = Math.max(a.y, b.y);
						if (estimateText && el.tagName.toLowerCase() === 'text') {
							// ⚠️ text 的矩形会被**子 tspan 的字形**撑坏（三连音标签那种：实测 9.6×78.4 ——
							//    字形 tspan 的 y 与父 text 的不同、字体度量又拿不到）⇒ 纵向改用「基线 ± 字号」
							//    估算，横向仍旧用矩形（宽度是可靠的）。
							const ty = parseFloat(el.getAttribute('y') || 'NaN');
							const fs = parseFloat(getComputedStyle(el).fontSize) || 12;
							if (Number.isFinite(ty)) {
								y0 = ty - fs * 0.9;
								y1 = ty + fs * 0.3;
							}
						}
						return { x0: Math.min(a.x, b.x), y0, x1: Math.max(a.x, b.x), y1 };
					};
					const mine = local(label);
					if (!mine) return;
					const asc = y0 - mine.y0;
					const desc = mine.y1 - y0;
					const width = mine.x1 - mine.x0;
					// 障碍：横向先按「最远能挪到哪」放宽收集，纵向再逐个候选位置比
					const boxes: { x0: number; x1: number; top: number; bottom: number }[] = [];
					svg.querySelectorAll('text, circle, line, path').forEach((el) => {
						if (label.contains(el)) return;
						const ly = jianpuLayerY(el); // 粗筛用属性坐标（不触发排版），只有近处的才量矩形
						if (!Number.isFinite(ly) || ly < base - 120 || ly > base + 8) return;
						const b = local(el as SVGElement, true);
						if (!b) return;
						if (b.x1 <= mine.x0 - JIANPU_MOD_SHIFT || b.x0 >= mine.x1 + JIANPU_MOD_SHIFT) return;
						boxes.push({ x0: b.x0, x1: b.x1, top: b.y0 - JIANPU_MOD_GAP, bottom: b.y1 + JIANPU_MOD_GAP });
					});
					// 横向优先（0 = 正对着换调点那个音），原地放不下才试着左右挪一点点；每个横向位置上再
					// 从「贴着本行音符」往上一格格扫，取离默认高度最近的那个干净位置。
					// ⚠️ 挪动幅度由 `JIANPU_MOD_SHIFT` 定（0 ⇒ 只有 0 这一个候选，绝不横移）。
					const shifts = [0];
					for (let step = 6; step <= JIANPU_MOD_SHIFT; step += 6) shifts.push(-step, step);
					let pickX = x;
					let pickY = y0;
					let bestPen = Infinity;
					for (const dx of shifts) {
						const cx0 = mine.x0 + dx;
						const cx1 = cx0 + width;
						const near = boxes.filter((b) => b.x1 > cx0 && b.x0 < cx1);
						const ok: number[] = [];
						let fallback = y0;
						let fallbackPen = Infinity;
						for (let y = base - 4; y >= base - 90; y -= 0.5) {
							const top = y - asc;
							const bottom = y + desc;
							let pen = 0;
							near.forEach((b) => {
								const o = Math.min(b.bottom, bottom) - Math.max(b.top, top);
								if (o > 0) pen += o;
							});
							if (pen <= 0.01) ok.push(y);
							else if (pen < fallbackPen) {
								fallbackPen = pen;
								fallback = y;
							}
						}
						if (ok.length) {
							pickX = x + dx;
							pickY = ok.reduce((a, b) => (Math.abs(b - y0) < Math.abs(a - y0) ? b : a));
							break;
						}
						if (fallbackPen < bestPen) {
							bestPen = fallbackPen;
							pickX = x + dx;
							pickY = fallback;
						}
					}
					if (Math.abs(pickX - x) > 0.01) label.setAttribute('x', String(pickX));
					if (Math.abs(pickY - y0) > 0.01) label.setAttribute('y', String(pickY));
				} catch {
					/* 量不到就保持默认位置 */
				}
			});
		}

		/**
		 * 每行首末墨迹贴齐左右边界 —— 「坐标重写式 justify」（② 方案）。
		 *
		 * 背景：库把每个小节的内容**居中在自己的小节槽**里 → 各行首音起点浮动（实测 17.6～43.4，极差 22px）。
		 * ⚠️ 不能只挪某个小节（那样会与它的小节线脱节，试过、已回退）。所以这里把**整行所有元素的 x 坐标**
		 * 按同一个线性映射重写一遍：`x → L + (x − c0)·s`，其中
		 *   c0 = 该行**音符数字的真实墨迹**左端（若有反复记号，用反复记号的粗线 x —— 用户：
		 *        「左侧对齐是以数字为准（除非有反复记号以其为准），**不带下面的线**」）、
		 *   c1 = 该行**音符数字的真实墨迹**右端，
		 *   s = (lineR − lineL) / (c1 − c0)，其中 lineL/lineR 是**谱面左右各留 JIANPU_LINE_MARGIN** 算出来的
		 *   （谱宽 = SVG viewBox 宽，随容器变）。
		 * 行内所有东西（音符 / 小节线 / 反复号 / 小房子 / 连音线 / 歌词）等比例挪动，**相对关系完全不变**，
		 * 只是整行横向疏密被微调（实测 s = 0.99～1.03 → 间距变化 ≤3%，肉眼几乎无感）。
		 * 与「给元素加 scale」的本质区别：这里**只改坐标、不动字形**，数字/记号不会被拉宽。
		 *
		 * ⚠️ 覆盖全部元素类型：`text@x`、`circle@cx`、`line@x1/x2`、`path@d`（实测库里 path 只有
		 *    M/L/A 三种、全是绝对坐标，但仍按 SVG 全部命令处理以求稳）。
		 * ⚠️ 唯一例外：该行**最右的那条/组竖线（终止线）不参与映射** —— 库本来就把它放在行宽右端（恒定），
		 *    跟着行内缩放走会被带偏（实测 718.2～732.6，极差 14px，用户：「右侧为什么没对齐」）。
		 * ⚠️ 连音线在 score 层，按「y 落在哪一行的 y 范围」找到该行的映射换算。
		 * ⚠️ 必须排在所有会改几何的步骤之后（否则改完又被挪）、centerJianpuScore 之前。
		 */
		function justifyJianpuLines(host: HTMLElement) {
			type Row = { baseY: number; els: Element[]; c0: number; c1: number; bars: number };
			const bb = (el: Element) => (el as SVGGraphicsElement).getBBox();
			const num = (el: Element, a: string) => parseFloat(el.getAttribute(a) || 'NaN');
			/** 元素所属行的「代表 y」（用于认行）：text@y / circle@cy / line@y1 / path@d 的第一个 y */
			const layerY = (el: Element) => {
				const tag = el.tagName.toLowerCase();
				if (tag === 'text') return num(el, 'y');
				if (tag === 'circle') return num(el, 'cy');
				if (tag === 'line') return num(el, 'y1');
				if (tag === 'path') {
					const n = (el.getAttribute('d') || '').match(/-?\d*\.?\d+/g);
					return n && n.length > 1 ? parseFloat(n[1]) : NaN;
				}
				return NaN;
			};
			try {
				// ① 每行 = stave 里的元素 + 「按最近的音符基线」认领来的 score 层元素
				//    ⚠️ beam（时值线/下划线）、chord（和弦记号 + 反复小房子）、tieline（连音线）都不在任何 stave 里，
				//    漏掉任何一个都会出现「它不跟着走」。
				const rows: Row[] = Array.from(host.querySelectorAll('svg g[sn-tag^="stave-"]'))
					.map((stave) => {
						const d = stave.querySelector('text[font-size="18"]');
						return d ? ({ baseY: num(d, 'y'), els: Array.from(stave.querySelectorAll('text, circle, line, path')), c0: Infinity, c1: -Infinity, bars: stave.querySelectorAll('g[sn-tag^="measure-"]').length } as Row) : null;
					})
					.filter((r): r is Row => !!r && Number.isFinite(r.baseY));
				if (!rows.length) return;
				host.querySelectorAll('svg g[sn-tag="beam"] *, svg g[sn-tag="chord"] *, svg g[sn-tag="tieline"] *').forEach((el) => {
					const y = layerY(el);
					if (!Number.isFinite(y)) return;
					const row = rows.reduce((best, r) => (Math.abs(r.baseY - y) < Math.abs(best.baseY - y) ? r : best));
					row.els.push(el);
				});
				// ② 每行端点：**以音符数字的「真实墨迹」为准**（canvas 量，不是 getBBox —— 那是行盒）。
				//    ⚠️ 不能把「下面的线」（时值线/下划线，在 beam 层）算进来：它比数字宽，当基准会把整行数字推右
				//       —— 实测各行数字墨迹左端 23～43.1（极差 20px）。和弦记号/小房子/连音线同理只跟着走、不当基准。
				//    ⚠️ 反复记号的粗线（stave 直接子层里 sw≥3 的竖线）可以当基准（用户明确允许）。
				//    ⚠️ 倚音（fs=12 的衬线数字）**不算**进端点（2026-10-01 改）：它现在排在 justify **之后**、按主数字的
				//       最终位置定位（见 ⑦）⇒ 算进来只会把「行首带倚音」的几行整体推右（实测行首数字 204.6 vs 231.4，
				//       用户：「音符左侧对不齐，跟有点什么东西挡住他似的」）。不算则倚音自己探到 24 左边一点，
				//       跟「时值线探出左边距」是同一类可接受的溢出。
				const inStave = (el: Element) => !!el.parentElement && /^stave-/.test(el.parentElement.getAttribute('sn-tag') || '');
				rows.forEach((row) => {
					row.els.forEach((el) => {
						const tag = el.tagName.toLowerCase();
						if (tag === 'text' && el.getAttribute('font-size') === '18') {
							const ink = jianpuTextInkLR(el);
							if (ink && Number.isFinite(ink.l)) {
								row.c0 = Math.min(row.c0, ink.l);
								row.c1 = Math.max(row.c1, ink.r);
							}
						} else if (tag === 'line' && inStave(el) && parseFloat(el.getAttribute('stroke-width') || '0') >= 3) {
							row.c0 = Math.min(row.c0, num(el, 'x1')); // 反复记号的粗线
						}
					});
				});
				// ③ 目标边界**按谱面自身宽度算**（谱宽 = SVG viewBox 宽，随容器变：436/636/696/736/800…）。
				//    ⚠️ 原来写死 24 / 712 —— 只在谱宽 736 时恰好左右各留 24（用户：「800-1250px 显示比较正常」
				//    ✓），谱宽 436 时右端 712 跑到谱外 → 整行被拉伸且右端裁掉；谱宽 800 时又缩在左边空一块。
				const svgEl = host.querySelector('svg');
				const vb = ((svgEl && svgEl.getAttribute('viewBox')) || '').trim().split(/\s+/).map(Number);
				const scoreW = vb.length === 4 && vb[2] > 0 ? vb[2] : 736;
				const lineL = JIANPU_LINE_MARGIN;
				const lineR = Math.max(lineL + 100, scoreW - JIANPU_LINE_MARGIN);
				// ④ 逐元素重写坐标（只改坐标、不动字形）；终止线及其同伴（双终止线的两条、反复号圆点）跳过
				// 每行小节数（`planJianpuBars` 定的分档）：末行该不该左对齐要看「有它几个小节」
				const perLine = Number(host.dataset.jianpuPerLine) || 0;
				rows.forEach((row, rowIdx) => {
					if (!(row.c1 > row.c0)) return;
					let s = (lineR - lineL) / (row.c1 - row.c0);
					// ⚠️ **末行左对齐**（2026-10-02，用户要求）：末行小节本来就少，库却照样把它铺满整行宽
					//    （实测 2 小节那行的音符间距是其它行的两倍）⇒ 按「小节数占比」压回自然密度、内容贴左。
					//    两个条件都满足才改：小节数 ≤ `JIANPU_LAST_LINE_BARS`，**且**小节数/每行小节数 ≤ `JIANPU_LAST_LINE_RATIO`
					//    （后者就是用户说的「左对齐宽度显著小于两端对齐宽度」，只是拿小节数当代理——
					//    库已经把这行拉满了，墨迹宽度量不出「本该多宽」）。
					//    左对齐时终止线跟着内容跑（不钉行右端，见下面 endDx）。
					const lastLeft =
						rowIdx === rows.length - 1 &&
						perLine > 0 &&
						row.bars <= JIANPU_LAST_LINE_BARS &&
						row.bars / perLine <= JIANPU_LAST_LINE_RATIO;
					if (lastLeft) s = row.bars / perLine;
					const mapX = (x: number) => lineL + (x - row.c0) * s;
					// ⚠️ 连音线**不往左外插**（2026-10-02 修）：跨行连音线的最后一段起点是库的 `innerX − 10`
					//    （行左界之外），线性映射会把它推到谱外 —— 看着就是「第二行开头伸进来一条老长的线」。
					//    但也不能就压在行左边距上（用户：「得往前伸一点，不然怎么知道是从上一行来的」）
					//    ⇒ 最多伸到左边距以外 `JIANPU_TIE_IN_EXTEND` 像素（固定像素，不跟行缩放）。
					const mapXIn = (x: number) =>
						Math.min(lineR + JIANPU_TIE_IN_EXTEND, Math.max(lineL - JIANPU_TIE_IN_EXTEND, lineL + (x - row.c0) * s));
					const isTieEl = (el: Element) => el.parentElement?.getAttribute('sn-tag') === 'tieline';
					const bars = row.els.filter((el) => el.tagName.toLowerCase() === 'line' && inStave(el));
					const keep = new Set<Element>();
					const isTwin = (el: Element) => el.getAttribute('data-jianpu-bar') === 'twin';
					// 反复号（`:|`）：库画成「细 + 粗」两根紧挨着的竖线 + 两个圆点，而且**不是**我们补的同伴
					// （没有 data-jianpu-bar）⇒ 得自己认：粗线（sw≥3）旁边有反复圆点（r>1.7 才算，八度点是 1.5）就是一组。
					// ⚠️ 整组必须**共用一条位移**：justify 是逐元素缩放，两根线各算各的会被拉开（实测 4px → 9.4px），
					//    后面那些按 x 聚类（≤8px）的步骤就认不出这是一对，各自被挪到中点 ⇒ 两根线重合、整组跑到谱外
					//    （用户：「我把最后改成了反复记号，结果超出去了」）。
					const dotEls = row.els.filter((el) => el.tagName.toLowerCase() === 'circle' && parseFloat(el.getAttribute('r') || '0') > 1.7);
					// 行末那组线（最靠右的一组，≤ `JIANPU_BAR_PAIR_GAP` 算一组）+ 它旁边的反复号圆点：这一组**不映射**，
					// 最后整组钉到行的右端（见下面 `endDx`）。中段的反复号不在这一组里，走 `groupOf` 那一支。
					const endLines = (() => {
						if (!bars.length) return [] as Element[];
						const sorted = [...bars].sort((a, b) => num(a, 'x1') - num(b, 'x1'));
						const right = num(sorted[sorted.length - 1], 'x1');
						return sorted.filter((l) => right - num(l, 'x1') <= JIANPU_BAR_PAIR_GAP);
					})();
					const endDots = endLines.length ? dotEls.filter((d) => Math.abs(num(d, 'cx') - num(endLines[0], 'x1')) < 20) : [];
					// ⚠️ 库是拿**它自己算出来的内容宽度**当行宽的：行不满、谱面窄的时候，行末那组会被画在行中间
					//    甚至行外（实测同一份谱：谱宽 782 时最后一根在 780.9，谱宽 538 时挤在行中 427，
					//    `len: 8` 那行还冲到 791.8 被 viewBox 裁掉）—— 各行「最右那根线」的位置因此各不相同
					//    （用户：「最最后面的线在不是全宽的时候为啥会乱跑」）⇒ 一律整组平移到「行末主线 = scoreW − 10」，
					//    组内间隔、反复号圆点距主线的距离都保持原样（`|]` 的粗线因此落在 scoreW − 7，跟库自己那套一致）。
					const endDx = !lastLeft && endLines.length ? scoreW - JIANPU_BAR_END_INSET - num(endLines[0], 'x1') : 0;
					if (!lastLeft) {
						endLines.forEach((l) => keep.add(l));
						endDots.forEach((d) => keep.add(d));
					}
					const repeatGroups: { lines: Element[]; dots: Element[] }[] = [];
					bars.forEach((l) => {
						if (parseFloat(l.getAttribute('stroke-width') || '0') < 3) return;
						const lx = num(l, 'x1');
						const dots = dotEls.filter((d) => Math.abs(num(d, 'cx') - lx) < 20);
						if (!dots.length) return;
						repeatGroups.push({ lines: bars.filter((o) => Math.abs(num(o, 'x1') - lx) <= 6), dots });
					});
					const groupOf = (el: Element) => repeatGroups.find((g) => g.lines.includes(el) || g.dots.includes(el));
					const doneRepeat = new Set<object>();
					row.els.forEach((el) => {
						if (keep.has(el)) return; // 行末那组：整组钉到行右端（下面）
						if (isTwin(el)) return; // 同伴线跟着主线一起挪（下面那一支）
						const rg = groupOf(el);
						if (rg) {
							if (doneRepeat.has(rg)) return;
							doneRepeat.add(rg);
							const x0 = Math.min(...rg.lines.map((l) => num(l, 'x1')));
							const dx = mapX(x0) - x0;
							if (dx) [...rg.lines, ...rg.dots].forEach((e) => mapElementX(e, (x) => x + dx));
							return;
						}
						// 线组（双纵线/终止线的那两根）：**整组共用一条位移** —— 各算各的会被缩放拉开
						// （实测单小节行 s≈4 ⇒ 原本相距 3px 变 12px，用户：「两条线怎么分离了」）
						const twin = el.nextElementSibling;
						if (twin && isTwin(twin)) {
							const dx = mapX(num(el, 'x1')) - num(el, 'x1');
							[el, twin].forEach((l) => {
								l.setAttribute('x1', String(num(l, 'x1') + dx));
								l.setAttribute('x2', String(num(l, 'x2') + dx));
							});
							return;
						}
						mapElementX(el, isTieEl(el) ? mapXIn : mapX);
					});
					if (endDx) [...endLines, ...endDots].forEach((el) => mapElementX(el, (x) => x + endDx));
				});
			} catch {
				// 容器不可见时 getBBox 会抛错：整体跳过，保持库的原始排版（下次重排再算）
			}
		}

		/**
		 * 音符自带的**固定像素装饰**：附点（`.`）和八度点（上下那几个 r=1.5 的圆点）。
		 * 库把它们摆在「数字时值槽」的固定偏移上，而 ⑪ justify 是按**墨迹**把整行拉伸的 ⇒
		 * 这两样都是**点**（没有宽度），偏移会被拉伸系数整倍放大：实测稀疏行（s≈5.7）附点跑到
		 * 数字右边 38px 处、八度点也不在数字正上了（用户：「还有没有这种诡异的 bug 快一块修了」）。
		 * ⇒ 一律按**主数字的最终位置**重摆（库本身就是这么摆的，两行都能对上）：
		 *   · 附点：墨迹左端 = 数字墨迹右端 + JIANPU_DOT_GAP
		 *   · 八度点：cx = 数字的 x（= 数字墨迹中心；实测 demo 里 110 个点全是 cx = 数字墨迹中心）
		 * ⚠️ 必须排在 ⑪ justify 之后：位移是固定像素。纵向不用管（justify 只改 x）。
		 */
		function settleJianpuDots(host: HTMLElement) {
			host.querySelectorAll('svg g[sn-tag^="stave-"] g[sn-tag^="note-"]').forEach((g) => {
				const digit = Array.from(g.querySelectorAll(':scope > text')).find((d) => d.getAttribute('font-size') === '18');
				if (!digit) return;
				const digitX = parseFloat(digit.getAttribute('x') || '0');
				// 八度点：r=1.5 的小圆点（倚音自己的八度点是 r=1，跟着倚音走，见 placeJianpuGraceNotes）
				g.querySelectorAll(':scope > circle').forEach((c) => {
					if (parseFloat(c.getAttribute('r') || '0') !== 1.5) return;
					c.setAttribute('cx', String(digitX));
				});
				const din = jianpuTextInkLR(digit);
				if (!din) return;
				g.querySelectorAll(':scope > text').forEach((t) => {
					if (t === digit || !/^\.+$/.test((t.textContent || '').trim())) return;
					const ink = jianpuTextInkLR(t);
					if (!ink) return;
					t.setAttribute('x', String(parseFloat(t.getAttribute('x') || '0') + (din.r + JIANPU_DOT_GAP - ink.l)));
				});
			});
		}

		/**
		 * 减时线（音符下面那几根时值线）：库按「线数相同的**音符组**」各画一条（组内只盖自己的音符），
		 * 而 ⑪ justify 又是**逐元素**重写坐标 ⇒ 两者叠加出两个毛病：
		 *   · 留头被拉伸系数乘一遍：一行的小节越少、线伸得越长（「线宽随小节宽度变化」）；
		 *   · 同一拍里线数变化的组各画各的 → `4>3`（附点八分 + 32 分）看着是**断开的两条线**，
		 *     而 `1/ 1//` 的第 3 条线长度也不对。
		 * 这里在 justify 之后按**标准记谱**重画：同一条线上**首尾相接**（≤ `JIANPU_UNDERLINE_JOIN`）的线段
		 * 合成一条，范围按所含音符的**真实墨迹**取（两端各留固定 `JIANPU_UNDERLINE_RIM`）。
		 * 库在**拍与拍之间**本来就会留缝（实测 6.2px），所以「相接」判据只合并同一拍内的组 ✓。
		 * ⚠️ **2026-10-01 起：分组改由「原文空格」决定**（用户：「数字音符之间没空格就连、有空格就不连」）——
		 *    没空格的相邻音符不论时值层数都连成一条，有空格的各自断开；行对不上/音符数对不上时才退回老规矩。
		 * ⚠️ 线的「层」按 y 认（基线 + 3 / 6 / 9，层高正好 3px）：曾经用「y 差 ≤8」当行过滤 →
		 *    第 3 条线（基线 +9）永远被跳过，于是它一直保持库那套错长度。
		 */
		/**
		 * 圆滑线（`(1 2 3)`）的**嵌套**与**连续**（2026-10-02，用户要求）。
		 *
		 * 库那边一个音最多只能挂「一个起点 + 一个终点」（`[` 前缀 / `]` 后缀都是布尔），配对走**栈**（后开先关）
		 * ⇒ 嵌套时只画得出最里那条，连续时（`(3(5)6)`）会配成 3→6 加一条 5→5 的零长弧。
		 * 这里按「第 k 个 `(` 配第 k 个 `)`」——用户定的口径，例子：
		 *   `(1(23))` → (1,3) 加 (2,3)（2–3 一条，外面套 1–3 一条）；`(3(5)6)` → (3,5) 加 (5,6)。
		 * 拿到全部端点对（`slurPairs`，见 `normalizeJianpuNotes`）后跟库画出来的弧**对账**：
		 * 认得出、却不在清单里的弧删掉；清单里还没人画的补一条库同款的单弧
		 * （后面 `curveJianpuTieLines` 会统一重画成纺锤形、并做套弧避让）。
		 * ⚠️ 弧的几何照库的口径：端点 = 音符数字的 `x`、弦线 y = 音符基线 − 24
		 *    （`curveJianpuTieLines` 之后统一 + `JIANPU_TIE_DROP`）。实测库的弧端点与音符 `x` 完全重合。
		 * ⚠️ **只认「两端都落在同一行音符上」的弧**：跨行的弧是两段、端点伸到行尾/行首，
		 *    对不上音符 ⇒ 一律不动，免得误删。
		 */
		function fixJianpuSlurs(host: HTMLElement, slurPairs: [number, number][]) {
			const svg = host.querySelector('svg');
			if (!svg) return;
			const layer = svg.querySelector('g[sn-tag="tieline"]');
			if (!layer) return;
			const ARC = /^M\s*([\d.eE+-]+)\s+([\d.eE+-]+)\s+A\s*([\d.eE+-]+)\s+([\d.eE+-]+)\s+([\d.eE+-]+)\s+([01])\s+([01])\s+([\d.eE+-]+)\s+([\d.eE+-]+)$/;
			const num = (el: Element, a: string) => parseFloat(el.getAttribute(a) || 'NaN');
			// 全局音符（DOM 顺序 = 原文顺序）：每个 note 组的主数字
			const notes: { x: number; y: number; row: number }[] = [];
			svg.querySelectorAll('g[sn-tag^="stave-"]').forEach((stave, row) => {
				stave.querySelectorAll('g[sn-tag^="note-"]').forEach((g) => {
					const t = g.querySelector('text[font-size="18"]');
					if (t) notes.push({ x: num(t, 'x'), y: num(t, 'y'), row });
				});
			});
			if (!notes.length) return;
			// 三连音的括号不是连音线：`3` 那个 text 前面紧挨的 3 个 path/line 跳过不认
			const skip = new Set<Element>();
			layer.querySelectorAll(':scope > text').forEach((t) => {
				if ((t.textContent || '').trim() !== '3') return;
				let el: Element | null = t.previousElementSibling;
				for (let k = 0; k < 3 && el; k++, el = el.previousElementSibling) skip.add(el);
			});
			/** 弧的端点 → 音符下标（库的端点是「音符槽中心」，与数字的 x 实测完全重合） */
			const near = (x: number, y: number) => notes.findIndex((n) => Math.abs(n.x - x) < 2.5 && Math.abs(n.y - 24 - y) < 6);
			const want = slurPairs.filter(([a, b]) => notes[a] && notes[b] && notes[a].row === notes[b].row);
			// ⚠️ 我们的配对是 **FIFO**（第 k 个 `(` 配第 k 个 `)`），库是**栈**（后开先关）—— 两者在
			//    「连续 / 嵌套」（`(3(5)6)` 那种）时结果不同，库就可能画出一条我们**不要**的弧；跨行的那种
			//    在下面认不出来，原先一律保留 ⇒ 用户看到的就是「第二条开头又长一大条」（《月亮桥》实测：
			//    那对弧的端点落在第一行与第二行的音符上，源里根本没有跨行的圆滑线）。
			//    所以：**只要清单里没有真正跨行的对**（圆滑线都在小节内 ⇒ 分句不会切开它），
			//    认不出来的弧就统统删掉。
			const crossWant = slurPairs.filter(([a, b]) => notes[a] && notes[b] && notes[a].row !== notes[b].row).length;
			const rest = [...want];
			Array.from(layer.querySelectorAll(':scope > path')).forEach((p) => {
				if (skip.has(p)) return;
				const m = ARC.exec((p.getAttribute('d') || '').trim());
				if (!m) return;
				const x1 = parseFloat(m[1]);
				const y = parseFloat(m[2]);
				const x2 = parseFloat(m[8]);
				const i = near(x1, y);
				const j = near(x2, y);
				if (i < 0 || j < 0) {
					if (!crossWant) p.remove(); // 认不出来 + 清单里没有跨行的对 ⇒ 是库自己配错的
					return;
				}
				const at = rest.findIndex(([a, b]) => a === i && b === j);
				if (at < 0) {
					p.remove(); // 库配错了（嵌套 / 连续时）
					return;
				}
				rest.splice(at, 1);
			});
			// 清单里还没人画的：照库的格式补一条单弧（后面统一重画成纺锤形）
			rest.forEach(([a, b]) => {
				const na = notes[a];
				const nb = notes[b];
				const span = Math.abs(nb.x - na.x);
				if (span < 1) return;
				const y = na.y - 24;
				const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
				path.setAttribute('d', `M ${na.x} ${y} A ${(span / 2).toFixed(2)} ${(span * 0.08).toFixed(2)} 0 0 1 ${nb.x} ${y}`);
				path.setAttribute('stroke', 'black');
				path.setAttribute('stroke-width', '2');
				layer.appendChild(path);
			});
		}

		function refineJianpuUnderlines(host: HTMLElement, glueLines?: (boolean[] | null)[]) {
			const svg = host.querySelector('svg');
			if (!svg) return;
			const num = (el: Element, a: string) => parseFloat(el.getAttribute(a) || 'NaN');
			const segs = Array.from(svg.querySelectorAll('g[sn-tag="beam"] line')).map((l) => ({ el: l, x1: num(l, 'x1'), x2: num(l, 'x2'), y: num(l, 'y1') }));
			if (!segs.length) return;
			Array.from(svg.querySelectorAll('g[sn-tag^="stave-"]')).forEach((stave, rowIdx) => {
				// 音符 = 每个 note 组里的第一个 18px 文本（附点也是 18px，不能算进来）
				const notes: { y: number; l: number; r: number; c: number; lv: number }[] = [];
				stave.querySelectorAll('g[sn-tag^="note-"]').forEach((g) => {
					const t = g.querySelector('text[font-size="18"]');
					if (!t) return;
					const ink = jianpuTextInkLR(t);
					const y = num(t, 'y');
					if (ink && Number.isFinite(y)) notes.push({ y, l: ink.l, r: ink.r, c: (ink.l + ink.r) / 2, lv: 0 });
				});
				if (!notes.length) return;
				const baseY = notes[0].y; // 同一行的音符共用一个基线
				const rowSegs = segs.filter((s) => Number.isFinite(s.y) && s.y > baseY && s.y < baseY + 14);
				if (!rowSegs.length) return;
				// 每个音下面压着几层线：库按「组」画、线只盖自己的音符 ⇒ 按中心点认领
				notes.forEach((n) => {
					n.lv = rowSegs.filter((s) => n.c >= s.x1 - 0.5 && n.c <= s.x2 + 0.5).length;
				});
				const levels = Array.from(new Set(rowSegs.map((s) => Math.round(s.y - baseY)))).sort((a, b) => a - b);
				const specs: { y: number; x1: number; x2: number }[] = [];
				const glue = glueLines?.[rowIdx];
				if (glue && glue.length === notes.length) {
					// 按**原文空格**分组：没空格的相邻音符连成一条，有空格的各画各的（层数不够的音也断开）
					const maxLv = Math.max(...notes.map((n) => n.lv));
					for (let lv = 1; lv <= maxLv; lv++) {
						const y = baseY + (levels[lv - 1] ?? lv * 3);
						let seg: { l: number; r: number } | null = null;
						const flushSeg = () => {
							if (seg) specs.push({ y, x1: seg.l - JIANPU_UNDERLINE_RIM, x2: seg.r + JIANPU_UNDERLINE_RIM });
							seg = null;
						};
						notes.forEach((n, i) => {
							if (n.lv < lv) {
								flushSeg();
								return;
							}
							if (seg && glue[i]) {
								seg.l = Math.min(seg.l, n.l);
								seg.r = Math.max(seg.r, n.r);
								return;
							}
							flushSeg();
							seg = { l: n.l, r: n.r };
						});
						flushSeg();
					}
				} else {
					// 拿不到原文空格（行数/音符数对不上）⇒ 退回老规矩：同层首尾相接的并成一条
					levels.forEach((lv) => {
						// 同层的线段按 x 排序，首尾相接的并成一条（库在拍之间留缝 ⇒ 跨拍的不会并上）
						const chains: { x1: number; x2: number; y: number }[] = [];
						rowSegs
							.filter((s) => Math.round(s.y - baseY) === lv)
							.sort((a, b) => a.x1 - b.x1)
							.forEach((s) => {
								const last = chains[chains.length - 1];
								if (last && s.x1 - last.x2 <= JIANPU_UNDERLINE_JOIN) {
									last.x2 = Math.max(last.x2, s.x2);
									return;
								}
								chains.push({ x1: s.x1, x2: s.x2, y: s.y });
							});
						chains.forEach((ch) => {
							const under = notes.filter((n) => n.c >= ch.x1 - 2 && n.c <= ch.x2 + 2);
							if (!under.length) return;
							specs.push({ y: ch.y, x1: Math.min(...under.map((n) => n.l)) - JIANPU_UNDERLINE_RIM, x2: Math.max(...under.map((n) => n.r)) + JIANPU_UNDERLINE_RIM });
						});
					});
				}
				if (!specs.length) return;
				const proto = rowSegs[0].el;
				const parent = proto.parentElement;
				rowSegs.forEach((s) => s.el.remove());
				if (!parent) return;
				specs.forEach((sp) => {
					const line = proto.cloneNode(false) as Element;
					line.setAttribute('x1', String(sp.x1));
					line.setAttribute('x2', String(sp.x2));
					line.setAttribute('y1', String(sp.y));
					line.setAttribute('y2', String(sp.y));
					parent.appendChild(line);
				});
			});
		}

		/**
		 * 同一行内把**各小节线的留白统一**。库按**时值权重**分小节槽、槽内又按拍位网格摆音符（首末音未必靠边）
		 * ⇒ 即使 ⑪e 把每根线摆到相邻墨迹的中点（逐条看左右相等），**线跟线之间**的留白也能差一倍
		 * （同一行实测 41 / 50 / 55，用户：「每个小节线左右的宽度都不太一样，不太工整」）。
		 * 做法：留白总量不变，只**重新分配** —— 每小节的内容当**刚性块**整体平移（块内音符间距一点不动），
		 * 块与块之间的空白均分；行末那根竖线（库钉在行宽右端）当锚点不动。
		 * ⚠️ 用**分段线性映射**改 x（块内 = 平移、块间 = 线性插值）：音符/减时线/连音线/小房子/倚音
		 *    全都跟着同一个映射走，不用去认「谁属于哪一小节」。
		 * ⚠️ 必须排在 ⑪e（连音线/三连音弧已经造好）之后、`centerJianpuBarlines` 之前：
		 *    前者要一起映射，后者负责把线精确摆到新留白的中点。
		 */
		function evenJianpuBarGaps(host: HTMLElement) {
			const svg = host.querySelector('svg');
			if (!svg) return;
			const num = (el: Element | null, a: string) => (el ? parseFloat(el.getAttribute(a) || 'NaN') : NaN);
			const rows: { baseY: number; mapX: (x: number) => number }[] = [];
			svg.querySelectorAll('g[sn-tag^="stave-"]').forEach((stave) => {
				const baseY = num(stave.querySelector('text[font-size="18"]'), 'y');
				// ① 每小节内容的墨迹范围（小节组里的 18px 数字 + 附点 + 延音破折号）
				const spans = Array.from(stave.children)
					.filter((c) => c.tagName === 'g' && /^measure-/.test(c.getAttribute('sn-tag') || ''))
					.map((m) => {
						const inks = Array.from(m.querySelectorAll('text[font-size="18"]'))
							.map((t) => jianpuTextInkLR(t))
							.filter((i): i is { l: number; r: number } => !!i);
						return inks.length ? { l: Math.min(...inks.map((i) => i.l)), r: Math.max(...inks.map((i) => i.r)) } : null;
					})
					.filter((s): s is { l: number; r: number } => !!s)
					.sort((a, b) => a.l - b.l);
				if (spans.length < 2) return;
				// ② 边界组的墨迹范围（竖线 ± 反复号的两个圆点）：按 x 邻近聚类（与 centerJianpuBarlines 同一套）
				const dotEls = Array.from(stave.querySelectorAll('circle')).filter((c) => num(c, 'r') >= 1.7);
				const clusters: { l: number; r: number }[] = [];
				Array.from(stave.children)
					.filter((c) => c.tagName === 'line')
					.map((l) => num(l, 'x1'))
					.filter(Number.isFinite)
					.sort((a, b) => a - b)
					.forEach((x) => {
						const last = clusters[clusters.length - 1];
						if (last && x - last.r <= JIANPU_BAR_PAIR_GAP) {
							last.r = x;
							return;
						}
						clusters.push({ l: x, r: x });
					});
				if (!clusters.length) return;
				clusters.forEach((c) => {
					dotEls.forEach((d) => {
						const cx = num(d, 'cx');
						const r = num(d, 'r');
						if (cx > c.l - JIANPU_REPEAT_DOT_NEAR && cx < c.r + JIANPU_REPEAT_DOT_NEAR) {
							c.l = Math.min(c.l, cx - r);
							c.r = Math.max(c.r, cx + r);
						}
					});
				});
				const endX = clusters[clusters.length - 1].r; // 行末那组竖线（含同伴）的右端：锚点
				const startX = spans[0].l; // 行首内容左端：锚点
				const m = spans.length;
				// ③ 交替成「块」：小节内容块、边界块（竖线 + 反复号的两个圆点）——
				//    两类块都是**刚性**的（块内坐标关系一点不动），留白只在块与块之间均分 ⇒
				//    反复号那组竖线/圆点自己不会变形，各条线的留白也完全一样。
				const blocks: { l: number; r: number }[] = [];
				for (let i = 0; i < m; i++) {
					blocks.push({ l: spans[i].l, r: spans[i].r });
					const nextL = i + 1 < m ? spans[i + 1].l : endX;
					const after = clusters.filter((c) => c.l >= spans[i].r - 1 && c.l <= nextL + 1).sort((a, b) => a.l - b.l)[0];
					if (!after) return;
					blocks.push({ l: after.l, r: after.r });
				}
				const inner = blocks.reduce((a, b) => a + (b.r - b.l), 0);
				const gapCount = blocks.length - 1; // 相邻块之间各一份留白：2m − 1
				const G = (endX - startX - inner) / gapCount;
				if (!(G > 0)) return;
				const targets: { l: number; r: number }[] = [];
				let cur = startX;
				blocks.forEach((b) => {
					targets.push({ l: cur, r: cur + (b.r - b.l) });
					cur += b.r - b.l + G;
				});
				const mapX = (x: number) => {
					if (x <= blocks[0].l || x >= endX) return x;
					for (let i = 0; i < blocks.length; i++) {
						const b = blocks[i];
						if (x <= b.r) return targets[i].l + (x - b.l); // 块内：纯平移
						const nb = blocks[i + 1];
						if (!nb) return x;
						if (x < nb.l) return targets[i].r + ((x - b.r) / (nb.l - b.r)) * (targets[i + 1].l - targets[i].r); // 块间：线性插值
					}
					return x;
				};
				if (Number.isFinite(baseY)) rows.push({ baseY, mapX });
				stave.querySelectorAll('text, circle, line, path').forEach((el) => mapElementX(el, mapX));
			});
			if (!rows.length) return;
			// 减时线/连音线/和弦层不在 stave 里：按 y 就近认行（与 justifyJianpuLines 同一套）
			const layerY = jianpuLayerY;
			svg.querySelectorAll('g[sn-tag="beam"] *, g[sn-tag="chord"] *, g[sn-tag="tieline"] *').forEach((el) => {
				const y = layerY(el);
				if (!Number.isFinite(y)) return;
				const row = rows.reduce((best, r) => (Math.abs(r.baseY - y) < Math.abs(best.baseY - y) ? r : best));
				mapElementX(el, row.mapX);
			});
		}

		/**
		 * 小节线左右留白不等：库把每小节的**内容整块居中在自己的小节槽**里，而线画在**槽边界**上 ⇒
		 * 线左边那点空来自「上一小节内容居中后剩下的尾巴」、右边那点空来自「下一小节内容的左边距」——
		 * 两个数出自**两个不同的小节**，必然不等（实测 14.5 vs 22.6、18.8 vs 21.7、18.6 vs 22.8；
		 * 用户：「小节线/双纵线这些线的前面和后面空白不一样」）。
		 * 做法：⑪ justify 之后，把每**组**线挪到「前一个墨迹右端」与「后一个墨迹左端」的**中点**。
		 * ⚠️ 「组」按 x 邻近（≤ `JIANPU_BAR_PAIR_GAP`）聚类：单线、双纵线的两根、终止线的细 + 粗、
		 *    库里自己画的反复号（`|:` `:|` 的两根竖线）都自然成组，整组共用一条位移（组内间距不变）。
		 * ⚠️ 反复号的两个圆点（r≥1.7，都在竖线一侧）也归到它那一组里**一起挪**，并且算进整组的墨迹范围
		 *    —— 不然「点」会被甩在原地，右侧留白也量不对。
		 * ⚠️ 行末那组后面没音符 ⇒ 不动（库把它钉在行宽右端，那是它该在的位置）。
		 */
		function centerJianpuBarlines(host: HTMLElement) {
			const svg = host.querySelector('svg');
			if (!svg) return;
			const barX = (el: Element) => parseFloat(el.getAttribute('x1') || 'NaN');
			const num = (el: Element, a: string) => parseFloat(el.getAttribute(a) || 'NaN');
			svg.querySelectorAll('g[sn-tag^="stave-"]').forEach((stave) => {
				const inks: { l: number; r: number }[] = [];
				stave.querySelectorAll('text[font-size="18"]').forEach((t) => {
					const ink = jianpuTextInkLR(t);
					if (ink) inks.push(ink);
				});
				if (!inks.length) return;
				type Group = { lines: Element[]; dots: Element[]; left: number; right: number };
				const groups: Group[] = [];
				Array.from(stave.children)
					.filter((c) => c.tagName === 'line')
					.map((l) => ({ l, x: barX(l) }))
					.filter((b) => Number.isFinite(b.x))
					.sort((a, b) => a.x - b.x)
					.forEach(({ l, x }) => {
						const g = groups[groups.length - 1];
						if (g && x - g.right <= JIANPU_BAR_PAIR_GAP) {
							g.lines.push(l);
							g.right = x;
							return;
						}
						groups.push({ lines: [l], dots: [], left: x, right: x });
					});
				const dotEls = Array.from(stave.querySelectorAll('circle')).filter((c) => num(c, 'r') >= 1.7);
				groups.forEach((g) => {
					const bars = g.lines.map((l) => [num(l, 'y1'), num(l, 'y2')] as const);
					const yTop = Math.min(...bars.map((b) => b[0]));
					const yBot = Math.max(...bars.map((b) => b[1]));
					g.dots = dotEls.filter((d) => {
						const cx = num(d, 'cx');
						const cy = num(d, 'cy');
						return cx > g.left - JIANPU_REPEAT_DOT_NEAR && cx < g.right + JIANPU_REPEAT_DOT_NEAR && cy > yTop - 4 && cy < yBot + 4;
					});
					g.dots.forEach((d) => {
						const r = num(d, 'r');
						const cx = num(d, 'cx');
						g.left = Math.min(g.left, cx - r);
						g.right = Math.max(g.right, cx + r);
					});
					const prev = inks.filter((n) => n.r <= g.left).sort((a, b) => b.r - a.r)[0];
					const next = inks.filter((n) => n.l >= g.right).sort((a, b) => a.l - b.l)[0];
					if (!prev || !next) return;
					const dx = (prev.r + next.l) / 2 - (g.left + g.right) / 2;
					if (!Number.isFinite(dx) || !dx) return;
					[...g.lines, ...g.dots].forEach((el) => {
						if (el.tagName === 'line') {
							el.setAttribute('x1', String(num(el, 'x1') + dx));
							el.setAttribute('x2', String(num(el, 'x2') + dx));
						} else {
							el.setAttribute('cx', String(num(el, 'cx') + dx));
						}
					});
				});
			});
		}

		/**
		 * 元素渲染出来的**横向墨迹**（绝对坐标 `[左, 右]`）—— 用 `getBBox()`。
		 * ⚠️ 为什么不用 canvas 量：字体没就绪时 canvas 会**静默落到兜底字形**（.notdef 方块 = 字号那么大），
		 *    而库那份 `Bravura` 是**渲染时才注入 @font-face** 的，同一帧里就可能拿不到字形
		 *    （实测 ♯ 量出 13px、实际 5px ⇒ 变音记号整体左偏 8px，倚音也被摆到主数字身上）；
		 *    `getBBox()` 量的是**已经画出来的东西**，拿不到字形时宽度为 0 ⇒ 天然不会错。
		 * ⚠️ 纵向不能用它：SVG 文本的盒子高度是**行盒**（含字体 ascent/descent），不是墨迹高。
		 * 容器不可见时 `getBBox()` 会抛错 → 返回 null，调用方退回 canvas 度量。
		 */
		function inkLR(el: Element, _ch: string): [number, number] | null {
			try {
				const b = (el as SVGGraphicsElement).getBBox();
				if (b.width > 0) return [b.x, b.x + b.width];
			} catch {
				/* 落到 null */
			}
			return null;
		}

		/** 把元素里所有「绝对 x 坐标」按 map 重写：text@x / circle@cx / line@x1,x2 / path@d */
		function mapElementX(el: Element, map: (x: number) => number) {
			const tag = el.tagName.toLowerCase();
			const num = (a: string) => parseFloat(el.getAttribute(a) || '0');
			if (tag === 'text') {
				if (el.getAttribute('x') !== null) el.setAttribute('x', String(map(num('x'))));
			} else if (tag === 'circle') {
				if (el.getAttribute('cx') !== null) el.setAttribute('cx', String(map(num('cx'))));
			} else if (tag === 'line') {
				el.setAttribute('x1', String(map(num('x1'))));
				el.setAttribute('x2', String(map(num('x2'))));
			} else if (tag === 'path') {
				const d = el.getAttribute('d');
				if (d) el.setAttribute('d', mapPathData(d, map));
			}
		}

		/**
		 * 重写 path 的 d：**只动绝对命令的 x 分量**（相对命令原样保留，否则会被平移两次）。
		 * 参数位置（只列含 x 的）：H→[末尾 x]、M/L/T→[x]、C→[x1,x2,x]、S/Q→[x1,x]、A→[末尾 x]（rx/ry 不动）。
		 */
		function mapPathData(d: string, map: (x: number) => number) {
			const TOKEN = /([MmLlHhVvCcSsQqTtAaZz])|(-?\d*\.?\d+(?:[eE][-+]?\d+)?)/g;
			const tokens: (string | number)[] = [];
			let m: RegExpExecArray | null;
			while ((m = TOKEN.exec(d)) !== null) tokens.push(m[1] !== undefined ? m[1] : parseFloat(m[2]));
			const X_IDX: Record<string, number[]> = { M: [0], L: [0], T: [0], H: [0], C: [0, 2, 4], S: [0, 2], Q: [0, 2], A: [5] };
			const ARGS: Record<string, number> = { M: 2, L: 2, T: 2, H: 1, V: 1, C: 6, S: 4, Q: 4, A: 7 };
			const out: string[] = [];
			let cmd = '';
			let i = 0;
			while (i < tokens.length) {
				if (typeof tokens[i] === 'string') {
					cmd = tokens[i] as string;
					i++;
				}
				const up = cmd.toUpperCase();
				if (up === 'Z') {
					out.push(cmd);
					continue;
				}
				const n = ARGS[up] ?? 2;
				const args = tokens.slice(i, i + n) as number[];
				i += n;
				// 只在「绝对命令」上映射（小写 = 相对坐标，其数值不是绝对 x）
				if (cmd === up) (X_IDX[up] || []).forEach((k) => (args[k] = map(args[k])));
				out.push(cmd + ' ' + args.map((v) => +v.toFixed(2)).join(' '));
			}
			return out.join(' ');
		}

		/**
		 * 小节线按围栏原文**精确对应**（用户要求）：
		 *   `|`  → 小节线（一根细线）
		 *   `||` → 双纵线（两根细线）
		 *   `|]` → 终止线（细 + 粗）
		 *
		 * ⚠️ 库只认 `|`：`||` / `|]` 都被它当普通 `|`；而且它**永远**在行末补一对「细 + 粗」。
		 *    所以这里按「原文里记号的顺序」对着库画出来的线逐个修正 —— 行内的小节线按第 1..n−1 个记号，
		 *    行末那对按**最后一个记号**重塑；原文末尾没有记号就把那对整组去掉。
		 * ⚠️ 补出来的第二根打 `data-jianpu-bar="twin"`：`justifyJianpuLines` 里它必须跟主线
		 *    **共用一条位移**（各算各的会被缩放拉开 —— 单小节行 s≈4 时 3px 会变 12px，用户实测「两条线分离了」）。
		 */
		function shapeJianpuBarlines(host: HTMLElement, rows: { measures: string[]; tokens: (string | null)[] }[]) {
			const svg = host.querySelector('svg') as SVGSVGElement | null;
			if (!svg || !rows.length) return;
			const dx = JIANPU_BAR_TWIN_DX;
			const setWidth = (l: SVGLineElement, w: number) => l.setAttribute('stroke-width', String(w));
			/** 给某根线补同伴（克隆它的 y 与描边样式，只改 x 与粗细） */
			const addTwin = (line: SVGLineElement, thick: boolean) => {
				line.setAttribute('data-jianpu-bar', 'main');
				const twin = line.cloneNode(true) as SVGLineElement;
				const x = (v: string) => parseFloat(line.getAttribute(v) || '0') + dx;
				twin.setAttribute('data-jianpu-bar', 'twin');
				twin.setAttribute('x1', String(x('x1')));
				twin.setAttribute('x2', String(x('x2')));
				setWidth(twin, thick ? 3 : 1);
				line.insertAdjacentElement('afterend', twin);
			};
			// 一行一条地对着 planJianpuBars 给的结构修（库每行都补了根粗线，那根不要）
			Array.from(svg.querySelectorAll('g[sn-tag^="stave-"]')).forEach((stave, si) => {
				const row = rows[si];
				if (!row) return;
				const bars = (Array.from(stave.querySelectorAll(':scope > line')) as SVGLineElement[]).sort(
					(a, b) => parseFloat(a.getAttribute('x1') || '0') - parseFloat(b.getAttribute('x1') || '0')
				);
				if (!bars.length) return;
				const x1 = (l: SVGLineElement) => parseFloat(l.getAttribute('x1') || '0');
				const sw = (l: SVGLineElement) => parseFloat(l.getAttribute('stroke-width') || '0');
				// 反复号的两个圆点（r=1.8）——用来把「反复号的那对竖线」和「库在行末补的细+粗」区分开
				const dots = Array.from(stave.querySelectorAll('circle')).filter((c) => parseFloat(c.getAttribute('r') || '0') >= 1.7);
				const nearDot = (x: number) => dots.some((d) => Math.abs(parseFloat(d.getAttribute('cx') || '0') - x) < 14);
				// 行末那根「粗」是库给每行都加的收尾装饰 → 摘掉（真终止线由下面按记号自己补）
				// ⚠️ 反复号（`:|`）也是「细 + 粗」挨着，而且它自带圆点 ⇒ 靠圆点区分，别把反复号的粗线当成收尾装饰删掉
				const last = bars[bars.length - 1];
				const prev = bars[bars.length - 2];
				if (prev && x1(last) - x1(prev) <= dx + 1 && sw(last) >= 3 && !nearDot(x1(last))) {
					last.remove();
					bars.pop();
				}
				// 按 x 邻近聚成「边界组」：一根单独的小节线、双纵线/终止线的两根、反复号的两根 + 下一个小节的起始线
				const groups: SVGLineElement[][] = [];
				bars.forEach((l) => {
					const g = groups[groups.length - 1];
					if (g && x1(l) - x1(g[g.length - 1]) <= JIANPU_BAR_PAIR_GAP) g.push(l);
					else groups.push([l]);
				});
				// 一条边界线（组）↔ 一个小节后面的记号（null = 原文没写 → 这行不该有线）
				groups.forEach((g, k) => {
					const token = row.tokens[k];
					// 反复号（组里有粗线）：库自己画的「两根竖线 + 两个圆点」原样保留，
					// 但**下一个小节的起始小节线**是多余的（库每小节都画一根）⇒ 删掉它，否则看着像三根线。
					const thick = g.find((l) => sw(l) >= 3);
					if (thick) {
						const mate = g.filter((l) => l !== thick).sort((a, b) => Math.abs(x1(a) - x1(thick)) - Math.abs(x1(b) - x1(thick)))[0];
						g.forEach((l) => {
							if (l !== thick && l !== mate) l.remove();
						});
						// 库自己那对相距 **4px**（我们补的同伴是 `JIANPU_BAR_TWIN_DX`）⇒ 把粗线收到同一档，
						// 免得反复记号跟终止线看着不一样宽（用户：「这俩线的间距也和终止线不一样」）。
						// 细线（靠圆点那根）不动，粗线留在它原来那一侧，只挪差值。
						if (mate) {
							const target = x1(mate) + (x1(thick) >= x1(mate) ? dx : -dx);
							const delta = target - x1(thick);
							thick.setAttribute('x1', String(x1(thick) + delta));
							thick.setAttribute('x2', String(parseFloat(thick.getAttribute('x2') || '0') + delta));
						}
						return;
					}
					if (!token) {
						g.forEach((l) => l.remove());
						return;
					}
					const line = g[0];
					g.slice(1).forEach((l) => l.remove());
					setWidth(line, 1);
					line.removeAttribute('data-jianpu-bar');
					if (token === '|]') addTwin(line, true);
					else if (token === '||') addTwin(line, false);
				});
			});
		}

		/**
		 * 等**库注入的那份 `Bravura`**（变音记号 / 倚音字形用的就是这个族，跟我们自己的
		 * `Bravura-Digits` 是两码事）真正可用后回调一次。
		 *
		 * ⚠️ 为什么必须单独等它：`whenBravuraReady` 探的是 `Bravura-Digits`（拍号/速度数字用），
		 *    而库那份 `Bravura` 是**渲染时才注入 @font-face**、就绪得更晚 ⇒ ⑧（变音记号）/⑦（倚音）
		 *    量墨迹会量到**兜底字形的 .notdef 方块**（实测 ♯ 量出 13px、实际只有 5px ⇒ 记号整体
		 *    左偏 8px、倚音被摆到主数字身上）。
		 * ⚠️ 用 `setTimeout` 轮询而不是 rAF：后台标签页里 rAF 不触发（同 bravura-digits.ts）。
		 */
		function whenScoreBravuraReady(cb: () => void) {
			const probe = '\uED62'; // 升号（库的 Bravura 里就有）
			const ready = () => {
				try {
					return document.fonts.check('13px Bravura', probe);
				} catch {
					return false;
				}
			};
			try {
				document.fonts.load('13px Bravura', probe).catch(() => {
					/* 失败就靠轮询收尾 */
				});
			} catch {
				/* 环境不支持就靠轮询 */
			}
			let tries = 0;
			const poll = () => {
				if (ready()) {
					cb();
					return;
				}
				if (++tries < 12) window.setTimeout(poll, 250);
			};
			poll();
		}

		/** 渲染单个谱面（幂等：成功后会清空容器，可安全用于宽度变化后的重排） */
		function renderJianpuScore(host: HTMLElement, SimpleNotation: any): boolean {
			const raw = host.dataset.jianpu || '';
			if (!raw) return false;
			const { info, lyric, score, bodyRows } = parseJianpuSource(raw);
			if (!score) return false;
			delete host.dataset.jianpuTitleStripped;
			// 标题 / 信息到底写没写：库里信息区是按「标题 + 三行」固定留高的，标题空着它也照留，
			// 所以把「有没有」记在 dataset 上，渲染完由 compactJianpuHead 把多出来那截收掉。
			const hasTitle = !!(info.title || '').trim();
			const hasInfo = ['composer', 'key', 'beat', 'time', 'tempo'].some((k) => String((info as any)[k] ?? '').trim());
			host.dataset.jianpuHasTitle = hasTitle ? '1' : '0';
			host.dataset.jianpuHasInfo = hasInfo ? '1' : '0';
			host.dataset.jianpuWrap = info.wrap || '';
			host.dataset.jianpuTime = (info.time || '').trim(); // 速度记号前的音符符号要用它决定（全/二分/四分…）
			// ⚠️ 宽度明显变了 ⇒ 丢掉「密度降档」的记忆（变宽了本来就能多放几小节）
			const widthNow = Math.round(host.clientWidth || 736);
			// 排版宽度：**≥ 600 跟容器走，< 600 恒为 600** —— 窄屏时谱面按 600px 的样子定死，之后只整体缩放
			const layoutWidth = Math.max(widthNow, JIANPU_MIN_LAYOUT_WIDTH);
			const prevWidthNow = Number(host.dataset.jianpuWidth) || 0;
			// ⚠️ 比较用**排版宽度**（`layoutWidth`）：容器 <600 时它恒为 600 ⇒ 窄屏拖动窗口不会反复重排
			if (prevWidthNow > 0 && Math.abs(prevWidthNow - layoutWidth) >= 24) {
				delete host.dataset.jianpuPerLineFit;
			}
			// 每行小节数 = 分档值，但上一轮发现「太挤」时会降档（`jianpuPerLineFit`，见本次渲染末尾的检查）
			const basePerLine = measuresPerLine(host);
			// ⚠️ `basePerLine === 0`（按原码行换行）时**不**采纳「密度降档」的结果，否则又会≠0 ⇒ 自动分句
			const perLine = basePerLine > 0 ? Number(host.dataset.jianpuPerLineFit) || basePerLine : 0;
			// 谱面结构：每行的小节 + 每条小节线后面的记号（`|` / `||` / `|]` / null=没写）
			const barRows = planJianpuBars(bodyRows, perLine);
			// 每行的换调（`K: X`：单独一行写在它后面那一行，写在行内的算这一行；空串 = 不换调）。
			// `at` = 换调点落在该行的第几个小节（不换调就是 −1）
			const mods = barRows.map((r) => ({ at: r.modAt, key: r.mod || r.inl || '' }));
			// 连音组的 N（`2(`–`9(`）：库只认 `3(` ⇒ 交给库时一律写 `3(`，真实数字按出现顺序记在这儿，
			// 由 `styleJianpuTriplets` 取回来当标签（标签本来就会被换成 Bravura 字形）
			const glueLines: (boolean[] | null)[] = [];
			// 圆滑线的端点对（全局音符序号，含嵌套/连续）：库画不出来的由 `fixJianpuSlurs` 补
			const slurPairs: [number, number][] = [];
			const tuplets: string[] = [];
			// 还原号（`=`）在**带变音记号的音符**里的下标（库只能画升/降号，见 applyJianpuNaturals）
			const naturals: number[] = [];
			// 倚音上的变音记号（按倚音出现顺序，空串 = 没记号）——库不画，见 drawJianpuGraceAccidentals
			const graceAccs: string[] = [];
			// 默认时值（`len:` 的分母，不写 = **跟随拍号的分母**）：音符时值都相对它
			// ⚠️ 用户 2026-10-01 定：「以 X 分音符为一拍」时，没写 `len:` 的默认时值就是那个 X 分音符（拿不到就退回 4）
			const lenDen = (() => {
				const m = /(\d+)\s*$/.exec(String(info.len ?? ''));
				if (m) return +m[1];
				const t = /(\d+)\s*$/.exec(String(info.time ?? ''));
				return t && JIANPU_LEN_DENS.includes(+t[1]) ? +t[1] : 4;
			})();
			host.dataset.jianpuPerLine = String(perLine);
			host.dataset.jianpuBasePerLine = String(basePerLine); // 分档值（宽度没实质变化时不再重排的凭据）
			host.dataset.jianpuWidth = String(layoutWidth);
			// ⚠️ simple-notation 内部用全局运行时（SNRuntime）：同页多个实例会互相覆盖。
			// 变通：渲染到「离屏容器」，再把渲染好的节点搬进真实容器，保证互不干扰。
			const scratch = document.createElement('div');
			scratch.setAttribute('aria-hidden', 'true');
			scratch.style.cssText = 'position:absolute;left:-99999px;top:0;visibility:hidden;pointer-events:none;';
			scratch.style.width = Math.max(320, layoutWidth) + 'px';
			document.body.appendChild(scratch);
			try {
				const sn = new SimpleNotation(scratch as HTMLDivElement, {
					resize: false,
					// ⚠️ padding 数组顺序是 [横向, 纵向]（与 CSS 相反）。库默认横向 20+10、纵向 20+10；
					// 这里把横向清零，谱面才能占满整行（实测墨迹 661.8px → 721.8px，多出 60px 给音符）；
					// 纵向保持原值，标题/谱面上下留白不变。
					content: { padding: [0, 20], infoShow: true },
					// 信息带高度：库默认 120。信息区原本要摆调号/速度/作曲三行，我们把它们并成一行后，
					// 原来那 3 行的带子下面就空出 2 行的高度 —— 白白把谱面往下推。改矮它（见常量注释）。
					info: { height: JIANPU_INFO_HEIGHT },
					// ⚠️ 有歌词时保持库默认的 lyricHeight(25)，否则歌词会糊到下一行上；
					//    没歌词时清掉它 —— 库不管有没有歌词都硬留 25px，白占行距。
					score: lyric
						? { padding: [0, 10], lineSpace: JIANPU_ROW_GAP }
						: { padding: [0, 10], lineSpace: JIANPU_ROW_GAP, lyricHeight: 0 },
				});
				const data: any = {
					info: {
						// ⚠️ 标题没写也给个空白占位：库里「有没有标题」会改变信息行的摆法（没标题时它把第一行
						// 信息摆到标题的位置上、其余留在原处 ⇒ 信息行之间空一大块）。给占位 = 几何跟「有标题」
						// 完全一致，后面几步微调也都按这个基准调；最后 compactJianpuHead 再把它连空白一起收掉。
						title: hasTitle ? info.title : '\u00a0',
						composer: info.composer,
						// ⚠️ 作词（`lyricist:`）已废（用户 2026-10-01：「用不到，有一个作曲足够了」）——
						//    键仍然认（不认就会整行落入谱面文本），但**不传给库** ⇒ 不画。
						key: info.key,
						beat: info.beat,
						time: info.time,
						tempo: info.tempo,
					},
					// ⚠️ 交给库之前：① 空格也当音符分隔符（用户不想老打逗号）；② 小节线一律给它单竖线
					//    （库只认 `|`，还会把 `|]` 里的 `]` 另当成一个小节边界 → 凭空多一根线）。
					//    记号本身由 `shapeJianpuBarlines` 按 barRows 里的记号重塑，这里丢掉这层信息没关系。
					score: normalizeJianpuNotes(barRows.map((r) => r.measures.join('|')).join('\n'), lenDen, tuplets, naturals, graceAccs, glueLines, slurPairs),
					lyric: lyric || undefined,
				};
				sn.loadData(data);
				host.innerHTML = ''; // 重排时先丢弃旧谱（源码已存 dataset，不再需要兜底块）
				while (scratch.firstChild) host.appendChild(scratch.firstChild);
				host.classList.add('is-rendered');
				// ① 补 viewBox：库输出的是固定 width/height 且无 viewBox，补上后 CSS 才能等比缩放
				const svg = host.querySelector('svg');
				if (svg && !svg.getAttribute('viewBox')) {
					const w = parseFloat(svg.getAttribute('width') || '0');
					const h = parseFloat(svg.getAttribute('height') || '0');
					if (w > 0 && h > 0) {
						svg.setAttribute('viewBox', '0 0 ' + w + ' ' + h);
						svg.removeAttribute('width');
						svg.removeAttribute('height');
					}
				}
				// ② 去掉冗余排版：小节号 + 每句开头的起始小节线
				cleanJianpuSvg(host);
				// ②a 圆滑线：库只能一个音一个起点/终点，嵌套与连续的几条得自己补（见 fixJianpuSlurs）
				fixJianpuSlurs(host, slurPairs);
				// ②a1 行内小节线：按围栏原文精确对应（`|` 单线 / `||` 双纵线 / `|]` 终止线）
				shapeJianpuBarlines(host, barRows);
				// ②b 信息行：去掉「作曲: 」前缀（只留名字）
				stripJianpuInfoLabels(host);
				// ②c 信息区：字号 14 → 16（𝅘𝅥 18 → 20.5），并解掉 𝅘𝅥 上写死的 y
				normalizeJianpuInfo(host);
				// ②c1 速度记号前的音符符号按「每拍时值」换成全/二分/四分…（库写死四分）
				useTempoBeatSymbol(host);
				// ②c2 速度里的数字（= 88）换成 Bravura 雕刻数字（与拍号同一套；⚠️ 要排在 ②e 量宽度之前）
				useBravuraTempoDigits(host);
				// ②d 调号的升降号改用 Bravura 字形（换码位 + 单独套 tspan）
				useBravuraKeySignature(host);
				// ②e 调号与速度排到同一行（放不下就保持两行），中间留空隙
				inlineJianpuKeyTempo(host);
				// ②f 作曲行抬到与调号/速度同一行（库只把它放在基线行上，会低 10；挤不下就留在下一行）
				alignJianpuComposerLine(host);
				// ③ 时值延长的 "-" 换成 en dash（与音符等宽）
				widenJianpuDashes(host);
				// ④ 小节线 / 终止线上下收窄一点
				shortenJianpuBarlines(host);
				// ④b 信息块在标题与谱面之间垂直居中（库按三行留白，并成一行后上小下大）
				//    ⚠️ 必须排在小节线收窄**之后**：下界用的是小节线顶，拿收窄前的 y1 会少算 6px（居中偏上 3px）
				centerJianpuInfoVertically(host);
				// ⑤ 反复记号的两个点收拢
				tightenJianpuRepeatDots(host);
				// ⑩ 反复「小房子」：整体右下移一点
				shiftJianpuVolta(host);
				// ⑩b 行首那种换调（`K: X` 单独一行）—— 只记下来，标记统一在几何定稿后画（见 ⑪i2）
				// ⑪ 每行首末墨迹贴齐左右边界（坐标重写式 justify，几何都定下来之后再动）
				justifyJianpuLines(host);
				// ⑪b 音符自带的固定像素装饰（附点、八度点）：按主数字的最终位置重摆
				//     （必须在 justify 之后：justify 会把这些偏移乘上整行拉伸系数）
				settleJianpuDots(host);
				// ⑪c 减时线：同层首尾相接的线段并成一条，长度按音符墨迹固定（justify 会按拉伸系数把它乘长）
				refineJianpuUnderlines(host, glueLines);
				// ⑪d 连音组：库画的方括号换成「一条圆滑线 + 上面一个小数字」
				//    ⚠️ 必须排在 ⑪e 之前：库那两个圆角 path 的 d 是「单弧」形状，会被改弧那步当成连音线
				//    ⚠️ 必须排在 ⑪ justify **之后**：弧的 rx 在 justify 里只跟着端点跑、**不跟着缩放**，
				//       而 SVG 渲染器发现 rx < 半弦长时会把整个椭圆**等比放大**补齐 ⇒ 行被拉伸 2.3 倍时
				//       弓高被放大成 16.8px（弧又粗又盖住数字）。放在后面就是按**最终跨度**造弧。
				styleJianpuTriplets(host, tuplets);
				// ⑪e 连音线弧度：库算出来的太平（跨度×0.08），按最终跨度重画成纺锤形
				curveJianpuTieLines(host);
				// ⑪f 同一行内把各小节线的留白统一（内容当刚性块整体平移，块间空白均分）
				evenJianpuBarGaps(host);
				// ⑪f1 连音组的数字贴到它那条弧的上方（弧可能刚被避让高音点的逻辑抬过）
				//    ⚠️ 必须排在 ⑪f **之后**：⑪f 按「块内平移、块间线性插值」映射 tieline 层，
				//       而标签的 x 常常落在两块之间的留白里（被插值挪走），弧的两个端点却都在块内（原地不动）
				//       —— 数字就相对它那条弧偏掉了（实测第二行偏 1.2px，用户：「三连音的 3 怎么偏移了」）。
				placeJianpuTripletLabels(host);
				// ⑪g 小节线挪到相邻音符墨迹的中点（库画在槽边界上，前后留白来自两个不同小节 ⇒ 必然不等）
				centerJianpuBarlines(host);
				// ⑪i 小房子：跨度到行尾（或本行的 `:|`）并按需封口 —— 小节线定稿之后才能算
				fitJianpuVoltas(host);
				// ⑪i2 谱内转调的标记：画在**换调那一行的开头**上方（行间，不占行内空间）
				//     ⚠️ 必须排在所有会改横向几何的步骤之后 —— 它是按音符的最终位置摆的
				addJianpuModulations(host, mods);
				// ⑦ 倚音：按真实墨迹重新定位（本体 + 下划线一起，排在标记弧对齐之前）
				//    ⚠️ 必须排在**所有横向位移之后**：⑦ 里摆的是 JIANPU_GRACE_GAP/STEP 这种固定像素的净空，
				//    放在 ⑪ justify 之前会被整行的拉伸系数乘一遍（同一份谱 s 到 2.5 ⇒ 间隙 4px 变 10px，
				//    两个倚音时靠左那个直接跑到谱外 —— 用户：「又被 bug 了，CD 组的倚音被甩到外边去了」）。
				placeJianpuGraceNotes(host);
				// ⑦b 倚音标记弧跟着倚音的下划线往下走（有下划线时会撞在一起）
				fixJianpuGraceNotes(host);
				// ⑦c 倚音引导线：改成两端细中间粗的叶片形（和连音线同一套画法）
				taperJianpuGraceArcs(host);
				// ⑪h 还原号：`=` 交给库时是按 `#` 发的，这一步换成真正的还原字形（得排在 ⑧ 量墨迹之前）
				applyJianpuNaturals(host, naturals);
				// ⑧ 变音记号：按真实墨迹摆到数字左上角（库给的偏小、且贴着音符数字）
				//    ⚠️ 必须排在**所有横向位移之后**：⑪ justify 会给整行乘一个拉伸系数，记号与数字的间隙也跟着被乘
				//       —— 实测同一份谱（行不满时 s 到 2.5）间隙从 −1px 变成 15.6px，窄屏下记号离自己的音符很远
				//       （用户：「符号按理说该跟着音符走吧，怎么宽度一窄了变音记号感觉没变化」）。
				//    又要排在 ⑫ centerJianpuScore 之前：它移动的是最左墨迹，居中得用挪完的位置算。
				adjustJianpuAccidentals(host);
				// ⑦d 倚音上的变音记号：库不画，用同一套墨迹常量自己补（必须排在 ⑧ 之后）
				drawJianpuGraceAccidentals(host, graceAccs);
				// ⑫ 删掉谱首小节线后左侧留白变大 → 按实际墨迹重新居中
				centerJianpuScore(host);
				// ⑬ 谱首留白：标题空着就不给它留位置（信息跟上来），信息也没有就直接跟谱
				//    ⚠️ 必须排在各步之后：它是按「最终几何」整体上移 + 收 viewBox 高度的
				compactJianpuHead(host);
				// ⚠️ Bravura 的 @font-face 是**库在渲染时才注入**的、且字体是异步加载的：
				//    字体就绪之前，canvas 量到的是兜底字体的字形宽度 → 变音记号会按错误宽度定位
				//    （实测间隙 1.4 / 2.9 / 6.0 / 10.0px 忽大忽小）。所以字体就绪后再整体重排一次。
				// ⚠️⚠️ **不能只靠 `fonts.load().then()`**：实测它有时会在字形真正可用**之前**就 resolve
				//    （那一刻 `document.fonts.status` 还是 loading）→ 重排照样用兜底度量，等于白排（实测拍号/速度数字
				//    被排成 13.7px 的荒唐字号，且因为已换成私用区码位，后面再也不会重错了）。
				//    所以改成「**`check()` 为真才重排**」，必要时逐帧重试（最多 ~40 帧，≈0.7s）。
				// ⚠️ 触发条件要盖两种情况：① 页面里已有 Bravura 元素（变音记号/休止符）；
				//    ② **我们本来就想用 Bravura 数字但当时没就绪**（拍号/速度数字先退回了正文数字，那一刻
				//    DOM 里没有任何 Bravura 元素 —— 只看 ① 就永远不会重排）。
				if (!host.dataset.jianpuFontRetry && (host.querySelector('svg [font-family*="Bravura"]') || host.querySelector('svg [data-jianpu-digits]'))) {
					host.dataset.jianpuFontRetry = '1';
					whenBravuraReady(() => {
						if (host.isConnected) renderJianpuScore(host, SimpleNotation);
					});
				}
				// ⚠️ 上面那次等的是 **Bravura**；但**音符数字本身用的是站点的衬线 web font**，它也是异步加载的 ⇒
				//    ⑦（倚音）/⑧（变音记号）量墨迹会拿到兜底字形的宽度（实测差 ~8px：记号歪向左边、倚音被摆到
				//    主数字身上、引导线也压住数字 —— 用户：「D 的倚音线和音符 6 重叠了」）。所以「页面用到的字体全部
				//    就绪」后再整体重排一次（dataset 标记保证只排这一轮，不会来回循环）。
				if (!host.dataset.jianpuFontRetryAll) {
					host.dataset.jianpuFontRetryAll = '1';
					whenScoreBravuraReady(() => {
						Promise.resolve(document.fonts?.ready).then(() => {
							if (host.isConnected) renderJianpuScore(host, SimpleNotation);
						});
					});
				}
				return true;
			} catch (err) {
				console.error('simple-notation render failed:', err);
				return false;
			} finally {
				scratch.remove();
			}
		}

		async function initJianpuScores() {
			const hosts = Array.from(document.querySelectorAll<HTMLElement>('.jianpu-score'));
			if (!hosts.length) return;
			const mod: any = await import('simple-notation');
			const SimpleNotation = mod.SimpleNotation || mod.default?.SimpleNotation;
			if (!SimpleNotation) {
				console.error('simple-notation: SimpleNotation 导出未找到', Object.keys(mod));
				return;
			}
			for (const host of hosts) {
				const codeEl = host.querySelector('.jianpu-source code');
				if (!codeEl) continue;
				// 记住源码：宽度变化时要按新的分句重新渲染
				host.dataset.jianpu = (codeEl.textContent || '').replace(/\r\n?/g, '\n');
			}
			// ⚠️ 切换组件里被隐藏的那块不渲染（display:none → clientWidth = 0，会按 736 的兑底宽度分句）
			//    它由切换器在「被显示」时通过 window.__scoreRender.jianpu 调起渲染
			hosts.forEach((host) => {
				if (host.offsetParent) renderJianpuScore(host, SimpleNotation);
			});
			(window as any).__scoreRender = Object.assign((window as any).__scoreRender || {}, {
				jianpu: (host: HTMLElement) => renderJianpuScore(host, SimpleNotation),
			});

			// ② 去重内嵌字体样式：库在每个 SVG 里都内嵌一份 ~400KB 的 @font-face（Bravura base64），
			// 同页多个谱（以及每次重排）都会重复 → 全局只保留一份，放进 <head>。
			function dedupeJianpuFontStyles() {
				Array.from(document.querySelectorAll('.jianpu-score svg style')).forEach((style) => {
					if (document.querySelector('head style[data-jianpu-font]')) {
						style.remove();
					} else {
						style.setAttribute('data-jianpu-font', '');
						document.head.appendChild(style);
					}
				});
			}
			dedupeJianpuFontStyles();

			// 宽度变化 → 每行小节数 / 原生像素宽可能变 → 重排（两者都没实质变化就不重渲染）
			// 注意：这里**同步执行**（不用定时器）——后台标签页会把定时器、ResizeObserver 回调节流推迟几分钟。
			const syncJianpuLayout = () => {
				hosts.forEach((host) => {
					if (!host.offsetParent) return; // 被切换器藏起来的那块：不在这里重排（显示时由切换器调起）
					// 排版宽度与 `renderJianpuScore` 同一口径：≥600 跟容器走，<600 恒为 600（⇒ 窄屏自动不重排）
					const width = Math.max(Math.round(host.clientWidth || 736), JIANPU_MIN_LAYOUT_WIDTH);
					// dataset 可能不存在该属性（类型为 string | undefined）；Number() 接受任意输入
					// （undefined → NaN），再 || 0 兜底，语义与原先的 +host.dataset.jianpuWidth || 0 一致。
					const prevWidth = Number(host.dataset.jianpuWidth) || 0;
					const perLineChanged = String(measuresPerLine(host)) !== (host.dataset.jianpuBasePerLine || host.dataset.jianpuPerLine);
					// 宽度抖动 24px 以内不重排（谱面只是轻微等比缩放，肉眼看不出来）
					if (perLineChanged || (prevWidth > 0 && Math.abs(prevWidth - width) >= 24)) renderJianpuScore(host, SimpleNotation);
				});
				dedupeJianpuFontStyles();
			};
			// ① ResizeObserver 盯容器宽度（内容区宽度变化也能感知）
			if ('ResizeObserver' in window) {
				const ro = new ResizeObserver(() => syncJianpuLayout());
				hosts.forEach((host) => ro.observe(host));
			}
			// ② 窗口尺寸变化兜底；③ 从后台切回前台时立刻校一次
			window.addEventListener('resize', () => syncJianpuLayout());
			document.addEventListener('visibilitychange', () => {
				if (!document.hidden) syncJianpuLayout();
			});
		}
		initJianpuScores();
	</script>
	<script>
		// 中西之间的那点空隙：文章按约定不手打空格，全交给内核让（CSS 的 text-autospace，1/8em）。
		// ⚠️ 光问 CSS.supports 不够：Safari 18.4+ 声称支持 text-autospace，可正文里跨 <a> 的那处
		//   （「你但凡知道[B站网址]呢」）它照样贴着 ⇒ 改成量：切到 no-autospace 再量一遍，
		//   距离没变就是内核在这儿不补，那就自己插一个空元素（宽度对齐 1/8em）。
		// ⚠️ 为什么用元素而不是改文字：不改文本内容 ⇒ 复制、RSS、搜索索引读到的还是原文，只是多了一层空元素。
		// ⚠️ 必须排在下面那段行尾标点脚本**之前**：插空隙会改变每个字的横向位置，行尾得在它之后重新量。
		// ⚠️ 编辑器里的 contenteditable 也带 .typography-body，但那个 DOM 归 ProseMirror 管 ⇒ 见到 .editor-prose 就退。
		const bodyForGap = document.querySelector('.typography-body');
		// 量一次内核在这处交界上会不会自己让空：同一个文本节点里的、跟跨行内元素的，各量一次。
		const nativeGapAt = (crossElement: boolean): boolean => {
			if (!bodyForGap) return false;
			const probe = document.createElement('span');
			probe.setAttribute('aria-hidden', 'true');
			const bodyStyle = getComputedStyle(bodyForGap);
			probe.style.cssText = 'position:absolute;left:-9999px;top:0;white-space:pre;';
			probe.style.fontFamily = bodyStyle.fontFamily;
			probe.style.fontSize = bodyStyle.fontSize;
			probe.style.fontWeight = bodyStyle.fontWeight;
			probe.style.fontStyle = bodyStyle.fontStyle;
			probe.style.setProperty('text-autospace', 'normal'); // 基准：这个内核在 normal 下该不该让空
			if (crossElement) {
				probe.appendChild(document.createTextNode('道'));
				const inner = document.createElement('span');
				inner.textContent = 'B';
				probe.appendChild(inner);
			} else {
				probe.textContent = '道B';
			}
			document.body.appendChild(probe);
			// ⚠️ 量整串宽度，别量两个字矩形之间的距离：内核把那点空隙算进前一个字的宽度里了（量出来永远是 0）。
			const withAutospace = probe.getBoundingClientRect().width;
			probe.style.setProperty('text-autospace', 'no-autospace');
			const withoutAutospace = probe.getBoundingClientRect().width;
			probe.remove();
			return withAutospace - withoutAutospace > 0.5;
		};
		const nativeGapInSameNode = nativeGapAt(false);
		const nativeGapAcrossElements = nativeGapAt(true);
		if (bodyForGap && !document.querySelector('.editor-prose') && !(nativeGapInSameNode && nativeGapAcrossElements)) {
			const GAP_CLASS = 'cjk-latin-gap';
			// 代码段、代码块不动（跟行尾标点那套一样），<br> 和块级元素都算「边界」（跨过去就不该补）
			const SKIP = new Set(['PRE', 'CODE', 'KBD', 'SAMP', 'SCRIPT', 'STYLE', 'SVG', 'TEXTAREA', 'BR']);
			const BLOCK = new Set([
				'P', 'LI', 'H1', 'H2', 'H3', 'H4', 'H5', 'H6', 'BLOCKQUOTE', 'FIGCAPTION', 'DIV', 'SECTION',
				'ARTICLE', 'ASIDE', 'HEADER', 'FOOTER', 'TD', 'TH', 'DT', 'DD', 'DETAILS', 'SUMMARY', 'UL', 'OL', 'TABLE',
			]);
			// ⚠️ 只算表意文字和字母数字：中文标点不参与（Chromium 的 text-autospace 也是这么定的）
			const CJK = /[\u3400-\u4dbf\u4e00-\u9fff\uf900-\ufaff]/;
			const LATIN = /[A-Za-z0-9]/;

			type GapChar = { node: Text; i: number; ch: string };
			type GapRun = { chars: GapChar[] };

			bodyForGap.querySelectorAll('.' + GAP_CLASS).forEach((el) => el.remove()); // 幂等：先拆掉上一轮插的
			const runs: GapRun[] = [];
			let current: GapRun | null = null;
			const walk = (node: Element) => {
				for (const child of node.childNodes) {
					if (child.nodeType === 3) {
						const text = child.nodeValue;
						if (!text) continue;
						if (!current) {
							current = { chars: [] };
							runs.push(current);
						}
						for (let i = 0; i < text.length; i++) current.chars.push({ node: child as Text, i, ch: text[i] });
						continue;
					}
					if (!(child instanceof Element)) continue;
					if (child.classList.contains('date-text')) {
						// 日期自己把中西空隙画成定值了（见 main.css 的 .date-cjk）⇒ 这儿别再叠一层
						current = null;
						continue;
					}
					if (SKIP.has(child.tagName)) {
						// 代码段那类：既断开 run，里面的字也压根不看
						current = null;
						continue;
					}
					if (BLOCK.has(child.tagName)) {
						// 块级：断开 run，但里面的内容照样走（各自算各自的 run）
						current = null;
						walk(child);
						continue;
					}
					walk(child);
				}
			};
			walk(bodyForGap);

			// 从后往前处理：插元素会切文本节点，倒着走才不会把前面的下标弄错
			for (const run of runs) {
				for (let k = run.chars.length - 1; k >= 1; k--) {
					const prev = run.chars[k - 1];
					const next = run.chars[k];
					const pair = (CJK.test(prev.ch) && LATIN.test(next.ch)) || (LATIN.test(prev.ch) && CJK.test(next.ch));
					if (!pair) continue;
					// 内核在这处自己就让空 ⇒ 不用我们插（跨元素的和同节点的分开判）
					const native = prev.node === next.node ? nativeGapInSameNode : nativeGapAcrossElements;
					if (native) continue;
					const gap = document.createElement('span');
					gap.className = GAP_CLASS;
					const tail = next.i > 0 ? next.node.splitText(next.i) : next.node;
					if (tail.parentNode) tail.parentNode.insertBefore(gap, tail);
				}
			}
		}
	</script>
	<script>
		// 行末句末号压半宽（开明式的补充）：句末号落在行尾时，全角那半格空白会把版心右缘顶出一个凹陷。
		// 为什么只能运行时做：CSS 选择器看不见行盒，「这个字是不是本行最后一个」只有布局完才知道。
		// 为什么压了还能两端对齐：省下的半格由 justify 摊进本行字间（实测每字间约 0.15px，看不出），
		//   于是行照样齐、标点墨迹落到右缘。
		// 为什么不把补偿加在标点后面：那半格必须出现在墨迹**前面**才有效，加在后面等于把凹陷原样推回来。
		// 谁会挡着「下一行的字被吸上来」：只有窄过半格的下一项（半角字母、数字之类）会钻进那半格，
		//   所以把下一行开头那几项粘成一整块（合计宽度超过半格就塞不进了）。中文项是整格，本来就不用粘。
		// ⚠️ 编辑器里的 contenteditable 也带 .typography-body，但那个 DOM 归 ProseMirror 管，
		//    碰不得（包 span / 加类会被它当成外部篡改）⇒ 见到 .editor-prose 直接退出。
		import { SENTENCE_END } from '../lib/punct-width.mjs';

		const END_CLASS = 'punct-line-end';
		const HEAD_CLASS = 'punct-line-head';

		const body = document.querySelector('.typography-body');
		if (body && !document.querySelector('.editor-prose')) {
			const reset = () => {
				body.querySelectorAll('.' + HEAD_CLASS).forEach((span) => span.replaceWith(...span.childNodes));
				body.querySelectorAll('.' + END_CLASS).forEach((span) => span.classList.remove(END_CLASS));
			};

			// 逐字收集：每个字符拿到自己的盒子和所属文本节点，顺便按行分好组
			const collectLines = (block: Element, fontSize: number) => {
				const lines = [];
				const walker = document.createTreeWalker(block, NodeFilter.SHOW_TEXT);
				let node;
				while ((node = walker.nextNode())) {
					const text = node.nodeValue;
					if (!text) continue;
					for (let i = 0; i < text.length; i++) {
						const ch = text[i];
						if (ch === ' ' || ch === '\t' || ch === '\n') continue;
						const range = document.createRange();
						range.setStart(node, i);
						range.setEnd(node, i + 1);
						const rect = range.getBoundingClientRect();
						if (!rect.width && !rect.height) continue; // 藏起来的内容（比如窄屏目录的副本）
						const line = lines[lines.length - 1];
						if (line && Math.abs(rect.top - line.top) <= fontSize * 0.5) line.items.push({ node, i, ch, width: rect.width });
						else lines.push({ top: rect.top, items: [{ node, i, ch, width: rect.width }] });
					}
				}
				return lines;
			};

			const run = () => {
				reset();
				const fontSize = parseFloat(getComputedStyle(body).fontSize) || 16;
				const half = fontSize / 2;
				// ⚠️ 判「下一项塞不塞得进那半格」的界限要比半格**宽一点**：text-autospace 会在中西交界处
				//    插 1/8em，那截空隙会算进「下一行第一个字」的盒子里（实测数字 `1` 的推进才 6.4px，
				//    量出来却是 8.4px）⇒ 照半格判会漏粘；更要紧的是行里本来就留着 justify 摊开的零点几格空，所以判据得宽到「粘住的那一截绝不可能塞得进去」。
				const glueLimit = fontSize * 2;
				body.querySelectorAll('p, li, figcaption').forEach((block) => {
					if (!/[\u3002\uff01\uff1f]/.test(block.textContent)) return;
					const lines = collectLines(block, fontSize);
					lines.forEach((line, index) => {
						const next = lines[index + 1];
						if (!next) return; // 段末行本来就右不齐，不用管
						const last = line.items[line.items.length - 1];
						if (!SENTENCE_END.has(last.ch)) return;
						const span = last.node.parentElement;
						if (!span || !span.classList.contains('punct-full')) return; // 已经是半宽的（后面跟了闭标号那种）不用管
						// 下一行第一项就窄过半格的话，得先把它跟后面几项粘成一整块，否则它会被吸上来
						const first = next.items[0];
						if (first.width <= glueLimit) {
							let acc = 0;
							let count = 0;
							while (count < next.items.length && acc <= glueLimit) acc += next.items[count++].width;
							const tail = next.items[count - 1];
							const range = document.createRange();
							range.setStart(first.node, first.i);
							range.setEnd(tail.node, tail.i + 1);
							const glue = document.createElement('span');
							glue.className = HEAD_CLASS;
							try {
								range.surroundContents(glue);
							} catch {
								return; // 跨了加粗/链接之类的元素边界，包不住 ⇒ 保守起见这一处不压
							}
						}
						span.classList.add(END_CLASS);
					});
				});
			};

			let lastWidth = Math.round(body.getBoundingClientRect().width);
			// ⚠️ 不用定时器去抖：后台标签页会把定时器和 ResizeObserver 回调推迟好几分钟，
			//    拖完窗口回来还看不到效果。改成同步跑 + 宽度没变就跳过（和简谱那边同一个理由）。
			const maybeRun = () => {
				const width = Math.round(body.getBoundingClientRect().width);
				if (width === lastWidth) return;
				lastWidth = width;
				run();
			};
			run();
			// 字体换了行尾就换了，强制再跑一次（先把记录的宽度清掉，免得被上面的判断跳过）
			if (document.fonts && document.fonts.ready) document.fonts.ready.then(() => { lastWidth = 0; run(); });
			if ('ResizeObserver' in window) new ResizeObserver(maybeRun).observe(body);
			window.addEventListener('resize', maybeRun);
		}
	</script>
	</body>
</html>
