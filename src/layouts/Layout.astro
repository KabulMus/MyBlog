---
import '../styles/main.css'
import LikeButton from '../components/LikeButton.astro';
import { tagNamesZh, tagNamesEn, tagCats, groupTagsByCat } from '../config/tags';
import { getCategoryName, toCatArray } from '../config/categories';

interface Props {
	title?: string;
	description?: string;
	frontmatter?: any; 
	brandUrl?: string;
	brandText?: string;
}

const { frontmatter, title, description, brandUrl, brandText } = Astro.props;
const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isEnglishRoute = currentPath.includes('/en-US');
const htmlLang = isEnglishRoute ? 'en-US' : 'zh-CN';
const resolvedBrandUrl = brandUrl || (isEnglishRoute ? '/en-US' : '/');
const langSwitchHref = getLangSwitchHref(currentPath);
const langSwitchLabel = isEnglishRoute ? '切换到中文' : 'Switch to English';
const navLabels = isEnglishRoute
    ? { blog: 'Blog', channels: 'Channels', toolkit: 'Toolkit', support: 'Support', charlie: 'About Charlie' }
    : { blog: '博客', channels: '频道列表', toolkit: '工具箱', support: '联系支持', charlie: '关于周深' };
const menuAriaLabel = isEnglishRoute ? 'Menu' : '菜单';
const themeAriaLabel = isEnglishRoute ? 'Toggle theme' : '切换亮暗模式';
function smartQuotes(text: string): string {
    return text
        .replace( /"([^"]*)"/g, '\u201C$1\u201D')
        .replace(/'([^']*)'/g, '\u2018$1\u2019')
        .replace(/'/g, '\u2019');
}

function renderTitle(text: string): string {
    const quoted = smartQuotes(text);
    // 仅将 emoji 单独包 span 以重置颜色，不分割渐变
    const emojiRanges = /[\u{1F300}-\u{1FAFF}\u{2600}-\u{27BF}\u{FE00}-\u{FE0F}\u{1F600}-\u{1F64F}\u{1F680}-\u{1F6FF}\u{1F900}-\u{1F9FF}]/gu;
    return quoted.replace(emojiRanges, '<span class="emoji">$&</span>');
}
const pageTitle = frontmatter?.title || title || (isEnglishRoute ? 'My Blog' : '我的博客');
const renderedTitle = renderTitle(pageTitle);
const ogDescription = description || (isEnglishRoute
    ? "Ethan's blog — music, creation, essays & achievements."
    : 'Ethan 的博客 — 音乐、创作、随笔与成就。');
const ogImage = 'https://blog.ethan929.com/favicon.webp';
const pageDate = formatDate(frontmatter?.date || "");

// 计算文章序号（时间正序）
let postIndex = 0;
let idx = -1;
let sorted: any[] = [];
if (frontmatter?.date && currentPath.startsWith('/blog')) {
    const cnPosts = Object.values(import.meta.glob('../pages/blog/*.md', { eager: true })) as any[];
    const enPosts = Object.values(import.meta.glob('../pages/blog/en-US/*.md', { eager: true })) as any[];
    const allMd = isEnglishRoute ? enPosts : cnPosts;
    sorted = allMd
        .filter((p: any) => !p.frontmatter?.draft)
        .sort((a: any, b: any) => new Date(a.frontmatter?.date || 0).getTime() - new Date(b.frontmatter?.date || 0).getTime());
    idx = sorted.findIndex((p: any) => p.frontmatter?.title === frontmatter?.title);
    if (idx !== -1) postIndex = idx + 1;
}

let prevPost: { title: string; url: string } | null = null;
let nextPost: { title: string; url: string } | null = null;
if (idx !== -1) {
    const base = isEnglishRoute ? '/blog/en-US' : '/blog';
    if (idx > 0) {
        const p = sorted[idx - 1];
        prevPost = { title: p.frontmatter?.title || '', url: p.url || '' };
    }
    if (idx < sorted.length - 1) {
        const p = sorted[idx + 1];
        nextPost = { title: p.frontmatter?.title || '', url: p.url || '' };
    }
}

const prevIndex = prevPost ? postIndex - 1 : 0;
const nextIndex = nextPost ? postIndex + 1 : 0;

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    // 英文：Aug 2, 2020；中文：2020.8.2（月日不补零）
    // 英文月份按规范：May/June/July 不缩写，其余缩写
    const [y, m, d] = dateStr.split('-').map(Number);
    if (!y || !m || !d) return dateStr.replace(/-/g, '.');
    if (isEnglishRoute) {
        const months = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'June', 'July', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        return `${months[m - 1]} ${d}, ${y}`;
    }
    return `${y}.${m}.${d}`;
}

// 文章点赞：从路径取 slug（如 /blog/2026-07-01-hi → 2026-07-01-hi）
const articleSlug = currentPath.startsWith('/blog') ? (currentPath.split('/').pop() || '') : '';

const tagNames: Record<string, string> = isEnglishRoute ? tagNamesEn : tagNamesZh;

function getLangSwitchHref(pathname: string) {
    const normalized = pathname.replace(/\/+$/, "") || "/";

    if (normalized === "/") return "/en-US";
    if (normalized === "/en-US") return "/";
    if (normalized === "/blog") return "/blog/en-US";
    if (normalized === "/blog/en-US") return "/blog";

    if (normalized.includes('/en-US')) {
        return normalized.replace('/en-US', '');
    }

    if (normalized.startsWith('/blog/')) {
        const [, , ...rest] = normalized.split('/');
        return `/blog/en-US/${rest.join('/')}`;
    }

    return normalized;
}

---
<!doctype html>
<html lang={htmlLang}> 
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.webp" type="image/webp"/>
		<link 
			rel="stylesheet" 
			href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" 
			crossorigin="anonymous"
		/>
		<!-- Google Fonts（替代原 CSS @import：link 并行加载 + preconnect 提前握手） -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Encode+Sans+SC:wght@100..900&family=Encode+Sans:wght@100..900&family=Google+Sans+Flex:opsz,wght@6..144,1..1000&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Noto+Sans+SC:wght@100..900&family=Noto+Serif+SC:wght@200..900&family=Playfair+Display+SC:ital,wght@0,400;0,700;0,900;1,400;1,700;1,900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" />
		<meta name="generator" content={Astro.generator} />
		<title>{frontmatter?.title || title || (isEnglishRoute ? 'My Blog' : '我的博客')}</title>

		<!-- Open Graph / 社交分享卡片 -->
		<meta property="og:site_name" content={isEnglishRoute ? "Ethan's Blog" : 'Ethan 的博客'} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:type" content={frontmatter?.date ? 'article' : 'website'} />
		<meta property="og:url" content={Astro.url.href} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:description" content={ogDescription} />
		<meta property="og:locale" content={isEnglishRoute ? 'en_US' : 'zh_CN'} />
		<meta property="og:locale:alternate" content={isEnglishRoute ? 'zh_CN' : 'en_US'} />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={ogDescription} />
		<meta name="twitter:image" content={ogImage} />

		<script src="/js/core.js" is:inline></script>
	</head>
	<body class={currentPath.startsWith('/blog') ? 'is-article-page' : ''} data-pagefind-ignore={frontmatter?.draft ? '' : undefined}>
		<nav class="navbar" id="top-nav">
			<div class="nav-container">
				<a href={resolvedBrandUrl} class="nav-brand">
                    {
                        /* ⚡️ 如果传了 brandText，就用 Fragment 渲染传进来的复杂 HTML，
                           否则显示其他 markdown 文章页默认的返回箭头 */
                        brandText ? (
                            <Fragment set:html={brandText} />
                        ) : (
                            <svg width="24" height="24" viewBox="0 0 48 48" fill="none"><path d="M31 36L19 24L31 12"/></svg>

                        )
                    }
                </a>
				
				<div class="nav-links desktop-only">
					<a href={isEnglishRoute ? '/en-US/rss.xml' : '/rss.xml'} class="rss-nav-link rss-link" data-copy={isEnglishRoute ? 'https://blog.ethan929.com/en-US/rss.xml' : 'https://blog.ethan929.com/rss.xml'} data-text="RSS">RSS</a>
					<span class="nav-divider" aria-hidden="true"></span>
					<a href={isEnglishRoute ? '/en-US' : '/'} data-text={navLabels.blog} class="active">{navLabels.blog}</a>
					<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/channels/' : 'https://www.ethan929.com/channels/'} data-text={navLabels.channels}>{navLabels.channels}</a>
					<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/toolkit/' : 'https://www.ethan929.com/toolkit/'} data-text={navLabels.toolkit}>{navLabels.toolkit}</a>
					<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/support/' : 'https://www.ethan929.com/support/'} data-text={navLabels.support}>{navLabels.support}</a>
					<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/charlie/' : 'https://www.ethan929.com/charlie/'} data-text={navLabels.charlie}>{navLabels.charlie}</a>
				</div>

				<a href={isEnglishRoute ? '/en-US/rss.xml' : '/rss.xml'} class="rss-link mobile-rss mobile-only" data-copy={isEnglishRoute ? 'https://blog.ethan929.com/en-US/rss.xml' : 'https://blog.ethan929.com/rss.xml'} data-text="RSS">RSS</a>
				<span class="mobile-rss-divider mobile-only" aria-hidden="true"></span>
				<button class="menu-toggle mobile-only" onclick="toggleMenu()" aria-label={menuAriaLabel}>
					<svg width="24" height="24" viewBox="0 0 48 48" fill="none"><path d="M7.94971 11.9497H39.9497"/><path d="M7.94971 23.9497H39.9497"/><path d="M7.94971 35.9497H39.9497"/></svg>
				</button>
			</div>

			<div class="nav-dropdown" id="nav-dropdown">
				<a href={isEnglishRoute ? '/en-US' : '/'} onclick="toggleMenu(false)" data-text={navLabels.blog} class="active">{navLabels.blog}</a>
				<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/channels/' : 'https://www.ethan929.com/channels/'} onclick="toggleMenu(false)" data-text={navLabels.channels}>{navLabels.channels}</a>
				<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/toolkit/' : 'https://www.ethan929.com/toolkit/'} onclick="toggleMenu(false)" data-text={navLabels.toolkit}>{navLabels.toolkit}</a>
				<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/support/' : 'https://www.ethan929.com/support/'} onclick="toggleMenu(false)" data-text={navLabels.support}>{navLabels.support}</a>
				<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/charlie/' : 'https://www.ethan929.com/charlie/'} onclick="toggleMenu(false)" data-text={navLabels.charlie}>{navLabels.charlie}</a>
			</div>
		</nav>

		<header class="page-hero">
			<section class="hero-content">
				<div>
					<h1 set:html={renderedTitle}></h1> 
					{pageDate && (
						<span class="date">
							{frontmatter?.draft ? (
								<span class="page-index is-draft">{isEnglishRoute ? 'Draft' : '草稿'}</span>
							) : (
								postIndex > 0 && <span class="page-index">#{postIndex}</span>
							)}
							<svg class="date-icon" viewBox="0 0 48 48" aria-hidden="true">
								<path d="M5 19H43V40C43 41.1046 42.1046 42 41 42H7C5.89543 42 5 41.1046 5 40V19Z"/>
								<path d="M5 9C5 7.89543 5.89543 7 7 7H41C42.1046 7 43 7.89543 43 9V19H5V9Z"/>
								<path d="M16 4V12"/>
								<path d="M32 4V12"/>
								<path d="M28 34H34"/>
								<path d="M14 34H20"/>
								<path d="M28 26H34"/>
								<path d="M14 26H20"/>
							</svg> {pageDate}
						</span>
					)}
					{(() => {
						const grouped = groupTagsByCat(toCatArray(frontmatter?.category), frontmatter?.tags || [], tagCats);
						if (grouped.length === 0) return null;
						return (
							<div class="article-tags" data-pagefind-ignore>
								{grouped.map((group, gi: number) => (
									<Fragment key={'cat-' + group.cat}>
										{gi > 0 && <span class="tag-group-sep" aria-hidden="true"><svg viewBox="0 0 12 24"><rect x="5.25" y="2" width="1.5" height="20" rx=".75" ry=".75"/></svg></span>}
										<span class={`tag cat-tag cat-${group.cat}`}>{getCategoryName(group.cat, isEnglishRoute ? 'en' : 'zh')}</span>
										{group.tags.map((tag: string, ti: number) => (
											<Fragment key={tag}>
												{ti > 0 && <span class="tag-sep" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="6"/></svg></span>}
												<span class={`tag tag-${tag}`}>{tagNames[tag] || tag}</span>
											</Fragment>
										))}
									</Fragment>
								))}
							</div>
						);
					})()}
				</div>
			</section>
		</header>

		<main class="typography-body">
			{currentPath.startsWith('/blog') && (
				<nav class="toc" id="toc" aria-label={isEnglishRoute ? 'Table of contents' : '目录'} data-pagefind-ignore></nav>
			)}
			{currentPath.startsWith('/blog') && (
				<button class="toc-toggle-btn" id="toc-toggle" aria-label={isEnglishRoute ? 'Table of contents' : '目录'}>
					<svg viewBox="0 0 24 24"><path d="M4 6.5h16"/><path d="M4 12h16"/><path d="M4 17.5h16"/></svg>
				</button>
			)}
			{currentPath.startsWith('/blog') && (
				<div class="toc-popup" id="toc-popup" data-pagefind-ignore></div>
			)}
			<div class="post-body">
				<slot />
				{articleSlug && <LikeButton slug={articleSlug} lang={isEnglishRoute ? 'en' : 'zh'} />}
			</div>
		</main>

		{(prevPost || nextPost) && (
			<nav class="post-nav">
				{prevPost ? (
					<a href={prevPost.url} class="post-nav-link prev">
						<span class="post-nav-index">{prevIndex}</span>
						<span class="post-nav-label">
							<svg viewBox="0 0 48 48" aria-hidden="true" class="post-nav-arrow"><path d="M31 36L19 24L31 12"/></svg>
							{isEnglishRoute ? 'Previous' : '上一篇'}
						</span>
						<span class="post-nav-title">{smartQuotes(prevPost.title)}</span>
					</a>
				) : (
					<div class="post-nav-link prev is-disabled">
						<span class="post-nav-label">
							<svg viewBox="0 0 48 48" aria-hidden="true" class="post-nav-arrow"><path d="M31 36L19 24L31 12"/></svg>
							{isEnglishRoute ? 'Previous' : '上一篇'}
						</span>
						<span class="post-nav-title">{isEnglishRoute ? 'This is the first post' : '此为第一篇'}</span>
					</div>
				)}
				{nextPost ? (
					<a href={nextPost.url} class="post-nav-link next">
						<span class="post-nav-index">{nextIndex}</span>
						<span class="post-nav-label">
							{isEnglishRoute ? 'Next' : '下一篇'}
							<svg viewBox="0 0 48 48" aria-hidden="true" class="post-nav-arrow"><path d="M19 12L31 24L19 36"/></svg>
						</span>
						<span class="post-nav-title">{smartQuotes(nextPost.title)}</span>
					</a>
				) : (
					<div class="post-nav-link next is-disabled">
						<span class="post-nav-label">
							{isEnglishRoute ? 'Next' : '下一篇'}
							<svg viewBox="0 0 48 48" aria-hidden="true" class="post-nav-arrow"><path d="M19 12L31 24L19 36"/></svg>
						</span>
						<span class="post-nav-title">{isEnglishRoute ? 'This is the last post' : '此为最后一篇'}</span>
					</div>
				)}
			</nav>
		)}

		<footer>
			<a href={isEnglishRoute ? 'https://www.ethan929.com/en-US/info' : 'https://www.ethan929.com/info'}>{isEnglishRoute ? 'Tech & Copyright' : '技术与版权'}</a>
			<p>©2026 Ethan Shaw</p>
			<p>Built with love for Charlie and you all</p>
		</footer>

		<!-- 全局 Toast 通知 -->
		<div id="global-toast" class="toast-notice" data-pagefind-ignore>
			<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
			<span></span>
		</div>

		<script is:inline>
			// 全局 Toast 通知函数（供全站复用）
			function showToast(message, isError) {
				var toast = document.getElementById('global-toast');
				if (!toast) return;
				var icon = toast.querySelector('svg');
				var text = toast.querySelector('span');
				text.innerText = message;
				if (isError) {
					toast.style.borderColor = '#ef4444';
					icon.innerHTML = '<path d="M18 6L6 18M6 6l12 12" style="stroke: #ef4444"/>';
				} else {
					toast.style.borderColor = 'var(--primary-blue)';
					icon.innerHTML = '<path d="M20 6L9 17l-5-5" style="stroke: var(--primary-blue)"/>';
				}
				toast.classList.add('show');
				setTimeout(function() { toast.classList.remove('show'); }, 3000);
			}

			// 点击 RSS 订阅：复制链接到剪贴板，弹出 Toast 提示（不跳转 XML 页面）
			(function() {
				function fallbackCopy(text, done) {
					var ta = document.createElement('textarea');
					ta.value = text;
					ta.style.position = 'fixed';
					ta.style.opacity = '0';
					document.body.appendChild(ta);
					ta.focus();
					ta.select();
					try { document.execCommand('copy'); done(); } catch (e) {}
					document.body.removeChild(ta);
				}
				function copyToClipboard(text, done) {
					if (navigator.clipboard && navigator.clipboard.writeText) {
						navigator.clipboard.writeText(text).then(done).catch(function() { fallbackCopy(text, done); });
					} else {
						fallbackCopy(text, done);
					}
				}
				var links = document.querySelectorAll('.rss-link');
				for (var i = 0; i < links.length; i++) {
					(function(link) {
						link.addEventListener('click', function(e) {
							e.preventDefault();
							var url = link.getAttribute('data-copy') || link.href;
							copyToClipboard(url, function() {
								showToast(document.documentElement.lang === 'en-US' ? 'RSS link copied' : 'RSS 地址已复制');
							});
						});
					})(links[i]);
				}
			})();
		</script>

		<a href={langSwitchHref} class="lang-toggle-btn" aria-label={langSwitchLabel}>
			<svg width="24" height="24" viewBox="0 0 48 48" fill="none">
				<path d="M24 44.0002C35.0457 44.0002 44 35.0459 44 24.0002C44 12.9545 35.0457 4.00024 24 4.00024C12.9543 4.00024 4 12.9545 4 24.0002C4 35.0459 12.9543 44.0002 24 44.0002Z" stroke="currentColor" stroke-width="4" />
				<path d="M6 30.9856C8.63192 32.041 10.5266 32.041 11.6839 30.9856C13.4199 29.4025 11.9219 24.5978 14.3532 23.2727C16.7844 21.9476 20.4886 27.8214 23.9508 25.8887C27.4129 23.9559 23.6246 18.8023 26.0272 16.713C28.4298 14.6237 31.554 16.98 32.1001 13.4865C32.6462 9.99304 29.5521 11.5082 28.9584 8.20693C28.5625 6.00611 28.5625 4.84884 28.9584 4.73511" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
				<path d="M29.0209 43.3505C27.1468 41.4325 26.4721 39.6497 26.9969 38.0019C27.7841 35.5303 29.0826 35.6764 29.6488 34.1482C30.2149 32.6199 28.6156 30.4433 32.1643 28.5826C34.5301 27.3421 37.783 28.7794 41.9228 32.8944" stroke="currentColor" stroke-width="4" stroke-linecap="round" />
			</svg>
		</a>

		<button class="theme-toggle-btn" onclick="toggleTheme()" aria-label={themeAriaLabel}>
			<svg viewBox="0 0 48 48">
				<path d="M9.15039 9.15088L11.3778 11.3783" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 24H6.15" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M9.15039 38.8495L11.3778 36.6221" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M38.8495 38.8495L36.6221 36.6221" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M44.9996 24H41.8496" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M38.8495 9.15088L36.6221 11.3783" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M24 3V6.15" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/><path d="M24 36C30.6274 36 36 30.6274 36 24C36 17.3726 30.6274 12 24 12C17.3726 12 12 17.3726 12 24C12 30.6274 17.3726 36 24 36Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round"/><path d="M24 45.0001V41.8501" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"/>
			</svg>
		</button>
	<script is:inline>
		(function() {
			var savedPage = sessionStorage.getItem('blogHomePage');
			if (savedPage && savedPage !== '1') {
				var brandLink = document.querySelector('.nav-brand');
				if (brandLink) {
					var href = brandLink.getAttribute('href') || '';
					if (href === '/' || href === '/en-US') {
						brandLink.setAttribute('href', href + '?page=' + savedPage);
					}
				}
			}

			// 可靠的 JS 两行省略号（post nav 卡片 + 目录条目共用：按词截断，加 …）
			function clampNavTitles() {
				document.querySelectorAll('.post-nav-title, .toc-text').forEach(function(el) {
					var lineHeight = parseFloat(window.getComputedStyle(el).lineHeight) || 22;
					var maxHeight = lineHeight * 2;
					var fullText = el.getAttribute('data-full-text');
					if (fullText === null) {
						fullText = el.textContent;
						el.setAttribute('data-full-text', fullText);
					}
					el.style.maxHeight = maxHeight + 'px';
					el.textContent = fullText;
					// 加 1px 容差，避免刚好两行时被误判为溢出
					if (el.scrollHeight <= el.clientHeight + 1) return;
					// 二分截断直到不超过两行
					var low = 0, high = fullText.length;
					while (low < high) {
						var mid = Math.ceil((low + high) / 2);
						el.textContent = fullText.slice(0, mid) + '…';
						if (el.scrollHeight <= el.clientHeight + 1) {
							low = mid;
						} else {
							high = mid - 1;
						}
					}
					// 词边界处理：只有当截断点正好落在英文单词内部（下一个字符是字母/数字）时，
					// 才回退到最近空格（单词边界），避免切断英文单词；
					// CJK 字符可逐字断行，无需回退（否则会因一个空格丢掉后面本可放下的中文字）
					var cut = low;
					var nextCh = fullText[low] || '';
					if (/[A-Za-z0-9]/.test(nextCh)) {
						var lastSpace = fullText.lastIndexOf(' ', cut);
						if (lastSpace > cut * 0.5) {
							cut = lastSpace;
						}
					}
					el.textContent = fullText.slice(0, cut).replace(/\s+$/, '') + '…';
				});
			}

			document.addEventListener('DOMContentLoaded', clampNavTitles);
			window.addEventListener('load', clampNavTitles);
			window.addEventListener('resize', clampNavTitles);
			// 字体加载完成后重算：避免首次测量因 CJK/西文字体未就绪而误判“未超两行”
			if (document.fonts && document.fonts.ready) {
				document.fonts.ready.then(clampNavTitles);
			}

			// 代码块复制按钮（与语言标签合成统一工具栏）
			function addCopyButtons() {
				document.querySelectorAll('.typography-body pre').forEach(function(pre) {
					if (pre.querySelector('.code-toolbar')) return;
					var lang = pre.getAttribute('data-language') || 'code';

					var toolbar = document.createElement('div');
					toolbar.className = 'code-toolbar';

					var langEl = document.createElement('span');
					langEl.className = 'code-lang';
					langEl.textContent = lang;

					var btn = document.createElement('button');
					btn.type = 'button';
					btn.className = 'code-copy-btn';
					btn.setAttribute('aria-label', '复制代码');
					var copyIcon = '<svg viewBox="0 0 24 24"><rect x="8.15" y="8.15" width="12.26" height="12.26" rx="3" ry="3"/><path d="M3.59,14.7V5.89c0-1.27,1.03-2.3,2.3-2.3h8.81"/></svg>';
					var checkIcon = '<svg viewBox="0 0 24 24"><polyline points="4.42 12.36 10.11 19.33 19.58 4.67" stroke="#58cc02"/></svg>';
					btn.innerHTML = copyIcon;
					btn.addEventListener('click', function() {
						var code = pre.querySelector('code');
						var text = code ? code.innerText : pre.innerText;
						function done() {
							btn.classList.add('copied');
							btn.innerHTML = checkIcon;
							setTimeout(function() {
								btn.classList.remove('copied');
								btn.innerHTML = copyIcon;
							}, 1500);
						}
						if (navigator.clipboard && navigator.clipboard.writeText) {
							navigator.clipboard.writeText(text).then(done, function() { fallbackCopy(text, done); });
						} else {
							fallbackCopy(text, done);
						}
					});

					toolbar.appendChild(langEl);
					toolbar.appendChild(btn);
					pre.classList.add('has-code-toolbar');
					pre.appendChild(toolbar);
				});
			}
			function fallbackCopy(text, done) {
				var ta = document.createElement('textarea');
				ta.value = text;
				ta.style.position = 'fixed';
				ta.style.opacity = '0';
				document.body.appendChild(ta);
				ta.select();
				try { document.execCommand('copy'); } catch (e) {}
				document.body.removeChild(ta);
				done();
			}
			document.addEventListener('DOMContentLoaded', addCopyButtons);

			// 文章目录（TOC）
			function buildToc() {
				var containers = [];
				var tocMain = document.getElementById('toc');
				var tocPopup = document.getElementById('toc-popup');
				if (tocMain) containers.push(tocMain);
				if (tocPopup) containers.push(tocPopup);
				if (!containers.length) return;

				var isEn = (document.documentElement.lang || '').toLowerCase().indexOf('en') === 0;
				var body = document.querySelector('.typography-body');
				if (!body) return;
				var headings = body.querySelectorAll('h2, h3, h4');
				var items = [];
				headings.forEach(function(h) {
					if (h.closest('.post-title-link') || h.closest('.toc') || h.closest('.toc-popup')) return;
					// 跳过不可见标题（如被 CSS 隐藏的自动注脚标题 #footnote-label）
					if (h.offsetParent === null) return;
					var text = h.textContent.replace(/\s+/g, ' ').trim();
					if (!text) return;
					var id = h.id || (text.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fff]+/g, '-').replace(/^-+|-+$/g, '') || ('toc-' + items.length));
					h.id = id;
					items.push({ level: parseInt(h.tagName.charAt(1), 10), id: id, text: text });
				});
				// 即使没有标题（items 为空），也继续渲染，保证始终有「top / bottom」导航项

				// 页面级导航：篇首 / 篇末（点击平滑滚动，实时计算目标位置）
				function makeNavItem(label, getTop) {
					var li = document.createElement('li');
					li.className = 'toc-item toc-item--nav';
					var a = document.createElement('a');
					a.href = '#';
					a.setAttribute('data-text', label); /* 供弹层条目 ::before 占位防字重位移 */
					var span = document.createElement('span');
					span.className = 'toc-text';
					span.textContent = label;
					a.appendChild(span);
					a.addEventListener('click', function(e) {
						e.preventDefault();
						window.scrollTo({ top: getTop(), behavior: 'smooth' });
					});
					li.appendChild(a);
					return li;
				}

				var allLinks = [];
				containers.forEach(function(container) {
					var title = document.createElement('div');
					title.className = 'toc-title';
					title.textContent = isEn ? 'Contents' : '目录';
					container.appendChild(title);

					var list = document.createElement('ul');
					list.className = 'toc-list';
					list.appendChild(makeNavItem('Top', function() { return 0; }));

					items.forEach(function(it) {
						var li = document.createElement('li');
						li.className = 'toc-item toc-item--h' + it.level;
						var a = document.createElement('a');
						a.href = '#' + encodeURIComponent(it.id);
						a.setAttribute('data-target', it.id);
						a.setAttribute('data-text', it.text); /* 供弹层条目 ::before 占位防字重位移 */
						var span = document.createElement('span');
						span.className = 'toc-text';
						span.textContent = it.text;
						a.appendChild(span);
						li.appendChild(a);
						list.appendChild(li);
					});

					list.appendChild(makeNavItem('Bottom', function() {
						return document.documentElement.scrollHeight;
					}));
					container.appendChild(list);
					allLinks = allLinks.concat(Array.prototype.slice.call(list.querySelectorAll('a')));
				});

				// 滚动时高亮当前章节（scroll 监听 + rAF 节流）
				function updateActive() {
					var currentId = null;
					var nearBottom = (window.innerHeight + (window.scrollY || 0)) >= document.documentElement.scrollHeight - 20;
					if (nearBottom) {
						var lastItem = items[items.length - 1];
						if (lastItem) currentId = lastItem.id;
					} else {
						for (var i = 0; i < items.length; i++) {
							var el = document.getElementById(items[i].id);
							if (el && el.getBoundingClientRect().top <= 120) {
								currentId = items[i].id;
							}
						}
					}
					allLinks.forEach(function(a) {
						var target = a.getAttribute('data-target');
						// 跳过「篇首/篇末」等无章节目标的导航项，避免 null===null 误高亮
						if (target === null) return;
						a.classList.toggle('is-active', target === currentId);
					});
				}
				updateActive();
				window.addEventListener('scroll', function() { window.requestAnimationFrame(updateActive); });
				window.addEventListener('resize', updateActive);
				// 目录条目生成后，应用 post nav 同款两行按词省略号
				clampNavTitles();
				// 移动端：右上角按钮切换目录弹层
				var toggleBtn = document.getElementById('toc-toggle');
				if (toggleBtn && tocPopup) {
					toggleBtn.addEventListener('click', function(e) {
						e.stopPropagation();
						toggleBtn.classList.toggle('active');
						tocPopup.classList.toggle('active');
					});
					// 点击弹层内任一目录项后收起弹层
					tocPopup.addEventListener('click', function(e) {
						if (e.target.closest && e.target.closest('a')) {
							toggleBtn.classList.remove('active');
							tocPopup.classList.remove('active');
						}
					});
					document.addEventListener('click', function(e) {
						if (tocPopup.classList.contains('active') &&
							!tocPopup.contains(e.target) &&
							!toggleBtn.contains(e.target)) {
							toggleBtn.classList.remove('active');
							tocPopup.classList.remove('active');
						}
					});
				}
			}
			document.addEventListener('DOMContentLoaded', buildToc);
		})();
	</script>
	</body>
</html>