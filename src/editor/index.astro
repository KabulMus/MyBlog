---
// 本地博客编辑器（只在 dev 下挂载：见 astro.config.mjs 的 blogEditor 集成）
// 不套 Layout —— 这是一个独立工具页，但样式 token 直接复用 main.css，跟站点同一套设计语言。
// M0：文章列表 + 原文只读 + 右侧真页面预览（iframe 指向 dev server 上的真实文章页）
// M1 起左侧会换成 TipTap 富文本编辑器，本页外壳不变。
import '../styles/main.css';
import './editor.css';
---

<html lang="zh-CN" data-pagefind-ignore>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Blog Editor</title>
		<script src="/js/core.js" is:inline></script>
	</head>
	<body class="editor-body">
		<header class="editor-bar">
			<div class="editor-bar-left">
				<span class="editor-brand">博客编辑器</span>
				<button class="editor-icon-btn" id="theme-btn" type="button" onclick="toggleTheme()" aria-label="切换亮暗模式">
					<span class="icon-sun" aria-hidden="true">
						<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
							<path d="M9.15039 9.15088L11.3778 11.3783"/><path d="M3 24H6.15"/><path d="M9.15039 38.8495L11.3778 36.6221"/><path d="M38.8495 38.8495L36.6221 36.6221"/><path d="M44.9996 24H41.8496"/><path d="M38.8495 9.15088L36.6221 11.3783"/><path d="M24 3V6.15"/><path d="M24 36C30.6274 36 36 30.6274 36 24C36 17.3726 30.6274 12 24 12C17.3726 12 12 17.3726 12 24C12 30.6274 17.3726 36 24 36Z"/><path d="M24 45.0001V41.8501"/>
						</svg>
					</span>
					<span class="icon-moon" aria-hidden="true">
						<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round">
							<path d="M28.0527 4.41085C22.5828 5.83695 18.5455 10.8106 18.5455 16.7273C18.5455 23.7564 24.2436 29.4545 31.2727 29.4545C37.1894 29.4545 42.1631 25.4172 43.5891 19.9473C43.8585 21.256 44 22.6115 44 24C44 35.0457 35.0457 44 24 44C12.9543 44 4 35.0457 4 24C4 12.9543 12.9543 4 24 4C25.3885 4 26.744 4.14149 28.0527 4.41085Z"/>
						</svg>
					</span>
				</button>
			</div>
			<div class="editor-bar-center">
				<select id="post-picker" class="editor-select" aria-label="选择文章">
					<option value="">正在读取文章列表…</option>
				</select>
			</div>
			<div class="editor-bar-right">
				<span id="post-meta" class="editor-meta"></span>
				<button class="editor-icon-btn" id="reload-btn" type="button" aria-label="重新加载预览" title="重新加载预览">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 1 1-3-6.7"/><path d="M21 4v5h-5"/></svg>
				</button>
				<a class="editor-icon-btn" id="open-btn" href="#" target="_blank" rel="noopener" aria-label="在新标签页打开" title="在新标签页打开">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5h5v5"/><path d="M19 5l-8 8"/><path d="M19 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h4"/></svg>
				</a>
			</div>
		</header>

		<main class="editor-main">
			<section class="editor-pane editor-pane--edit" aria-label="编辑区">
				<div class="editor-pane-head">
					<span>源码（只读）</span>
					<span class="editor-hint">M1 会换成富文本编辑器</span>
				</div>
				<pre id="source-view" class="editor-source">请先在上方选择一篇文章。</pre>
			</section>
			<section class="editor-pane editor-pane--preview" aria-label="预览区">
				<div class="editor-pane-head">
					<span>预览</span>
					<span id="preview-url" class="editor-hint"></span>
				</div>
				<iframe id="preview" class="editor-frame" title="预览" src="about:blank"></iframe>
			</section>
		</main>

		<script>
			type Post = {
				path: string;
				url: string;
				lang: 'zh' | 'en';
				draft: boolean;
				ai: boolean;
				date: string;
				title: string;
				bytes: number;
			};
			type PostDetail = { path: string; url: string; raw: string; body: string; frontmatter: Record<string, unknown> };

			const api = (p: string) => `/__editor/api${p}`;
			// ⚠️ 必须走 unknown 中转：本仓库 TS 的 DOM lib 里 HTMLElement 与 HTMLSelectElement 等
			//    被判定为「不充分重叠」（lib 版本差异），直接 as 会报错。
			const el = <T,>(id: string) => document.getElementById(id) as unknown as T;
			const picker = el<HTMLSelectElement>('post-picker');
			const sourceView = el<HTMLPreElement>('source-view');
			const frame = el<HTMLIFrameElement>('preview');
			const meta = el<HTMLSpanElement>('post-meta');
			const previewUrl = el<HTMLSpanElement>('preview-url');
			const openBtn = el<HTMLAnchorElement>('open-btn');
			const reloadBtn = el<HTMLButtonElement>('reload-btn');

			let posts: Post[] = [];
			let current: PostDetail | null = null;

			const fmtBadges = (p: Post) => {
				const bits = [p.lang === 'en' ? 'EN' : 'ZH'];
				if (p.draft) bits.push('草稿');
				if (p.ai) bits.push('AI 译');
				return bits.join(' · ');
			};

			async function loadList() {
				const res = await fetch(api('/posts'));
				if (!res.ok) throw new Error('读取文章列表失败（HTTP ' + res.status + '）');
				posts = (await res.json()) as Post[];
				const groups: Array<{ label: string; test: (p: Post) => boolean }> = [
					{ label: '中文 · 已发布', test: (p) => p.lang === 'zh' && !p.draft },
					{ label: 'English · Published', test: (p) => p.lang === 'en' && !p.draft },
					{ label: '草稿 · Drafts（中文）', test: (p) => p.lang === 'zh' && p.draft },
					{ label: '草稿 · Drafts（English）', test: (p) => p.lang === 'en' && p.draft },
				];
				picker.innerHTML = '';
				for (const g of groups) {
					const items = posts.filter(g.test);
					if (!items.length) continue;
					const og = document.createElement('optgroup');
					og.label = g.label;
					for (const p of items) {
						const opt = document.createElement('option');
						opt.value = p.path;
						opt.textContent = `${p.date.slice(0, 10)} · ${p.title} [${fmtBadges(p)}]`;
						og.appendChild(opt);
					}
					picker.appendChild(og);
				}
				if (!posts.length) picker.innerHTML = '<option value="">（没有找到任何文章）</option>';
			}

			async function loadPost(path: string) {
				if (!path) return;
				const res = await fetch(api('/post?path=' + encodeURIComponent(path)));
				if (!res.ok) {
					sourceView.textContent = '读取失败：HTTP ' + res.status;
					return;
				}
				const detail = (await res.json()) as PostDetail;
				current = detail;
				sourceView.textContent = detail.raw;
				const p = posts.find((x) => x.path === path);
				meta.textContent = p ? `${fmtBadges(p)} · ${(p.bytes / 1024).toFixed(1)} KB` : '';
				previewUrl.textContent = detail.url;
				openBtn.href = detail.url;
				reload();
			}

			const reload = () => {
				if (!current) return;
				frame.src = current.url + (current.url.includes('?') ? '&' : '?') + 'editor=1&t=' + Date.now();
			};

			picker.addEventListener('change', () => {
				if (picker.value) localStorage.setItem('editor:last-post', picker.value);
				void loadPost(picker.value);
			});
			reloadBtn.addEventListener('click', reload);

			loadList()
				.then(() => {
					const remember = localStorage.getItem('editor:last-post');
					const target = posts.some((p) => p.path === remember) ? String(remember) : posts[0]?.path;
					if (target) {
						picker.value = target;
						return loadPost(target);
					}
				})
				.catch((err) => {
					sourceView.textContent = String(err && err.message ? err.message : err);
				});
		</script>
	</body>
</html>
