				<div class="np-block"><span class="np-key">分类</span><div class="fm-chips" id="np-category"></div></div>
				<div class="np-block"><span class="np-key">标签</span><div class="fm-chips" id="np-tags"></div></div>
				<div class="np-block"><span class="np-key">警告</span><div class="fm-chips" id="np-warning"></div></div>
				<div class="np-block"><span class="np-key">标记</span><div class="fm-chips" id="np-flags"></div></div>
