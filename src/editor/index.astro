---
// 本地博客编辑器（只在 dev 下挂载：见 astro.config.mjs 的 blogEditor 集成）
// 不套 Layout —— 独立工具页，但样式 token 直接复用 main.css，跟站点同一套设计语言。
// M1：frontmatter 表单 + TipTap 正文 + 保存（写回文件 -> 右侧 iframe 自动热更新）
import '../styles/main.css';
import './editor.css';
import { categories } from '../config/categories';
import { tagDefs, tagOrder } from '../config/tags';

// 分类 / 标签直接取配置真源（CLI 脚本里那份拷贝以后也可以换成这个）
const editorConfig = {
	categories: categories.map((c) => ({ id: c.id, zh: c.zh, en: c.en })),
	tags: tagOrder.map((key) => ({ key, zh: tagDefs[key].zh, en: tagDefs[key].en, cats: tagDefs[key].cats ?? [] })),
	warnings: [
		{ key: 'opinion', zh: '主观', en: 'Opinion' },
		{ key: 'spoilers', zh: '剧透', en: 'Spoilers' },
		{ key: 'politics', zh: '政治', en: 'Politics' },
		{ key: 'adult', zh: '成人', en: 'Adult' },
	],
};
---

<html lang="zh-CN" data-pagefind-ignore>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Blog Editor</title>
		<!-- ⚠️ 必须跟 Layout.astro 一样引一遍字体：正文样式（main.css 的 .typography-body）用的是
		     Inter / JetBrains Mono / Noto Serif SC / Source Serif 4 等，编辑器不引就全套回落成系统字体，
		     跟真页面对不上。（Source Serif 4 是 main.css 自带 @font-face，其余都靠这两个 link） -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Encode+Sans+SC:wght@100..900&family=Encode+Sans:wght@100..900&family=Google+Sans+Flex:opsz,wght@6..144,1..1000&family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Noto+Sans+SC:wght@100..900&family=Noto+Serif+SC:wght@200..900&family=Playfair+Display+SC:ital,wght@0,400;0,700;0,900;1,400;1,700;1,900&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" />
		<link rel="preconnect" href="https://rsms.me/" />
		<link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
		<script src="/js/core.js" is:inline></script>
	</head>
	<body class="editor-body">
		<header class="editor-bar">
			<div class="editor-bar-left">
				<span class="editor-brand">博客编辑器</span>
				<button class="editor-icon-btn editor-icon-btn--plain" id="theme-btn" type="button" onclick="toggleTheme()" aria-label="切换亮暗模式">
					<span class="icon-sun" aria-hidden="true">
						<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
							<path d="M9.15039 9.15088L11.3778 11.3783"/><path d="M3 24H6.15"/><path d="M9.15039 38.8495L11.3778 36.6221"/><path d="M38.8495 38.8495L36.6221 36.6221"/><path d="M44.9996 24H41.8496"/><path d="M38.8495 9.15088L36.6221 11.3783"/><path d="M24 3V6.15"/><path d="M24 36C30.6274 36 36 30.6274 36 24C36 17.3726 30.6274 12 24 12C17.3726 12 12 17.3726 12 24C12 30.6274 17.3726 36 24 36Z"/><path d="M24 45.0001V41.8501"/>
						</svg>
					</span>
					<span class="icon-moon" aria-hidden="true">
						<svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round">
							<path d="M28.0527 4.41085C22.5828 5.83695 18.5455 10.8106 18.5455 16.7273C18.5455 23.7564 24.2436 29.4545 31.2727 29.4545C37.1894 29.4545 42.1631 25.4172 43.5891 19.9473C43.8585 21.256 44 22.6115 44 24C44 35.0457 35.0457 44 24 44C12.9543 44 4 35.0457 4 24C4 12.9543 12.9543 4 24 4C25.3885 4 26.744 4.14149 28.0527 4.41085Z"/>
						</svg>
					</span>
				</button>
			</div>
			<div class="editor-bar-center">
				<select id="post-picker" class="editor-select" aria-label="选择文章">
					<option value="">正在读取文章列表…</option>
				</select>
				<button class="editor-btn" id="new-btn" type="button">新建</button>
			</div>
			<div class="editor-bar-right">
				<span id="post-meta" class="editor-meta"></span>
				<button class="editor-btn" id="source-btn" type="button">源码</button>
				<button class="editor-btn" id="pub-btn" type="button">发布</button>
				<button class="editor-btn editor-btn--primary" id="save-btn" type="button" disabled>保存</button>
				<a class="editor-icon-btn" id="open-btn" href="#" target="_blank" rel="noopener" aria-label="在新标签页打开">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 5h5v5"/><path d="M19 5l-8 8"/><path d="M19 14v4a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h4"/></svg>
				</a>
			</div>
		</header>

		<main class="editor-main">
			<section class="editor-pane editor-pane--edit" aria-label="编辑区">
				<form class="editor-form" id="fm-form" autocomplete="off">
					<div class="fm-row fm-row--title">
						<label for="fm-title">标题</label>
						<input id="fm-title" class="fm-title" type="text" />
					</div>
					<div class="fm-row">
						<label for="fm-date">日期</label>
						<span class="fm-date-wrap">
							<input id="fm-date" type="datetime-local" />
							<svg class="fm-date-icon" viewBox="0 0 48 48" aria-hidden="true">
								<path d="M5 19H43V40C43 41.1046 42.1046 42 41 42H7C5.89543 42 5 41.1046 5 40V19Z" />
								<path d="M5 9C5 7.89543 5.89543 7 7 7H41C42.1046 7 43 7.89543 43 9V19H5V9Z" />
								<path d="M16 4V12" />
								<path d="M32 4V12" />
								<path d="M28 34H34" />
								<path d="M14 34H20" />
								<path d="M28 26H34" />
								<path d="M14 26H20" />
							</svg>
						</span>
					</div>
					<div class="fm-row">
						<label>标记</label>
						<div class="fm-chips" id="fm-flags"></div>
					</div>
					<div class="fm-row">
						<label>分类</label>
						<div class="fm-chips" id="fm-category"></div>
					</div>
					<div class="fm-row">
						<label>标签</label>
						<div class="fm-chips" id="fm-tags"></div>
					</div>
					<div class="fm-row">
						<label>内容警告</label>
						<div class="fm-chips" id="fm-warning"></div>
					</div>
				</form>

				<div class="editor-toolbar" id="toolbar">
					<!-- 段落/标题：一个下拉管 H1–H6（文章里最常用的是 H2/H3，但级别不能缺）。
					     图标是站内那套描边图标（viewBox 48 / stroke 4），stroke 用 currentColor ⇒ 跟着主题/选中态变。
					     H1 置灰：站点里文章标题本身就是 H1，正文再写 H1 属于「能写但不推荐」—— 只是提示，仍然可点。 -->
					<span class="hd-wrap">
						<!-- 段落/标题：自绘下拉。原生 <select> 的**弹层**是 Chromium 自己画的（系统字体、灰色高亮、方角），
						     跟编辑器不是一个长相 ⇒ 按钮 + 自绘菜单。收起态 = 图标 + 级别名 + 箭头，
						     图标路径由 syncHeading() 从菜单里对应那一项搬过来（只维护一份 path）。 -->
						<button type="button" id="heading-btn" class="editor-toolbar-select" aria-haspopup="listbox" aria-expanded="false" aria-label="段落 / 标题级别">
							<svg id="hd-cur" class="hd-cur" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"></svg>
							<span id="hd-label">正文</span>
							<svg class="hd-arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M6.5 9.75L12 15.25L17.5 9.75" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
						</button>
					</span>
					<!-- 弹层 position: fixed ⇒ 不参与这行 flex 布局，放工具条里也没事（但用 .editor-menu 前缀写样式，免得被工具条那套按钮规则抢走） -->
					<div class="editor-menu" id="heading-menu" role="listbox" aria-label="段落 / 标题级别" hidden>
						<button type="button" class="editor-menu-item" role="option" data-value="p" aria-selected="false"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 10.9333V6H40V10.9333" /><path d="M24 6V42" /><path d="M16 42H32" /></svg>正文</button>
						<button type="button" class="editor-menu-item is-dim" role="option" data-value="h1" aria-selected="false"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8V40" /><path d="M25 8V40" /><path d="M6 24H25" /><path d="M34.2261 24L39.0001 19.0166V40" /></svg>标题 1</button>
						<button type="button" class="editor-menu-item" role="option" data-value="h2" aria-selected="false"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8V40" /><path d="M24 8V40" /><path d="M7 24H23" /><path d="M32 25C32 21.8334 34.6667 20 37 20C39.3334 20 42 21.8334 42 25C42 30.7 32 34.9333 32 40H42" /></svg>标题 2</button>
						<button type="button" class="editor-menu-item" role="option" data-value="h3" aria-selected="false"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8V40" /><path d="M24 8V40" /><path d="M7 24H23" /><path d="M32 20H42L35 29C39 29 42 31 42 35C42 39 39 40 37 40C34.619 40 33 39 32 37.9" /></svg>标题 3</button>
						<button type="button" class="editor-menu-item" role="option" data-value="h4" aria-selected="false"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8V40" /><path d="M24 8V40" /><path d="M7 24H23" /><path d="M39.9767 40V20L31 32.9967V35.0199H43" /></svg>标题 4</button>
						<button type="button" class="editor-menu-item" role="option" data-value="h5" aria-selected="false"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8V40" /><path d="M24 8V40" /><path d="M7 24H23" /><path d="M40 21.0093H32V28.0341C32 28 34 27 37 27C40 27 41 29.5339 41 33.5C41 37.4661 40 40 36 40C33 40 32 38 32 36.0078" /></svg>标题 5</button>
						<button type="button" class="editor-menu-item" role="option" data-value="h6" aria-selected="false"><svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 8V40" /><path d="M24 8V40" /><path d="M7 24H23" /><path d="M36.5 40C39.5376 40 42 37.5376 42 34.5C42 31.4624 39.5376 29 36.5 29C33.4624 29 31 31.4624 31 34.5C31 37.5376 33.4624 40 36.5 40Z" /><path d="M41.5962 24.7392C40.7778 22.5461 38.8044 21 36.5 21C33.4624 21 31 23.6863 31 27V34" /></svg>标题 6</button>
					</div>
					<!-- 行内（图标按钮：stroke/fill 一律吃 currentColor ⇒ hover、按下态自动跟着变色。
					     粗体那枚线加粗一档（4 → 5.5）拉开主次；没有可见文字的都补 aria-label。
					     ⚠️ 图标按钮比文字按钮矮，靠 .editor-toolbar button 的 min-height 拉齐高度。） -->
					<button type="button" data-cmd="bold" aria-label="粗体"><svg width="15" height="15" viewBox="0 0 48 48" fill="none" aria-hidden="true"><!-- 线宽 7（= 屏幕 2.02px，其他图标是 1.25px）比 4 的图标往外多长 1.5 单位，
						     上下会只剩 0.5 单位、贴着框边看着像被切。所以整个 B 绕中心缩到 0.925：
						     画出来的范围回到 y 2–46，跟斜体/删除线/行内代码那几枚完全对齐。 -->
						<g transform="translate(24 24) scale(0.925) translate(-24 -24)"><path fill-rule="evenodd" clip-rule="evenodd" d="M24 24C29.5056 24 33.9688 19.5228 33.9688 14C33.9688 8.47715 29.5056 4 24 4H11V24H24Z" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /><path fill-rule="evenodd" clip-rule="evenodd" d="M28.0312 44C33.5368 44 38 39.5228 38 34C38 28.4772 33.5368 24 28.0312 24H11V44H28.0312Z" stroke="currentColor" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" /></g></svg></button>
					<button type="button" data-cmd="italic" aria-label="斜体"><svg width="15" height="15" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M20 6H36" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /><path d="M12 42H28" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /><path d="M29 5.95215L19 41.9998" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
					<button type="button" data-cmd="strike" aria-label="删除线"><svg width="15" height="15" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M5 24H43" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /><path d="M24 24C40 30 34 44 24 44C13.9999 44 12 36 12 36" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /><path d="M35.9999 12C35.9999 12 33 4 23.9999 4C14.9999 4 11.4359 11.5995 15.6096 18" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /><path d="M12 36C12 36 15.9999 44 24 44C32 44 36.564 36.4005 32.3903 30" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
					<button type="button" data-cmd="code" aria-label="行内代码"><svg width="15" height="15" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M16 13L4 25.4322L16 37" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /><path d="M32 13L44 25.4322L32 37" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /><path d="M28 4L21 44" stroke="currentColor" stroke-width="4" stroke-linecap="round" /></svg></button>
					<button type="button" data-cmd="mark" aria-label="高亮"><svg width="15" height="15" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M6 44L6 25H12V17H36V25H42V44H6Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" /><path d="M17 17V8L31 4V17" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
					<!-- 上标/下标：没有现成图标，自己仿的 —— 带衬线的 X + 缩小并抬/沉的「2」（X² / X₂）。
					     三条 path：X 的两条对角线、四条「脚」（衬线，照标题下拉那枚 T 的做法用横杠）、那个 2（曲线）。
					     视口就是 15（跟渲染尺寸 1:1），线宽 1.25 换算成屏幕等于 48 格的 4 / 24 格的 2。 -->
					<button type="button" data-cmd="sup" aria-label="上标"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true"><path d="M2.29,5.88l5.5,6.75M7.79,5.88l-5.5,6.75" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /><path d="M1.16,5.88h2.25M6.66,5.88h2.25M1.16,12.63h2.25M6.66,12.63h2.25" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /><path d="M10.58,3.56c0-.78.87-1.22,1.63-1.22s1.63.45,1.63,1.22c0,1.4-3.26,2.43-3.26,3.67h3.26" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
					<button type="button" data-cmd="sub" aria-label="下标"><svg width="15" height="15" viewBox="0 0 15 15" fill="none" aria-hidden="true"><path d="M2.29,2.34l5.5,6.75M7.79,2.34l-5.5,6.75" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /><path d="M1.16,2.34h2.25M6.66,2.34h2.25M1.16,9.09h2.25M6.66,9.09h2.25" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /><path d="M10.58,8.97c0-.78.87-1.22,1.63-1.22s1.63.45,1.63,1.22c0,1.4-3.26,2.43-3.26,3.67h3.26" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
					<button type="button" data-cmd="kbd" aria-label="键盘按键"><svg width="15" height="15" viewBox="0 0 48 48" fill="none" aria-hidden="true"><path d="M24 44C35.0457 44 44 35.0457 44 24C44 12.9543 35.0457 4 24 4C12.9543 4 4 12.9543 4 24C4 35.0457 12.9543 44 24 44Z" fill="none" stroke="currentColor" stroke-width="4" stroke-linejoin="round" /><path fill-rule="evenodd" clip-rule="evenodd" d="M15 19C16.3807 19 17.5 17.8807 17.5 16.5C17.5 15.1193 16.3807 14 15 14C13.6193 14 12.5 15.1193 12.5 16.5C12.5 17.8807 13.6193 19 15 19Z" fill="currentColor" /><path fill-rule="evenodd" clip-rule="evenodd" d="M15 27C16.3807 27 17.5 25.8807 17.5 24.5C17.5 23.1193 16.3807 22 15 22C13.6193 22 12.5 23.1193 12.5 24.5C12.5 25.8807 13.6193 27 15 27Z" fill="currentColor" /><path fill-rule="evenodd" clip-rule="evenodd" d="M24 19C25.3807 19 26.5 17.8807 26.5 16.5C26.5 15.1193 25.3807 14 24 14C22.6193 14 21.5 15.1193 21.5 16.5C21.5 17.8807 22.6193 19 24 19Z" fill="currentColor" /><path fill-rule="evenodd" clip-rule="evenodd" d="M24 27C25.3807 27 26.5 25.8807 26.5 24.5C26.5 23.1193 25.3807 22 24 22C22.6193 22 21.5 23.1193 21.5 24.5C21.5 25.8807 22.6193 27 24 27Z" fill="currentColor" /><path fill-rule="evenodd" clip-rule="evenodd" d="M33 19C34.3807 19 35.5 17.8807 35.5 16.5C35.5 15.1193 34.3807 14 33 14C31.6193 14 30.5 15.1193 30.5 16.5C30.5 17.8807 31.6193 19 33 19Z" fill="currentColor" /><path fill-rule="evenodd" clip-rule="evenodd" d="M33 27C34.3807 27 35.5 25.8807 35.5 24.5C35.5 23.1193 34.3807 22 33 22C31.6193 22 30.5 23.1193 30.5 24.5C30.5 25.8807 31.6193 27 33 27Z" fill="currentColor" /><path d="M17 33H31" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
					<!-- 注音 ruby（<ruby>汉<rt>hàn</rt></ruby>）：站点 main.css 有整套 ruby 样式，ruby/rt 也在 RICH_TAGS 里 ⇒ 编辑器里直接显示真注音。
					     图标是 Illustrator 导出的那版（viewBox 24）。⚠️ 原文件里写的是 stroke-width 1.25px，
					     换算到 15px 只有 0.78px，比其它图标细 40% ⇒ 按现有那套规则改成 2（屏幕上 1.25px）。 -->
					<button type="button" data-cmd="ruby" aria-label="注音 ruby"><svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M11.37,12.37l.63,1.24" /><path d="M5.1,14.43h13.8" /><path d="M7.61,16.5s1.12,2.58,3.93,4.02c2.81,1.43,7.36,2.58,7.36,2.58" /><path d="M16.39,14.43s-1.12,3.39-3.93,5.27c-2.81,1.88-7.36,3.39-7.36,3.39" /><!-- 上面这四条是「文」（亠 + 乂），描边沿用 2（屏幕上 1.25px）。
					     下面一组是注音「wén」（ㄨㄣ + 阳平调号）：字形本来就小，四条 1.25px 的线挤在 6px 里会糊成一块
