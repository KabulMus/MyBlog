				<button type="button" id="link-open" hidden>打开</button>
				<button type="button" id="link-cancel">取消</button>
			</div>
		</div>

		<!-- 自绘确认弹窗（取代 window.confirm）。Chromium 自带的那些弹窗改不了字体/圆角/配色，
		     跟编辑器放一起一眼就看出不是一套；而且自动化标签页里还可能被拦。 -->
		<div class="editor-modal" id="modal" hidden>
			<div class="editor-modal-card" role="dialog" aria-modal="true" aria-labelledby="modal-title">
				<h3 class="editor-modal-title" id="modal-title"></h3>
				<p class="editor-modal-text" id="modal-text"></p>
				<div class="editor-modal-btns">
					<button type="button" id="modal-cancel">取消</button>
